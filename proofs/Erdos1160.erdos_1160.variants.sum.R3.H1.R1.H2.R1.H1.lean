import OMAReductions.R_Erdos1160_erdos_1160_variants_sum_R3_H1_R1_H2_R1

-- Step Erdos1160.erdos_1160.variants.sum.R3.H1.R1.H2.R1.H1: hypothesis H1 of reduction Erdos1160.erdos_1160.variants.sum.R3.H1.R1.H2.R1
-- Credit: @FarzanAhmedHossain
-- H1 := ∀ p a : ℕ, p.Prime → g (p^a)^6 * p^a ≤ p^(a^3)

/-!
The classical power-conjugate presentation bound: there are at most `p^((n^3-n)/6)` groups of
order `p^n`.

* `exists_pcgs`: a group of order `p^n` has a generating list `a_0, ..., a_{n-1}` refining a
  central series with factors of order `p` (induction through `G / <z>`, `z` central of order `p`).
* `nf_surj`: every element of the closure of a suffix is a normal-form product with exponents
  below `p`.
* `iso_Gam`: such a group is isomorphic to the group presented by its power and conjugation
  codes, because the presented group has at most `p^n` elements and surjects onto it.
* `g_pow_le`: isomorphism classes inject into codes, indexed by triples `i ≤ j < k < n`, of which
  there are `C(n+1,3) = (n^3-n)/6` (`six_card`).
-/

open Subgroup

namespace OMA.PcBound

universe u v

section NF

variable {G : Type u} [Group G] {H : Type v} [Group H]

/-- The subgroup generated by the entries of a list. -/
def cl (l : List G) : Subgroup G := Subgroup.closure {x | x ∈ l}

lemma cl_def (l : List G) : cl l = Subgroup.closure {x | x ∈ l} := rfl

lemma mem_cl_of_mem {l : List G} {x : G} (h : x ∈ l) : x ∈ cl l := Subgroup.subset_closure h

/-- A normal-form product `l[n-1]^(e (n-1)) * ... * l[0]^(e 0)`. -/
def nf : List G → (ℕ → ℕ) → G
  | [], _ => 1
  | b :: l, e => nf l (fun k => e (k + 1)) * b ^ (e 0)

@[simp] lemma nf_nil (e : ℕ → ℕ) : nf ([] : List G) e = 1 := rfl

@[simp] lemma nf_cons (b : G) (l : List G) (e : ℕ → ℕ) :
    nf (b :: l) e = nf l (fun k => e (k + 1)) * b ^ (e 0) := rfl

lemma nf_map (f : G →* H) : ∀ (l : List G) (e : ℕ → ℕ), f (nf l e) = nf (l.map f) e
  | [], e => by simp
  | b :: l, e => by simp [nf_map f l]

lemma nf_mem : ∀ (l : List G) (e : ℕ → ℕ), nf l e ∈ cl l
  | [], e => by simp [cl]
  | b :: l, e => by
    rw [nf_cons]
    refine mul_mem ?_ (pow_mem (mem_cl_of_mem (by simp)) _)
    exact Subgroup.closure_mono (fun x hx => by simp_all) (nf_mem l _)

lemma nf_congr : ∀ (l : List G) (e e' : ℕ → ℕ), (∀ k < l.length, e k = e' k) →
    nf l e = nf l e'
  | [], e, e', _ => rfl
  | b :: l, e, e', h => by
    rw [nf_cons, nf_cons, nf_congr l _ (fun k => e' (k + 1))
      (fun k hk => h (k + 1) (by simp; omega)), h 0 (by simp)]

lemma cl_drop_mono (l : List G) {a b : ℕ} (h : a ≤ b) : cl (l.drop b) ≤ cl (l.drop a) :=
  Subgroup.closure_mono fun _ hx => (List.drop_sublist_drop_left l h).subset hx

lemma getElem_mem_drop (l : List G) {i j : ℕ} (hij : i ≤ j) (hj : j < l.length) :
    l[j] ∈ l.drop i := by
  rw [List.mem_iff_getElem]
  refine ⟨j - i, by simp; omega, ?_⟩
  simp only [List.getElem_drop]
  congr 1
  omega

/-- Normal forms exist: under the power and normality hypotheses every element of the closure is
a normal-form product with exponents below `p`. -/
theorem nf_surj (p : ℕ) (hp : 0 < p) : ∀ (X : List G),
    (∀ i (hi : i < X.length), X[i] ^ p ∈ cl (X.drop (i + 1))) →
    (∀ i j (hij : i < j) (hj : j < X.length), X[i] * X[j] * X[i]⁻¹ ∈ cl (X.drop (i + 1))) →
    ∀ x ∈ cl X, ∃ e : ℕ → ℕ, (∀ k, e k < p) ∧ x = nf X e
  | [], _, _, x, hx => by
    refine ⟨fun _ => 0, fun _ => hp, ?_⟩
    have : x = 1 := by simpa [cl] using hx
    simp [this]
  | b :: Y, hpow, hnorm, x, hx => by
    have hpowY : ∀ i (hi : i < Y.length), Y[i] ^ p ∈ cl (Y.drop (i + 1)) := fun i hi =>
      hpow (i + 1) (by simp; omega)
    have hnormY : ∀ i j (hij : i < j) (hj : j < Y.length),
        Y[i] * Y[j] * Y[i]⁻¹ ∈ cl (Y.drop (i + 1)) := fun i j hij hj =>
      hnorm (i + 1) (j + 1) (by omega) (by simp; omega)
    have hbp : b ^ p ∈ cl Y := hpow 0 (by simp)
    have hconj : ∀ y ∈ cl Y, b * y * b⁻¹ ∈ cl Y := by
      intro y hy
      have hle : cl Y ≤ (cl Y).comap (MulAut.conj b).toMonoidHom := by
        rw [cl_def Y, Subgroup.closure_le]
        intro z hz
        obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem hz
        exact hnorm 0 (j + 1) (by omega) (by simp; omega)
      simpa using hle hy
    have hconjm : ∀ m : ℕ, ∀ y ∈ cl Y, b ^ m * y * (b ^ m)⁻¹ ∈ cl Y := by
      intro m
      induction m with
      | zero => intro y hy; simpa using hy
      | succ m ih =>
        intro y hy
        have := hconj _ (ih y hy)
        convert this using 1
        group
    have key : ∀ z ∈ cl (b :: Y), ∃ y ∈ cl Y, ∃ k : ℕ, z = y * b ^ k := by
      intro z hz
      rw [cl_def] at hz
      induction hz using Subgroup.closure_induction_left with
      | one => exact ⟨1, one_mem _, 0, by simp⟩
      | mul_left g hg z hz ih =>
        obtain ⟨y, hy, k, rfl⟩ := ih
        simp only [Set.mem_ofPred_eq, List.mem_cons] at hg
        rcases hg with rfl | hg
        · exact ⟨g * y * g⁻¹, hconj y hy, k + 1, by group⟩
        · exact ⟨g * y, mul_mem (mem_cl_of_mem hg) hy, k, by group⟩
      | inv_mul_cancel g hg z hz ih =>
        obtain ⟨y, hy, k, rfl⟩ := ih
        simp only [Set.mem_ofPred_eq, List.mem_cons] at hg
        rcases hg with rfl | hg
        · obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
          refine ⟨g ^ q * ((g ^ (q + 1))⁻¹ * y) * (g ^ q)⁻¹,
            hconjm q _ (mul_mem (inv_mem hbp) hy), q + k, ?_⟩
          group
        · exact ⟨g⁻¹ * y, mul_mem (inv_mem (mem_cl_of_mem hg)) hy, k, by group⟩
    obtain ⟨y, hy, k, rfl⟩ := key x hx
    have hy' : y * (b ^ p) ^ (k / p) ∈ cl Y := mul_mem hy (pow_mem hbp _)
    obtain ⟨e', he'p, he'⟩ := nf_surj p hp Y hpowY hnormY _ hy'
    refine ⟨fun i => Nat.casesOn i (k % p) e', ?_, ?_⟩
    · intro i
      cases i with
      | zero => exact Nat.mod_lt _ hp
      | succ i => exact he'p i
    · show y * b ^ k = nf Y e' * b ^ (k % p)
      rw [← he', mul_assoc, ← pow_mul, ← pow_add, Nat.div_add_mod]

end NF

section Pres

variable (p n : ℕ) (P : ℕ → ℕ → ℕ) (C : ℕ → ℕ → ℕ → ℕ)

/-- The free generators `x_0, ..., x_{n-1}`. -/
def gens : List (FreeGroup ℕ) := (List.range n).map FreeGroup.of

/-- Power relations, conjugation relations, and `x_k = 1` for `k ≥ n`. -/
def rels : Set (FreeGroup ℕ) :=
  {r | ∃ i, i < n ∧ r = FreeGroup.of i ^ p * (nf ((gens n).drop (i + 1)) (P i))⁻¹} ∪
  {r | ∃ i j, i < j ∧ j < n ∧ r = FreeGroup.of i * FreeGroup.of j * (FreeGroup.of i)⁻¹ *
      (nf ((gens n).drop (j + 1)) (C i j) * FreeGroup.of j)⁻¹} ∪
  {r | ∃ k, n ≤ k ∧ r = FreeGroup.of k}

/-- The group presented by the power-conjugate codes. -/
abbrev Gam : Type := PresentedGroup (rels p n P C)

lemma length_gens : (gens n).length = n := by simp [gens]

lemma map_gens {K : Type u} [Group K] (l : List K) (hl : l.length = n) :
    (gens n).map (FreeGroup.lift (fun k => l.getD k 1)) = l := by
  apply List.ext_getElem
  · simp [gens, hl]
  · intro i h1 h2
    simp [gens, FreeGroup.lift_apply_of, h2]

lemma rels_hold {K : Type u} [Group K] (l : List K) (hl : l.length = n)
    (hP : ∀ i (hi : i < l.length), l[i] ^ p = nf (l.drop (i + 1)) (P i))
    (hC : ∀ i j (hij : i < j) (hj : j < l.length),
      l[i] * l[j] * l[i]⁻¹ = nf (l.drop (j + 1)) (C i j) * l[j]) :
    ∀ r ∈ rels p n P C, FreeGroup.lift (fun k => l.getD k 1) r = 1 := by
  have hnf : ∀ m e, FreeGroup.lift (fun k => l.getD k 1) (nf ((gens n).drop m) e) =
      nf (l.drop m) e := by
    intro m e
    rw [nf_map, List.map_drop, map_gens n l hl]
  rintro r ((⟨i, hi, rfl⟩ | ⟨i, j, hij, hj, rfl⟩) | ⟨k, hk, rfl⟩)
  · have hi' : i < l.length := by omega
    rw [map_mul, map_inv, map_pow, hnf, FreeGroup.lift_apply_of,
      List.getD_eq_getElem _ _ hi', hP i hi', mul_inv_cancel]
  · have hi' : i < l.length := by omega
    have hj' : j < l.length := by omega
    rw [map_mul, map_inv, map_mul, map_mul, map_mul, map_inv, hnf, FreeGroup.lift_apply_of,
      FreeGroup.lift_apply_of, List.getD_eq_getElem _ _ hi', List.getD_eq_getElem _ _ hj',
      hC i j hij hj', mul_inv_cancel]
  · rw [FreeGroup.lift_apply_of, List.getD_eq_default _ _ (by omega)]

/-- The generators of the presented group, as a list. -/
def X : List (Gam p n P C) := (gens n).map (PresentedGroup.mk (rels p n P C))

lemma length_X : (X p n P C).length = n := by simp [X, gens]

lemma getElem_X (i : ℕ) (hi : i < (X p n P C).length) :
    (X p n P C)[i] = PresentedGroup.of i := by
  simp [X, gens, PresentedGroup.of]

lemma mk_nf (m : ℕ) (e : ℕ → ℕ) :
    PresentedGroup.mk (rels p n P C) (nf ((gens n).drop m) e) = nf ((X p n P C).drop m) e := by
  rw [nf_map, List.map_drop]
  rfl

lemma X_pow (i : ℕ) (hi : i < (X p n P C).length) :
    (X p n P C)[i] ^ p = nf ((X p n P C).drop (i + 1)) (P i) := by
  have hi' : i < n := by rw [length_X] at hi; exact hi
  have h := PresentedGroup.one_of_mem (rels := rels p n P C)
    (x := FreeGroup.of i ^ p * (nf ((gens n).drop (i + 1)) (P i))⁻¹)
    (Set.mem_union_left _ (Set.mem_union_left _ ⟨i, hi', rfl⟩))
  rw [map_mul, map_inv, map_pow, mk_nf, mul_inv_eq_one] at h
  rw [getElem_X]
  exact h

lemma X_conj (i j : ℕ) (hij : i < j) (hj : j < (X p n P C).length) :
    (X p n P C)[i] * (X p n P C)[j] * ((X p n P C)[i])⁻¹ =
      nf ((X p n P C).drop (j + 1)) (C i j) * (X p n P C)[j] := by
  have hj' : j < n := by rw [length_X] at hj; exact hj
  have h := PresentedGroup.one_of_mem (rels := rels p n P C)
    (x := FreeGroup.of i * FreeGroup.of j * (FreeGroup.of i)⁻¹ *
      (nf ((gens n).drop (j + 1)) (C i j) * FreeGroup.of j)⁻¹)
    (Set.mem_union_left _ (Set.mem_union_right _ ⟨i, j, hij, hj', rfl⟩))
  rw [map_mul, map_inv, map_mul, map_mul, map_mul, map_inv, mk_nf, mul_inv_eq_one] at h
  rw [getElem_X, getElem_X]
  exact h

lemma of_large (k : ℕ) (hk : n ≤ k) : (PresentedGroup.of k : Gam p n P C) = 1 :=
  PresentedGroup.one_of_mem (Set.mem_union_right _ ⟨k, hk, rfl⟩)

lemma cl_X : cl (X p n P C) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  apply PresentedGroup.generated_by _ (cl (X p n P C))
  intro j
  by_cases hj : j < n
  · have hj' : j < (X p n P C).length := by rw [length_X]; exact hj
    rw [← getElem_X p n P C j hj']
    exact mem_cl_of_mem (List.getElem_mem hj')
  · rw [of_large p n P C j (by omega)]
    exact one_mem _

lemma card_Gam (hp : 0 < p) : Finite (Gam p n P C) ∧ Nat.card (Gam p n P C) ≤ p ^ n := by
  have hsurj := nf_surj p hp (X p n P C)
    (fun i hi => by rw [X_pow]; exact nf_mem _ _)
    (fun i j hij hj => by
      rw [X_conj p n P C i j hij hj]
      exact mul_mem (cl_drop_mono _ (by omega) (nf_mem _ _))
        (mem_cl_of_mem (getElem_mem_drop _ (by omega) hj)))
  let Φ : (Fin n → Fin p) → Gam p n P C :=
    fun v => nf (X p n P C) (fun k => if h : k < n then (v ⟨k, h⟩ : ℕ) else 0)
  have hΦ : Function.Surjective Φ := by
    intro x
    obtain ⟨e, he, rfl⟩ := hsurj x (by rw [cl_X]; exact Subgroup.mem_top x)
    refine ⟨fun k => ⟨e k, he k⟩, ?_⟩
    apply nf_congr
    intro k hk
    rw [length_X] at hk
    simp [hk]
  haveI : Finite (Gam p n P C) := Finite.of_surjective Φ hΦ
  refine ⟨inferInstance, ?_⟩
  have := Nat.card_le_card_of_surjective Φ hΦ
  simpa [Nat.card_eq_fintype_card] using this

/-- Rigidity: a group of order `p^n` generated by a list satisfying the coded relations is
isomorphic to the presented group. -/
theorem iso_Gam (hp : 0 < p) {K : Type u} [Group K] [Finite K] (l : List K) (hl : l.length = n)
    (hK : Nat.card K = p ^ n) (htop : cl l = ⊤)
    (hP : ∀ i (hi : i < l.length), l[i] ^ p = nf (l.drop (i + 1)) (P i))
    (hC : ∀ i j (hij : i < j) (hj : j < l.length),
      l[i] * l[j] * l[i]⁻¹ = nf (l.drop (j + 1)) (C i j) * l[j]) :
    Nonempty (K ≃* Gam p n P C) := by
  let π := PresentedGroup.toGroup (rels_hold p n P C l hl hP hC)
  have hsurj : Function.Surjective π := by
    rw [← MonoidHom.range_eq_top, eq_top_iff, ← htop, cl_def, Subgroup.closure_le]
    intro x hx
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hx
    refine ⟨PresentedGroup.of i, ?_⟩
    rw [PresentedGroup.toGroup.of, List.getD_eq_getElem _ _ hi]
  obtain ⟨hfin, hcard⟩ := card_Gam p n P C hp
  have hbij : Function.Bijective π := hsurj.bijective_of_nat_card_le (hK ▸ hcard)
  exact ⟨(MulEquiv.ofBijective π hbij).symm⟩

end Pres

section Exist

variable {G : Type u} [Group G]

lemma suffix_hyps (p : ℕ) (l : List G)
    (h2 : ∀ i (hi : i < l.length), l[i] ^ p ∈ cl (l.drop (i + 1)))
    (h3 : ∀ (g : G) j (hj : j < l.length), g * l[j] * g⁻¹ * l[j]⁻¹ ∈ cl (l.drop (j + 1)))
    (m : ℕ) :
    (∀ i (hi : i < (l.drop m).length), (l.drop m)[i] ^ p ∈ cl ((l.drop m).drop (i + 1))) ∧
    (∀ i j (hij : i < j) (hj : j < (l.drop m).length),
      (l.drop m)[i] * (l.drop m)[j] * ((l.drop m)[i])⁻¹ ∈ cl ((l.drop m).drop (i + 1))) := by
  have hdd : ∀ i, (l.drop m).drop (i + 1) = l.drop (m + i + 1) := by
    intro i
    rw [List.drop_drop]
    congr 1
  constructor
  · intro i hi
    have hi' : m + i < l.length := by simp at hi; omega
    rw [hdd, List.getElem_drop]
    exact h2 (m + i) hi'
  · intro i j hij hj
    have hj' : m + j < l.length := by simp at hj; omega
    rw [hdd, List.getElem_drop, List.getElem_drop]
    have h := h3 (l[m + i]'(by omega)) (m + j) hj'
    have e : l[m + i] * l[m + j] * (l[m + i])⁻¹ =
        (l[m + i] * l[m + j] * (l[m + i])⁻¹ * (l[m + j])⁻¹) * l[m + j] := by group
    rw [e]
    exact mul_mem (cl_drop_mono l (by omega) h)
      (mem_cl_of_mem (getElem_mem_drop l (by omega) hj'))

lemma cl_append_comap {Q : Type v} [Group Q] (f : G →* Q) (z : G) (hker : f.ker = zpowers z)
    (A : List G) : cl (A ++ [z]) = (cl (A.map f)).comap f := by
  have e1 : {x | x ∈ A ++ [z]} = {x | x ∈ A} ∪ {z} := by
    ext x
    simp [or_comm]
  have e2 : {x | x ∈ A.map f} = f '' {x | x ∈ A} := by
    ext x
    simp
  rw [cl_def, cl_def, e1, e2, Subgroup.closure_union, ← Subgroup.zpowers_eq_closure, ← MonoidHom.map_closure,
    Subgroup.comap_map_eq, hker]

/-- Every group of order `p^n` has a generating list refining a central series with factors of
order `p`. -/
theorem exists_pcgs (p : ℕ) (hp : p.Prime) : ∀ (n : ℕ) (G : Type u) [Group G] [Finite G],
    Nat.card G = p ^ n → ∃ l : List G, l.length = n ∧ cl l = ⊤ ∧
      (∀ i (hi : i < l.length), l[i] ^ p ∈ cl (l.drop (i + 1))) ∧
      (∀ (g : G) j (hj : j < l.length), g * l[j] * g⁻¹ * l[j]⁻¹ ∈ cl (l.drop (j + 1)))
  | 0, G, _, _, hG => by
    refine ⟨[], rfl, ?_, fun i hi => absurd hi (by simp), fun g j hj => absurd hj (by simp)⟩
    rw [pow_zero] at hG
    haveI : Subsingleton G := (Nat.card_eq_one_iff_unique.mp hG).1
    rw [eq_top_iff]
    intro x _
    rw [Subsingleton.elim x 1]
    exact one_mem _
  | n + 1, G, _, _, hG => by
    haveI : Fact p.Prime := ⟨hp⟩
    have hpG : IsPGroup p G := IsPGroup.of_card hG
    haveI : Nontrivial G := by
      rw [← Finite.one_lt_card_iff_nontrivial, hG]
      exact Nat.one_lt_pow (by omega) hp.one_lt
    haveI := hpG.center_nontrivial
    obtain ⟨z₀, hz₀⟩ : ∃ z : center G, orderOf z = p := by
      haveI : Fintype (center G) := Fintype.ofFinite _
      apply exists_prime_orderOf_dvd_card p
      obtain ⟨k, hk, hk'⟩ := (hpG.to_subgroup (center G)).nontrivial_iff_card.mp ‹_›
      rw [← Nat.card_eq_fintype_card, hk']
      exact dvd_pow_self p hk.ne'
    set z : G := (z₀ : G) with hzdef
    have hzo : orderOf z = p := by rw [hzdef, Subgroup.orderOf_coe, hz₀]
    have hzc : z ∈ center G := z₀.2
    haveI hZn : (zpowers z).Normal := by
      constructor
      intro x hx g
      have hc : x ∈ center G := (Subgroup.zpowers_le.mpr hzc) hx
      rw [Subgroup.mem_center_iff] at hc
      rw [hc g, mul_inv_cancel_right]
      exact hx
    have hQ : Nat.card (G ⧸ zpowers z) = p ^ n := by
      have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup (zpowers z)
      rw [Nat.card_zpowers, hzo, hG, pow_succ] at h1
      exact (Nat.eq_of_mul_eq_mul_right hp.pos h1).symm
    obtain ⟨q, hql, hqtop, hqpow, hqcen⟩ := exists_pcgs p hp n (G ⧸ zpowers z) hQ
    let mk : G →* G ⧸ zpowers z := QuotientGroup.mk' (zpowers z)
    let lift : G ⧸ zpowers z → G := Function.surjInv (QuotientGroup.mk'_surjective (zpowers z))
    have hmk : ∀ x : G ⧸ zpowers z, mk (lift x) = x :=
      fun x => Function.surjInv_eq (QuotientGroup.mk'_surjective (zpowers z)) x
    obtain ⟨l', hl'def⟩ : ∃ l' : List G, l' = q.map lift := ⟨_, rfl⟩
    have hl'len : l'.length = n := by simp [hl'def, hql]
    have hmapq : l'.map mk = q := by
      simp only [hl'def, List.map_map]
      conv_rhs => rw [← List.map_id q]
      apply List.map_congr_left
      intro x _
      exact hmk x
    have hA : ∀ k ≤ n, cl ((l' ++ [z]).drop k) = (cl (q.drop k)).comap mk := by
      intro k hk
      rw [List.drop_append_of_le_length (by omega),
        cl_append_comap mk z (QuotientGroup.ker_mk' _), List.map_drop, hmapq]
    have hget : ∀ i (hi : i < (l' ++ [z]).length) (hin : i < n),
        mk ((l' ++ [z])[i]) = q[i]'(by omega) := by
      intro i hi hin
      rw [List.getElem_append_left (by omega)]
      simp [hl'def, hmk]
    have hgetz : ∀ i (hi : i < (l' ++ [z]).length), ¬ i < n → (l' ++ [z])[i] = z := by
      intro i hi hin
      rw [List.getElem_append_right (by omega)]
      simp
    refine ⟨l' ++ [z], by simp [hl'len], ?_, ?_, ?_⟩
    · have h0 := hA 0 (Nat.zero_le _)
      rw [List.drop_zero, List.drop_zero, hqtop, Subgroup.comap_top] at h0
      exact h0
    · intro i hi
      by_cases hin : i < n
      · rw [hA (i + 1) (by omega), Subgroup.mem_comap, map_pow, hget i hi hin]
        exact hqpow i (by omega)
      · rw [hgetz i hi hin, ← hzo, pow_orderOf_eq_one]
        exact one_mem _
    · intro g j hj
      by_cases hjn : j < n
      · rw [hA (j + 1) (by omega), Subgroup.mem_comap, map_mul, map_mul, map_mul, map_inv, map_inv,
          hget j hj hjn]
        exact hqcen (mk g) j (by omega)
      · rw [hgetz j hj hjn, Subgroup.mem_center_iff.mp hzc g, mul_inv_cancel_right, mul_inv_cancel]
        exact one_mem _

end Exist

section Count

/-- Index set for the codes: triples `i ≤ j < k < n`. -/
def D (n : ℕ) : Type := Σ k : Fin n, Σ j : Fin k.val, Fin (j.val + 1)

instance (n : ℕ) : Fintype (D n) :=
  inferInstanceAs (Fintype (Σ k : Fin n, Σ j : Fin k.val, Fin (j.val + 1)))

/-- Decoding a code into exponent functions. -/
def dec {n p : ℕ} (c : D n → Fin p) (i j k : ℕ) : ℕ :=
  if h : i ≤ j ∧ j < k ∧ k < n then
    (c ⟨⟨k, h.2.2⟩, ⟨j, h.2.1⟩, ⟨i, Nat.lt_succ_of_le h.1⟩⟩ : ℕ)
  else 0

/-- Power exponents of a code. -/
def PP {n p : ℕ} (c : D n → Fin p) : ℕ → ℕ → ℕ := fun i k => dec c i i (i + 1 + k)

/-- Conjugation exponents of a code. -/
def CC {n p : ℕ} (c : D n → Fin p) : ℕ → ℕ → ℕ → ℕ := fun i j k => dec c i j (j + 1 + k)

/-- Encoding exponent functions into a code. -/
def enc {n p : ℕ} (hp : 0 < p) (P : ℕ → ℕ → ℕ) (C : ℕ → ℕ → ℕ → ℕ) (x : D n) : Fin p :=
  ⟨(if (x.2.2 : ℕ) = x.2.1 then P x.2.2 (x.1 - x.2.2 - 1)
      else C x.2.2 x.2.1 (x.1 - x.2.1 - 1)) % p, Nat.mod_lt _ hp⟩

lemma dec_enc_P {n p : ℕ} (hp : 0 < p) (P : ℕ → ℕ → ℕ) (C : ℕ → ℕ → ℕ → ℕ) {i k : ℕ}
    (h : i + 1 + k < n) (hb : P i k < p) : dec (n := n) (enc hp P C) i i (i + 1 + k) = P i k := by
  unfold dec
  rw [dif_pos ⟨le_rfl, by omega, h⟩]
  simp only [enc, if_true]
  rw [show i + 1 + k - i - 1 = k by omega, Nat.mod_eq_of_lt hb]

lemma dec_enc_C {n p : ℕ} (hp : 0 < p) (P : ℕ → ℕ → ℕ) (C : ℕ → ℕ → ℕ → ℕ) {i j k : ℕ}
    (hij : i < j) (h : j + 1 + k < n) (hb : C i j k < p) :
    dec (n := n) (enc hp P C) i j (j + 1 + k) = C i j k := by
  unfold dec
  rw [dif_pos ⟨by omega, by omega, h⟩]
  simp only [enc, if_neg (Nat.ne_of_lt hij)]
  rw [show j + 1 + k - j - 1 = k by omega, Nat.mod_eq_of_lt hb]

theorem exists_code (p : ℕ) (hp : p.Prime) (n : ℕ) (G : Type u) [Group G] [Finite G]
    (hG : Nat.card G = p ^ n) :
    ∃ c : D n → Fin p, Nonempty (G ≃* Gam p n (PP c) (CC c)) := by
  obtain ⟨l, hl, htop, h2, h3⟩ := exists_pcgs p hp n G hG
  have hs : ∀ m, ∀ x ∈ cl (l.drop m), ∃ e : ℕ → ℕ, (∀ k, e k < p) ∧ x = nf (l.drop m) e :=
    fun m => nf_surj p hp.pos (l.drop m) (suffix_hyps p l h2 h3 m).1 (suffix_hyps p l h2 h3 m).2
  have hPex : ∀ i, i < n → ∃ e : ℕ → ℕ, (∀ k, e k < p) ∧
      ∀ hi : i < l.length, l[i] ^ p = nf (l.drop (i + 1)) e := by
    intro i hi
    obtain ⟨e, he, heq⟩ := hs (i + 1) _ (h2 i (by omega))
    exact ⟨e, he, fun _ => heq⟩
  choose! P hPb hP using hPex
  have hCex : ∀ i j, i < j → j < n → ∃ e : ℕ → ℕ, (∀ k, e k < p) ∧
      ∀ (hi : i < l.length) (hj : j < l.length),
        l[i] * l[j] * l[i]⁻¹ = nf (l.drop (j + 1)) e * l[j] := by
    intro i j hij hj
    obtain ⟨e, he, heq⟩ := hs (j + 1) _ (h3 (l[i]'(by omega)) j (by omega))
    refine ⟨e, he, fun _ _ => ?_⟩
    rw [← heq, inv_mul_cancel_right]
  choose! C hCb hC using hCex
  refine ⟨enc hp.pos P C, iso_Gam p n _ _ hp.pos l hl hG htop ?_ ?_⟩
  · intro i hi
    rw [hP i (by omega) hi]
    apply nf_congr
    intro k hk
    simp [hl] at hk
    exact (dec_enc_P hp.pos P C (by omega) (hPb i (by omega) k)).symm
  · intro i j hij hj
    rw [hC i j hij (by omega) (by omega) hj]
    congr 1
    apply nf_congr
    intro k hk
    simp [hl] at hk
    exact (dec_enc_C hp.pos P C hij (by omega) (hCb i j hij (by omega) k)).symm

lemma tri (k : ℕ) : 2 * ∑ j ∈ Finset.range k, (j + 1) = k * (k + 1) := by
  induction k with
  | zero => simp
  | succ k ih => rw [Finset.sum_range_succ, mul_add, ih]; ring

lemma six (n : ℕ) :
    6 * ∑ k ∈ Finset.range n, ∑ j ∈ Finset.range k, (j + 1) + n = n ^ 3 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Finset.sum_range_succ]
    have h := tri n
    nlinarith [ih, h]

lemma card_D (n : ℕ) :
    Fintype.card (D n) = ∑ k ∈ Finset.range n, ∑ j ∈ Finset.range k, (j + 1) := by
  rw [show Fintype.card (D n) = Fintype.card (Σ k : Fin n, Σ j : Fin k.val, Fin (j.val + 1))
    from rfl]
  simp only [Fintype.card_sigma, Fintype.card_fin]
  rw [← Fin.sum_univ_eq_sum_range (fun k => ∑ j ∈ Finset.range k, (j + 1)) n]
  congr 1
  ext k
  exact Fin.sum_univ_eq_sum_range (fun j => j + 1) k

lemma six_card (n : ℕ) : 6 * Fintype.card (D n) + n = n ^ 3 := by
  rw [card_D]
  exact six n

end Count

section Final

/-- The number of groups of order `p^n` is at most `p ^ card (D n)`, by injecting isomorphism
classes into codes. -/
theorem g_pow_le (p : ℕ) (hp : p.Prime) (n : ℕ) :
    Erdos1160.g (p ^ n) ≤ p ^ Fintype.card (D n) := by
  classical
  unfold Erdos1160.g
  let S := (Quotient.mk (CategoryTheory.isIsomorphicSetoid FiniteGrp.{0})) ''
    {G : FiniteGrp.{0} | Nat.card G = p ^ n}
  let Pr : Quotient (CategoryTheory.isIsomorphicSetoid FiniteGrp.{0}) → (D n → Fin p) → Prop :=
    fun s c => ∃ G : FiniteGrp.{0}, Quotient.mk _ G = s ∧ Nonempty (G ≃* Gam p n (PP c) (CC c))
  have key : ∀ s ∈ S, ∃ c, Pr s c := by
    rintro s ⟨G, hG, rfl⟩
    obtain ⟨c, hc⟩ := exists_code p hp n G hG
    exact ⟨c, G, rfl, hc⟩
  let F : Quotient (CategoryTheory.isIsomorphicSetoid FiniteGrp.{0}) → (D n → Fin p) :=
    fun s => if h : ∃ c, Pr s c then h.choose else fun _ => ⟨0, hp.pos⟩
  have hF : ∀ s ∈ S, Pr s (F s) := by
    intro s hs
    have h := key s hs
    simp only [F, dif_pos h]
    exact h.choose_spec
  have hinj : Set.InjOn F S := by
    intro s₁ h₁ s₂ h₂ heq
    obtain ⟨G₁, rfl, ⟨e₁⟩⟩ := hF s₁ h₁
    obtain ⟨G₂, rfl, ⟨e₂⟩⟩ := hF s₂ h₂
    rw [heq] at e₁
    apply Quotient.sound
    exact ⟨CategoryTheory.InducedCategory.isoMk (MulEquiv.toGrpIso (e₁.trans e₂.symm))⟩
  have h := Set.ncard_le_ncard_of_injOn F (fun s _ => Set.mem_univ (F s)) hinj Set.finite_univ
  rw [Set.ncard_univ, Nat.card_eq_fintype_card, Fintype.card_fun, Fintype.card_fin] at h
  exact h

end Final

end OMA.PcBound

theorem OMA.solution : OMA.R_Erdos1160_erdos_1160_variants_sum_R3_H1_R1_H2_R1.H1 := by
  intro p a hp
  have h1 := OMA.PcBound.g_pow_le p hp a
  have h2 := OMA.PcBound.six_card a
  calc Erdos1160.g (p ^ a) ^ 6 * p ^ a
      ≤ (p ^ Fintype.card (OMA.PcBound.D a)) ^ 6 * p ^ a :=
        Nat.mul_le_mul_right _ (Nat.pow_le_pow_left h1 6)
    _ = p ^ (a ^ 3) := by
        rw [← pow_mul, ← pow_add]
        congr 1
        linarith [h2]
