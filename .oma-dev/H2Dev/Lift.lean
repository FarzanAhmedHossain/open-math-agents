import H2Dev.Breadth
import H2Dev.Graded
import H2Dev.Bridge

/-! Li-Qiao Section 2.3, eqs. (35)-(41), and the glue between the Sims data of a group and the
class-3 bracket count of `Breadth` (Lemma 4.1, Propositions 4.2/4.3, Remark 4.4).

Part 1, the recovery of the bracket `L_2 × C_core → L_3` from the recorded coefficients
`c(2, j, k, 3, v)` (Sec 2.3, p.18, after (41)):
* `lf_recover_core` : two second brackets `β_2, β_2'` (Jacobi with the same first bracket `β_1`)
  that agree on the recorded pairs `(ḡ_{2,j}, ḡ_{1,k})`, `k ≤ k(j)`, where
  `ḡ_{2,j} = [ḡ_{1,f(j)}, ḡ_{1,k(j)}]` with `f(j) < k(j)`, agree on `L_2 × ḡ_{1,k}` for all `k < s`
  (induction on `k` through the Jacobi identity);
* `lf_recover_eq` : with Lemma 4.1 (`br_lemma41`) they are equal.

Part 2, the core generation (34) for the brackets of a group and their transports:
* `lf_core_L3` : abstract `L_3 = [L_2, C_core]` from `L_2 = [C_core, C_core]`, `L_3 = [L_2, L_1]`;
* `lf_brB2_closure` : `γ_3 / γ_4` is generated by the values of `brB2 G`;
* `lf_brT1_core`, `lf_brT2_full`, `lf_brT2_core` : the transported pair `(brT1, brT2)` along any
  identifications `e_1, e_2, e_3` satisfies both generation conditions of `br_eq53_sum` for the
  core `⟨e_1 (g_{1,1}), ..., e_1 (g_{1,s})⟩`, whenever `γ_2 ≤ [H, H] γ_3` for `H = ⟨g_{1,k} : k < s⟩`
  (the form of the Sims core given by `exists_sims_gen`);
* `lf_brT_mem` : the transported pair lies in the set `lfBrSet` counted by `br_eq53_sum`;
* `lf_ncard_transported_le` : every set of transported bracket pairs of groups (with common
  `L_1, L_2, L_3`, common transported generators and common defining values on `D`) has at most
  the `br_eq53_sum` number of elements.

Part 3, the identification of layers by the recorded data (37), abstractly:
* `lfRel`, `lfSpan` : the relation vectors `p ^ a(j) δ_j - Σ_{v < j} b(j, v) δ_v` and their span;
* `lf_reduce` : every integer vector is congruent modulo the relations to one in the box
  `0 ≤ e_j < p ^ a(j)` (the Sims coordinates (35));
* `lf_card_quot_le` : the presented group has order at most `p ^ Σ a(j)`;
* `lfPsi`, `lfPsi_rel`, `lfPsi_rel_eq_zero` : the evaluation `e ↦ Σ e_j y_j` and relation (37);
* `lf_quot_equiv`, `lf_layer_iso` : two commutative groups of order `p ^ Σ a(j)`, generated by
  `y`, `y'` satisfying the same triangular relations (37), are isomorphic by `y_j ↦ y'_j`
  (the identifications `e_i` of (57)).

Part 4, the Sims lift (36):
* `SimsGenSet.lf_mem_relSub`, `SimsGenSet.lf_sims_lift` : an element of `γ_{i+1}` is its weight-`i`
  block `Π_v g_{i,v} ^ e(i,v)` (the Sims lift of its class) times its deeper blocks;
* `SimsGenSet.lf_grOf_coord` : (35), its class is `Σ_v e(i,v) ḡ_{i,v}`.

Part 5, the fibrewise count over the recorded data and the power word array:
* `realizedCB` : the commutator coefficient arrays over fixed recorded data and power word array;
* `lf_ncard_classes_le_fiberB` : the number of classes is at most `Σ_{(D, B)} N_c(D, B)`;
* `lf_ncard_classes_le_fiberB_pw` : with Theorem 3.1, at most `Σ_D p ^ PW(D) M(D)` whenever
  `N_c(D, B) ≤ M(D)` for every realised `B`. -/

namespace OMA.SimsLite

open scoped commutatorElement

universe u

section LfRecover

variable {L1 L2 L3 : Type*} [CommGroup L1] [CommGroup L2] [CommGroup L3]

/-- Sec 2.3 (p.18): recovery of the core bracket `L_2 × C_core → L_3` from the recorded
coefficients. The weight-2 generators are `y_j = [g_{f(j)}, g_{k(j)}]` with `f(j) < k(j)`; the
recorded values are `[y_j, g_k]` for `k ≤ k(j)`. Two second brackets satisfying the Jacobi identity
with the same first bracket and agreeing on the recorded values agree on `L_2 × g_k`, `k < s`. -/
theorem lf_recover_core {r n s : ℕ} (β1 : L1 →* L1 →* L2) {β2 β2' : L2 →* L1 →* L3}
    (hJ : brJacobi β1 β2) (hJ' : brJacobi β1 β2') (g : Fin r → L1) (y : Fin n → L2)
    (hy : Subgroup.closure (Set.range y) = ⊤) (f kk : Fin n → Fin r)
    (hfk : ∀ j, f j < kk j) (hyd : ∀ j, y j = β1 (g (f j)) (g (kk j)))
    (hrec : ∀ j (k : Fin r), (k : ℕ) < s → k ≤ kk j → β2 (y j) (g k) = β2' (y j) (g k)) :
    ∀ k : Fin r, (k : ℕ) < s → ∀ z, β2 z (g k) = β2' z (g k) := by
  have main : ∀ N : ℕ, ∀ k : Fin r, (k : ℕ) = N → (k : ℕ) < s → ∀ z,
      β2 z (g k) = β2' z (g k) := by
    intro N
    refine Nat.strong_induction_on N ?_
    intro N ih k hkN hks z
    have hflip : β2.flip (g k) = β2'.flip (g k) := by
      refine MonoidHom.eq_of_eqOn_dense hy ?_
      rintro _ ⟨j, rfl⟩
      rw [MonoidHom.flip_apply, MonoidHom.flip_apply]
      by_cases hle : k ≤ kk j
      · exact hrec j k hks hle
      · have hlt : (kk j : ℕ) < k := Fin.lt_def.mp (not_le.mp hle)
        have hf : (f j : ℕ) < kk j := Fin.lt_def.mp (hfk j)
        have i1 : ∀ z, β2 z (g (f j)) = β2' z (g (f j)) := fun z =>
          ih (f j : ℕ) (by omega) (f j) rfl (by omega) z
        have i2 : ∀ z, β2 z (g (kk j)) = β2' z (g (kk j)) := fun z =>
          ih (kk j : ℕ) (by omega) (kk j) rfl (by omega) z
        have e1 := hJ (g (f j)) (g (kk j)) (g k)
        have e2 := hJ' (g (f j)) (g (kk j)) (g k)
        rw [i1, i2] at e1
        rw [hyd j]
        exact mul_right_cancel (mul_right_cancel (e1.trans e2.symm))
    have h := DFunLike.congr_fun hflip z
    rwa [MonoidHom.flip_apply, MonoidHom.flip_apply] at h
  exact fun k hk z => main k k rfl hk z

/-- With Lemma 4.1: the recorded coefficients `c(2, j, k, 3, v)` determine the whole second
bracket `L_2 × L_1 → L_3`, given the first bracket and the core generation of `L_2`. -/
theorem lf_recover_eq {r n s : ℕ} {β1 : L1 →* L1 →* L2} {β2 β2' : L2 →* L1 →* L3}
    (hA : brAlt β1) (hJ : brJacobi β1 β2) (hJ' : brJacobi β1 β2') (g : Fin r → L1)
    (hgen : Subgroup.closure {w | ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}),
      ∃ u' ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β1 u u' = w} = ⊤)
    (y : Fin n → L2) (hy : Subgroup.closure (Set.range y) = ⊤) (f kk : Fin n → Fin r)
    (hfk : ∀ j, f j < kk j) (hyd : ∀ j, y j = β1 (g (f j)) (g (kk j)))
    (hrec : ∀ j (k : Fin r), (k : ℕ) < s → k ≤ kk j → β2 (y j) (g k) = β2' (y j) (g k)) :
    β2 = β2' := by
  have hc := lf_recover_core β1 hJ hJ' g y hy f kk hfk hyd hrec
  refine br_lemma41 (Subgroup.closure (g '' {j | (j : ℕ) < s})) hA hA hJ hJ' hgen
    (fun _ _ _ => rfl) ?_
  intro z u hu
  have hle : Subgroup.closure (g '' {j | (j : ℕ) < s}) ≤ (β2 z).eqLocus (β2' z) := by
    rw [Subgroup.closure_le]
    rintro _ ⟨j, hj, rfl⟩
    show β2 z (g j) = β2' z (g j)
    exact hc j hj z
  exact hle hu

end LfRecover

section LfCore

variable {L1 L2 L3 : Type*} [CommGroup L1] [CommGroup L2] [CommGroup L3]

/-- (34) for `i = 2`, abstractly: if `L_2 = [C, C]` and `L_3 = [L_2, L_1]`, then `L_3 = [L_2, C]`,
by the Jacobi identity. -/
theorem lf_core_L3 {β1 : L1 →* L1 →* L2} {β2 : L2 →* L1 →* L3} (hJ : brJacobi β1 β2)
    (C : Subgroup L1) (hgen2 : Subgroup.closure {w | ∃ u ∈ C, ∃ v ∈ C, β1 u v = w} = ⊤)
    (hgen3 : Subgroup.closure {w | ∃ z x, β2 z x = w} = ⊤) :
    Subgroup.closure {w | ∃ z, ∃ u ∈ C, β2 z u = w} = ⊤ := by
  set K := Subgroup.closure {w | ∃ z, ∃ u ∈ C, β2 z u = w} with hK
  have hx : ∀ x : L1, ∀ z : L2, β2 z x ∈ K := by
    intro x
    have hle : Subgroup.closure {w | ∃ u ∈ C, ∃ v ∈ C, β1 u v = w} ≤ K.comap (β2.flip x) := by
      rw [Subgroup.closure_le]
      rintro _ ⟨u, hu, v, hv, rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_comap, MonoidHom.flip_apply]
      have e := hJ u v x
      have hA : β2 (β1 v x) u ∈ K := Subgroup.subset_closure ⟨_, u, hu, rfl⟩
      have hB : β2 (β1 x u) v ∈ K := Subgroup.subset_closure ⟨_, v, hv, rfl⟩
      have e' : β2 (β1 u v) x = (β2 (β1 v x) u * β2 (β1 x u) v)⁻¹ := by
        rw [mul_assoc] at e
        exact eq_inv_of_mul_eq_one_left e
      rw [e']
      exact K.inv_mem (K.mul_mem hA hB)
    rw [hgen2] at hle
    intro z
    have h := hle (Subgroup.mem_top z)
    rwa [Subgroup.mem_comap, MonoidHom.flip_apply] at h
  rw [eq_top_iff, ← hgen3, Subgroup.closure_le]
  rintro _ ⟨z, x, rfl⟩
  exact hx x z

theorem lf_brq3_surjective (G : Type u) [Group G] : Function.Surjective (brq3 G) :=
  QuotientGroup.mk'_surjective ((lcs G 3).subgroupOf (lcs G 2))

/-- `L_3 = γ_3 / γ_4` is generated by the values of the bracket `L_2 × L_1 → L_3`. -/
theorem lf_brB2_closure (G : Type u) [Group G] :
    Subgroup.closure {w | ∃ z x, brB2 G z x = w} = ⊤ := by
  set K := Subgroup.closure {w | ∃ z x, brB2 G z x = w} with hK
  have hle : ⁅lcs G 1, (⊤ : Subgroup G)⁆ ≤ (K.comap (brq3 G)).map (lcs G 2).subtype := by
    rw [Subgroup.commutator_def, Subgroup.closure_le]
    rintro _ ⟨w, hw, y, -, rfl⟩
    refine Subgroup.mem_map.2 ⟨cw2 ⟨w, hw⟩ y, ?_, rfl⟩
    rw [Subgroup.mem_comap, ← brB2_mk_of]
    exact Subgroup.subset_closure ⟨_, _, rfl⟩
  rw [eq_top_iff]
  intro q _
  obtain ⟨w, rfl⟩ := lf_brq3_surjective G q
  obtain ⟨w', hw', hww⟩ := Subgroup.mem_map.1 (hle w.2)
  have : w' = w := Subtype.ext hww
  rw [← this]
  exact hw'

end LfCore

section LfTransport

/-- The transported image of the core `H = ⟨g_{1,k} : k < s⟩` lies in the core generated by the
transported generators. -/
theorem lf_core_mem {G : Type u} [Group G] {L1 : Type*} [CommGroup L1]
    (e1 : Abelianization G ≃* L1) {r s : ℕ} (X : Fin r → G) {a : G}
    (ha : a ∈ Subgroup.closure (X '' {j | (j : ℕ) < s})) :
    e1 (Abelianization.of a) ∈
      Subgroup.closure ((fun j => e1 (Abelianization.of (X j))) '' {j | (j : ℕ) < s}) := by
  have hle : Subgroup.closure (X '' {j | (j : ℕ) < s}) ≤
      (Subgroup.closure ((fun j => e1 (Abelianization.of (X j))) '' {j | (j : ℕ) < s})).comap
        (e1.toMonoidHom.comp Abelianization.of) := by
    rw [Subgroup.closure_le]
    rintro _ ⟨j, hj, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap]
    exact Subgroup.subset_closure ⟨j, hj, rfl⟩
  exact Subgroup.mem_comap.mp (hle ha)

/-- (34), `i = 1`, for the transported first bracket: `L_2 = [C_core, C_core]`. -/
theorem lf_brT1_core {G : Type u} [Group G] {L1 L2 : Type*} [CommGroup L1] [CommGroup L2]
    (e1 : Abelianization G ≃* L1) (e2 : brL2 G ≃* L2) {r s : ℕ} (X : Fin r → G)
    (hcore : lcs G 1 ≤ ⁅Subgroup.closure (X '' {j | (j : ℕ) < s}),
      Subgroup.closure (X '' {j | (j : ℕ) < s})⁆ ⊔ lcs G 2) :
    Subgroup.closure {w | ∃ u ∈ Subgroup.closure
        ((fun j => e1 (Abelianization.of (X j))) '' {j | (j : ℕ) < s}),
      ∃ u' ∈ Subgroup.closure ((fun j => e1 (Abelianization.of (X j))) '' {j | (j : ℕ) < s}),
        brT1 e1 e2 u u' = w} = ⊤ := by
  set K := Subgroup.closure {w | ∃ u ∈ Subgroup.closure
        ((fun j => e1 (Abelianization.of (X j))) '' {j | (j : ℕ) < s}),
      ∃ u' ∈ Subgroup.closure ((fun j => e1 (Abelianization.of (X j))) '' {j | (j : ℕ) < s}),
        brT1 e1 e2 u u' = w} with hK
  have hM : lcs G 1 ≤ (K.comap (e2.toMonoidHom.comp (brq2 G))).map (lcs G 1).subtype := by
    refine hcore.trans (sup_le ?_ ?_)
    · rw [Subgroup.commutator_le]
      intro a ha b hb
      refine Subgroup.mem_map.2 ⟨cw a b, ?_, rfl⟩
      rw [Subgroup.mem_comap, MonoidHom.comp_apply]
      have e : e2.toMonoidHom (brq2 G (cw a b)) =
          brT1 e1 e2 (e1 (Abelianization.of a)) (e1 (Abelianization.of b)) :=
        (brT1_of e1 e2 a b).symm
      rw [e]
      exact Subgroup.subset_closure ⟨_, lf_core_mem e1 X ha, _, lf_core_mem e1 X hb, rfl⟩
    · intro x hx
      have hx1 : x ∈ lcs G 1 := lcs_antitone (by norm_num) hx
      refine Subgroup.mem_map.2 ⟨⟨x, hx1⟩, ?_, rfl⟩
      rw [Subgroup.mem_comap, MonoidHom.comp_apply]
      have h1 : brq2 G ⟨x, hx1⟩ = 1 := (brq2_eq_one_iff _).2 hx
      rw [h1, map_one]
      exact K.one_mem
  rw [eq_top_iff]
  intro q _
  obtain ⟨w, hw⟩ := brq2_surjective (e2.symm q)
  obtain ⟨w', hw', hww⟩ := Subgroup.mem_map.1 (hM w.2)
  have hw'w : w' = w := Subtype.ext hww
  rw [hw'w, Subgroup.mem_comap, MonoidHom.comp_apply, hw] at hw'
  simpa using hw'

/-- The transported second bracket generates `L_3`. -/
theorem lf_brT2_full {G : Type u} [Group G] {L1 L2 L3 : Type*} [CommGroup L1] [CommGroup L2]
    [CommGroup L3] (e1 : Abelianization G ≃* L1) (e2 : brL2 G ≃* L2) (e3 : brL3 G ≃* L3) :
    Subgroup.closure {w | ∃ z x, brT2 e1 e2 e3 z x = w} = ⊤ := by
  have hle : Subgroup.closure {w | ∃ z x, brB2 G z x = w} ≤
      (Subgroup.closure {w | ∃ z x, brT2 e1 e2 e3 z x = w}).comap e3.toMonoidHom := by
    rw [Subgroup.closure_le]
    rintro _ ⟨z, x, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap]
    refine Subgroup.subset_closure ⟨e2 z, e1 x, ?_⟩
    simp [brT2_apply]
  rw [lf_brB2_closure G] at hle
  rw [eq_top_iff]
  intro q _
  have h := hle (Subgroup.mem_top (e3.symm q))
  rw [Subgroup.mem_comap] at h
  simpa using h

/-- (34), `i = 2`, for the transported pair: `L_3 = [L_2, C_core]`. -/
theorem lf_brT2_core {G : Type u} [Group G] {L1 L2 L3 : Type*} [CommGroup L1] [CommGroup L2]
    [CommGroup L3] (e1 : Abelianization G ≃* L1) (e2 : brL2 G ≃* L2) (e3 : brL3 G ≃* L3)
    {r s : ℕ} (X : Fin r → G)
    (hcore : lcs G 1 ≤ ⁅Subgroup.closure (X '' {j | (j : ℕ) < s}),
      Subgroup.closure (X '' {j | (j : ℕ) < s})⁆ ⊔ lcs G 2) :
    Subgroup.closure {w | ∃ z, ∃ u ∈ Subgroup.closure
        ((fun j => e1 (Abelianization.of (X j))) '' {j | (j : ℕ) < s}),
      brT2 e1 e2 e3 z u = w} = ⊤ :=
  lf_core_L3 (brT_jacobi e1 e2 e3) _ (lf_brT1_core e1 e2 X hcore) (lf_brT2_full e1 e2 e3)

/-- The set of graded bracket pairs counted by `br_eq53_sum` (core generation of `L_2` and `L_3`,
alternation, Jacobi, prescribed values on the defining pairs `D`). -/
def lfBrSet {L1 L2 : Type*} [CommGroup L1] [CommGroup L2] (L3 : Type*) [CommGroup L3] {r : ℕ}
    (s : ℕ) (g : Fin r → L1) (D : Finset (Fin r × Fin r)) (v : Fin r × Fin r → L2) :
    Set ((L1 →* L1 →* L2) × (L2 →* L1 →* L3)) :=
  {β | brAlt β.1 ∧
    Subgroup.closure {w | ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}),
      ∃ u' ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β.1 u u' = w} = ⊤ ∧
    brJacobi β.1 β.2 ∧
    Subgroup.closure
      {w | ∃ z, ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β.2 z u = w} = ⊤ ∧
    ∀ q ∈ D, β.1 (g q.1) (g q.2) = v q}

/-- The transported brackets of a group with a Sims core lie in the counted set. -/
theorem lf_brT_mem {G : Type u} [Group G] {L1 L2 L3 : Type*} [CommGroup L1] [CommGroup L2]
    [CommGroup L3] (e1 : Abelianization G ≃* L1) (e2 : brL2 G ≃* L2) (e3 : brL3 G ≃* L3)
    {r s : ℕ} (X : Fin r → G) (g : Fin r → L1) (hg : ∀ j, e1 (Abelianization.of (X j)) = g j)
    (hcore : lcs G 1 ≤ ⁅Subgroup.closure (X '' {j | (j : ℕ) < s}),
      Subgroup.closure (X '' {j | (j : ℕ) < s})⁆ ⊔ lcs G 2)
    (D : Finset (Fin r × Fin r)) (v : Fin r × Fin r → L2)
    (hv : ∀ q ∈ D, e2 (brq2 G (cw (X q.1) (X q.2))) = v q) :
    (brT1 e1 e2, brT2 e1 e2 e3) ∈ lfBrSet L3 s g D v := by
  have hgX : g = fun j => e1 (Abelianization.of (X j)) := funext fun j => (hg j).symm
  subst hgX
  rw [lfBrSet, Set.mem_setOf_eq]
  refine ⟨brT1_alt e1 e2, lf_brT1_core e1 e2 X hcore, brT_jacobi e1 e2 e3,
    lf_brT2_core e1 e2 e3 X hcore, fun q hq => ?_⟩
  show brT1 e1 e2 (e1 (Abelianization.of (X q.1))) (e1 (Abelianization.of (X q.2))) = v q
  rw [brT1_of]
  exact hv q hq

/-- The class-3 count of the leading commutator coefficients for groups: any set of graded
bracket pairs, each transported from a group `G` with a Sims core `X_0, ..., X_{s-1}`
(`γ_2 ≤ [H, H] γ_3`) along identifications `e_1, e_2, e_3` with common transported generators `g`
and common values `v` on the defining pairs `D`, has at most the number of elements given by eq.
(53) at `c = 3` summed over the breadth (`br_eq53_sum`). -/
theorem lf_ncard_transported_le {L1 L2 L3 : Type*} [CommGroup L1] [CommGroup L2]
    [CommGroup L3] [Finite L1] [Finite L2] [Finite L3] {p r s s2 s3 n : ℕ}
    (hp : p.Prime) (hsr : s ≤ r) (hL2 : Nat.card L2 = p ^ s2) (hL3 : Nat.card L3 = p ^ s3)
    (y : Fin n → L2) (hy : Subgroup.closure (Set.range y) = ⊤) (g : Fin r → L1)
    (hg : Subgroup.closure (Set.range g) = ⊤) (D : Finset (Fin r × Fin r))
    (hD : ∀ q ∈ D, q.1 < q.2 ∧ (q.1 : ℕ) < s) (v : Fin r × Fin r → L2)
    (S : Set ((L1 →* L1 →* L2) × (L2 →* L1 →* L3)))
    (hS : ∀ β ∈ S, ∃ (G : Type u) (_ : Group G) (e1 : Abelianization G ≃* L1)
      (e2 : brL2 G ≃* L2) (e3 : brL3 G ≃* L3) (X : Fin r → G),
      (∀ j, e1 (Abelianization.of (X j)) = g j) ∧
      lcs G 1 ≤ ⁅Subgroup.closure (X '' {j | (j : ℕ) < s}),
        Subgroup.closure (X '' {j | (j : ℕ) < s})⁆ ⊔ lcs G 2 ∧
      (∀ q ∈ D, e2 (brq2 G (cw (X q.1) (X q.2))) = v q) ∧
      β = (brT1 e1 e2, brT2 e1 e2 e3)) :
    S.ncard ≤ ∑ b ∈ (Finset.range (min s2 s3 + 1)).filter (fun b => s3 ≤ s * b),
        p ^ (s * (b * (n + s3 + 1 - b))) *
          p ^ ((r.choose 2 - D.card) * s2 - (r - s).choose 2 * b) := by
  have := br_finite_pairs (L1 := L1) (L2 := L2) (L3 := L3)
  refine (Set.ncard_le_ncard (t := lfBrSet L3 s g D v) ?_ (Set.toFinite _)).trans
    (br_eq53_sum hp hsr hL2 hL3 y hy g hg D hD v)
  intro β hβ
  obtain ⟨G, _, e1, e2, e3, X, hgX, hcore, hv, rfl⟩ := hS β hβ
  exact lf_brT_mem e1 e2 e3 X g hgX hcore D v hv

end LfTransport

section LfPresent

/-- The relation vectors of (37): `p ^ a(j) δ_j - Σ_{v < j} b(j, v) δ_v`. -/
def lfRel {n : ℕ} (p : ℕ) (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ) (j : Fin n) : Fin n → ℤ :=
  fun i => if i = j then (p : ℤ) ^ a j else if i < j then -(b j i : ℤ) else 0

/-- The span of the relation vectors. -/
def lfSpan {n : ℕ} (p : ℕ) (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ) : AddSubgroup (Fin n → ℤ) :=
  AddSubgroup.closure (Set.range (lfRel p a b))

lemma lfRel_self {n p : ℕ} (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ) (j : Fin n) :
    lfRel p a b j j = (p : ℤ) ^ a j := by
  unfold lfRel
  rw [if_pos rfl]

lemma lfRel_of_gt {n p : ℕ} (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ) {i j : Fin n} (h : j < i) :
    lfRel p a b j i = 0 := by
  unfold lfRel
  rw [if_neg h.ne', if_neg (not_lt.mpr h.le)]

/-- Every integer vector is congruent, modulo the relations (37), to a vector of Sims coordinates
`0 ≤ e_j < p ^ a(j)` (descending reduction of the coordinates). -/
theorem lf_reduce {n p : ℕ} (hp : 0 < p) (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ)
    (x : Fin n → ℤ) : ∃ w : Fin n → ℤ, (∀ j, 0 ≤ w j ∧ w j < (p : ℤ) ^ a j) ∧
      x - w ∈ lfSpan p a b := by
  have key : ∀ k : ℕ, ∃ w : Fin n → ℤ,
      (∀ j : Fin n, n ≤ (j : ℕ) + k → 0 ≤ w j ∧ w j < (p : ℤ) ^ a j) ∧
        x - w ∈ lfSpan p a b := by
    intro k
    induction k with
    | zero =>
      refine ⟨x, fun j hj => absurd hj (by have := j.isLt; omega), ?_⟩
      rw [sub_self]
      exact (lfSpan p a b).zero_mem
    | succ k ih =>
      obtain ⟨w, hw, hx⟩ := ih
      by_cases hk : k < n
      · obtain ⟨jk, hjkv⟩ : ∃ jk : Fin n, (jk : ℕ) = n - 1 - k := ⟨⟨n - 1 - k, by omega⟩, rfl⟩
        have hPpos : (0 : ℤ) < (p : ℤ) ^ a jk := pow_pos (by exact_mod_cast hp) _
        obtain ⟨q, hq⟩ : ∃ q : ℤ, q = w jk / (p : ℤ) ^ a jk := ⟨_, rfl⟩
        refine ⟨w - q • lfRel p a b jk, fun j hj => ?_, ?_⟩
        · by_cases hjj : j = jk
          · rw [hjj]
            have e : (w - q • lfRel p a b jk) jk = w jk % (p : ℤ) ^ a jk := by
              rw [Pi.sub_apply, Pi.smul_apply, lfRel_self, smul_eq_mul, hq]
              have h := Int.mul_ediv_add_emod (w jk) ((p : ℤ) ^ a jk)
              linear_combination -h
            rw [e]
            exact ⟨Int.emod_nonneg _ hPpos.ne', Int.emod_lt_of_pos _ hPpos⟩
          · have hne : (j : ℕ) ≠ n - 1 - k := fun h => hjj (Fin.ext (h.trans hjkv.symm))
            have hlt : jk < j := Fin.lt_def.mpr (by omega)
            have h0 : (w - q • lfRel p a b jk) j = w j := by
              rw [Pi.sub_apply, Pi.smul_apply, lfRel_of_gt a b hlt, smul_zero, sub_zero]
            rw [h0]
            exact hw j (by omega)
        · have e : x - (w - q • lfRel p a b jk) = (x - w) + q • lfRel p a b jk := by abel
          rw [e]
          have hmem : lfRel p a b jk ∈ lfSpan p a b := AddSubgroup.subset_closure ⟨jk, rfl⟩
          exact (lfSpan p a b).add_mem hx (zsmul_mem hmem q)
      · exact ⟨w, fun j hj => hw j (by omega), hx⟩
  obtain ⟨w, hw, hx⟩ := key n
  exact ⟨w, fun j => hw j (by omega), hx⟩

/-- Every class of the presented group has a representative with Sims coordinates. -/
theorem lf_box_surj {n p : ℕ} (hp : 0 < p) (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ) :
    Function.Surjective (fun e : (j : Fin n) → Fin (p ^ a j) =>
      (QuotientAddGroup.mk (fun j => ((e j : ℕ) : ℤ)) : (Fin n → ℤ) ⧸ lfSpan p a b)) := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective q
    obtain ⟨w, hw, hxw⟩ := lf_reduce hp a b x
    have hnat : ∀ j, ((w j).toNat : ℤ) = w j := fun j => Int.toNat_of_nonneg (hw j).1
    have hlt : ∀ j, (w j).toNat < p ^ a j := by
      intro j
      have h1 : ((w j).toNat : ℤ) < ((p ^ a j : ℕ) : ℤ) := by
        rw [hnat j, Nat.cast_pow]
        exact (hw j).2
      exact_mod_cast h1
    refine ⟨fun j => ⟨(w j).toNat, hlt j⟩, ?_⟩
    have hfun : (fun j => (((w j).toNat : ℕ) : ℤ)) = w := funext hnat
    show QuotientAddGroup.mk (fun j => (((w j).toNat : ℕ) : ℤ)) = QuotientAddGroup.mk x
    rw [hfun, QuotientAddGroup.eq]
    have e : -w + x = x - w := by abel
    rw [e]
    exact hxw

lemma lf_card_box {n p : ℕ} (a : Fin n → ℕ) :
    Nat.card ((j : Fin n) → Fin (p ^ a j)) = p ^ ∑ j, a j := by
  rw [Nat.card_eq_fintype_card, Fintype.card_pi]
  simp only [Fintype.card_fin]
  rw [Finset.prod_pow_eq_pow_sum]

/-- The group presented by the relations (37) has order at most `p ^ Σ_j a(j)`. -/
theorem lf_card_quot_le {n p : ℕ} (hp : 0 < p) (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ) :
    Finite ((Fin n → ℤ) ⧸ lfSpan p a b) ∧
      Nat.card ((Fin n → ℤ) ⧸ lfSpan p a b) ≤ p ^ ∑ j, a j := by
  have hsurj := lf_box_surj hp a b
  refine ⟨Finite.of_surjective _ hsurj, ?_⟩
  rw [← lf_card_box (p := p) a]
  exact Nat.card_le_card_of_surjective _ hsurj

variable {L : Type*} [CommGroup L]

/-- The evaluation `e ↦ Σ_j e_j y_j` (written additively). -/
def lfPsi {n : ℕ} (y : Fin n → L) : (Fin n → ℤ) →+ Additive L where
  toFun x := ∑ j, x j • Additive.ofMul (y j)
  map_zero' := by simp
  map_add' x x' := by simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]

lemma lfPsi_apply {n : ℕ} (y : Fin n → L) (x : Fin n → ℤ) :
    lfPsi y x = ∑ j, x j • Additive.ofMul (y j) := rfl

lemma lfPsi_single {n : ℕ} (y : Fin n → L) (j : Fin n) :
    lfPsi y (Pi.single j 1) = Additive.ofMul (y j) := by
  rw [lfPsi_apply, Finset.sum_eq_single j]
  · simp
  · intro i _ hi
    simp [hi]
  · intro h
    exact absurd (Finset.mem_univ j) h

/-- The evaluation of a relation vector. -/
lemma lfPsi_rel {n p : ℕ} (y : Fin n → L) (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ) (j : Fin n) :
    lfPsi y (lfRel p a b j) = ((p : ℤ) ^ a j) • Additive.ofMul (y j) -
      ∑ i ∈ Finset.univ.filter (fun i => i < j), (b j i : ℤ) • Additive.ofMul (y i) := by
  have hpt : ∀ i, lfRel p a b j i • Additive.ofMul (y i) =
      (if i = j then ((p : ℤ) ^ a i) • Additive.ofMul (y i) else 0) -
        (if i < j then (b j i : ℤ) • Additive.ofMul (y i) else 0) := by
    intro i
    unfold lfRel
    by_cases h1 : i = j
    · subst h1
      simp
    · by_cases h2 : i < j
      · simp [h1, h2]
      · simp [h1, h2]
  rw [lfPsi_apply, Finset.sum_congr rfl (fun i _ => hpt i), Finset.sum_sub_distrib,
    Finset.sum_ite_eq', if_pos (Finset.mem_univ j), Finset.sum_filter]

/-- The relation (37) `p ^ a(j) y_j = Σ_{v < j} b(j, v) y_v` (in the form of
`SimsGenSet.layer_power_tri`) says that the relation vector is in the kernel. -/
lemma lfPsi_rel_eq_zero {n p : ℕ} (y : Fin n → L) (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ)
    (j : Fin n) (hrel : (p ^ a j) • Additive.ofMul (y j) =
      ∑ i ∈ Finset.univ.filter (fun i => i < j), b j i • Additive.ofMul (y i)) :
    lfPsi y (lfRel p a b j) = 0 := by
  rw [lfPsi_rel, ← Nat.cast_pow, natCast_zsmul]
  simp only [natCast_zsmul]
  rw [hrel, sub_self]

/-- A commutative group of order `p ^ Σ a(j)` generated by `y` with the relations (37) is the
presented group. -/
theorem lf_quot_equiv [Finite L] {n p : ℕ} (hp : 0 < p) (a : Fin n → ℕ)
    (b : Fin n → Fin n → ℕ) (y : Fin n → L) (hy : Subgroup.closure (Set.range y) = ⊤)
    (hL : Nat.card L = p ^ ∑ j, a j) (hrel : ∀ j, lfPsi y (lfRel p a b j) = 0) :
    ∃ φ : ((Fin n → ℤ) ⧸ lfSpan p a b) ≃+ Additive L,
      (∀ j, φ (QuotientAddGroup.mk (Pi.single j 1)) = Additive.ofMul (y j)) ∧
        ∀ x, φ (QuotientAddGroup.mk x) = lfPsi y x := by
  have hle : lfSpan p a b ≤ (lfPsi y).ker := by
    rw [lfSpan, AddSubgroup.closure_le]
    rintro _ ⟨j, rfl⟩
    exact AddMonoidHom.mem_ker.2 (hrel j)
  let φ := QuotientAddGroup.lift (lfSpan p a b) (lfPsi y) hle
  have hs : ∀ z : L, ∃ x, lfPsi y x = Additive.ofMul z := by
    let T : Subgroup L :=
      { carrier := {z | ∃ x, lfPsi y x = Additive.ofMul z}
        mul_mem' := by
          rintro z z' ⟨x, hx⟩ ⟨x', hx'⟩
          exact ⟨x + x', by rw [map_add, hx, hx', ofMul_mul]⟩
        one_mem' := ⟨0, by rw [map_zero, ofMul_one]⟩
        inv_mem' := by
          rintro z ⟨x, hx⟩
          exact ⟨-x, by rw [map_neg, hx, ofMul_inv]⟩ }
    have hT : Subgroup.closure (Set.range y) ≤ T := by
      rw [Subgroup.closure_le]
      rintro _ ⟨j, rfl⟩
      exact ⟨Pi.single j 1, lfPsi_single y j⟩
    rw [hy] at hT
    intro z
    obtain ⟨x, hx⟩ := hT (Subgroup.mem_top z)
    exact ⟨x, hx⟩
  have hsurj : Function.Surjective φ := by
    intro z
    obtain ⟨x, hx⟩ := hs (Additive.toMul z)
    exact ⟨QuotientAddGroup.mk x, hx⟩
  obtain ⟨hfin, hcard⟩ := lf_card_quot_le hp a b
  have hLA : Nat.card L = Nat.card (Additive L) := Nat.card_congr Additive.ofMul
  have hbij : Function.Bijective φ := by
    refine (Nat.bijective_iff_surjective_and_card φ).2 ⟨hsurj, le_antisymm ?_ ?_⟩
    · rw [← hLA, hL]
      exact hcard
    · exact Nat.card_le_card_of_surjective φ hsurj
  refine ⟨AddEquiv.ofBijective φ hbij, fun j => ?_, fun x => rfl⟩
  have h1 : φ (QuotientAddGroup.mk (Pi.single j 1)) = lfPsi y (Pi.single j 1) := rfl
  show φ (QuotientAddGroup.mk (Pi.single j 1)) = Additive.ofMul (y j)
  rw [h1, lfPsi_single]

/-- The identifications (57) of the layers with the coordinate groups: two commutative groups of
order `p ^ Σ a(j)`, generated by `y`, `y'` satisfying the same triangular relations (37), are
isomorphic by an isomorphism sending `y_j` to `y'_j`. -/
theorem lf_layer_iso {L' : Type*} [CommGroup L'] [Finite L] [Finite L'] {n p : ℕ} (hp : 0 < p)
    (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ) (y : Fin n → L) (y' : Fin n → L')
    (hy : Subgroup.closure (Set.range y) = ⊤) (hy' : Subgroup.closure (Set.range y') = ⊤)
    (hL : Nat.card L = p ^ ∑ j, a j) (hL' : Nat.card L' = p ^ ∑ j, a j)
    (hrel : ∀ j, lfPsi y (lfRel p a b j) = 0) (hrel' : ∀ j, lfPsi y' (lfRel p a b j) = 0) :
    ∃ e : L ≃* L', ∀ j, e (y j) = y' j := by
  obtain ⟨φ, hφ, -⟩ := lf_quot_equiv hp a b y hy hL hrel
  obtain ⟨φ', hφ', -⟩ := lf_quot_equiv hp a b y' hy' hL' hrel'
  let e : L ≃* L' := MulEquiv.toAdditive.symm (φ.symm.trans φ')
  have key : ∀ x, e x = Additive.toMul (φ' (φ.symm (Additive.ofMul x))) := fun x => rfl
  refine ⟨e, fun j => ?_⟩
  rw [key, ← hφ j, AddEquiv.symm_apply_apply, hφ' j, toMul_ofMul]

/-- Uniqueness of Sims coordinates in the coordinate group: when the presented group is identified
with a group of order `p ^ Σ a(j)`, two coordinate vectors in the box `0 ≤ e_j < p ^ a(j)` with the
same class are equal. -/
theorem lf_box_inj {n p : ℕ} (hp : 0 < p) (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ)
    (φ : ((Fin n → ℤ) ⧸ lfSpan p a b) ≃+ Additive L) (hL : Nat.card L = p ^ ∑ j, a j)
    (e e' : Fin n → ℕ) (he : ∀ j, e j < p ^ a j) (he' : ∀ j, e' j < p ^ a j)
    (h : (QuotientAddGroup.mk (fun j => (e j : ℤ)) : (Fin n → ℤ) ⧸ lfSpan p a b) =
      QuotientAddGroup.mk (fun j => (e' j : ℤ))) : e = e' := by
  have hcard : Nat.card ((j : Fin n) → Fin (p ^ a j)) =
      Nat.card ((Fin n → ℤ) ⧸ lfSpan p a b) := by
    rw [lf_card_box, ← hL]
    exact (Nat.card_congr (Additive.ofMul : L ≃ Additive L)).trans
      (Nat.card_congr φ.toEquiv).symm
  have hbij := (Nat.bijective_iff_surjective_and_card _).2 ⟨lf_box_surj hp a b, hcard⟩
  have key : (fun j => (⟨e j, he j⟩ : Fin (p ^ a j))) = fun j => ⟨e' j, he' j⟩ := hbij.1 h
  funext j
  exact congrArg Fin.val (congrFun key j)

end LfPresent

section LfSimsLift

variable {G : Type u} [Group G] {p c : ℕ} {r : Fin c → ℕ} {a : SimsIdx c r → ℕ}
  {g : SimsIdx c r → G}

/-- An element of `γ_{i+1}` lies in the Sims series term `⟨g_{i,v} : v < r_i⟩ γ_{i+2}`. -/
theorem SimsGenSet.lf_mem_relSub (S : SimsGenSet p a g) (i : Fin c) {x : G}
    (hx : x ∈ lcs G i) : x ∈ relSub g i (r i) := by
  have h := le_closure_sup_of_layerQ_gen (fun v : Fin (r i) => g ⟨i, v⟩)
    (fun v => S.mem ⟨i, v⟩) (S.gen i) hx
  have hmono : Subgroup.closure (Set.range fun v : Fin (r i) => g ⟨i, v⟩) ≤
      Subgroup.closure {x | ∃ v : Fin (r i), v.val < r i ∧ g ⟨i, v⟩ = x} := by
    apply Subgroup.closure_mono
    rintro _ ⟨v, rfl⟩
    exact ⟨v, v.isLt, rfl⟩
  exact sup_le_sup_right hmono (lcs G ((i : ℕ) + 1)) h

/-- The Sims lift (36): an element `x ∈ γ_{i+1}` is the product of its weight-`i` block
`Π_v g_{i,v} ^ e(i,v)` (the Sims lift of its class, with Sims coordinates `0 ≤ e(i,v) < p ^ a(i,v)`)
and its deeper blocks. -/
theorem SimsGenSet.lf_sims_lift (S : SimsGenSet p a g) (i : Fin c) {x : G}
    (hx : x ∈ lcs G i) :
    x = blockProd g (fun h => (S.nf.coord x h).val) i *
      (List.ofFn fun u : Fin c =>
        if i < u then blockProd g (fun h => (S.nf.coord x h).val) u else 1).prod := by
  obtain ⟨hsupp, hprod⟩ := S.nf.coord_spec i (r i) x (S.lf_mem_relSub i hx)
  refine hprod.symm.trans
    (list_prod_ofFn_split c (blockProd g fun h => (S.nf.coord x h).val) i fun u hu => ?_)
  unfold blockProd
  refine List.prod_eq_one fun z hz => ?_
  rw [List.mem_ofFn'] at hz
  obtain ⟨v, rfl⟩ := hz
  have h0 : (S.nf.coord x ⟨u, v⟩).val = 0 := hsupp ⟨u, v⟩ (Or.inl hu)
  show g ⟨u, v⟩ ^ (S.nf.coord x ⟨u, v⟩).val = 1
  rw [h0, pow_zero]

/-- (35): the class of `x ∈ γ_{i+1}` in the layer is `Σ_v e(i,v) ḡ_{i,v}` for its Sims
coordinates `e(i,v)`. -/
theorem SimsGenSet.lf_grOf_coord (S : SimsGenSet p a g) (i : Fin c) {x : G}
    (hx : x ∈ lcs G i) :
    grOf (lcs G) i x =
      ∑ v : Fin (r i), (S.nf.coord x ⟨i, v⟩).val • grOf (lcs G) i (g ⟨i, v⟩) := by
  refine (congrArg (grOf (lcs G) (i : ℕ)) (S.lf_sims_lift i hx)).trans ?_
  exact grOf_block nseries_lcs (fun v => g ⟨i, v⟩) (fun v => (S.nf.coord x ⟨i, v⟩).val)
    (fun v => S.mem ⟨i, v⟩) (deeper_mem g S.mem (fun h => (S.nf.coord x h).val) i)

/-- Coordinates `e` on layer `i`, `dc` on the layers above `i`, zero below. -/
def lfComb (hp : 0 < p) (i : Fin c) (e : Fin (r i) → ℕ) (he : ∀ v, e v < p ^ a ⟨i, v⟩)
    (dc : (h : SimsIdx c r) → Fin (p ^ a h)) : (h : SimsIdx c r) → Fin (p ^ a h)
  | ⟨i', v⟩ => if hh : i' = i then ⟨e (hh ▸ v), by subst hh; exact he v⟩
      else if i < i' then dc ⟨i', v⟩ else ⟨0, pow_pos hp _⟩

lemma lfComb_self (hp : 0 < p) (i : Fin c) (e : Fin (r i) → ℕ) (he : ∀ v, e v < p ^ a ⟨i, v⟩)
    (dc : (h : SimsIdx c r) → Fin (p ^ a h)) (v : Fin (r i)) :
    (lfComb hp i e he dc ⟨i, v⟩).val = e v := by
  rw [lfComb, dif_pos rfl]
  try rfl

lemma lfComb_lt (hp : 0 < p) (i : Fin c) (e : Fin (r i) → ℕ) (he : ∀ v, e v < p ^ a ⟨i, v⟩)
    (dc : (h : SimsIdx c r) → Fin (p ^ a h)) {u : Fin c} (hu : u < i) (v : Fin (r u)) :
    (lfComb hp i e he dc ⟨u, v⟩).val = 0 := by
  rw [lfComb, dif_neg hu.ne, if_neg (not_lt.mpr hu.le)]

lemma lfComb_gt (hp : 0 < p) (i : Fin c) (e : Fin (r i) → ℕ) (he : ∀ v, e v < p ^ a ⟨i, v⟩)
    (dc : (h : SimsIdx c r) → Fin (p ^ a h)) {u : Fin c} (hu : i < u) (v : Fin (r u)) :
    lfComb hp i e he dc ⟨u, v⟩ = dc ⟨u, v⟩ := by
  rw [lfComb, dif_neg hu.ne', if_pos hu]

/-- (35), uniqueness of the weight-`i` coordinates: for Sims coordinates `0 ≤ e(v) < p ^ a(i,v)`
and any `d ∈ γ_{i+2}`, the weight-`i` normal form coordinates of `(Π_v g_{i,v} ^ e(v)) d` are
`e`. (For the last layer one needs `γ_{i+2} = 1`.) -/
theorem SimsGenSet.lf_coord_layer (S : SimsGenSet p a g) (hp : 0 < p) (i : Fin c)
    (e : Fin (r i) → ℕ) (he : ∀ v, e v < p ^ a ⟨i, v⟩) {d : G} (hd : d ∈ lcs G ((i : ℕ) + 1))
    (hlast : (i : ℕ) + 1 < c ∨ lcs G ((i : ℕ) + 1) = ⊥) (v : Fin (r i)) :
    (S.nf.coord ((List.ofFn fun w => g ⟨i, w⟩ ^ e w).prod * d) ⟨i, v⟩).val = e v := by
  have hdi : d ∈ lcs G i := lcs_antitone (Nat.le_succ _) hd
  have hdprod : fullProd g (fun h => (S.nf.coord d h).val) = d :=
    (S.nf.coord_spec i (r i) d (S.lf_mem_relSub i hdi)).2
  have hdc : ∀ h : SimsIdx c r, h.1 ≤ i → (S.nf.coord d h).val = 0 := by
    rcases hlast with h1 | hbot
    · intro h hh
      have hsup := (S.nf.coord_spec ⟨(i : ℕ) + 1, h1⟩ (r ⟨(i : ℕ) + 1, h1⟩) d
        (S.lf_mem_relSub ⟨(i : ℕ) + 1, h1⟩ hd)).1
      exact hsup h (Or.inl (Fin.lt_def.mpr (Nat.lt_succ_of_le (Fin.le_def.mp hh))))
    · have hd1 : d = 1 := by
        rw [hbot] at hd
        exact Subgroup.mem_bot.mp hd
      intro h _
      have hZ : fullProd g (fun h => ((⟨0, pow_pos hp _⟩ : Fin (p ^ a h)) : ℕ)) = 1 := by
        unfold fullProd
        refine List.prod_eq_one fun z hz => ?_
        rw [List.mem_ofFn'] at hz
        obtain ⟨u, rfl⟩ := hz
        unfold blockProd
        refine List.prod_eq_one fun z hz => ?_
        rw [List.mem_ofFn'] at hz
        obtain ⟨w, rfl⟩ := hz
        exact pow_zero _
      have hu : S.nf.coord (fullProd g (fun h => ((⟨0, pow_pos hp _⟩ : Fin (p ^ a h)) : ℕ))) =
          fun h => ⟨0, pow_pos hp _⟩ := S.nf.uniq _
      rw [hZ, ← hd1] at hu
      rw [hu]
  obtain ⟨E, hE⟩ : ∃ E, E = lfComb hp i e he (S.nf.coord d) := ⟨_, rfl⟩
  have hEi : ∀ w, (E ⟨i, w⟩).val = e w := by
    intro w
    rw [hE]
    exact lfComb_self hp i e he _ w
  have hElt : ∀ u, u < i → ∀ w, (E ⟨u, w⟩).val = 0 := by
    intro u hu w
    rw [hE]
    exact lfComb_lt hp i e he _ hu w
  have hEgt : ∀ u, i < u → ∀ w, E ⟨u, w⟩ = S.nf.coord d ⟨u, w⟩ := by
    intro u hu w
    rw [hE]
    exact lfComb_gt hp i e he _ hu w
  have hs := list_prod_ofFn_split c (blockProd g fun h => (E h).val) i fun u hu => by
    unfold blockProd
    refine List.prod_eq_one fun z hz => ?_
    rw [List.mem_ofFn'] at hz
    obtain ⟨w, rfl⟩ := hz
    show g ⟨u, w⟩ ^ (E ⟨u, w⟩).val = 1
    rw [hElt u hu w, pow_zero]
  have hd' := list_prod_ofFn_split c (blockProd g fun h => (S.nf.coord d h).val) i fun u hu => by
    unfold blockProd
    refine List.prod_eq_one fun z hz => ?_
    rw [List.mem_ofFn'] at hz
    obtain ⟨w, rfl⟩ := hz
    show g ⟨u, w⟩ ^ (S.nf.coord d ⟨u, w⟩).val = 1
    rw [hdc ⟨u, w⟩ hu.le, pow_zero]
  have hb1 : blockProd g (fun h => (S.nf.coord d h).val) i = 1 := by
    unfold blockProd
    refine List.prod_eq_one fun z hz => ?_
    rw [List.mem_ofFn'] at hz
    obtain ⟨w, rfl⟩ := hz
    show g ⟨i, w⟩ ^ (S.nf.coord d ⟨i, w⟩).val = 1
    rw [hdc ⟨i, w⟩ le_rfl, pow_zero]
  have hbi : blockProd g (fun h => (E h).val) i = (List.ofFn fun w => g ⟨i, w⟩ ^ e w).prod := by
    simp only [blockProd, hEi]
  have hdeep : (List.ofFn fun u : Fin c =>
        if i < u then blockProd g (fun h => (E h).val) u else 1).prod =
      (List.ofFn fun u : Fin c =>
        if i < u then blockProd g (fun h => (S.nf.coord d h).val) u else 1).prod := by
    congr 2
    funext u
    by_cases hu : i < u
    · rw [if_pos hu, if_pos hu]
      simp only [blockProd, hEgt u hu]
    · rw [if_neg hu, if_neg hu]
  have hdd : d = (List.ofFn fun u : Fin c =>
        if i < u then blockProd g (fun h => (S.nf.coord d h).val) u else 1).prod := by
    have h2 := hdprod.symm.trans hd'
    rwa [hb1, one_mul] at h2
  have hfull : fullProd g (fun h => (E h).val) = (List.ofFn fun w => g ⟨i, w⟩ ^ e w).prod * d := by
    calc fullProd g (fun h => (E h).val)
        = blockProd g (fun h => (E h).val) i * (List.ofFn fun u : Fin c =>
          if i < u then blockProd g (fun h => (E h).val) u else 1).prod := hs
      _ = _ := by rw [hbi, hdeep, ← hdd]
  have hu := S.nf.uniq E
  rw [hfull] at hu
  rw [hu]
  exact hEi v

/-- The order of a layer: `|γ_{i+1} / γ_{i+2}| = p ^ Σ_v a(i,v)`, from the Sims normal form
(the Sims lift (36) and the uniqueness (35)); the classes of the blocks `Π_v g_{i,v} ^ e(v)`,
`0 ≤ e(v) < p ^ a(i,v)`, are exactly the elements of the layer. -/
theorem SimsGenSet.lf_card_layer (S : SimsGenSet p a g) (hp : 0 < p) (i : Fin c)
    (hlast : (i : ℕ) + 1 < c ∨ lcs G ((i : ℕ) + 1) = ⊥) :
    Nat.card (LayerQ G i) = p ^ ∑ v : Fin (r i), a ⟨i, v⟩ := by
  have hB : ∀ e : (v : Fin (r i)) → Fin (p ^ a ⟨i, v⟩),
      (List.ofFn fun w => g ⟨i, w⟩ ^ (e w).val).prod ∈ lcs G i := fun e =>
    Subgroup.list_prod_mem _ fun z hz => by
      rw [List.mem_ofFn'] at hz
      obtain ⟨w, rfl⟩ := hz
      exact Subgroup.pow_mem _ (S.mem ⟨i, w⟩) _
  let β : ((v : Fin (r i)) → Fin (p ^ a ⟨i, v⟩)) → LayerQ G i := fun e =>
    QuotientGroup.mk (⟨(List.ofFn fun w => g ⟨i, w⟩ ^ (e w).val).prod, hB e⟩ : lcs G i)
  have hinj : Function.Injective β := by
    intro e e' hee
    have hee' : (QuotientGroup.mk (⟨(List.ofFn fun w => g ⟨i, w⟩ ^ (e w).val).prod, hB e⟩ :
        lcs G i) : LayerQ G i) =
        QuotientGroup.mk (⟨(List.ofFn fun w => g ⟨i, w⟩ ^ (e' w).val).prod, hB e'⟩ :
          lcs G i) := hee
    have h1 := Subgroup.mem_subgroupOf.mp (QuotientGroup.eq.mp hee')
    have hd : ((List.ofFn fun w => g ⟨i, w⟩ ^ (e w).val).prod)⁻¹ *
        (List.ofFn fun w => g ⟨i, w⟩ ^ (e' w).val).prod ∈ lcs G ((i : ℕ) + 1) := h1
    funext v
    apply Fin.ext
    have hc1 := S.lf_coord_layer hp i (fun w => (e w).val) (fun w => (e w).isLt) hd hlast v
    have hc2 := S.lf_coord_layer hp i (fun w => (e' w).val) (fun w => (e' w).isLt)
      (Subgroup.one_mem _) hlast v
    beta_reduce at hc1 hc2
    rw [mul_one] at hc2
    rw [mul_inv_cancel_left] at hc1
    exact hc1.symm.trans hc2
  have hsurj : Function.Surjective β := by
    intro q
    obtain ⟨⟨x, hx⟩, rfl⟩ := QuotientGroup.mk_surjective q
    refine ⟨fun w => S.nf.coord x ⟨i, w⟩, ?_⟩
    show (QuotientGroup.mk _ : LayerQ G i) = QuotientGroup.mk _
    rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
    have hl := S.lf_sims_lift i hx
    have hdeep := deeper_mem g S.mem (fun h => (S.nf.coord x h).val) i
    show (blockProd g (fun h => (S.nf.coord x h).val) i)⁻¹ * x ∈ lcs G ((i : ℕ) + 1)
    have e1 : (blockProd g (fun h => (S.nf.coord x h).val) i)⁻¹ * x =
        (List.ofFn fun u : Fin c => if i < u then
          blockProd g (fun h => (S.nf.coord x h).val) u else 1).prod := by
      calc _ = (blockProd g (fun h => (S.nf.coord x h).val) i)⁻¹ *
            (blockProd g (fun h => (S.nf.coord x h).val) i * (List.ofFn fun u : Fin c =>
              if i < u then blockProd g (fun h => (S.nf.coord x h).val) u else 1).prod) := by
            rw [← hl]
        _ = _ := inv_mul_cancel_left _ _
    rw [e1]
    exact hdeep
  rw [← Nat.card_congr (Equiv.ofBijective β ⟨hinj, hsurj⟩), Nat.card_eq_fintype_card,
    Fintype.card_pi]
  simp only [Fintype.card_fin]
  rw [Finset.prod_pow_eq_pow_sum]

lemma lf_map_ofFn_prod {K : Subgroup G} {M : Type*} [Monoid M] (π : K →* M) {n : ℕ}
    (f : Fin n → G) (hf : ∀ v, f v ∈ K) (h : (List.ofFn f).prod ∈ K) :
    π ⟨(List.ofFn f).prod, h⟩ = (List.ofFn fun v => π ⟨f v, hf v⟩).prod := by
  have e : (⟨(List.ofFn f).prod, h⟩ : K) = (List.ofFn fun v => (⟨f v, hf v⟩ : K)).prod := by
    apply Subtype.ext
    rw [SubmonoidClass.coe_list_prod, List.map_ofFn]
    try rfl
  rw [e, map_list_prod, List.map_ofFn]
  try rfl

/-- (35)/(39) in a commutative quotient `π : γ_{i+1} → L` of the layer: the class of
`(Π_v g_{i,v} ^ e(v)) d`, `d ∈ γ_{i+2}`, is `Π_v ḡ_{i,v} ^ e(v)`. -/
theorem SimsGenSet.lf_pi_block (S : SimsGenSet p a g) (i : Fin c) {L : Type*} [CommGroup L]
    (π : lcs G i →* L) (hker : ∀ x : lcs G i, (x : G) ∈ lcs G ((i : ℕ) + 1) → π x = 1)
    (e : Fin (r i) → ℕ) {d : G} (hd : d ∈ lcs G ((i : ℕ) + 1)) {x : G} (hx : x ∈ lcs G i)
    (hxe : x = (List.ofFn fun v => g ⟨i, v⟩ ^ e v).prod * d) :
    π ⟨x, hx⟩ = ∏ v, π ⟨g ⟨i, v⟩, S.mem ⟨i, v⟩⟩ ^ e v := by
  have hf : ∀ v, g ⟨i, v⟩ ^ e v ∈ lcs G i := fun v => Subgroup.pow_mem _ (S.mem ⟨i, v⟩) _
  have hB : (List.ofFn fun v => g ⟨i, v⟩ ^ e v).prod ∈ lcs G i :=
    Subgroup.list_prod_mem _ fun z hz => by
      rw [List.mem_ofFn'] at hz
      obtain ⟨v, rfl⟩ := hz
      exact hf v
  have hdi : d ∈ lcs G i := lcs_antitone (Nat.le_succ _) hd
  have e1 : (⟨x, hx⟩ : lcs G i) = ⟨_, hB⟩ * ⟨d, hdi⟩ := Subtype.ext hxe
  rw [e1, map_mul, hker ⟨d, hdi⟩ hd, mul_one, lf_map_ofFn_prod π _ hf hB, List.prod_ofFn]
  refine Finset.prod_congr rfl fun v _ => ?_
  rw [← map_pow]
  exact congrArg π (Subtype.ext (by simp))

/-- (37) in a commutative quotient of the layer:
`ḡ_{i,j} ^ (p ^ a(i,j)) = Π_{v < j} ḡ_{i,v} ^ b(i,j,i,v)`. -/
theorem SimsGenSet.lf_pi_rel (S : SimsGenSet p a g) (i : Fin c) {L : Type*} [CommGroup L]
    (π : lcs G i →* L) (hker : ∀ x : lcs G i, (x : G) ∈ lcs G ((i : ℕ) + 1) → π x = 1)
    (j : Fin (r i)) :
    π ⟨g ⟨i, j⟩, S.mem ⟨i, j⟩⟩ ^ (p ^ a ⟨i, j⟩) =
      ∏ v ∈ Finset.univ.filter (fun v : Fin (r i) => v < j),
        π ⟨g ⟨i, v⟩, S.mem ⟨i, v⟩⟩ ^ (S.powerWords ⟨i, j⟩ ⟨i, v⟩).val := by
  have hpow := S.powerData.pow i j
  have hdeep := deeper_mem g S.mem (fun h => (S.powerWords ⟨i, j⟩ h).val) i
  have hmem : g ⟨i, j⟩ ^ p ^ a ⟨i, j⟩ ∈ lcs G i := Subgroup.pow_mem _ (S.mem ⟨i, j⟩) _
  have hb := S.lf_pi_block i π hker (fun v => (S.powerWords ⟨i, j⟩ ⟨i, v⟩).val) hdeep hmem hpow
  rw [← map_pow]
  have e1 : (⟨g ⟨i, j⟩, S.mem ⟨i, j⟩⟩ : lcs G i) ^ (p ^ a ⟨i, j⟩) = ⟨_, hmem⟩ :=
    Subtype.ext (SubgroupClass.coe_pow _ _)
  rw [e1, hb, Finset.prod_filter]
  refine Finset.prod_congr rfl fun v _ => ?_
  by_cases hv : v < j
  · rw [if_pos hv]
  · rw [if_neg hv, S.powerWords_same_layer_eq_zero i j v (not_lt.mp hv), pow_zero]

/-- The order of a commutative layer quotient `π : γ_{i+1} → L` (kernel `γ_{i+2}`). -/
theorem SimsGenSet.lf_card_quotL (S : SimsGenSet p a g) (hp : 0 < p) (i : Fin c)
    (hlast : (i : ℕ) + 1 < c ∨ lcs G ((i : ℕ) + 1) = ⊥) {L : Type*} [CommGroup L]
    (π : lcs G i →* L) (hπ : Function.Surjective π)
    (hker : ∀ x : lcs G i, π x = 1 ↔ (x : G) ∈ lcs G ((i : ℕ) + 1)) :
    Nat.card L = p ^ ∑ v : Fin (r i), a ⟨i, v⟩ := by
  have hkereq : π.ker = (lcs G ((i : ℕ) + 1)).subgroupOf (lcs G i) := by
    ext x
    rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, hker]
  rw [← S.lf_card_layer hp i hlast]
  exact (Nat.card_congr ((QuotientGroup.quotientMulEquivOfEq hkereq).symm.trans
    (QuotientGroup.quotientKerEquivOfSurjective π hπ)).toEquiv).symm

/-- The identification (57) of a layer with the coordinate group presented by the recorded data
(37): for a commutative layer quotient `π : γ_{i+1} → L` with kernel `γ_{i+2}` and the same-layer
power words `b`, the presented group `(ℤ^{r_i}) / ⟨p ^ a(i,j) δ_j - Σ_{v<j} b(j,v) δ_v⟩` is
isomorphic to `L` by `e ↦ Π_v ḡ_{i,v} ^ e(v)`. -/
theorem SimsGenSet.lf_layer_equiv (S : SimsGenSet p a g) (hp : 0 < p) (i : Fin c)
    (hlast : (i : ℕ) + 1 < c ∨ lcs G ((i : ℕ) + 1) = ⊥) {L : Type*} [CommGroup L] [Finite L]
    (π : lcs G i →* L) (hπ : Function.Surjective π)
    (hker : ∀ x : lcs G i, π x = 1 ↔ (x : G) ∈ lcs G ((i : ℕ) + 1))
    (b : Fin (r i) → Fin (r i) → ℕ) (hb : ∀ j v, (S.powerWords ⟨i, j⟩ ⟨i, v⟩).val = b j v) :
    ∃ φ : ((Fin (r i) → ℤ) ⧸ lfSpan p (fun v => a ⟨i, v⟩) b) ≃+ Additive L,
      ∀ x : Fin (r i) → ℤ, φ (QuotientAddGroup.mk x) =
        lfPsi (fun v => π ⟨g ⟨i, v⟩, S.mem ⟨i, v⟩⟩) x := by
  have hker1 : ∀ x : lcs G i, (x : G) ∈ lcs G ((i : ℕ) + 1) → π x = 1 :=
    fun x hx => (hker x).2 hx
  have hgen : Subgroup.closure (Set.range fun v => π ⟨g ⟨i, v⟩, S.mem ⟨i, v⟩⟩) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    obtain ⟨⟨x, hx⟩, rfl⟩ := hπ z
    rw [S.lf_pi_block i π hker1 (fun v => (S.nf.coord x ⟨i, v⟩).val)
      (deeper_mem g S.mem (fun h => (S.nf.coord x h).val) i) hx (S.lf_sims_lift i hx)]
    exact Subgroup.prod_mem _ fun v _ =>
      Subgroup.pow_mem _ (Subgroup.subset_closure (Set.mem_range_self v)) _
  have hcard := S.lf_card_quotL hp i hlast π hπ hker
  have hrel : ∀ j, lfPsi (fun v => π ⟨g ⟨i, v⟩, S.mem ⟨i, v⟩⟩)
      (lfRel p (fun v => a ⟨i, v⟩) b j) = 0 := by
    intro j
    apply lfPsi_rel_eq_zero
    beta_reduce
    rw [← ofMul_pow, S.lf_pi_rel i π hker1 j, ofMul_prod]
    simp only [ofMul_pow, hb]
  obtain ⟨φ, -, hφ⟩ := lf_quot_equiv hp _ b _ hgen hcard hrel
  exact ⟨φ, hφ⟩

/-- Under the identification (57), the class of `x ∈ γ_{i+1}` corresponds to its vector of Sims
coordinates `(e(i,v))_v`. -/
theorem SimsGenSet.lf_layer_equiv_coord (S : SimsGenSet p a g) (i : Fin c) {L : Type*}
    [CommGroup L] (π : lcs G i →* L)
    (hker : ∀ x : lcs G i, (x : G) ∈ lcs G ((i : ℕ) + 1) → π x = 1)
    (b : Fin (r i) → Fin (r i) → ℕ)
    (φ : ((Fin (r i) → ℤ) ⧸ lfSpan p (fun v => a ⟨i, v⟩) b) ≃+ Additive L)
    (hφ : ∀ x : Fin (r i) → ℤ, φ (QuotientAddGroup.mk x) =
      lfPsi (fun v => π ⟨g ⟨i, v⟩, S.mem ⟨i, v⟩⟩) x) {x : G} (hx : x ∈ lcs G i) :
    φ (QuotientAddGroup.mk (fun v => ((S.nf.coord x ⟨i, v⟩ : ℕ) : ℤ))) =
      Additive.ofMul (π ⟨x, hx⟩) := by
  rw [hφ, lfPsi_apply, S.lf_pi_block i π hker (fun v => (S.nf.coord x ⟨i, v⟩).val)
    (deeper_mem g S.mem (fun h => (S.nf.coord x h).val) i) hx (S.lf_sims_lift i hx), ofMul_prod]
  simp only [ofMul_pow, natCast_zsmul]

/-- Comparison of two groups with Sims generating sets over the same relative orders and the
same same-layer power words: elements of `γ_{i+1}` whose classes correspond under the
identifications (57) have the same weight-`i` Sims coordinates. -/
theorem SimsGenSet.lf_coord_eq {G' : Type*} [Group G'] {g' : SimsIdx c r → G'}
    (S : SimsGenSet p a g) (S' : SimsGenSet p a g') (hp : 0 < p) (i : Fin c)
    {L : Type*} [CommGroup L] {L' : Type*} [CommGroup L'] (π : lcs G i →* L)
    (π' : lcs G' i →* L')
    (hker : ∀ x : lcs G i, (x : G) ∈ lcs G ((i : ℕ) + 1) → π x = 1)
    (hker' : ∀ x : lcs G' i, (x : G') ∈ lcs G' ((i : ℕ) + 1) → π' x = 1)
    (hL : Nat.card L = p ^ ∑ v : Fin (r i), a ⟨i, v⟩)
    (b : Fin (r i) → Fin (r i) → ℕ)
    (φ : ((Fin (r i) → ℤ) ⧸ lfSpan p (fun v => a ⟨i, v⟩) b) ≃+ Additive L)
    (φ' : ((Fin (r i) → ℤ) ⧸ lfSpan p (fun v => a ⟨i, v⟩) b) ≃+ Additive L')
    (hφ : ∀ x : Fin (r i) → ℤ, φ (QuotientAddGroup.mk x) =
      lfPsi (fun v => π ⟨g ⟨i, v⟩, S.mem ⟨i, v⟩⟩) x)
    (hφ' : ∀ x : Fin (r i) → ℤ, φ' (QuotientAddGroup.mk x) =
      lfPsi (fun v => π' ⟨g' ⟨i, v⟩, S'.mem ⟨i, v⟩⟩) x)
    {x : G} (hx : x ∈ lcs G i) {x' : G'} (hx' : x' ∈ lcs G' i)
    (h : φ.symm (Additive.ofMul (π ⟨x, hx⟩)) = φ'.symm (Additive.ofMul (π' ⟨x', hx'⟩)))
    (v : Fin (r i)) : (S.nf.coord x ⟨i, v⟩ : ℕ) = (S'.nf.coord x' ⟨i, v⟩ : ℕ) := by
  have h1 := S.lf_layer_equiv_coord i π hker b φ hφ hx
  have h2 := S'.lf_layer_equiv_coord i π' hker' b φ' hφ' hx'
  have h3 : (QuotientAddGroup.mk (fun v => ((S.nf.coord x ⟨i, v⟩ : ℕ) : ℤ)) :
      (Fin (r i) → ℤ) ⧸ lfSpan p (fun v => a ⟨i, v⟩) b) =
      QuotientAddGroup.mk (fun v => ((S'.nf.coord x' ⟨i, v⟩ : ℕ) : ℤ)) := by
    rw [← φ.symm_apply_apply (QuotientAddGroup.mk _), h1, h,
      ← φ'.symm_apply_apply (QuotientAddGroup.mk (fun v => ((S'.nf.coord x' ⟨i, v⟩ : ℕ) : ℤ))),
      h2]
  have key := lf_box_inj hp (fun v => a ⟨i, v⟩) b φ hL (fun v => (S.nf.coord x ⟨i, v⟩ : ℕ))
    (fun v => (S'.nf.coord x' ⟨i, v⟩ : ℕ)) (fun v => (S.nf.coord x ⟨i, v⟩).isLt)
    (fun v => (S'.nf.coord x' ⟨i, v⟩).isLt) h3
  exact congrFun key v

/-- `e_1` of (57): `L_1 = G / γ_2` is the coordinate group of the first layer. -/
theorem SimsGenSet.lf_abel_equiv [Finite G] (S : SimsGenSet p a g) (hp : 0 < p) (h0 : 0 < c)
    (hlast : 1 < c ∨ lcs G 1 = ⊥) (b : Fin (r ⟨0, h0⟩) → Fin (r ⟨0, h0⟩) → ℕ)
    (hb : ∀ j v, (S.powerWords ⟨⟨0, h0⟩, j⟩ ⟨⟨0, h0⟩, v⟩).val = b j v) :
    ∃ φ : ((Fin (r ⟨0, h0⟩) → ℤ) ⧸ lfSpan p (fun v => a ⟨⟨0, h0⟩, v⟩) b) ≃+
        Additive (Abelianization G),
      ∀ x, φ (QuotientAddGroup.mk x) = lfPsi (fun v =>
        (Abelianization.of.comp (lcs G 0).subtype) ⟨g ⟨⟨0, h0⟩, v⟩, S.mem ⟨⟨0, h0⟩, v⟩⟩) x := by
  refine S.lf_layer_equiv hp ⟨0, h0⟩ hlast (Abelianization.of.comp (lcs G 0).subtype)
    ?_ ?_ b hb
  · intro z
    obtain ⟨x, rfl⟩ := br_of_surjective z
    exact ⟨⟨x, mem_lcs_zero x⟩, rfl⟩
  · intro x
    rw [MonoidHom.comp_apply, Subgroup.coe_subtype, ← MonoidHom.mem_ker, Abelianization.ker_of,
      commutator_eq_lcs_one]
    try exact Iff.rfl

/-- `e_2` of (57): `L_2 = γ_2 / γ_3` (`brL2`) is the coordinate group of the second layer. -/
theorem SimsGenSet.lf_brL2_equiv [Finite G] (S : SimsGenSet p a g) (hp : 0 < p) (h1 : 1 < c)
    (hlast : 2 < c ∨ lcs G 2 = ⊥) (b : Fin (r ⟨1, h1⟩) → Fin (r ⟨1, h1⟩) → ℕ)
    (hb : ∀ j v, (S.powerWords ⟨⟨1, h1⟩, j⟩ ⟨⟨1, h1⟩, v⟩).val = b j v) :
    ∃ φ : ((Fin (r ⟨1, h1⟩) → ℤ) ⧸ lfSpan p (fun v => a ⟨⟨1, h1⟩, v⟩) b) ≃+ Additive (brL2 G),
      ∀ x, φ (QuotientAddGroup.mk x) =
        lfPsi (fun v => brq2 G ⟨g ⟨⟨1, h1⟩, v⟩, S.mem ⟨⟨1, h1⟩, v⟩⟩) x :=
  S.lf_layer_equiv hp ⟨1, h1⟩ hlast (brq2 G) brq2_surjective (fun x => brq2_eq_one_iff x) b hb

/-- `e_3` of (57): `L_3 = γ_3 / γ_4` (`brL3`) is the coordinate group of the third layer (for
class 3, `γ_4 = 1`). -/
theorem SimsGenSet.lf_brL3_equiv [Finite G] (S : SimsGenSet p a g) (hp : 0 < p) (h2 : 2 < c)
    (hlast : 3 < c ∨ lcs G 3 = ⊥) (b : Fin (r ⟨2, h2⟩) → Fin (r ⟨2, h2⟩) → ℕ)
    (hb : ∀ j v, (S.powerWords ⟨⟨2, h2⟩, j⟩ ⟨⟨2, h2⟩, v⟩).val = b j v) :
    ∃ φ : ((Fin (r ⟨2, h2⟩) → ℤ) ⧸ lfSpan p (fun v => a ⟨⟨2, h2⟩, v⟩) b) ≃+ Additive (brL3 G),
      ∀ x, φ (QuotientAddGroup.mk x) =
        lfPsi (fun v => brq3 G ⟨g ⟨⟨2, h2⟩, v⟩, S.mem ⟨⟨2, h2⟩, v⟩⟩) x :=
  S.lf_layer_equiv hp ⟨2, h2⟩ hlast (brq3 G) (lf_brq3_surjective G) (fun x => brq3_eq_one_iff x)
    b hb

end LfSimsLift

section LfFiber

variable {p : ℕ}

/-- The commutator coefficient arrays of the Sims codes, with recorded component `D` and power
word array `B`, of groups of `T`. -/
def realizedCB {m : ℕ} (hp : p.Prime) (T : Set FiniteGrp.{0}) (D : RecData m)
    (B : Fin D.2.2.1.tot → Fin D.2.2.1.tot → Fin (p ^ m)) :
    Set (Fin D.2.2.1.tot → Fin D.2.2.1.tot → Fin D.2.2.1.tot → Fin (p ^ m)) :=
  {C | ∃ G ∈ T, SimsCode hp m G (⟨D, (B, C)⟩ : FullData p m)}

/-- INF-1 fibred over the recorded data and the power word array (the paper's count of Sec 2.4
and Sec 4, which fixes `B` before counting the commutator coefficients). -/
theorem lf_ncard_classes_le_fiberB {m : ℕ} (hp : p.Prime) (T : Set FiniteGrp.{0})
    (I : Finset (RecData m)) (hI : ∀ G ∈ T, ∃ D : FullData p m, SimsCode hp m G D ∧ D.1 ∈ I) :
    (Quotient.mk (CategoryTheory.isIsomorphicSetoid FiniteGrp.{0}) '' T).ncard ≤
      ∑ x ∈ I.sigma (fun D => (Set.toFinite (realizedB hp T D)).toFinset),
        (realizedCB hp T x.1 x.2).ncard := by
  refine (ncard_le_sum_of_rel (I.sigma fun D => (Set.toFinite (realizedB hp T D)).toFinset)
    (fun x => (Set.toFinite (realizedCB hp T x.1 x.2)).toFinset)
    (fun x s C => ∃ G ∈ T,
      Quotient.mk (CategoryTheory.isIsomorphicSetoid FiniteGrp.{0}) G = s ∧
        SimsCode hp m G (⟨x.1, (x.2, C)⟩ : FullData p m)) ?_ ?_).trans_eq
    (Finset.sum_congr rfl fun x _ => ?_)
  · rintro s ⟨G, hG, rfl⟩
    obtain ⟨⟨D, B, C⟩, hD, hDI⟩ := hI G hG
    refine ⟨⟨D, B⟩, Finset.mem_sigma.2 ⟨hDI, ((Set.toFinite _).mem_toFinset).2 ⟨G, hG, C, hD⟩⟩,
      C, ((Set.toFinite _).mem_toFinset).2 ⟨G, hG, hD⟩, G, hG, rfl, hD⟩
  · rintro s₁ - s₂ - x C ⟨G₁, hG₁, rfl, h₁⟩ ⟨G₂, hG₂, rfl, h₂⟩
    obtain ⟨e⟩ := simsCode_rigid hp h₁ h₂
    exact Quotient.sound ⟨CategoryTheory.InducedCategory.isoMk (MulEquiv.toGrpIso e)⟩
  · exact (Set.ncard_eq_toFinset_card _ (Set.toFinite _)).symm

/-- The fibrewise count with Theorem 3.1 for the power word factor and a uniform bound `M(D)` on
the commutator coefficient factor over each realised power word array. -/
theorem lf_ncard_classes_le_fiberB_pw {m : ℕ} (hp : p.Prime) (T : Set FiniteGrp.{0})
    (I : Finset (RecData m)) (hI : ∀ G ∈ T, ∃ D : FullData p m, SimsCode hp m G D ∧ D.1 ∈ I)
    (M : RecData m → ℕ)
    (hM : ∀ D ∈ I, ∀ B ∈ realizedB hp T D, (realizedCB hp T D B).ncard ≤ M D) :
    (Quotient.mk (CategoryTheory.isIsomorphicSetoid FiniteGrp.{0}) '' T).ncard ≤
      ∑ D ∈ I, p ^ pwBound2 (fibAk D) * M D := by
  have : Fact p.Prime := ⟨hp⟩
  refine (lf_ncard_classes_le_fiberB hp T I hI).trans ?_
  rw [Finset.sum_sigma]
  refine Finset.sum_le_sum fun D hD => ?_
  calc ∑ B ∈ (Set.toFinite (realizedB hp T D)).toFinset, (realizedCB hp T D B).ncard
      ≤ ∑ B ∈ (Set.toFinite (realizedB hp T D)).toFinset, M D :=
        Finset.sum_le_sum fun B hB => hM D hD B ((Set.toFinite _).mem_toFinset.1 hB)
    _ = (realizedB hp T D).ncard * M D := by
        rw [Finset.sum_const, smul_eq_mul, ← Set.ncard_eq_toFinset_card]
    _ ≤ p ^ pwBound2 (fibAk D) * M D :=
        Nat.mul_le_mul_right _ ((ncard_realizedB_le hp T D).trans
          (liqiao_thm_3_1 D.1.val (fibRk D) (fibAk D) (fibAk_pos D)))

end LfFiber

section LfLead

/-! Part 6, the leading commutator coefficients of a class-3 group and the count of eq. (53).

* `lfMulE` : `L ≃* Multiplicative Q` from an identification `Q ≃+ Additive L`;
* `LfQ`, `lf_closure_single` : the coordinate group of (37) is generated by the unit vectors;
* `SimsGenSet.LfIdent`, `SimsGenSet.lf_ident_nonempty` : the identifications `e_1, e_2, e_3` of
  (57) of the three layers with their coordinate groups, built from the recorded data (37);
* `SimsGenSet.lfLead1`, `SimsGenSet.lfLead2` : the leading commutator coefficients
  `c(1, j, k, 2, v)` of `[g_{1,j}, g_{1,k}]` and `c(2, j, k, 3, v)` of `[g_{2,j}, g_{1,k}]`
  (Sims coordinates in the next layer);
* `SimsGenSet.lf_lead_eq` : groups whose transported brackets `(brT1, brT2)` agree have the same
  leading coefficients (the coefficients are the coordinates of the transported brackets);
* `lf_ncard_lead_le` : the leading coefficient arrays of class-3 groups with common recorded data
  number at most the `br_eq53_sum` bound (term A);
* `SimsGen.lf_coord_comm`, `SimsGen.lf_brCm_eq_coord` : the flattened commutator coefficient
  array `brCm` of the code `SimsGen.enc` is, on the recorded pairs, the array of Sims
  coordinates of the commutators in the normal form of `SimsGen.toSimsGenSet`;
* `SimsGen.lf_core` : the core hypothesis (34) of `exists_sims_gen` in the form used by
  `lf_ncard_lead_le`. -/

/-- A multiplicative isomorphism `L ≃* Multiplicative Q` from `φ : Q ≃+ Additive L`. -/
def lfMulE {Q L : Type*} [AddCommGroup Q] [CommGroup L] (φ : Q ≃+ Additive L) :
    L ≃* Multiplicative Q where
  toFun x := Multiplicative.ofAdd (φ.symm (Additive.ofMul x))
  invFun y := Additive.toMul (φ (Multiplicative.toAdd y))
  left_inv x := by simp
  right_inv y := by simp
  map_mul' x y := by
    show Multiplicative.ofAdd (φ.symm (Additive.ofMul x + Additive.ofMul y)) = _
    exact (congrArg Multiplicative.ofAdd (map_add φ.symm _ _)).trans (ofAdd_add _ _)

lemma lfMulE_apply {Q L : Type*} [AddCommGroup Q] [CommGroup L] (φ : Q ≃+ Additive L) (x : L) :
    lfMulE φ x = Multiplicative.ofAdd (φ.symm (Additive.ofMul x)) := rfl

lemma lfMulE_of {Q L : Type*} [AddCommGroup Q] [CommGroup L] (φ : Q ≃+ Additive L) {x : L}
    {q : Q} (h : φ q = Additive.ofMul x) : lfMulE φ x = Multiplicative.ofAdd q := by
  rw [lfMulE_apply, ← h, AddEquiv.symm_apply_apply]

/-- The coordinate group `ℤ^n / ⟨p ^ a(j) δ_j - Σ_{v<j} b(j,v) δ_v⟩` of (37). -/
abbrev LfQ {n : ℕ} (p : ℕ) (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ) : Type :=
  (Fin n → ℤ) ⧸ lfSpan p a b

lemma lf_single_smul {n : ℕ} (x : Fin n → ℤ) (j : Fin n) :
    Pi.single j (x j) = x j • (Pi.single j (1 : ℤ) : Fin n → ℤ) := by
  funext i
  by_cases h : i = j
  · subst h
    simp
  · simp [Pi.single_apply, h]

/-- The unit vectors generate the coordinate group (written multiplicatively). -/
theorem lf_closure_single {n : ℕ} (p : ℕ) (a : Fin n → ℕ) (b : Fin n → Fin n → ℕ) :
    Subgroup.closure (Set.range fun j : Fin n =>
      Multiplicative.ofAdd (QuotientAddGroup.mk (Pi.single j (1 : ℤ)) : LfQ p a b)) = ⊤ := by
  rw [eq_top_iff]
  rintro z -
  obtain ⟨x, hx⟩ := QuotientAddGroup.mk_surjective (Multiplicative.toAdd z)
  have hz : z = Multiplicative.ofAdd (QuotientAddGroup.mk x : LfQ p a b) := by
    rw [hx]
    rfl
  rw [hz]
  have key : ∀ s : Finset (Fin n), Multiplicative.ofAdd
      (QuotientAddGroup.mk (∑ j ∈ s, Pi.single j (x j)) : LfQ p a b) ∈
      Subgroup.closure (Set.range fun j : Fin n =>
        Multiplicative.ofAdd (QuotientAddGroup.mk (Pi.single j (1 : ℤ)) : LfQ p a b)) := by
    intro s
    refine Finset.induction_on s ?_ ?_
    · rw [Finset.sum_empty, QuotientAddGroup.mk_zero, ofAdd_zero]
      exact Subgroup.one_mem _
    · intro j s hj ih
      rw [Finset.sum_insert hj, QuotientAddGroup.mk_add, ofAdd_add]
      refine Subgroup.mul_mem _ ?_ ih
      rw [lf_single_smul x j, QuotientAddGroup.mk_zsmul, ofAdd_zsmul]
      exact Subgroup.zpow_mem _ (Subgroup.subset_closure (Set.mem_range_self j)) _
  have h := key Finset.univ
  rwa [Finset.univ_sum_single] at h

lemma lf_card_mulQ {n p : ℕ} {a : Fin n → ℕ} {b : Fin n → Fin n → ℕ} {L : Type*} [CommGroup L]
    (φ : LfQ p a b ≃+ Additive L) {N : ℕ} (hL : Nat.card L = N) :
    Nat.card (Multiplicative (LfQ p a b)) = N := by
  rw [← hL, Nat.card_congr (Multiplicative.toAdd : Multiplicative (LfQ p a b) ≃ _),
    Nat.card_congr φ.toEquiv]
  exact Nat.card_congr Additive.toMul

/-- The first three layer indices. -/
abbrev lfI0 {c : ℕ} (h2 : 2 < c) : Fin c := ⟨0, by omega⟩

abbrev lfI1 {c : ℕ} (h2 : 2 < c) : Fin c := ⟨1, by omega⟩

abbrev lfI2 {c : ℕ} (h2 : 2 < c) : Fin c := ⟨2, h2⟩

variable {G : Type u} [Group G] {p c : ℕ} {r : Fin c → ℕ} {a : SimsIdx c r → ℕ}
  {g : SimsIdx c r → G}

/-- The leading coefficients `c(1, j, k, 2, v)`: the weight-1 Sims coordinates of
`[g_{0,j}, g_{0,k}]` (layers indexed from `0`). -/
def SimsGenSet.lfLead1 (S : SimsGenSet p a g) (h2 : 2 < c) :
    Fin (r (lfI0 h2)) → Fin (r (lfI0 h2)) → Fin (r (lfI1 h2)) → ℕ :=
  fun j k v => (S.nf.coord ⁅g ⟨lfI0 h2, j⟩, g ⟨lfI0 h2, k⟩⁆ ⟨lfI1 h2, v⟩).val

/-- The leading coefficients `c(2, j, k, 3, v)`: the weight-2 Sims coordinates of
`[g_{1,j}, g_{0,k}]`. -/
def SimsGenSet.lfLead2 (S : SimsGenSet p a g) (h2 : 2 < c) :
    Fin (r (lfI1 h2)) → Fin (r (lfI0 h2)) → Fin (r (lfI2 h2)) → ℕ :=
  fun j k v => (S.nf.coord ⁅g ⟨lfI1 h2, j⟩, g ⟨lfI0 h2, k⟩⁆ ⟨lfI2 h2, v⟩).val

/-- The identifications (57) of the layers `L_1, L_2, L_3` with the coordinate groups presented
by the recorded relative orders and same-layer power words `b0, b1, b2` (37). -/
structure SimsGenSet.LfIdent (S : SimsGenSet p a g) (h2 : 2 < c)
    (b0 : Fin (r (lfI0 h2)) → Fin (r (lfI0 h2)) → ℕ)
    (b1 : Fin (r (lfI1 h2)) → Fin (r (lfI1 h2)) → ℕ)
    (b2 : Fin (r (lfI2 h2)) → Fin (r (lfI2 h2)) → ℕ) where
  φ1 : LfQ p (fun v => a ⟨lfI0 h2, v⟩) b0 ≃+ Additive (Abelianization G)
  φ2 : LfQ p (fun v => a ⟨lfI1 h2, v⟩) b1 ≃+ Additive (brL2 G)
  φ3 : LfQ p (fun v => a ⟨lfI2 h2, v⟩) b2 ≃+ Additive (brL3 G)
  spec1 : ∀ x, φ1 (QuotientAddGroup.mk x) = lfPsi (fun v =>
    (Abelianization.of.comp (lcs G 0).subtype) ⟨g ⟨lfI0 h2, v⟩, S.mem ⟨lfI0 h2, v⟩⟩) x
  spec2 : ∀ x, φ2 (QuotientAddGroup.mk x) =
    lfPsi (fun v => brq2 G ⟨g ⟨lfI1 h2, v⟩, S.mem ⟨lfI1 h2, v⟩⟩) x
  spec3 : ∀ x, φ3 (QuotientAddGroup.mk x) =
    lfPsi (fun v => brq3 G ⟨g ⟨lfI2 h2, v⟩, S.mem ⟨lfI2 h2, v⟩⟩) x
  card2 : Nat.card (brL2 G) = p ^ ∑ v, a ⟨lfI1 h2, v⟩
  card3 : Nat.card (brL3 G) = p ^ ∑ v, a ⟨lfI2 h2, v⟩

/-- The identifications exist (from the recorded data (37), for class at most 3 beyond the third
layer: `γ_4 = 1` or a fourth layer). -/
theorem SimsGenSet.lf_ident_nonempty [Finite G] (S : SimsGenSet p a g) (hp : 0 < p)
    (h2 : 2 < c) (hlast : 3 < c ∨ lcs G 3 = ⊥)
    (b0 : Fin (r (lfI0 h2)) → Fin (r (lfI0 h2)) → ℕ)
    (b1 : Fin (r (lfI1 h2)) → Fin (r (lfI1 h2)) → ℕ)
    (b2 : Fin (r (lfI2 h2)) → Fin (r (lfI2 h2)) → ℕ)
    (hb0 : ∀ j v, (S.powerWords ⟨lfI0 h2, j⟩ ⟨lfI0 h2, v⟩).val = b0 j v)
    (hb1 : ∀ j v, (S.powerWords ⟨lfI1 h2, j⟩ ⟨lfI1 h2, v⟩).val = b1 j v)
    (hb2 : ∀ j v, (S.powerWords ⟨lfI2 h2, j⟩ ⟨lfI2 h2, v⟩).val = b2 j v) :
    Nonempty (S.LfIdent h2 b0 b1 b2) := by
  obtain ⟨φ1, h1⟩ := S.lf_abel_equiv hp (by omega) (Or.inl (by omega)) b0 hb0
  obtain ⟨φ2, h2'⟩ := S.lf_brL2_equiv hp (by omega) (Or.inl h2) b1 hb1
  obtain ⟨φ3, h3⟩ := S.lf_brL3_equiv hp h2 hlast b2 hb2
  have c2 := S.lf_card_quotL hp (lfI1 h2) (Or.inl (show (1 : ℕ) + 1 < c by omega)) (brq2 G)
    brq2_surjective (fun x => brq2_eq_one_iff x)
  have c3 := S.lf_card_quotL hp (lfI2 h2) hlast (brq3 G) (lf_brq3_surjective G)
    (fun x => brq3_eq_one_iff x)
  exact ⟨⟨φ1, φ2, φ3, h1, h2', h3, c2, c3⟩⟩

variable {S : SimsGenSet p a g} {h2 : 2 < c} {b0 : Fin (r (lfI0 h2)) → Fin (r (lfI0 h2)) → ℕ}
  {b1 : Fin (r (lfI1 h2)) → Fin (r (lfI1 h2)) → ℕ} {b2 : Fin (r (lfI2 h2)) → Fin (r (lfI2 h2)) → ℕ}

theorem SimsGenSet.LfIdent.e1_gen (I : S.LfIdent h2 b0 b1 b2) (v : Fin (r (lfI0 h2))) :
    lfMulE I.φ1 (Abelianization.of (g ⟨lfI0 h2, v⟩)) =
      Multiplicative.ofAdd (QuotientAddGroup.mk (Pi.single v (1 : ℤ))) :=
  lfMulE_of _ ((I.spec1 _).trans (lfPsi_single _ v))

theorem SimsGenSet.LfIdent.e2_gen (I : S.LfIdent h2 b0 b1 b2) (v : Fin (r (lfI1 h2))) :
    lfMulE I.φ2 (brq2 G ⟨g ⟨lfI1 h2, v⟩, S.mem ⟨lfI1 h2, v⟩⟩) =
      Multiplicative.ofAdd (QuotientAddGroup.mk (Pi.single v (1 : ℤ))) :=
  lfMulE_of _ ((I.spec2 _).trans (lfPsi_single _ v))

/-- Under `e_2`, the class of `x ∈ γ_2` is its vector of weight-1 Sims coordinates. -/
theorem SimsGenSet.LfIdent.e2_coord (I : S.LfIdent h2 b0 b1 b2) {x : G} (hx : x ∈ lcs G 1) :
    lfMulE I.φ2 (brq2 G ⟨x, hx⟩) = Multiplicative.ofAdd
      (QuotientAddGroup.mk (fun v => ((S.nf.coord x ⟨lfI1 h2, v⟩ : ℕ) : ℤ))) :=
  lfMulE_of _ (S.lf_layer_equiv_coord (lfI1 h2) (brq2 G) (fun y hy => (brq2_eq_one_iff y).2 hy)
    b1 I.φ2 I.spec2 hx)

/-- Under `e_3`, the class of `x ∈ γ_3` is its vector of weight-2 Sims coordinates. -/
theorem SimsGenSet.LfIdent.e3_coord (I : S.LfIdent h2 b0 b1 b2) {x : G} (hx : x ∈ lcs G 2) :
    lfMulE I.φ3 (brq3 G ⟨x, hx⟩) = Multiplicative.ofAdd
      (QuotientAddGroup.mk (fun v => ((S.nf.coord x ⟨lfI2 h2, v⟩ : ℕ) : ℤ))) :=
  lfMulE_of _ (S.lf_layer_equiv_coord (lfI2 h2) (brq3 G) (fun y hy => (brq3_eq_one_iff y).2 hy)
    b2 I.φ3 I.spec3 hx)

variable {G' : Type u} [Group G'] {g' : SimsIdx c r → G'} {S' : SimsGenSet p a g'}

/-- Recovery of the leading coefficients from the transported brackets (Sec 2.3 with (57)): two
groups with Sims generating sets over the same relative orders and same-layer power words whose
transported bracket pairs `(brT1, brT2)` (along the identifications `e_1, e_2, e_3`) agree have
the same leading commutator coefficients `c(1, j, k, 2, v)` and `c(2, j, k, 3, v)`. -/
theorem SimsGenSet.lf_lead_eq (hp : 0 < p) (I : S.LfIdent h2 b0 b1 b2)
    (I' : S'.LfIdent h2 b0 b1 b2)
    (hT1 : brT1 (lfMulE I.φ1) (lfMulE I.φ2) = brT1 (lfMulE I'.φ1) (lfMulE I'.φ2))
    (hT2 : brT2 (lfMulE I.φ1) (lfMulE I.φ2) (lfMulE I.φ3) =
      brT2 (lfMulE I'.φ1) (lfMulE I'.φ2) (lfMulE I'.φ3)) :
    S.lfLead1 h2 = S'.lfLead1 h2 ∧ S.lfLead2 h2 = S'.lfLead2 h2 := by
  have ha : ∀ i, lfMulE I.φ1 (Abelianization.of (g ⟨lfI0 h2, i⟩)) =
      lfMulE I'.φ1 (Abelianization.of (g' ⟨lfI0 h2, i⟩)) := fun i =>
    (I.e1_gen i).trans (I'.e1_gen i).symm
  constructor
  · funext j k
    have hc := brT1_coeff_eq (lfMulE I.φ1) (lfMulE I.φ2) (lfMulE I'.φ1) (lfMulE I'.φ2) hT1
      (fun i => g ⟨lfI0 h2, i⟩) (fun i => g' ⟨lfI0 h2, i⟩) ha j k
    have hc' := ((I.e2_coord (cw (g ⟨lfI0 h2, j⟩) (g ⟨lfI0 h2, k⟩)).2).symm.trans hc).trans
      (I'.e2_coord (cw (g' ⟨lfI0 h2, j⟩) (g' ⟨lfI0 h2, k⟩)).2)
    exact lf_box_inj hp _ b1 I.φ2 I.card2 (S.lfLead1 h2 j k) (S'.lfLead1 h2 j k)
      (fun v => (S.nf.coord ⁅g ⟨lfI0 h2, j⟩, g ⟨lfI0 h2, k⟩⁆ ⟨lfI1 h2, v⟩).isLt)
      (fun v => (S'.nf.coord ⁅g' ⟨lfI0 h2, j⟩, g' ⟨lfI0 h2, k⟩⁆ ⟨lfI1 h2, v⟩).isLt)
      (Multiplicative.ofAdd.injective hc')
  · funext j k
    have hw : lfMulE I.φ2 (brq2 G ⟨g ⟨lfI1 h2, j⟩, S.mem ⟨lfI1 h2, j⟩⟩) =
        lfMulE I'.φ2 (brq2 G' ⟨g' ⟨lfI1 h2, j⟩, S'.mem ⟨lfI1 h2, j⟩⟩) :=
      (I.e2_gen j).trans (I'.e2_gen j).symm
    have hc := brT2_coeff_eq (lfMulE I.φ1) (lfMulE I.φ2) (lfMulE I.φ3) (lfMulE I'.φ1)
      (lfMulE I'.φ2) (lfMulE I'.φ3) hT2 _ _ hw (g ⟨lfI0 h2, k⟩) (g' ⟨lfI0 h2, k⟩) (ha k)
    have hc' := ((I.e3_coord (cw2 ⟨g ⟨lfI1 h2, j⟩, S.mem ⟨lfI1 h2, j⟩⟩
        (g ⟨lfI0 h2, k⟩)).2).symm.trans hc).trans
      (I'.e3_coord (cw2 ⟨g' ⟨lfI1 h2, j⟩, S'.mem ⟨lfI1 h2, j⟩⟩ (g' ⟨lfI0 h2, k⟩)).2)
    exact lf_box_inj hp _ b2 I.φ3 I.card3 (S.lfLead2 h2 j k) (S'.lfLead2 h2 j k)
      (fun v => (S.nf.coord ⁅g ⟨lfI1 h2, j⟩, g ⟨lfI0 h2, k⟩⁆ ⟨lfI2 h2, v⟩).isLt)
      (fun v => (S'.nf.coord ⁅g' ⟨lfI1 h2, j⟩, g' ⟨lfI0 h2, k⟩⁆ ⟨lfI2 h2, v⟩).isLt)
      (Multiplicative.ofAdd.injective hc')

end LfLead

section LfLeadCount

variable {p c : ℕ} {r : Fin c → ℕ} {a : SimsIdx c r → ℕ}

/-- Term A of the class-3 count for groups (Lemma 4.1, Propositions 4.2/4.3 and eq. (53) with
the identifications (57)): the leading commutator coefficient arrays
`(c(1, j, k, 2, v), c(2, j, k, 3, v))` of groups with Sims generating sets of common shape
`(c, r, a)`, common same-layer power words `b0, b1, b2`, `γ_4 = 1` (or a fourth layer), a Sims core
`g_{0,0}, ..., g_{0,s-1}` (`γ_2 ≤ [H, H] γ_3`, (34)) and prescribed coefficients `w` on the
defining pairs `D` number at most the `br_eq53_sum` bound with `s_2 = Σ_v a(1, v)`,
`s_3 = Σ_v a(2, v)`, `n = r_1`. -/
theorem lf_ncard_lead_le (hp : p.Prime) (h2 : 2 < c)
    (b0 : Fin (r (lfI0 h2)) → Fin (r (lfI0 h2)) → ℕ)
    (b1 : Fin (r (lfI1 h2)) → Fin (r (lfI1 h2)) → ℕ)
    (b2 : Fin (r (lfI2 h2)) → Fin (r (lfI2 h2)) → ℕ) {s : ℕ} (hs : s ≤ r (lfI0 h2))
    (D : Finset (Fin (r (lfI0 h2)) × Fin (r (lfI0 h2))))
    (hD : ∀ q ∈ D, q.1 < q.2 ∧ (q.1 : ℕ) < s)
    (w : Fin (r (lfI0 h2)) × Fin (r (lfI0 h2)) → Fin (r (lfI1 h2)) → ℕ)
    (Λ : Set ((Fin (r (lfI0 h2)) → Fin (r (lfI0 h2)) → Fin (r (lfI1 h2)) → ℕ) ×
      (Fin (r (lfI1 h2)) → Fin (r (lfI0 h2)) → Fin (r (lfI2 h2)) → ℕ)))
    (hΛ : ∀ x ∈ Λ, ∃ (G : Type u) (_ : Group G) (_ : Finite G) (g : SimsIdx c r → G)
      (S : SimsGenSet p a g),
      (∀ j v, (S.powerWords ⟨lfI0 h2, j⟩ ⟨lfI0 h2, v⟩).val = b0 j v) ∧
      (∀ j v, (S.powerWords ⟨lfI1 h2, j⟩ ⟨lfI1 h2, v⟩).val = b1 j v) ∧
      (∀ j v, (S.powerWords ⟨lfI2 h2, j⟩ ⟨lfI2 h2, v⟩).val = b2 j v) ∧
      (3 < c ∨ lcs G 3 = ⊥) ∧
      lcs G 1 ≤ ⁅Subgroup.closure ((fun j => g ⟨lfI0 h2, j⟩) '' {j | (j : ℕ) < s}),
        Subgroup.closure ((fun j => g ⟨lfI0 h2, j⟩) '' {j | (j : ℕ) < s})⁆ ⊔ lcs G 2 ∧
      (∀ q ∈ D, S.lfLead1 h2 q.1 q.2 = w q) ∧
      x = (S.lfLead1 h2, S.lfLead2 h2)) :
    Λ.ncard ≤ ∑ β ∈ (Finset.range (min (∑ v, a ⟨lfI1 h2, v⟩) (∑ v, a ⟨lfI2 h2, v⟩) + 1)).filter
        (fun β => (∑ v, a ⟨lfI2 h2, v⟩) ≤ s * β),
      p ^ (s * (β * (r (lfI1 h2) + (∑ v, a ⟨lfI2 h2, v⟩) + 1 - β))) *
        p ^ (((r (lfI0 h2)).choose 2 - D.card) * (∑ v, a ⟨lfI1 h2, v⟩) -
          (r (lfI0 h2) - s).choose 2 * β) := by
  classical
  have hp0 := hp.pos
  have : Finite (LfQ p (fun v => a ⟨lfI0 h2, v⟩) b0) := (lf_card_quot_le hp0 _ b0).1
  have : Finite (LfQ p (fun v => a ⟨lfI1 h2, v⟩) b1) := (lf_card_quot_le hp0 _ b1).1
  have : Finite (LfQ p (fun v => a ⟨lfI2 h2, v⟩) b2) := (lf_card_quot_le hp0 _ b2).1
  have : Finite (Multiplicative (LfQ p (fun v => a ⟨lfI0 h2, v⟩) b0)) :=
    Finite.of_equiv _ Multiplicative.ofAdd
  have : Finite (Multiplicative (LfQ p (fun v => a ⟨lfI1 h2, v⟩) b1)) :=
    Finite.of_equiv _ Multiplicative.ofAdd
  have : Finite (Multiplicative (LfQ p (fun v => a ⟨lfI2 h2, v⟩) b2)) :=
    Finite.of_equiv _ Multiplicative.ofAdd
  rcases Λ.eq_empty_or_nonempty with hE | ⟨x0, hx0⟩
  · rw [hE, Set.ncard_empty]
    exact Nat.zero_le _
  obtain ⟨G0, _, _, g0, S0, hb0, hb1, hb2, hl, -, -, -⟩ := hΛ x0 hx0
  obtain ⟨I0⟩ := S0.lf_ident_nonempty hp0 h2 hl b0 b1 b2 hb0 hb1 hb2
  have hL2 := lf_card_mulQ I0.φ2 I0.card2
  have hL3 := lf_card_mulQ I0.φ3 I0.card3
  have := br_finite_pairs (L1 := Multiplicative (LfQ p (fun v => a ⟨lfI0 h2, v⟩) b0))
    (L2 := Multiplicative (LfQ p (fun v => a ⟨lfI1 h2, v⟩) b1))
    (L3 := Multiplicative (LfQ p (fun v => a ⟨lfI2 h2, v⟩) b2))
  let gg : Fin (r (lfI0 h2)) → Multiplicative (LfQ p (fun v => a ⟨lfI0 h2, v⟩) b0) :=
    fun j => Multiplicative.ofAdd (QuotientAddGroup.mk (Pi.single j (1 : ℤ)))
  let yy : Fin (r (lfI1 h2)) → Multiplicative (LfQ p (fun v => a ⟨lfI1 h2, v⟩) b1) :=
    fun j => Multiplicative.ofAdd (QuotientAddGroup.mk (Pi.single j (1 : ℤ)))
  let vv : Fin (r (lfI0 h2)) × Fin (r (lfI0 h2)) →
      Multiplicative (LfQ p (fun v => a ⟨lfI1 h2, v⟩) b1) :=
    fun q => Multiplicative.ofAdd (QuotientAddGroup.mk (fun v => ((w q v : ℕ) : ℤ)))
  obtain ⟨R, hR⟩ : ∃ R : ((Fin (r (lfI0 h2)) → Fin (r (lfI0 h2)) → Fin (r (lfI1 h2)) → ℕ) ×
      (Fin (r (lfI1 h2)) → Fin (r (lfI0 h2)) → Fin (r (lfI2 h2)) → ℕ)) →
      ((Multiplicative (LfQ p (fun v => a ⟨lfI0 h2, v⟩) b0) →*
          Multiplicative (LfQ p (fun v => a ⟨lfI0 h2, v⟩) b0) →*
            Multiplicative (LfQ p (fun v => a ⟨lfI1 h2, v⟩) b1)) ×
        (Multiplicative (LfQ p (fun v => a ⟨lfI1 h2, v⟩) b1) →*
          Multiplicative (LfQ p (fun v => a ⟨lfI0 h2, v⟩) b0) →*
            Multiplicative (LfQ p (fun v => a ⟨lfI2 h2, v⟩) b2))) → Prop, R =
    fun x β => ∃ (G : Type u) (_ : Group G) (g : SimsIdx c r → G) (S : SimsGenSet p a g)
      (I : S.LfIdent h2 b0 b1 b2), x = (S.lfLead1 h2, S.lfLead2 h2) ∧
        β = (brT1 (lfMulE I.φ1) (lfMulE I.φ2), brT2 (lfMulE I.φ1) (lfMulE I.φ2) (lfMulE I.φ3)) :=
    ⟨_, rfl⟩
  have hfun : ∀ x x' β, R x β → R x' β → x = x' := by
    intro x x' β h h'
    rw [hR] at h h'
    obtain ⟨G, _, g, S, I, rfl, rfl⟩ := h
    obtain ⟨G', _, g', S', I', rfl, hβ⟩ := h'
    obtain ⟨h1, h2'⟩ := Prod.mk.inj hβ
    obtain ⟨e1, e2⟩ := SimsGenSet.lf_lead_eq hp0 I I' h1 h2'
    rw [e1, e2]
  have hex : ∀ x ∈ Λ, ∃ β, β ∈ lfBrSet (Multiplicative (LfQ p (fun v => a ⟨lfI2 h2, v⟩) b2))
      s gg D vv ∧ R x β := by
    intro x hx
    obtain ⟨G, _, _, g, S, hb0, hb1, hb2, hl, hcore, hDw, rfl⟩ := hΛ x hx
    obtain ⟨I⟩ := S.lf_ident_nonempty hp0 h2 hl b0 b1 b2 hb0 hb1 hb2
    refine ⟨_, lf_brT_mem (lfMulE I.φ1) (lfMulE I.φ2) (lfMulE I.φ3)
      (fun j => g ⟨lfI0 h2, j⟩) gg (fun j => I.e1_gen j) hcore D vv (fun q hq => ?_), ?_⟩
    swap
    · rw [hR]
      exact ⟨G, inferInstance, g, S, I, rfl, rfl⟩
    refine (I.e2_coord (cw (g ⟨lfI0 h2, q.1⟩) (g ⟨lfI0 h2, q.2⟩)).2).trans ?_
    show _ = Multiplicative.ofAdd (QuotientAddGroup.mk (fun v => ((w q v : ℕ) : ℤ)))
    rw [← hDw q hq]
    rfl
  let F := fun x => if h : x ∈ Λ then Classical.choose (hex x h) else 1
  have hF : ∀ x (h : x ∈ Λ), F x = Classical.choose (hex x h) := fun x h => dif_pos h
  have hmaps : ∀ x ∈ Λ, F x ∈ lfBrSet (Multiplicative (LfQ p (fun v => a ⟨lfI2 h2, v⟩) b2))
      s gg D vv := fun x h => by
    rw [hF x h]
    exact (Classical.choose_spec (hex x h)).1
  have hinj : Set.InjOn F Λ := by
    intro x hx x' hx' he
    refine hfun x x' (F x) ?_ ?_
    · rw [hF x hx]
      exact (Classical.choose_spec (hex x hx)).2
    · rw [he, hF x' hx']
      exact (Classical.choose_spec (hex x' hx')).2
  refine (Set.ncard_le_ncard_of_injOn F hmaps hinj (Set.toFinite _)).trans ?_
  exact br_eq53_sum hp hs hL2 hL3 yy (lf_closure_single p _ b1) gg (lf_closure_single p _ b0)
    D hD vv

end LfLeadCount

section LfFlat

variable {G : Type u} [Group G] {p : ℕ} {u : ℕ → G} {d : SimsData} {X : Fin d.n → G}
  {r : ℕ → ℕ}

/-- The recorded commutator coefficients `d.c t k` (on the recorded pairs `Rec`) are the Sims
coordinates of `[X_t, X_k]` in the normal form of `SimsGen.toSimsGenSet`. -/
theorem SimsGen.lf_coord_comm [Finite G] (hp : p.Prime) (hS : SimsGen p u d X r) {c : ℕ}
    (hn : d.n = fOff r c) (t k : Fin d.n) (hrec : d.Rec t k) (k' : SimsIdx c (brR r c)) :
    ((hS.toSimsGenSet hp hn).nf.coord ⁅X t, X k⁆ k').val = d.c t k (hS.brEquiv hn k') := by
  have hcomm : ⁅X t, X k⁆ = nfw X (d.c t k) := by
    rcases hrec with ⟨h1, h2, h3⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact hS.realizes.comm0 t k h1 h2 h3
    · exact hS.realizes.comm1 t k h1 h2
    · exact hS.realizes.comm2 t k h1 h2
  have hx := Classical.choose_spec (hS.nf_exists ⁅X t, X k⁆)
  have h2 := hS.nf_unique _ (d.c t k) hx.1 (fun v => hS.bounded.2 t k v) (hx.2.symm.trans hcomm)
  show Classical.choose (hS.nf_exists ⁅X t, X k⁆) (hS.brEquiv hn k') = _
  rw [h2]

/-- The flattened commutator coefficient array `brCm` of the code `SimsGen.enc` (the `C`
component of the full data) at recorded pairs is the array of Sims coordinates of the
commutators of the generators of `SimsGen.toSimsGenSet`; in particular the leading coefficients
`SimsGenSet.lfLead1`, `SimsGenSet.lfLead2` of `toSimsGenSet` are entries of the code. -/
theorem SimsGen.lf_brCm_eq_coord [Finite G] (hp : p.Prime) (hS : SimsGen p u d X r) {c : ℕ}
    (hn : d.n = fOff r c) (k1 k2 k3 : SimsIdx c (brR r c))
    (hrec : d.Rec (hS.brEquiv hn k1) (hS.brEquiv hn k2)) :
    brCm d (hS.brEquiv hn k1).val (hS.brEquiv hn k2).val (hS.brEquiv hn k3).val =
      ((hS.toSimsGenSet hp hn).nf.coord
        ⁅X (hS.brEquiv hn k1), X (hS.brEquiv hn k2)⁆ k3).val := by
  unfold brCm
  rw [dif_pos (show _ ∧ _ ∧ _ from
    ⟨(hS.brEquiv hn k1).isLt, (hS.brEquiv hn k2).isLt, (hS.brEquiv hn k3).isLt⟩)]
  refine (if_pos ?_).trans ?_
  · exact hrec
  · exact (hS.lf_coord_comm hp hn _ _ hrec k3).symm

/-- (34) for the reindexed Sims generating set: the core hypothesis of `exists_sims_gen`
(`γ_2 ≤ [H, H] γ_3`, `H = ⟨u_0, ..., u_{s-1}⟩`) with `H` generated by the first `s` weight-0
generators of `SimsGen.toSimsGenSet`, and `s ≤ r_0`. -/
theorem SimsGen.lf_core (hS : SimsGen p u d X r) {c : ℕ} (hn : d.n = fOff r c) (h0 : 0 < c)
    (hcore : lcs G 1 ≤ ⁅Subgroup.closure (u '' Set.Iio d.s),
      Subgroup.closure (u '' Set.Iio d.s)⁆ ⊔ lcs G 2) :
    d.s ≤ r 0 ∧ lcs G 1 ≤ ⁅Subgroup.closure ((fun j : Fin (brR r c ⟨0, h0⟩) =>
        X (hS.brEquiv hn ⟨⟨0, h0⟩, j⟩)) '' {j | (j : ℕ) < d.s}),
      Subgroup.closure ((fun j : Fin (brR r c ⟨0, h0⟩) =>
        X (hS.brEquiv hn ⟨⟨0, h0⟩, j⟩)) '' {j | (j : ℕ) < d.s})⁆ ⊔ lcs G 2 := by
  have e0 : fOff r 0 = 0 := rfl
  have hsn := hS.valid.s_le
  have hsr : d.s ≤ r 0 := by
    rcases Nat.eq_zero_or_pos d.s with h | h
    · omega
    · have hl := hS.valid.core ⟨d.s - 1, by omega⟩ (show d.s - 1 < d.s by omega)
      have := ((hS.layer_iff ⟨d.s - 1, by omega⟩ 0).mp hl).2
      rw [e0] at this
      show d.s ≤ r 0
      have h' : d.s - 1 < r 0 := by simpa using this
      omega
  have hX : ∀ (k : ℕ) (hk : k < d.s) (hkr : k < brR r c ⟨0, h0⟩),
      X (hS.brEquiv hn ⟨⟨0, h0⟩, ⟨k, hkr⟩⟩) = u k := by
    intro k hk hkr
    have hv : hS.brEquiv hn ⟨⟨0, h0⟩, ⟨k, hkr⟩⟩ = ⟨k, by omega⟩ := by
      apply Fin.ext
      rw [hS.val_brEquiv hn]
      show fOff r 0 + k = k
      rw [e0, zero_add]
    rw [hv]
    exact hS.core ⟨k, by omega⟩ hk
  have hset : u '' Set.Iio d.s = (fun j : Fin (brR r c ⟨0, h0⟩) =>
      X (hS.brEquiv hn ⟨⟨0, h0⟩, j⟩)) '' {j | (j : ℕ) < d.s} := by
    ext z
    constructor
    · rintro ⟨k, hk, rfl⟩
      have hk' : k < d.s := hk
      exact ⟨⟨k, show k < r 0 by omega⟩, hk', hX k hk' _⟩
    · rintro ⟨j, hj, rfl⟩
      have hj' : (j : ℕ) < d.s := hj
      exact ⟨j.val, hj', (hX j.val hj' j.isLt).symm⟩
  rw [hset] at hcore
  exact ⟨hsr, hcore⟩

end LfFlat

