import H2Dev.Comm

/-! Fixed statements of the two pure group-theory engines, so that the code-dependent modules
can be developed in parallel. DEVELOPMENT STUBS: the bodies are proved in `Lie.lean` and
`Strict.lean` and pasted here before assembly; the submitted file contains no sorry. -/

namespace OMA.SimsLite

universe u

section Stmt

variable {D : Type u} [Group D]

/-- Theorem L (0-based levels). `E w` is the set of level-`w` generators (`E 1` the core
commutators indexed by `P`); then every `lcs D w` (w ≥ 1) is generated by `E w` modulo the
next term. -/
theorem lie_lemma (t : ℕ) (u : ℕ → D) (H1 : Set D) (P : Set (ℕ × ℕ)) (E : ℕ → Set D)
    (hP : ∀ ab ∈ P, ab.1 < ab.2 ∧ ab.2 < t)
    (hE1 : E 1 = (fun ab : ℕ × ℕ => ⁅u ab.1, u ab.2⁆) '' P)
    (hL2 : ∀ w, 1 ≤ w → ∀ x ∈ E (w + 1), ∃ y ∈ Subgroup.closure (E w), ∃ b < t, x = ⁅y, u b⁆)
    (hL0 : Subgroup.closure H1 ⊔ lcs D 1 = ⊤)
    (hH1 : ∀ x ∈ H1, ∀ y ∈ H1, ⁅x, y⁆ ∈ Subgroup.closure (E 1) ⊔ lcs D 2)
    (hH2 : ∀ ab ∈ P, ∀ k ≤ ab.2, ⁅⁅u ab.1, u ab.2⁆, u k⁆ ∈ Subgroup.closure (E 2) ⊔ lcs D 3)
    (hH3 : ∀ w, 2 ≤ w → ∀ x ∈ E w, ∀ k < t,
      ⁅x, u k⁆ ∈ Subgroup.closure (E (w + 1)) ⊔ lcs D (w + 2)) :
    ∀ w, 1 ≤ w → lcs D w ≤ Subgroup.closure (E w) ⊔ lcs D (w + 1) := by
  sorry

/-- Corollary L' (tail form): in a nilpotent group the level-`≥ w` generators generate `lcs D w`. -/
theorem lie_lemma_tail (t : ℕ) (u : ℕ → D) (H1 : Set D) (P : Set (ℕ × ℕ)) (E : ℕ → Set D)
    (hP : ∀ ab ∈ P, ab.1 < ab.2 ∧ ab.2 < t)
    (hE1 : E 1 = (fun ab : ℕ × ℕ => ⁅u ab.1, u ab.2⁆) '' P)
    (hL2 : ∀ w, 1 ≤ w → ∀ x ∈ E (w + 1), ∃ y ∈ Subgroup.closure (E w), ∃ b < t, x = ⁅y, u b⁆)
    (hL0 : Subgroup.closure H1 ⊔ lcs D 1 = ⊤)
    (hH1 : ∀ x ∈ H1, ∀ y ∈ H1, ⁅x, y⁆ ∈ Subgroup.closure (E 1) ⊔ lcs D 2)
    (hH2 : ∀ ab ∈ P, ∀ k ≤ ab.2, ⁅⁅u ab.1, u ab.2⁆, u k⁆ ∈ Subgroup.closure (E 2) ⊔ lcs D 3)
    (hH3 : ∀ w, 2 ≤ w → ∀ x ∈ E w, ∀ k < t,
      ⁅x, u k⁆ ∈ Subgroup.closure (E (w + 1)) ⊔ lcs D (w + 2))
    (N : ℕ) (hN : lcs D N = ⊥) :
    ∀ w, 1 ≤ w → lcs D w ≤ Subgroup.closure (⋃ v ∈ Set.Ici w, E v) := by
  sorry

/-- The level-`w` generators lie in `lcs D w`. -/
theorem closure_E_le (t : ℕ) (u : ℕ → D) (P : Set (ℕ × ℕ)) (E : ℕ → Set D)
    (hE1 : E 1 = (fun ab : ℕ × ℕ => ⁅u ab.1, u ab.2⁆) '' P)
    (hL2 : ∀ w, 1 ≤ w → ∀ x ∈ E (w + 1), ∃ y ∈ Subgroup.closure (E w), ∃ b < t, x = ⁅y, u b⁆) :
    ∀ w, 1 ≤ w → Subgroup.closure (E w) ≤ lcs D w := by
  sorry

end Stmt

section StrictStmt

variable {G : Type u} [Group G]

/-- `W_k(u) = ⟨⁅u a, u b⁆ : a < b < k⟩ γ_3`. -/
def Wk (u : ℕ → G) (k : ℕ) : Subgroup G :=
  Subgroup.closure {x | ∃ a b, a < b ∧ b < k ∧ x = ⁅u a, u b⁆} ⊔ lcs G 2

/-- `u` is strict of length `t`: each new core element enlarges `W`. -/
def StrictChain (u : ℕ → G) (t : ℕ) : Prop := ∀ k, 2 ≤ k → k ≤ t → Wk u (k - 1) ≠ Wk u k

/-- S1: a strict chain whose commutators generate `γ_2` modulo `γ_3`. -/
theorem exists_strict_chain [Finite G] :
    ∃ (t : ℕ) (u : ℕ → G), t ≠ 1 ∧ StrictChain u t ∧ lcs G 1 ≤ Wk u t := by
  sorry

/-- S2: the elements of a strict chain are independent modulo `γ_2`. -/
theorem strict_chain_indep (u : ℕ → G) (t : ℕ) (h : StrictChain u t) (ht : 2 ≤ t) :
    ∀ k < t, u k ∉ Subgroup.closure (u '' Set.Iio k) ⊔ lcs G 1 := by
  sorry

end StrictStmt

end OMA.SimsLite
