import Mathlib.GroupTheory.Nilpotent
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
import Mathlib.Tactic.Group
import Mathlib.Tactic.Linarith

/-! Normal forms for lists of group elements (from the accepted proof of R3.H1.R1.H2.R1.H1). -/

namespace OMA.SimsLite

universe u v

section NF

variable {G : Type u} [Group G] {H : Type v} [Group H]

/-- The subgroup generated by the entries of a list. -/
def cl (l : List G) : Subgroup G := Subgroup.closure {x | x ∈ l}

lemma cl_def (l : List G) : cl l = Subgroup.closure {x | x ∈ l} := rfl

lemma mem_cl_of_mem {l : List G} {x : G} (h : x ∈ l) : x ∈ cl l := Subgroup.subset_closure h

/-- A normal-form product `l[n-1]^(e (n-1)) * ... * l[0]^(e 0)`. -/
def nf : List G → (ℕ → ℕ) → G
  | [], _ => 1
  | b :: l, e => nf l (fun k => e (k + 1)) * b ^ (e 0)

@[simp] lemma nf_nil (e : ℕ → ℕ) : nf ([] : List G) e = 1 := rfl

@[simp] lemma nf_cons (b : G) (l : List G) (e : ℕ → ℕ) :
    nf (b :: l) e = nf l (fun k => e (k + 1)) * b ^ (e 0) := rfl

lemma nf_map (f : G →* H) : ∀ (l : List G) (e : ℕ → ℕ), f (nf l e) = nf (l.map f) e
  | [], e => by simp
  | b :: l, e => by simp [nf_map f l]

lemma nf_mem : ∀ (l : List G) (e : ℕ → ℕ), nf l e ∈ cl l
  | [], e => by simp [cl]
  | b :: l, e => by
    rw [nf_cons]
    refine mul_mem ?_ (pow_mem (mem_cl_of_mem (by simp)) _)
    exact Subgroup.closure_mono (fun x hx => by simp_all) (nf_mem l _)

lemma nf_congr : ∀ (l : List G) (e e' : ℕ → ℕ), (∀ k < l.length, e k = e' k) →
    nf l e = nf l e'
  | [], e, e', _ => rfl
  | b :: l, e, e', h => by
    rw [nf_cons, nf_cons, nf_congr l _ (fun k => e' (k + 1))
      (fun k hk => h (k + 1) (by simp; omega)), h 0 (by simp)]

lemma cl_drop_mono (l : List G) {a b : ℕ} (h : a ≤ b) : cl (l.drop b) ≤ cl (l.drop a) :=
  Subgroup.closure_mono fun _ hx => (List.drop_sublist_drop_left l h).subset hx

lemma getElem_mem_drop (l : List G) {i j : ℕ} (hij : i ≤ j) (hj : j < l.length) :
    l[j] ∈ l.drop i := by
  rw [List.mem_iff_getElem]
  refine ⟨j - i, by simp; omega, ?_⟩
  simp only [List.getElem_drop]
  congr 1
  omega

/-- Normal forms exist: under the power and normality hypotheses every element of the closure is
a normal-form product with exponents below `p`. -/
theorem nf_surj (p : ℕ) (hp : 0 < p) : ∀ (X : List G),
    (∀ i (hi : i < X.length), X[i] ^ p ∈ cl (X.drop (i + 1))) →
    (∀ i j (hij : i < j) (hj : j < X.length), X[i] * X[j] * X[i]⁻¹ ∈ cl (X.drop (i + 1))) →
    ∀ x ∈ cl X, ∃ e : ℕ → ℕ, (∀ k, e k < p) ∧ x = nf X e
  | [], _, _, x, hx => by
    refine ⟨fun _ => 0, fun _ => hp, ?_⟩
    have : x = 1 := by simpa [cl] using hx
    simp [this]
  | b :: Y, hpow, hnorm, x, hx => by
    have hpowY : ∀ i (hi : i < Y.length), Y[i] ^ p ∈ cl (Y.drop (i + 1)) := fun i hi =>
      hpow (i + 1) (by simp; omega)
    have hnormY : ∀ i j (hij : i < j) (hj : j < Y.length),
        Y[i] * Y[j] * Y[i]⁻¹ ∈ cl (Y.drop (i + 1)) := fun i j hij hj =>
      hnorm (i + 1) (j + 1) (by omega) (by simp; omega)
    have hbp : b ^ p ∈ cl Y := hpow 0 (by simp)
    have hconj : ∀ y ∈ cl Y, b * y * b⁻¹ ∈ cl Y := by
      intro y hy
      have hle : cl Y ≤ (cl Y).comap (MulAut.conj b).toMonoidHom := by
        rw [cl_def Y, Subgroup.closure_le]
        intro z hz
        obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem hz
        exact hnorm 0 (j + 1) (by omega) (by simp; omega)
      simpa using hle hy
    have hconjm : ∀ m : ℕ, ∀ y ∈ cl Y, b ^ m * y * (b ^ m)⁻¹ ∈ cl Y := by
      intro m
      induction m with
      | zero => intro y hy; simpa using hy
      | succ m ih =>
        intro y hy
        have := hconj _ (ih y hy)
        convert this using 1
        group
    have key : ∀ z ∈ cl (b :: Y), ∃ y ∈ cl Y, ∃ k : ℕ, z = y * b ^ k := by
      intro z hz
      rw [cl_def] at hz
      induction hz using Subgroup.closure_induction_left with
      | one => exact ⟨1, one_mem _, 0, by simp⟩
      | mul_left g hg z hz ih =>
        obtain ⟨y, hy, k, rfl⟩ := ih
        simp only [Set.mem_ofPred_eq, List.mem_cons] at hg
        rcases hg with rfl | hg
        · exact ⟨g * y * g⁻¹, hconj y hy, k + 1, by group⟩
        · exact ⟨g * y, mul_mem (mem_cl_of_mem hg) hy, k, by group⟩
      | inv_mul_cancel g hg z hz ih =>
        obtain ⟨y, hy, k, rfl⟩ := ih
        simp only [Set.mem_ofPred_eq, List.mem_cons] at hg
        rcases hg with rfl | hg
        · obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
          refine ⟨g ^ q * ((g ^ (q + 1))⁻¹ * y) * (g ^ q)⁻¹,
            hconjm q _ (mul_mem (inv_mem hbp) hy), q + k, ?_⟩
          group
        · exact ⟨g⁻¹ * y, mul_mem (inv_mem (mem_cl_of_mem hg)) hy, k, by group⟩
    obtain ⟨y, hy, k, rfl⟩ := key x hx
    have hy' : y * (b ^ p) ^ (k / p) ∈ cl Y := mul_mem hy (pow_mem hbp _)
    obtain ⟨e', he'p, he'⟩ := nf_surj p hp Y hpowY hnormY _ hy'
    refine ⟨fun i => Nat.casesOn i (k % p) e', ?_, ?_⟩
    · intro i
      cases i with
      | zero => exact Nat.mod_lt _ hp
      | succ i => exact he'p i
    · show y * b ^ k = nf Y e' * b ^ (k % p)
      rw [← he', mul_assoc, ← pow_mul, ← pow_add, Nat.div_add_mod]

end NF

section Suffix

variable {G : Type u} [Group G]

lemma suffix_hyps (p : ℕ) (l : List G)
    (h2 : ∀ i (hi : i < l.length), l[i] ^ p ∈ cl (l.drop (i + 1)))
    (h3 : ∀ (g : G) j (hj : j < l.length), g * l[j] * g⁻¹ * l[j]⁻¹ ∈ cl (l.drop (j + 1)))
    (m : ℕ) :
    (∀ i (hi : i < (l.drop m).length), (l.drop m)[i] ^ p ∈ cl ((l.drop m).drop (i + 1))) ∧
    (∀ i j (hij : i < j) (hj : j < (l.drop m).length),
      (l.drop m)[i] * (l.drop m)[j] * ((l.drop m)[i])⁻¹ ∈ cl ((l.drop m).drop (i + 1))) := by
  have hdd : ∀ i, (l.drop m).drop (i + 1) = l.drop (m + i + 1) := by
    intro i
    rw [List.drop_drop]
    congr 1
  constructor
  · intro i hi
    have hi' : m + i < l.length := by simp at hi; omega
    rw [hdd, List.getElem_drop]
    exact h2 (m + i) hi'
  · intro i j hij hj
    have hj' : m + j < l.length := by simp at hj; omega
    rw [hdd, List.getElem_drop, List.getElem_drop]
    have h := h3 (l[m + i]'(by omega)) (m + j) hj'
    have e : l[m + i] * l[m + j] * (l[m + i])⁻¹ =
        (l[m + i] * l[m + j] * (l[m + i])⁻¹ * (l[m + j])⁻¹) * l[m + j] := by group
    rw [e]
    exact mul_mem (cl_drop_mono l (by omega) h)
      (mem_cl_of_mem (getElem_mem_drop l (by omega) hj'))

lemma cl_append_comap {Q : Type v} [Group Q] (f : G →* Q) (z : G) (hker : f.ker = zpowers z)
    (A : List G) : cl (A ++ [z]) = (cl (A.map f)).comap f := by
  have e1 : {x | x ∈ A ++ [z]} = {x | x ∈ A} ∪ {z} := by
    ext x
    simp [or_comm]
  have e2 : {x | x ∈ A.map f} = f '' {x | x ∈ A} := by
    ext x
    simp
  rw [cl_def, cl_def, e1, e2, Subgroup.closure_union, ← Subgroup.zpowers_eq_closure, ← MonoidHom.map_closure,
    Subgroup.comap_map_eq, hker]

end Suffix

end OMA.SimsLite
