import Mathlib
import H2Dev.Frame

/-! Li-Qiao Section 4 and Lemma 6.1 in the class-3 case: counting the leading commutator
coefficients through the graded brackets `L_1 × L_1 → L_2` and `L_2 × L_1 → L_3`.

Abstract layer (commutative groups written multiplicatively, brackets as `L →* L' →* L''`):
* `br_lemma41` : Lemma 4.1(i) (two class-3 brackets agreeing on `L_1 × C` and `L_2 × C`, with
  `L_2` generated by `[C, C]`, agree on `L_2 × L_1`), via the Jacobi identity;
* `br_card_homs_le`, `br_prop42_crude`, `br_prop42_restrict` : Proposition 4.2 at `i = 2` with
  the crude subgroup bound (an image of order `≤ p ^ b` is generated by `b` elements): at most
  `p ^ (s * (b * (r_2 + s_3)))` core bracket maps `L_2 × C_core → L_3` of breadth `≤ b`;
* `br_jacobi_kernel` : eq. (52), the Jacobi constraint `ad(h)[x, y]` fixed by the core values;
* `br_prop43_gen`, `br_prop43` : Proposition 4.3 and the first alternative of Remark 4.4
  (prescribed defining values on a set `D` of core pairs), for any index set of generators with
  a core/outside split of the generator pairs; `br_prop43_fin` is the paper's form
  `((r_1 choose 2) - |D|) s_2 - (r_1 - s choose 2) b_2` for generators `Fin r_1` with core the first
  `s`; `br_eq53` is the class-3 case of (53), Props 4.2 and 4.3 combined through Lemma 4.1;
* `br_rem44_lift` : the second alternative of Remark 4.4 (lifts of a reduction mod `p`);
* `br_card_subgroups_le` : Lemma 2.7(iii), at most `p ^ (b (e - b + 1))` subgroups of order
  `p ^ b` in a commutative group of order `p ^ e`; `br_card_homs_le_sharp`, `br_prop42` : the
  sharp Proposition 4.2 at `i = 2`, at most `p ^ (s b (r_2 + s_3 - b + 1))` core slice families;
* `brBreadth` : the breadth (48); `brBreadth_spec`, `br_card_range_le_breadth`,
  `brBreadth_le_s2`, `brBreadth_le_s3`, `br_s3_le_breadth` (eq. (51), `s_3 ≤ s b_2`) and
  `br_breadth_range`; `br_eq53_breadth` (fixed `b_2`) and `br_eq53_sum` (summed over the
  admissible `b_2` with `s_3 ≤ s b_2`, `b_2 ≤ min(s_2, s_3)`);
* `br_deeper_count`, `br_deeper_count_fin` : the deeper coefficients on the non-defining pairs,
  at most `p ^ (((r_1 choose 2) - r_2) m_3)`;
* `br_finite_hom_of_gen`, `br_bracket_set_finite` : finiteness of the counted bracket sets;
* `br_lemma61` : Lemma 6.1, `log_p |p L_2| ≤ (δ choose 2)` where `|p L_1| = p ^ δ`;
* `br_card_le_of_exp`, `br_s2_le` : the bound `s_2 ≤ r_2 (δ + 1)` of (126).

Group layer (any group `G`; no class hypothesis is needed since the brackets land in the
sections `γ_2/γ_3` and `γ_3/γ_4`):
* `brL2 G = γ_2 / γ_3` and `brL3 G = γ_3 / γ_4` as commutative groups, `L_1 = Abelianization G`;
* `brB1 G`, `brB2 G` : the commutator brackets, `brB1_of`, `brB2_mk_of`;
* `brB1_alt`, `brB1_closure`, `brB_jacobi` (the Jacobi identity from the Hall-Witt identity);
* `br_lemma61_group` : `|γ_2| ≤ |γ_3| p ^ (r_2 + (λ choose 2))`, i.e. `e = m_2 - m_3 - r_2 ≤ (λ choose 2)`;
* `br_s2_le_group` : `|γ_2| ≤ |γ_3| p ^ (r_2 (λ + 1))`, i.e. `m_2 - m_3 ≤ r_2 (λ + 1)`;
* `brT1`, `brT2` : the brackets transported to fixed layers along identifications
  `G^ab ≃ L_1`, `γ_2/γ_3 ≃ L_2`, `γ_3/γ_4 ≃ L_3`, with `brT1_alt`, `brT_jacobi`, `brT1_closure`,
  the leading-coefficient formulas `brT1_of`, `brT2_of`, and `brT1_coeff_eq`, `brT2_coeff_eq`
  (equal transported brackets give equal transported leading commutators). -/

namespace OMA.SimsLite

open scoped commutatorElement

universe u

section BrCount

/-! ### Counting helpers -/

/-- Fibre counting: `|S| ≤ |β| · M` when every fibre of `f` on `S` has at most `M` elements. -/
theorem br_ncard_le_mul {α β : Type*} [Finite β] (S : Set α) (f : α → β) (M : ℕ)
    (hM : ∀ b, (S ∩ f ⁻¹' {b}).ncard ≤ M) : S.ncard ≤ Nat.card β * M := by
  classical
  have := Fintype.ofFinite β
  rcases S.finite_or_infinite with hS | hS
  · rw [Set.ncard_eq_toFinset_card S hS,
      Finset.card_eq_sum_card_fiberwise (f := f) (t := Finset.univ) (by intro x _; simp)]
    calc ∑ b : β, (hS.toFinset.filter (fun a => f a = b)).card ≤ ∑ _b : β, M := by
          refine Finset.sum_le_sum fun b _ => ?_
          have h1 : ((hS.toFinset.filter (fun a => f a = b) : Finset α) : Set α) =
              S ∩ f ⁻¹' {b} := by
            ext a
            simp
          rw [← Set.ncard_coe_finset, h1]
          exact hM b
      _ = Nat.card β * M := by simp
  · rw [hS.ncard]
    exact Nat.zero_le _

/-- Fibre counting over the image: `|S| ≤ |f(S)| · M`. -/
theorem br_ncard_le_image_mul {α β : Type*} (S : Set α) (f : α → β) (M : ℕ)
    (hM : ∀ b, (S ∩ f ⁻¹' {b}).ncard ≤ M) : S.ncard ≤ (f '' S).ncard * M := by
  classical
  rcases S.finite_or_infinite with hS | hS
  · rw [Set.ncard_eq_toFinset_card S hS, Finset.card_eq_sum_card_image f hS.toFinset]
    have himg : (f '' S).ncard = (hS.toFinset.image f).card := by
      rw [← Set.ncard_coe_finset, Finset.coe_image, Set.Finite.coe_toFinset]
    rw [himg]
    calc ∑ b ∈ hS.toFinset.image f, (hS.toFinset.filter (fun a => f a = b)).card
        ≤ ∑ _b ∈ hS.toFinset.image f, M := by
          refine Finset.sum_le_sum fun b _ => ?_
          have h1 : ((hS.toFinset.filter (fun a => f a = b) : Finset α) : Set α) =
              S ∩ f ⁻¹' {b} := by
            ext a
            simp
          rw [← Set.ncard_coe_finset, h1]
          exact hM b
      _ = (hS.toFinset.image f).card * M := by simp
  · rw [hS.ncard]
    exact Nat.zero_le _

/-- Injective data in a finite type. -/
theorem br_ncard_le_card_of_injOn {α β : Type*} [Finite β] (S : Set α) (f : α → β)
    (hf : Set.InjOn f S) : S.ncard ≤ Nat.card β := by
  have h := Set.ncard_le_ncard_of_injOn (t := (Set.univ : Set β)) f
    (fun _ _ => Set.mem_univ _) hf
  rwa [Set.ncard_univ] at h

lemma br_pow_le_cancel {p a b : ℕ} (hp : 1 < p) (h : p ^ a ≤ p ^ b) : a ≤ b := by
  by_contra hc
  push_neg at hc
  have h1 : p ^ (b + 1) ≤ p ^ a := Nat.pow_le_pow_right (by omega) hc
  have h2 : 0 < p ^ b := Nat.pos_of_ne_zero (pow_ne_zero _ (by omega))
  rw [pow_succ] at h1
  nlinarith

/-- Two distinct divisors of `p ^ n`, one dividing the other, differ by a factor `≥ p`. -/
lemma br_pmul_le_of_dvd {p n a c : ℕ} (hp : p.Prime) (ha : a ∣ p ^ n) (hc : c ∣ p ^ n)
    (hac : a ∣ c) (hne : a ≠ c) : p * a ≤ c := by
  obtain ⟨i, -, rfl⟩ := (Nat.dvd_prime_pow hp).1 ha
  obtain ⟨j, -, rfl⟩ := (Nat.dvd_prime_pow hp).1 hc
  have hij : i ≤ j := (Nat.pow_dvd_pow_iff_le_right hp.one_lt).1 hac
  have hij' : i ≠ j := fun h => hne (by rw [h])
  rw [← pow_succ']
  exact Nat.pow_le_pow_right hp.pos (by omega)

/-- `|ker f| ≤ p ^ (s - b)` when `|M| = p ^ s` and `|im f| ≥ p ^ b`. -/
theorem br_card_ker_le {M N : Type*} [Group M] [Group N] [Finite M] {p s b : ℕ} (hp : p.Prime)
    (f : M →* N) (hM : Nat.card M = p ^ s) (hb : p ^ b ≤ Nat.card f.range) :
    Nat.card f.ker ≤ p ^ (s - b) := by
  have h1 : Nat.card f.ker * Nat.card f.range = p ^ s := by
    have e := Nat.card_congr (QuotientGroup.quotientKerEquivRange f).toEquiv
    rw [← e, ← hM]
    exact Subgroup.card_mul_index f.ker
  obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow hp).1 (⟨_, h1.symm⟩ : Nat.card f.ker ∣ p ^ s)
  obtain ⟨j, -, hj⟩ := (Nat.dvd_prime_pow hp).1
    (⟨Nat.card f.ker, by rw [mul_comm]; exact h1.symm⟩ : Nat.card f.range ∣ p ^ s)
  rw [hk, hj, ← pow_add] at h1
  have hkj : k + j = s := Nat.pow_right_injective hp.two_le h1
  rw [hj] at hb
  have hbj : b ≤ j := br_pow_le_cancel hp.one_lt hb
  rw [hk]
  exact Nat.pow_le_pow_right hp.pos (by omega)

end BrCount

section BrSub

/-! ### Subgroups of finite abelian `p`-groups -/

variable {L : Type*} [CommGroup L]

/-- `|H ⊔ K| ≤ |H| |K|` in a commutative group. -/
theorem br_card_sup_le [Finite L] (H K : Subgroup L) :
    Nat.card ↥(H ⊔ K) ≤ Nat.card H * Nat.card K := by
  rw [← Nat.card_prod]
  refine Nat.card_le_card_of_surjective
    (fun q : H × K => (⟨(q.1 : L) * q.2, Subgroup.mul_mem_sup q.1.2 q.2.2⟩ : ↥(H ⊔ K))) ?_
  rintro ⟨x, hx⟩
  obtain ⟨y, hy, z, hz, rfl⟩ := Subgroup.mem_sup.mp hx
  exact ⟨(⟨y, hy⟩, ⟨z, hz⟩), rfl⟩

/-- Greedy generation: a subgroup `H` with `|H| ≤ p ^ k |⟨T⟩|` is generated by `T` and `k`
further elements. -/
theorem br_exists_finset_closure_eq [Finite L] {p n : ℕ} (hp : p.Prime)
    (hL : Nat.card L = p ^ n) (H : Subgroup L) :
    ∀ (k : ℕ) (T : Finset L), Subgroup.closure (T : Set L) ≤ H →
      Nat.card H ≤ p ^ k * Nat.card (Subgroup.closure (T : Set L)) →
      ∃ T' : Finset L, T'.card ≤ T.card + k ∧ Subgroup.closure (T' : Set L) = H := by
  classical
  intro k
  induction k with
  | zero =>
    intro T hT hc
    rw [pow_zero, one_mul] at hc
    exact ⟨T, by omega, Subgroup.eq_of_le_of_card_ge hT hc⟩
  | succ k ih =>
    intro T hT hc
    by_cases heq : Subgroup.closure (T : Set L) = H
    · exact ⟨T, by omega, heq⟩
    · have hx : ∃ x ∈ H, x ∉ Subgroup.closure (T : Set L) := by
        by_contra hne
        push_neg at hne
        exact heq (le_antisymm hT hne)
      obtain ⟨x, hxH, hxT⟩ := hx
      have hT1 : Subgroup.closure ((insert x T : Finset L) : Set L) ≤ H := by
        rw [Subgroup.closure_le, Finset.coe_insert]
        intro y hy
        rcases hy with rfl | hy
        · exact hxH
        · exact hT (Subgroup.subset_closure hy)
      have hle : Subgroup.closure (T : Set L) ≤
          Subgroup.closure ((insert x T : Finset L) : Set L) :=
        Subgroup.closure_mono (by rw [Finset.coe_insert]; exact Set.subset_insert _ _)
      have hne : Nat.card (Subgroup.closure (T : Set L)) ≠
          Nat.card (Subgroup.closure ((insert x T : Finset L) : Set L)) := by
        intro h
        have h' := Subgroup.eq_of_le_of_card_ge hle h.symm.le
        apply hxT
        rw [h']
        exact Subgroup.subset_closure (by rw [Finset.coe_insert]; exact Set.mem_insert _ _)
      have hp1 : p * Nat.card (Subgroup.closure (T : Set L)) ≤
          Nat.card (Subgroup.closure ((insert x T : Finset L) : Set L)) :=
        br_pmul_le_of_dvd hp (by rw [← hL]; exact Subgroup.card_subgroup_dvd_card _)
          (by rw [← hL]; exact Subgroup.card_subgroup_dvd_card _)
          (Subgroup.card_dvd_of_le hle) hne
      obtain ⟨T', hT'c, hT'⟩ := ih (insert x T) hT1 (by
        calc Nat.card H ≤ p ^ (k + 1) * Nat.card (Subgroup.closure (T : Set L)) := hc
          _ = p ^ k * (p * Nat.card (Subgroup.closure (T : Set L))) := by ring
          _ ≤ p ^ k * Nat.card (Subgroup.closure ((insert x T : Finset L) : Set L)) :=
            Nat.mul_le_mul_left _ hp1)
      refine ⟨T', ?_, hT'⟩
      have := Finset.card_insert_le x T
      omega

/-- A subgroup of order `≤ p ^ b` of a finite `p`-group is generated by `b` elements. -/
theorem br_exists_tuple_closure_eq [Finite L] {p n b : ℕ} (hp : p.Prime)
    (hL : Nat.card L = p ^ n) (H : Subgroup L) (hH : Nat.card H ≤ p ^ b) :
    ∃ a : Fin b → L, Subgroup.closure (Set.range a) = H := by
  classical
  obtain ⟨T, hTc, hT⟩ := br_exists_finset_closure_eq hp hL H b ∅ (by simp) (by simpa using hH)
  have hTb : T.card ≤ b := by simpa using hTc
  let e := T.equivFin
  refine ⟨fun i => if h : i.val < T.card then (e.symm ⟨i.val, h⟩ : L) else 1, ?_⟩
  rw [← hT]
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    dsimp only
    split_ifs with h
    · exact Subgroup.subset_closure (Finset.mem_coe.2 (e.symm ⟨i.val, h⟩).2)
    · exact Subgroup.one_mem _
  · apply Subgroup.closure_mono
    intro x hx
    have hk := (e ⟨x, hx⟩).2
    refine ⟨⟨(e ⟨x, hx⟩).val, lt_of_lt_of_le hk hTb⟩, ?_⟩
    dsimp only
    rw [dif_pos hk]
    simp

end BrSub

section BrSubCount

/-! ### Lemma 2.7(iii): counting subgroups of order `p ^ b` -/

lemma br_ncard_subgroups_one {L : Type*} [Group L] [Finite L] :
    {H : Subgroup L | Nat.card H = 1}.ncard ≤ 1 := by
  have hsub : {H : Subgroup L | Nat.card H = 1} ⊆ {⊥} := by
    intro H hH
    exact Subgroup.eq_bot_of_card_eq H hH
  calc _ ≤ ({⊥} : Set (Subgroup L)).ncard := Set.ncard_le_ncard hsub (Set.finite_singleton _)
    _ = 1 := Set.ncard_singleton _

lemma br_ncard_subgroups_big {L : Type*} [Group L] [Finite L] {p e b : ℕ} (hp : p.Prime)
    (hL : Nat.card L = p ^ e) (hb : e < b) : {H : Subgroup L | Nat.card H = p ^ b}.ncard = 0 := by
  have he : {H : Subgroup L | Nat.card H = p ^ b} = ∅ := by
    ext H
    simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
    intro hH
    have h := Subgroup.card_subgroup_dvd_card H
    rw [hH, hL] at h
    have := (Nat.pow_dvd_pow_iff_le_right hp.one_lt).1 h
    omega
  rw [he, Set.ncard_empty]

/-- Lemma 2.7(iii) ([BNV07, Lemma 20.15]): a commutative group of order `p ^ e` has at most
`p ^ (b (e - b + 1))` subgroups of order `p ^ b`. Proof by induction on `e` through a maximal
subgroup `M`: the subgroups inside `M` are counted by induction, and a subgroup `H ⊄ M` is
determined by `M ⊓ H` (of order `p ^ (b - 1)`) and the coset `t⁻¹ (H ∩ t M)` in `M / (M ⊓ H)`. -/
theorem br_card_subgroups_le {p : ℕ} (hp : p.Prime) (e : ℕ) :
    ∀ (L : Type u) [CommGroup L] [Finite L], Nat.card L = p ^ e → ∀ b : ℕ,
      {H : Subgroup L | Nat.card H = p ^ b}.ncard ≤ p ^ (b * (e + 1 - b)) := by
  haveI := Fact.mk hp
  induction e with
  | zero =>
    intro L _ _ hL b
    rcases Nat.eq_zero_or_pos b with rfl | hb
    · simpa using br_ncard_subgroups_one (L := L)
    · rw [br_ncard_subgroups_big hp hL hb]
      exact Nat.zero_le _
  | succ e ih =>
    intro L _ _ hL b
    rcases Nat.eq_zero_or_pos b with rfl | hb0
    · simpa using br_ncard_subgroups_one (L := L)
    rcases Nat.lt_or_ge (e + 1) b with hbe | hbe
    · rw [br_ncard_subgroups_big hp hL hbe]
      exact Nat.zero_le _
    obtain ⟨c, rfl⟩ : ∃ c, b = c + 1 := ⟨b - 1, by omega⟩
    obtain ⟨d, rfl⟩ : ∃ d, e = c + d := ⟨e - c, by omega⟩
    classical
    haveI : Finite (Subgroup L) :=
      Finite.of_injective (fun H : Subgroup L => (H : Set L)) SetLike.coe_injective
    obtain ⟨M, hM⟩ := Sylow.exists_subgroup_card_pow_prime p
      (show p ^ (c + d) ∣ Nat.card L by rw [hL]; exact pow_dvd_pow p (Nat.le_succ _))
    haveI : Finite (Subgroup M) :=
      Finite.of_injective (fun H : Subgroup M => (H : Set M)) SetLike.coe_injective
    have hMi : M.index = p := by
      have h := Subgroup.card_mul_index M
      rw [hM, hL, pow_succ] at h
      exact Nat.eq_of_mul_eq_mul_left (pow_pos hp.pos _) h
    have hMtop : M ≠ ⊤ := by
      intro h
      rw [h, Subgroup.index_top] at hMi
      exact hp.one_lt.ne hMi
    obtain ⟨t, htM⟩ : ∃ t, t ∉ M := by
      by_contra hne
      push_neg at hne
      exact hMtop (eq_top_iff.2 fun x _ => hne x)
    set S1 := {H : Subgroup L | Nat.card H = p ^ (c + 1) ∧ H ≤ M} with hS1
    set S2 := {H : Subgroup L | Nat.card H = p ^ (c + 1) ∧ ¬ H ≤ M} with hS2
    have hsplit : {H : Subgroup L | Nat.card H = p ^ (c + 1)} = S1 ∪ S2 := by
      ext H
      simp only [hS1, hS2, Set.mem_union, Set.mem_setOf_eq]
      tauto
    -- subgroups inside `M`
    have h1 : S1.ncard ≤ p ^ ((c + 1) * (c + d + 1 - (c + 1))) := by
      refine le_trans ?_ (ih M hM (c + 1))
      refine Set.ncard_le_ncard_of_injOn (fun H => H.subgroupOf M) ?_ ?_ (Set.toFinite _)
      · rintro H ⟨hH, hHM⟩
        show Nat.card (H.subgroupOf M) = p ^ (c + 1)
        rw [← hH]
        exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hHM).toEquiv
      · rintro H ⟨-, hHM⟩ H' ⟨-, hH'M⟩ he
        have := Subgroup.subgroupOf_inj.1 he
        rwa [inf_of_le_left hHM, inf_of_le_left hH'M] at this
    -- subgroups not inside `M`
    have hS2card : ∀ H ∈ S2, Nat.card ↥(M ⊓ H) = p ^ c := by
      rintro H ⟨hH, hHM⟩
      have hdvd : M.relIndex H ∣ p := hMi ▸ Subgroup.relIndex_dvd_index_of_normal (H := M) (K := H)
      have hne : M.relIndex H ≠ 1 := fun h1 => hHM (Subgroup.relIndex_eq_one.1 h1)
      have hrel : M.relIndex H = p := ((Nat.dvd_prime hp).1 hdvd).resolve_left hne
      have hc1 := Subgroup.card_mul_index (M ⊓ H)
      have hc2 := Subgroup.relIndex_mul_index (inf_le_right : M ⊓ H ≤ H)
      rw [Subgroup.inf_relIndex_right (H := M) (K := H), hrel] at hc2
      have hc3 := Subgroup.card_mul_index H
      rw [hH] at hc3
      rw [← hc2, hL] at hc1
      have hi : H.index ≠ 0 := Subgroup.index_ne_zero_of_finite
      have e1 : (Nat.card ↥(M ⊓ H) * p) * H.index = (p ^ c * p) * H.index := by
        rw [← pow_succ, hc3, hL, ← hc1]
        ring
      have e2 := Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero hi) e1
      exact Nat.eq_of_mul_eq_mul_right hp.pos e2
    have hex : ∀ H ∈ S2, ∃ y, y ∈ H ∧ t⁻¹ * y ∈ M := by
      rintro H ⟨hH, hHM⟩
      have hle : M ≤ H ⊔ M := le_sup_right
      have hne : M ≠ H ⊔ M := fun h => hHM (le_sup_left.trans h.symm.le)
      have hcne : Nat.card M ≠ Nat.card ↥(H ⊔ M) := fun h =>
        hne (Subgroup.eq_of_le_of_card_ge hle h.symm.le)
      have hp1 := br_pmul_le_of_dvd hp (n := c + d + 1)
        (by rw [← hL]; exact Subgroup.card_subgroup_dvd_card _)
        (by rw [← hL]; exact Subgroup.card_subgroup_dvd_card _) (Subgroup.card_dvd_of_le hle) hcne
      have htop : H ⊔ M = ⊤ := by
        refine Subgroup.eq_of_le_of_card_ge le_top ?_
        rw [Subgroup.card_top, hL, pow_succ, ← hM, mul_comm]
        exact hp1
      have ht : t ∈ H ⊔ M := by
        rw [htop]
        exact Subgroup.mem_top t
      obtain ⟨y, hy, z, hz, hyz⟩ := Subgroup.mem_sup.1 ht
      refine ⟨y, hy, ?_⟩
      have e : t⁻¹ * y = z⁻¹ := by
        rw [← hyz]
        group
      rw [e]
      exact inv_mem hz
    let ch : Subgroup L → L := fun H => Classical.epsilon (fun y => y ∈ H ∧ t⁻¹ * y ∈ M)
    have hch : ∀ H ∈ S2, ch H ∈ H ∧ t⁻¹ * ch H ∈ M := fun H hH =>
      Classical.epsilon_spec (hex H hH)
    let f : Subgroup L → Subgroup M := fun H => (M ⊓ H).subgroupOf M
    have hfib : ∀ a : Subgroup M, (S2 ∩ f ⁻¹' {a}).ncard ≤ p ^ d := by
      intro a
      rcases (S2 ∩ f ⁻¹' {a}).eq_empty_or_nonempty with he | ⟨H0, hH0, hH0a⟩
      · rw [he, Set.ncard_empty]
        exact Nat.zero_le _
      obtain ⟨K, hK⟩ : ∃ K : Subgroup L, K = M ⊓ H0 := ⟨_, rfl⟩
      have hKc : Nat.card K = p ^ c := by
        rw [hK]
        exact hS2card H0 hH0
      have hKM : K ≤ M := by
        rw [hK]
        exact inf_le_left
      have hfK : ∀ H ∈ S2 ∩ f ⁻¹' {a}, M ⊓ H = K := by
        rintro H ⟨-, hHa⟩
        have e : f H = f H0 := (show f H = a from hHa).trans (show f H0 = a from hH0a).symm
        have e2 := Subgroup.subgroupOf_inj.1 e
        rw [inf_of_le_left inf_le_left, inf_of_le_left inf_le_left] at e2
        rw [hK]
        exact e2
      have hmap : Nat.card ↥(M.map (QuotientGroup.mk' K)) = p ^ d := by
        have e := Subgroup.relIndex_ker (K := M) (f := QuotientGroup.mk' K)
        rw [QuotientGroup.ker_mk'] at e
        have hc2 := Subgroup.relIndex_mul_index hKM
        rw [e, hMi] at hc2
        have hc1 := Subgroup.card_mul_index K
        rw [hKc, ← hc2, hL] at hc1
        have h3 : p ^ c * (Nat.card ↥(M.map (QuotientGroup.mk' K)) * p) = p ^ c * (p ^ d * p) := by
          rw [hc1]
          ring
        exact Nat.eq_of_mul_eq_mul_right hp.pos (Nat.eq_of_mul_eq_mul_left (pow_pos hp.pos c) h3)
      let Φ : Subgroup L → L ⧸ K := fun H => ((t⁻¹ * ch H : L) : L ⧸ K)
      have hmaps : ∀ H ∈ S2 ∩ f ⁻¹' {a},
          Φ H ∈ ((M.map (QuotientGroup.mk' K) : Subgroup (L ⧸ K)) : Set (L ⧸ K)) := by
        intro H hH
        exact Subgroup.mem_map.2 ⟨t⁻¹ * ch H, (hch H hH.1).2, rfl⟩
      have hinj : Set.InjOn Φ (S2 ∩ f ⁻¹' {a}) := by
        intro H hH H' hH' hΦ
        obtain ⟨hy1, -⟩ := hch H hH.1
        obtain ⟨hy1', hy2'⟩ := hch H' hH'.1
        have hcardH : Nat.card H = p ^ (c + 1) := hH.1.1
        have hcardH' : Nat.card H' = p ^ (c + 1) := hH'.1.1
        have hKH : K ≤ H := by
          rw [← hfK H hH]
          exact inf_le_right
        have hKH' : K ≤ H' := by
          rw [← hfK H' hH']
          exact inf_le_right
        have hq : (ch H)⁻¹ * ch H' ∈ K := by
          have h0 := QuotientGroup.eq.1 hΦ
          have e : (t⁻¹ * ch H)⁻¹ * (t⁻¹ * ch H') = (ch H)⁻¹ * ch H' := by group
          rwa [e] at h0
        have hcH : ch H' ∈ H := by
          have e : ch H' = ch H * ((ch H)⁻¹ * ch H') := by group
          rw [e]
          exact mul_mem hy1 (hKH hq)
        have hnotK : ch H' ∉ K := by
          intro hc
          have hcM : ch H' ∈ M := hKM hc
          apply htM
          have e : t = ch H' * (t⁻¹ * ch H')⁻¹ := by group
          rw [e]
          exact mul_mem hcM (inv_mem hy2')
        obtain ⟨J, hJ⟩ : ∃ J : Subgroup L, J = K ⊔ Subgroup.zpowers (ch H') := ⟨_, rfl⟩
        have hJH : J ≤ H := by
          rw [hJ]
          exact sup_le hKH (Subgroup.zpowers_le.2 hcH)
        have hJH' : J ≤ H' := by
          rw [hJ]
          exact sup_le hKH' (Subgroup.zpowers_le.2 hy1')
        have hKJ : K ≤ J := by
          rw [hJ]
          exact le_sup_left
        have hKne : Nat.card K ≠ Nat.card J := by
          intro h
          have h' := Subgroup.eq_of_le_of_card_ge hKJ h.symm.le
          apply hnotK
          rw [h', hJ]
          exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _)
        have hpJ := br_pmul_le_of_dvd hp (n := c + d + 1)
          (by rw [← hL]; exact Subgroup.card_subgroup_dvd_card _)
          (by rw [← hL]; exact Subgroup.card_subgroup_dvd_card _) (Subgroup.card_dvd_of_le hKJ) hKne
        have hJeq : J = H' := by
          refine Subgroup.eq_of_le_of_card_ge hJH' ?_
          rw [hcardH', pow_succ, ← hKc, mul_comm]
          exact hpJ
        have hH'H : H' ≤ H := by
          rw [← hJeq]
          exact hJH
        exact (Subgroup.eq_of_le_of_card_ge hH'H (by rw [hcardH, hcardH'])).symm
      calc (S2 ∩ f ⁻¹' {a}).ncard
          ≤ ((M.map (QuotientGroup.mk' K) : Subgroup (L ⧸ K)) : Set (L ⧸ K)).ncard :=
            Set.ncard_le_ncard_of_injOn Φ hmaps hinj (Set.toFinite _)
        _ = p ^ d := by rw [← Nat.card_coe_set_eq]; exact hmap
    have himg : (f '' S2).ncard ≤ p ^ (c * (c + d + 1 - c)) := by
      refine le_trans (Set.ncard_le_ncard ?_ (Set.toFinite _)) (ih M hM c)
      rintro _ ⟨H, hH, rfl⟩
      show Nat.card ((M ⊓ H).subgroupOf M) = p ^ c
      rw [← hS2card H hH]
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe inf_le_left).toEquiv
    have h2 : S2.ncard ≤ (f '' S2).ncard * p ^ d := br_ncard_le_image_mul S2 f _ hfib
    have e1 : c + d + 1 - (c + 1) = d := by omega
    have e2 : c + d + 1 - c = d + 1 := by omega
    have e3 : c + d + 1 + 1 - (c + 1) = d + 1 := by omega
    rw [e1] at h1
    rw [e2] at himg
    rw [e3, hsplit]
    calc (S1 ∪ S2).ncard ≤ S1.ncard + S2.ncard := Set.ncard_union_le _ _
      _ ≤ p ^ ((c + 1) * d) + p ^ (c * (d + 1)) * p ^ d :=
          Nat.add_le_add h1 (h2.trans (Nat.mul_le_mul_right _ himg))
      _ ≤ p ^ (c * d + c + d) + p ^ (c * d + c + d) := by
          refine Nat.add_le_add (Nat.pow_le_pow_right hp.pos ?_) (le_of_eq ?_)
          · rw [add_mul, one_mul]
            omega
          · rw [← pow_add]
            congr 1 <;> ring
      _ = 2 * p ^ (c * d + c + d) := by ring
      _ ≤ p * p ^ (c * d + c + d) := Nat.mul_le_mul_right _ hp.two_le
      _ = p ^ ((c + 1) * (d + 1)) := by
          rw [← pow_succ']
          congr 1
          ring

end BrSubCount

section BrProp42

/-! ### Proposition 4.2 at `i = 2`, crude subgroup bound -/

variable {L1 L2 L3 : Type*} [CommGroup L1] [CommGroup L2] [CommGroup L3]

/-- Homomorphisms `L_2 → L_3` with image of order `≤ p ^ b`, where `L_2` is generated by `n`
elements and `|L_3| = p ^ s_3`: at most `p ^ (b (n + s_3))`. -/
theorem br_card_homs_le [Finite L2] [Finite L3] {p s3 n b : ℕ} (hp : p.Prime)
    (hL3 : Nat.card L3 = p ^ s3) (y : Fin n → L2) (hy : Subgroup.closure (Set.range y) = ⊤) :
    {φ : L2 →* L3 | Nat.card φ.range ≤ p ^ b}.ncard ≤ p ^ (b * (n + s3)) := by
  classical
  set S := {φ : L2 →* L3 | Nat.card φ.range ≤ p ^ b} with hSdef
  let f : (L2 →* L3) → (Fin b → L3) := fun φ =>
    Classical.epsilon (fun a : Fin b → L3 => Subgroup.closure (Set.range a) = φ.range)
  have hf : ∀ φ ∈ S, Subgroup.closure (Set.range (f φ)) = φ.range := fun φ hφ =>
    Classical.epsilon_spec (br_exists_tuple_closure_eq hp hL3 φ.range hφ)
  have hM : ∀ a : Fin b → L3, (S ∩ f ⁻¹' {a}).ncard ≤ (p ^ b) ^ n := by
    intro a
    rcases (S ∩ f ⁻¹' {a}).eq_empty_or_nonempty with he | ⟨φ0, hφ0S, hφ0a⟩
    · rw [he, Set.ncard_empty]
      exact Nat.zero_le _
    · have hφ0a' : f φ0 = a := hφ0a
      have hcl : Subgroup.closure (Set.range a) = φ0.range := by
        rw [← hφ0a', hf φ0 hφ0S]
      have hmem : ∀ φ ∈ S ∩ f ⁻¹' {a}, ∀ i, φ (y i) ∈ Subgroup.closure (Set.range a) := by
        rintro φ ⟨hφS, hφa⟩ i
        have hφa' : f φ = a := hφa
        rw [← hφa', hf φ hφS]
        exact ⟨y i, rfl⟩
      let F : (L2 →* L3) → (Fin n → Subgroup.closure (Set.range a)) := fun φ i =>
        if h : φ (y i) ∈ Subgroup.closure (Set.range a) then ⟨φ (y i), h⟩ else 1
      have hinj : Set.InjOn F (S ∩ f ⁻¹' {a}) := by
        intro φ hφ ψ hψ hFeq
        apply MonoidHom.eq_of_eqOn_dense hy
        rintro _ ⟨i, rfl⟩
        have h1 := congrFun hFeq i
        have h2 : ((F φ i : Subgroup.closure (Set.range a)) : L3) = φ (y i) := by
          show ((if h : φ (y i) ∈ Subgroup.closure (Set.range a) then
            (⟨φ (y i), h⟩ : Subgroup.closure (Set.range a)) else 1 :
              Subgroup.closure (Set.range a)) : L3) = φ (y i)
          rw [dif_pos (hmem φ hφ i)]
        have h3 : ((F ψ i : Subgroup.closure (Set.range a)) : L3) = ψ (y i) := by
          show ((if h : ψ (y i) ∈ Subgroup.closure (Set.range a) then
            (⟨ψ (y i), h⟩ : Subgroup.closure (Set.range a)) else 1 :
              Subgroup.closure (Set.range a)) : L3) = ψ (y i)
          rw [dif_pos (hmem ψ hψ i)]
        rw [← h2, ← h3, h1]
      calc (S ∩ f ⁻¹' {a}).ncard ≤ Nat.card (Fin n → Subgroup.closure (Set.range a)) :=
            br_ncard_le_card_of_injOn _ F hinj
        _ = Nat.card (Subgroup.closure (Set.range a)) ^ n := by rw [Nat.card_fun, Nat.card_fin]
        _ ≤ (p ^ b) ^ n := by
            apply Nat.pow_le_pow_left
            rw [hcl]
            exact hφ0S
  calc S.ncard ≤ Nat.card (Fin b → L3) * (p ^ b) ^ n := br_ncard_le_mul S f _ hM
    _ = p ^ (b * (n + s3)) := by
      rw [Nat.card_fun, Nat.card_fin, hL3, ← pow_mul, ← pow_mul, ← pow_add]
      congr 1
      ring

/-- Proposition 4.2 at `i = 2` (crude subgroup bound): the families of `s` core slices
`ad(g_{1,k}) : L_2 → L_3` of breadth `≤ b` number at most `p ^ (s · b · (r_2 + s_3))`. -/
theorem br_prop42_crude [Finite L2] [Finite L3] {p s3 n b : ℕ} (hp : p.Prime)
    (hL3 : Nat.card L3 = p ^ s3) (y : Fin n → L2) (hy : Subgroup.closure (Set.range y) = ⊤)
    (s : ℕ) :
    {κ : Fin s → (L2 →* L3) | ∀ k, Nat.card (κ k).range ≤ p ^ b}.ncard ≤
      p ^ (s * (b * (n + s3))) := by
  classical
  haveI : Finite (L2 →* L3) :=
    Finite.of_injective (fun f : L2 →* L3 => (f : L2 → L3)) DFunLike.coe_injective
  let S1 : Set (L2 →* L3) := {φ | Nat.card φ.range ≤ p ^ b}
  have h1 : (1 : L2 →* L3) ∈ S1 := by
    show Nat.card (1 : L2 →* L3).range ≤ p ^ b
    rw [MonoidHom.range_one, Subgroup.card_bot]
    exact Nat.one_le_pow _ _ hp.pos
  let F : (Fin s → (L2 →* L3)) → (Fin s → S1) := fun κ k =>
    if h : κ k ∈ S1 then ⟨κ k, h⟩ else ⟨1, h1⟩
  have hinj : Set.InjOn F {κ : Fin s → (L2 →* L3) | ∀ k, Nat.card (κ k).range ≤ p ^ b} := by
    intro κ hκ κ' hκ' he
    funext k
    have hk1 : κ k ∈ S1 := hκ k
    have hk2 : κ' k ∈ S1 := hκ' k
    have e := congrArg Subtype.val (congrFun he k)
    have e1 : ((F κ k : S1) : L2 →* L3) = κ k := by
      show ((if h : κ k ∈ S1 then (⟨κ k, h⟩ : S1) else ⟨1, h1⟩ : S1) : L2 →* L3) = κ k
      rw [dif_pos hk1]
    have e2 : ((F κ' k : S1) : L2 →* L3) = κ' k := by
      show ((if h : κ' k ∈ S1 then (⟨κ' k, h⟩ : S1) else ⟨1, h1⟩ : S1) : L2 →* L3) = κ' k
      rw [dif_pos hk2]
    rw [← e1, ← e2]
    exact e
  calc _ ≤ Nat.card (Fin s → S1) := br_ncard_le_card_of_injOn _ F hinj
    _ = S1.ncard ^ s := by rw [Nat.card_fun, Nat.card_fin, Nat.card_coe_set_eq]
    _ ≤ (p ^ (b * (n + s3))) ^ s := Nat.pow_le_pow_left (br_card_homs_le hp hL3 y hy) s
    _ = p ^ (s * (b * (n + s3))) := by rw [← pow_mul, mul_comm]

/-- Proposition 4.2 at `i = 2` for restrictions: for any set `B` of maps `L_2 × L_1 → L_3` whose
slices at the `s` core generators `c k` have breadth `≤ b`, the restrictions to `L_2 × C_core`
(the tuples of slices) number at most `p ^ (s · b · (r_2 + s_3))`. -/
theorem br_prop42_restrict [Finite L2] [Finite L3] {p s3 n b : ℕ} (hp : p.Prime)
    (hL3 : Nat.card L3 = p ^ s3) (y : Fin n → L2) (hy : Subgroup.closure (Set.range y) = ⊤)
    {s : ℕ} (c : Fin s → L1) (B : Set (L2 →* L1 →* L3))
    (hB : ∀ β ∈ B, ∀ k, Nat.card (β.flip (c k)).range ≤ p ^ b) :
    ((fun β : L2 →* L1 →* L3 => fun k => β.flip (c k)) '' B).ncard ≤
      p ^ (s * (b * (n + s3))) := by
  haveI : Finite (L2 →* L3) :=
    Finite.of_injective (fun f : L2 →* L3 => (f : L2 → L3)) DFunLike.coe_injective
  refine le_trans (Set.ncard_le_ncard ?_ (Set.toFinite _)) (br_prop42_crude hp hL3 y hy s)
  rintro _ ⟨β, hβ, rfl⟩
  exact hB β hβ

/-- Tuples with entries in a set `T` of a finite type: at most `|T| ^ s`. -/
theorem br_ncard_tuples_le {X : Type*} [Finite X] (T : Set X) (x0 : X) (hx0 : x0 ∈ T) (s : ℕ) :
    {κ : Fin s → X | ∀ k, κ k ∈ T}.ncard ≤ T.ncard ^ s := by
  classical
  let F : (Fin s → X) → (Fin s → T) := fun κ k => if h : κ k ∈ T then ⟨κ k, h⟩ else ⟨x0, hx0⟩
  have hinj : Set.InjOn F {κ : Fin s → X | ∀ k, κ k ∈ T} := by
    intro κ hκ κ' hκ' he
    funext k
    have hk1 : κ k ∈ T := hκ k
    have hk2 : κ' k ∈ T := hκ' k
    have e := congrArg Subtype.val (congrFun he k)
    have e1 : ((F κ k : T) : X) = κ k := by
      show ((if h : κ k ∈ T then (⟨κ k, h⟩ : T) else ⟨x0, hx0⟩ : T) : X) = κ k
      rw [dif_pos hk1]
    have e2 : ((F κ' k : T) : X) = κ' k := by
      show ((if h : κ' k ∈ T then (⟨κ' k, h⟩ : T) else ⟨x0, hx0⟩ : T) : X) = κ' k
      rw [dif_pos hk2]
    rw [← e1, ← e2]
    exact e
  calc _ ≤ Nat.card (Fin s → T) := br_ncard_le_card_of_injOn _ F hinj
    _ = T.ncard ^ s := by rw [Nat.card_fun, Nat.card_fin, Nat.card_coe_set_eq]

/-- Homomorphisms `L_2 → L_3` with image of order `≤ p ^ b`, where `L_2` is generated by `n`
elements, `|L_3| = p ^ s_3` and `b ≤ s_3`: at most `p ^ (b (n + s_3 - b + 1))`. The image is
extended to a subgroup of order exactly `p ^ b` (Sylow), there are at most `p ^ (b (s_3 - b + 1))`
of these (Lemma 2.7(iii), `br_card_subgroups_le`), and then the images of the `n` generators have
at most `p ^ (b n)` possibilities. -/
theorem br_card_homs_le_sharp [Finite L2] [Finite L3] {p s3 n b : ℕ} (hp : p.Prime)
    (hL3 : Nat.card L3 = p ^ s3) (hb : b ≤ s3) (y : Fin n → L2)
    (hy : Subgroup.closure (Set.range y) = ⊤) :
    {φ : L2 →* L3 | Nat.card φ.range ≤ p ^ b}.ncard ≤ p ^ (b * (n + s3 + 1 - b)) := by
  classical
  haveI := Fact.mk hp
  haveI : Finite (Subgroup L3) :=
    Finite.of_injective (fun H : Subgroup L3 => (H : Set L3)) SetLike.coe_injective
  set S := {φ : L2 →* L3 | Nat.card φ.range ≤ p ^ b} with hSdef
  have hext : ∀ φ ∈ S, ∃ K : Subgroup L3, Nat.card K = p ^ b ∧ φ.range ≤ K := by
    intro φ hφ
    have hφ' : Nat.card φ.range ≤ p ^ b := hφ
    obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow hp).1
      (show Nat.card φ.range ∣ p ^ s3 by rw [← hL3]; exact Subgroup.card_subgroup_dvd_card _)
    rw [hk] at hφ'
    have hkb : k ≤ b := br_pow_le_cancel hp.one_lt hφ'
    exact Sylow.exists_subgroup_card_pow_prime_le p
      (show p ^ b ∣ Nat.card L3 by rw [hL3]; exact pow_dvd_pow p hb) φ.range hk hkb
  let f : (L2 →* L3) → Subgroup L3 := fun φ =>
    Classical.epsilon (fun K : Subgroup L3 => Nat.card K = p ^ b ∧ φ.range ≤ K)
  have hf : ∀ φ ∈ S, Nat.card (f φ) = p ^ b ∧ φ.range ≤ f φ := fun φ hφ =>
    Classical.epsilon_spec (hext φ hφ)
  have hM : ∀ K : Subgroup L3, (S ∩ f ⁻¹' {K}).ncard ≤ (p ^ b) ^ n := by
    intro K
    rcases (S ∩ f ⁻¹' {K}).eq_empty_or_nonempty with he | ⟨φ0, hφ0S, hφ0K⟩
    · rw [he, Set.ncard_empty]
      exact Nat.zero_le _
    · have hK : Nat.card K = p ^ b := by
        have h0 := (hf φ0 hφ0S).1
        rwa [show f φ0 = K from hφ0K] at h0
      have hmem : ∀ φ ∈ S ∩ f ⁻¹' {K}, ∀ i, φ (y i) ∈ K := by
        rintro φ ⟨hφS, hφK⟩ i
        have hφK' : f φ = K := hφK
        rw [← hφK']
        exact (hf φ hφS).2 ⟨y i, rfl⟩
      let F : (L2 →* L3) → (Fin n → K) := fun φ i =>
        if h : φ (y i) ∈ K then ⟨φ (y i), h⟩ else 1
      have hinj : Set.InjOn F (S ∩ f ⁻¹' {K}) := by
        intro φ hφ ψ hψ hFeq
        apply MonoidHom.eq_of_eqOn_dense hy
        rintro _ ⟨i, rfl⟩
        have h1 := congrFun hFeq i
        have h2 : ((F φ i : K) : L3) = φ (y i) := by
          show ((if h : φ (y i) ∈ K then (⟨φ (y i), h⟩ : K) else 1 : K) : L3) = φ (y i)
          rw [dif_pos (hmem φ hφ i)]
        have h3 : ((F ψ i : K) : L3) = ψ (y i) := by
          show ((if h : ψ (y i) ∈ K then (⟨ψ (y i), h⟩ : K) else 1 : K) : L3) = ψ (y i)
          rw [dif_pos (hmem ψ hψ i)]
        rw [← h2, ← h3, h1]
      calc (S ∩ f ⁻¹' {K}).ncard ≤ Nat.card (Fin n → K) := br_ncard_le_card_of_injOn _ F hinj
        _ = Nat.card K ^ n := by rw [Nat.card_fun, Nat.card_fin]
        _ = (p ^ b) ^ n := by rw [hK]
  have himg : (f '' S).ncard ≤ p ^ (b * (s3 + 1 - b)) := by
    refine le_trans (Set.ncard_le_ncard ?_ (Set.toFinite _)) (br_card_subgroups_le hp s3 L3 hL3 b)
    rintro _ ⟨φ, hφ, rfl⟩
    exact (hf φ hφ).1
  calc S.ncard ≤ (f '' S).ncard * (p ^ b) ^ n := br_ncard_le_image_mul S f _ hM
    _ ≤ p ^ (b * (s3 + 1 - b)) * (p ^ b) ^ n := Nat.mul_le_mul_right _ himg
    _ = p ^ (b * (n + s3 + 1 - b)) := by
      rw [← pow_mul, ← pow_add]
      congr 1
      obtain ⟨d, rfl⟩ : ∃ d, s3 = b + d := ⟨s3 - b, by omega⟩
      rw [show b + d + 1 - b = d + 1 by omega, show n + (b + d) + 1 - b = n + d + 1 by omega]
      ring

/-- Proposition 4.2 at `i = 2` with Lemma 2.7(iii) (the paper's sharp form): the families of `s`
core slices `ad(g_{1,k}) : L_2 → L_3` of breadth `≤ b` (with `b ≤ s_3`) number at most
`p ^ (s · b · (r_2 + s_3 - b + 1))`, where `L_2` is generated by `n = r_2` elements. -/
theorem br_prop42 [Finite L2] [Finite L3] {p s3 n b : ℕ} (hp : p.Prime)
    (hL3 : Nat.card L3 = p ^ s3) (hb : b ≤ s3) (y : Fin n → L2)
    (hy : Subgroup.closure (Set.range y) = ⊤) (s : ℕ) :
    {κ : Fin s → (L2 →* L3) | ∀ k, Nat.card (κ k).range ≤ p ^ b}.ncard ≤
      p ^ (s * (b * (n + s3 + 1 - b))) := by
  haveI : Finite (L2 →* L3) :=
    Finite.of_injective (fun f : L2 →* L3 => (f : L2 → L3)) DFunLike.coe_injective
  have h1 : (1 : L2 →* L3) ∈ {φ : L2 →* L3 | Nat.card φ.range ≤ p ^ b} := by
    show Nat.card (1 : L2 →* L3).range ≤ p ^ b
    rw [MonoidHom.range_one, Subgroup.card_bot]
    exact Nat.one_le_pow _ _ hp.pos
  calc _ ≤ {φ : L2 →* L3 | Nat.card φ.range ≤ p ^ b}.ncard ^ s :=
        br_ncard_tuples_le {φ : L2 →* L3 | Nat.card φ.range ≤ p ^ b} 1 h1 s
    _ ≤ (p ^ (b * (n + s3 + 1 - b))) ^ s :=
        Nat.pow_le_pow_left (br_card_homs_le_sharp hp hL3 hb y hy) s
    _ = p ^ (s * (b * (n + s3 + 1 - b))) := by rw [← pow_mul, mul_comm]

end BrProp42

section BrBracket

/-! ### Class-3 brackets: Lemma 4.1, eq. (52), Proposition 4.3 and Remark 4.4 -/

variable {L1 L2 L3 : Type*} [CommGroup L1] [CommGroup L2] [CommGroup L3]

/-- Alternation of a bracket `L × L → L'`. -/
abbrev brAlt (β : L1 →* L1 →* L2) : Prop := ∀ x, β x x = 1

/-- The Jacobi identity of a class-3 graded bracket: `[[x,y],z] [[y,z],x] [[z,x],y] = 1`. -/
abbrev brJacobi (β1 : L1 →* L1 →* L2) (β2 : L2 →* L1 →* L3) : Prop :=
  ∀ x y z, β2 (β1 x y) z * β2 (β1 y z) x * β2 (β1 z x) y = 1

theorem br_antisymm {β : L1 →* L1 →* L2} (hA : brAlt β) (x y : L1) : β y x = (β x y)⁻¹ := by
  have h := hA (x * y)
  simp only [map_mul, MonoidHom.mul_apply, hA x, hA y, one_mul, mul_one] at h
  exact eq_inv_of_mul_eq_one_left h

theorem br_map_pow_left (β : L1 →* L1 →* L2) (x y : L1) (n : ℕ) :
    β (x ^ n) y = (β x y) ^ n := by
  have h := map_pow (β.flip y) x n
  simpa [MonoidHom.flip_apply] using h

/-- Lemma 4.1(i), class 3. Two brackets `(β_1, β_2)` and `(β_1', β_2')` with the Jacobi identity,
agreeing on `L_1 × C` and on `L_2 × C`, where `L_2` is generated by `β_1(C, C)`, have the same
second bracket `L_2 × L_1 → L_3`. -/
theorem br_lemma41 (C : Subgroup L1) {β1 β1' : L1 →* L1 →* L2} {β2 β2' : L2 →* L1 →* L3}
    (hA : brAlt β1) (hA' : brAlt β1') (hJ : brJacobi β1 β2) (hJ' : brJacobi β1' β2')
    (hgen : Subgroup.closure {w | ∃ u ∈ C, ∃ v ∈ C, β1 u v = w} = ⊤)
    (h1 : ∀ x, ∀ u ∈ C, β1 x u = β1' x u) (h2 : ∀ z, ∀ u ∈ C, β2 z u = β2' z u) :
    β2 = β2' := by
  have key : ∀ w ∈ {w | ∃ u ∈ C, ∃ v ∈ C, β1 u v = w}, β2 w = β2' w := by
    rintro _ ⟨u, hu, v, hv, rfl⟩
    ext x
    have e1 := hJ u v x
    have e2 := hJ' u v x
    have a1 : β1 v x = β1' v x := by
      rw [br_antisymm hA x v, br_antisymm hA' x v, h1 x v hv]
    have a2 : β2 (β1 v x) u = β2' (β1' v x) u := by rw [a1, h2 _ u hu]
    have a3 : β2 (β1 x u) v = β2' (β1' x u) v := by rw [h1 x u hu, h2 _ v hv]
    have a4 : β1' u v = β1 u v := (h1 u v hv).symm
    rw [a2, a3] at e1
    rw [a4] at e2
    exact mul_right_cancel (mul_right_cancel (e1.trans e2.symm))
  exact MonoidHom.eq_of_eqOn_dense hgen key

/-- Eq. (52): for two class-3 brackets with the same core map `κ` on `L_2 × C` and agreeing on
`L_1 × C`, the Jacobi identity fixes `ad(h)[x, y] = [[x, y], h]` for `h ∈ C`. -/
theorem br_jacobi_kernel (C : Subgroup L1) {κ : L2 →* L1 →* L3} {β β0 : L1 →* L1 →* L2}
    {β2 β20 : L2 →* L1 →* L3} (hA : brAlt β) (hA0 : brAlt β0) (hJ : brJacobi β β2)
    (hJ0 : brJacobi β0 β20) (hgen : Subgroup.closure {w | ∃ u ∈ C, ∃ v ∈ C, β u v = w} = ⊤)
    (hκ : ∀ z, ∀ u ∈ C, β2 z u = κ z u) (hκ0 : ∀ z, ∀ u ∈ C, β20 z u = κ z u)
    (hagree : ∀ x, ∀ u ∈ C, β x u = β0 x u) {h : L1} (hh : h ∈ C) (x y : L1) :
    κ (β x y) h = κ (β0 x y) h := by
  have h22 : β2 = β20 := br_lemma41 C hA hA0 hJ hJ0 hgen hagree
    (fun z u hu => (hκ z u hu).trans (hκ0 z u hu).symm)
  have e1 := hJ x y h
  have e2 := hJ0 x y h
  have b1 : β y h = β0 y h := hagree y h hh
  have b2 : β h x = β0 h x := by
    rw [br_antisymm hA x h, br_antisymm hA0 x h, hagree x h hh]
  rw [b1, b2, h22] at e1
  rw [← hκ _ h hh, ← hκ0 _ h hh, h22]
  exact mul_right_cancel (mul_right_cancel (e1.trans e2.symm))

/-- Values on the core pairs determine an alternating bracket on `L_1 × C`. -/
theorem br_agree_core {ι : Type*} {g : ι → L1} (hg : Subgroup.closure (Set.range g) = ⊤)
    {Cidx : Set ι} {β β' : L1 →* L1 →* L2} (hA : brAlt β) (hA' : brAlt β')
    (Pc : Finset (ι × ι)) (hcov : ∀ i, ∀ j ∈ Cidx, i = j ∨ (i, j) ∈ Pc ∨ (j, i) ∈ Pc)
    (hP : ∀ q ∈ Pc, β (g q.1) (g q.2) = β' (g q.1) (g q.2)) :
    ∀ x, ∀ u ∈ Subgroup.closure (g '' Cidx), β x u = β' x u := by
  have hgen : ∀ j ∈ Cidx, β.flip (g j) = β'.flip (g j) := by
    intro j hj
    apply MonoidHom.eq_of_eqOn_dense hg
    rintro _ ⟨i, rfl⟩
    simp only [MonoidHom.flip_apply]
    rcases hcov i j hj with rfl | h | h
    · exact (hA _).trans (hA' _).symm
    · exact hP _ h
    · rw [br_antisymm hA (g j) (g i), br_antisymm hA' (g j) (g i), hP _ h]
  intro x u hu
  have hle : Subgroup.closure (g '' Cidx) ≤ (β x).eqLocus (β' x) := by
    rw [Subgroup.closure_le]
    rintro _ ⟨j, hj, rfl⟩
    show β x (g j) = β' x (g j)
    have := congrArg (fun φ : L1 →* L2 => φ x) (hgen j hj)
    simpa [MonoidHom.flip_apply] using this
  exact hle hu

/-- An alternating bracket is determined by its values on `L_1 × C` and on outside pairs. -/
theorem br_ext_of_agree {ι : Type*} {g : ι → L1} (hg : Subgroup.closure (Set.range g) = ⊤)
    {Cidx : Set ι} {β β' : L1 →* L1 →* L2} (hA : brAlt β) (hA' : brAlt β')
    (Po : Finset (ι × ι))
    (hcovo : ∀ i j, i ∉ Cidx → j ∉ Cidx → i = j ∨ (i, j) ∈ Po ∨ (j, i) ∈ Po)
    (hC : ∀ x, ∀ u ∈ Subgroup.closure (g '' Cidx), β x u = β' x u)
    (hPo : ∀ q ∈ Po, β (g q.1) (g q.2) = β' (g q.1) (g q.2)) : β = β' := by
  have hgi : ∀ i, β (g i) = β' (g i) := by
    intro i
    apply MonoidHom.eq_of_eqOn_dense hg
    rintro _ ⟨j, rfl⟩
    by_cases hj : j ∈ Cidx
    · exact hC _ _ (Subgroup.subset_closure ⟨j, hj, rfl⟩)
    · by_cases hi : i ∈ Cidx
      · rw [br_antisymm hA (g j) (g i), br_antisymm hA' (g j) (g i),
          hC _ _ (Subgroup.subset_closure ⟨i, hi, rfl⟩)]
      · rcases hcovo i j hi hj with rfl | h | h
        · exact (hA _).trans (hA' _).symm
        · exact hPo _ h
        · rw [br_antisymm hA (g j) (g i), br_antisymm hA' (g j) (g i), hPo _ h]
  apply MonoidHom.eq_of_eqOn_dense hg
  rintro _ ⟨i, rfl⟩
  exact hgi i

lemma br_dite_val {L : Type*} [Group L] {K : Subgroup L} {x : L} [Decidable (x ∈ K)]
    (h : x ∈ K) : ((if hp : x ∈ K then (⟨x, hp⟩ : K) else 1 : K) : L) = x := by
  rw [dif_pos h]

/-- Proposition 4.3 and Remark 4.4 (first alternative), general form. Generators `g` of `L_1`,
core `C = ⟨g(Cidx)⟩`, a fixed core map `κ` (the restriction `L_2 × C → L_3`), an element `h ∈ C`;
core pairs `Pc` covering every pair with a core entry, outside pairs `Po` covering the pairs of
outside generators, and prescribed values `v` on a set `D` of pairs. The first-layer brackets with
these data number at most `|L_2| ^ |Pc \ D| · |ker ad(h)| ^ |Po|`. -/
theorem br_prop43_gen [Finite L2] {ι : Type*} [DecidableEq ι] (g : ι → L1)
    (hg : Subgroup.closure (Set.range g) = ⊤) (Cidx : Set ι) (κ : L2 →* L1 →* L3) {h : L1}
    (hh : h ∈ Subgroup.closure (g '' Cidx)) (Pc Po D : Finset (ι × ι))
    (hcov : ∀ i, ∀ j ∈ Cidx, i = j ∨ (i, j) ∈ Pc ∨ (j, i) ∈ Pc)
    (hcovo : ∀ i j, i ∉ Cidx → j ∉ Cidx → i = j ∨ (i, j) ∈ Po ∨ (j, i) ∈ Po)
    (v : ι × ι → L2) :
    {β1 : L1 →* L1 →* L2 | brAlt β1 ∧
        Subgroup.closure {w | ∃ u ∈ Subgroup.closure (g '' Cidx),
          ∃ u' ∈ Subgroup.closure (g '' Cidx), β1 u u' = w} = ⊤ ∧
        (∃ β2 : L2 →* L1 →* L3, (∀ z, ∀ u ∈ Subgroup.closure (g '' Cidx), β2 z u = κ z u) ∧
          brJacobi β1 β2) ∧
        ∀ q ∈ D, β1 (g q.1) (g q.2) = v q}.ncard ≤
      Nat.card L2 ^ (Pc \ D).card * Nat.card (κ.flip h).ker ^ Po.card := by
  classical
  set C := Subgroup.closure (g '' Cidx) with hCdef
  set S := {β1 : L1 →* L1 →* L2 | brAlt β1 ∧
        Subgroup.closure {w | ∃ u ∈ C, ∃ u' ∈ C, β1 u u' = w} = ⊤ ∧
        (∃ β2 : L2 →* L1 →* L3, (∀ z, ∀ u ∈ C, β2 z u = κ z u) ∧ brJacobi β1 β2) ∧
        ∀ q ∈ D, β1 (g q.1) (g q.2) = v q} with hSdef
  let fc : (L1 →* L1 →* L2) → (↥(Pc \ D) → L2) := fun β q => β (g q.1.1) (g q.1.2)
  have hfib : ∀ a, (S ∩ fc ⁻¹' {a}).ncard ≤ Nat.card (κ.flip h).ker ^ Po.card := by
    intro a
    rcases (S ∩ fc ⁻¹' {a}).eq_empty_or_nonempty with he | ⟨β0, hβ0S, hβ0a⟩
    · rw [he, Set.ncard_empty]
      exact Nat.zero_le _
    · obtain ⟨hA0, -, ⟨β20, hκ0, hJ0⟩, hD0⟩ := hβ0S
      have hβ0a' : fc β0 = a := hβ0a
      have hag : ∀ β ∈ S ∩ fc ⁻¹' {a}, ∀ x, ∀ u ∈ C, β x u = β0 x u := by
        rintro β ⟨⟨hA, -, -, hD⟩, hβa⟩
        have hβa' : fc β = a := hβa
        apply br_agree_core hg hA hA0 Pc hcov
        intro q hq
        by_cases hqD : q ∈ D
        · rw [hD q hqD, hD0 q hqD]
        · have hq' : q ∈ Pc \ D := Finset.mem_sdiff.2 ⟨hq, hqD⟩
          exact congrFun (hβa'.trans hβ0a'.symm) ⟨q, hq'⟩
      have hker : ∀ β ∈ S ∩ fc ⁻¹' {a}, ∀ x y,
          β x y / β0 x y ∈ (κ.flip h).ker := by
        intro β hβ x y
        obtain ⟨⟨hA, hgen, ⟨β2, hκ, hJ⟩, -⟩, -⟩ := id hβ
        rw [MonoidHom.mem_ker, map_div, MonoidHom.flip_apply, MonoidHom.flip_apply,
          br_jacobi_kernel C hA hA0 hJ hJ0 hgen hκ hκ0 (hag β hβ) hh x y, div_self']
      let F : (L1 →* L1 →* L2) → (↥Po → (κ.flip h).ker) := fun β q =>
        if hq : β (g q.1.1) (g q.1.2) / β0 (g q.1.1) (g q.1.2) ∈ (κ.flip h).ker then
          ⟨_, hq⟩ else 1
      have hv : ∀ β ∈ S ∩ fc ⁻¹' {a}, ∀ q : ↥Po, ((F β q : (κ.flip h).ker) : L2) =
          β (g q.1.1) (g q.1.2) / β0 (g q.1.1) (g q.1.2) := by
        intro β hβ q
        exact br_dite_val (hker β hβ _ _)
      have hinj : Set.InjOn F (S ∩ fc ⁻¹' {a}) := by
        intro β hβ β' hβ' hF
        have hpo : ∀ q ∈ Po, β (g q.1) (g q.2) = β' (g q.1) (g q.2) := by
          intro q hq
          have e := congrArg Subtype.val (congrFun hF ⟨q, hq⟩)
          rw [hv β hβ ⟨q, hq⟩, hv β' hβ' ⟨q, hq⟩] at e
          exact div_left_inj.mp e
        obtain ⟨⟨hA, -⟩, -⟩ := id hβ
        obtain ⟨⟨hA', -⟩, -⟩ := id hβ'
        exact br_ext_of_agree hg hA hA' Po hcovo
          (fun x u hu => (hag β hβ x u hu).trans (hag β' hβ' x u hu).symm) hpo
      calc (S ∩ fc ⁻¹' {a}).ncard ≤ Nat.card (↥Po → (κ.flip h).ker) :=
            br_ncard_le_card_of_injOn _ F hinj
        _ = Nat.card (κ.flip h).ker ^ Po.card := by
            rw [Nat.card_fun, Nat.card_eq_fintype_card (α := ↥Po), Fintype.card_coe]
  calc S.ncard ≤ Nat.card (↥(Pc \ D) → L2) * Nat.card (κ.flip h).ker ^ Po.card :=
        br_ncard_le_mul S fc _ hfib
    _ = Nat.card L2 ^ (Pc \ D).card * Nat.card (κ.flip h).ker ^ Po.card := by
        rw [Nat.card_fun, Nat.card_eq_fintype_card (α := ↥(Pc \ D)), Fintype.card_coe]

/-- Proposition 4.3 / Remark 4.4 (first alternative) with `|L_2| = p ^ s_2` and the breadth
`b_2` attained at `h ∈ C`: at most `p ^ (s_2 |Pc \ D| + (s_2 - b_2) |Po|)`. -/
theorem br_prop43 [Finite L2] {ι : Type*} [DecidableEq ι] {p s2 b : ℕ} (hp : p.Prime)
    (hL2 : Nat.card L2 = p ^ s2) (g : ι → L1)
    (hg : Subgroup.closure (Set.range g) = ⊤) (Cidx : Set ι) (κ : L2 →* L1 →* L3) {h : L1}
    (hh : h ∈ Subgroup.closure (g '' Cidx)) (hb : p ^ b ≤ Nat.card (κ.flip h).range)
    (Pc Po D : Finset (ι × ι))
    (hcov : ∀ i, ∀ j ∈ Cidx, i = j ∨ (i, j) ∈ Pc ∨ (j, i) ∈ Pc)
    (hcovo : ∀ i j, i ∉ Cidx → j ∉ Cidx → i = j ∨ (i, j) ∈ Po ∨ (j, i) ∈ Po)
    (v : ι × ι → L2) :
    {β1 : L1 →* L1 →* L2 | brAlt β1 ∧
        Subgroup.closure {w | ∃ u ∈ Subgroup.closure (g '' Cidx),
          ∃ u' ∈ Subgroup.closure (g '' Cidx), β1 u u' = w} = ⊤ ∧
        (∃ β2 : L2 →* L1 →* L3, (∀ z, ∀ u ∈ Subgroup.closure (g '' Cidx), β2 z u = κ z u) ∧
          brJacobi β1 β2) ∧
        ∀ q ∈ D, β1 (g q.1) (g q.2) = v q}.ncard ≤
      p ^ (s2 * (Pc \ D).card + (s2 - b) * Po.card) := by
  refine le_trans (br_prop43_gen g hg Cidx κ hh Pc Po D hcov hcovo v) ?_
  rw [hL2, pow_add, pow_mul, pow_mul]
  exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (br_card_ker_le hp _ hL2 hb) _)

/-- The pairs `i < j` in `ℕ` below `r` with `s ≤ i`: `(r - s) choose 2` of them. -/
theorem br_card_pairs_nat (s : ℕ) : ∀ r : ℕ,
    ((Finset.range r ×ˢ Finset.range r).filter (fun q : ℕ × ℕ => q.1 < q.2 ∧ s ≤ q.1)).card =
      (r - s).choose 2
  | 0 => by simp
  | r + 1 => by
    classical
    have hsplit : (Finset.range (r + 1) ×ˢ Finset.range (r + 1)).filter
          (fun q : ℕ × ℕ => q.1 < q.2 ∧ s ≤ q.1) =
        (Finset.range r ×ˢ Finset.range r).filter (fun q : ℕ × ℕ => q.1 < q.2 ∧ s ≤ q.1) ∪
          (Finset.Ico s r).image (fun i => (i, r)) := by
      ext ⟨i, j⟩
      simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range, Finset.mem_union,
        Finset.mem_image, Finset.mem_Ico, Prod.mk.injEq]
      constructor
      · rintro ⟨⟨hi, hj⟩, hij, hsi⟩
        by_cases hjr : j < r
        · exact Or.inl ⟨⟨by omega, hjr⟩, hij, hsi⟩
        · exact Or.inr ⟨i, ⟨hsi, by omega⟩, rfl, by omega⟩
      · rintro (⟨⟨hi, hj⟩, hij, hsi⟩ | ⟨a, ⟨hsa, har⟩, rfl, rfl⟩)
        · exact ⟨⟨by omega, by omega⟩, hij, hsi⟩
        · exact ⟨⟨by omega, by omega⟩, har, hsa⟩
    have hdisj : Disjoint ((Finset.range r ×ˢ Finset.range r).filter
        (fun q : ℕ × ℕ => q.1 < q.2 ∧ s ≤ q.1)) ((Finset.Ico s r).image (fun i => (i, r))) := by
      rw [Finset.disjoint_left]
      rintro ⟨i, j⟩ h1 h2
      simp only [Finset.mem_filter, Finset.mem_product, Finset.mem_range, Finset.mem_image,
        Finset.mem_Ico, Prod.mk.injEq] at h1 h2
      obtain ⟨a, -, -, hj⟩ := h2
      omega
    have hinj : Function.Injective (fun i : ℕ => (i, r)) := fun a b h => (Prod.mk.inj h).1
    have hu := Finset.card_union_add_card_inter
      ((Finset.range r ×ˢ Finset.range r).filter (fun q : ℕ × ℕ => q.1 < q.2 ∧ s ≤ q.1))
      ((Finset.Ico s r).image (fun i => (i, r)))
    rw [Finset.disjoint_iff_inter_eq_empty.1 hdisj, Finset.card_empty, add_zero] at hu
    rw [hsplit, hu, br_card_pairs_nat s r, Finset.card_image_of_injective _ hinj, Nat.card_Ico]
    rcases Nat.lt_or_ge r s with h | h
    · rw [show r - s = 0 by omega, show r + 1 - s = 0 by omega, Nat.add_zero]
    · rw [show r + 1 - s = (r - s) + 1 by omega, Nat.choose_succ_succ', Nat.choose_one_right,
        Nat.add_comm]

/-- The pairs `i < j` in `Fin r` with `¬ i < s`: `(r - s) choose 2` of them. -/
theorem br_card_pairs_fin (r s : ℕ) :
    ((Finset.univ : Finset (Fin r × Fin r)).filter
      (fun q => q.1 < q.2 ∧ ¬ (q.1 : ℕ) < s)).card = (r - s).choose 2 := by
  classical
  rw [← br_card_pairs_nat s r]
  have hinj : Function.Injective (fun q : Fin r × Fin r => ((q.1 : ℕ), (q.2 : ℕ))) := by
    intro q1 q2 h
    simp only [Prod.mk.injEq] at h
    exact Prod.ext (Fin.ext h.1) (Fin.ext h.2)
  rw [← Finset.card_image_of_injective _ hinj]
  congr 1
  ext ⟨i, j⟩
  simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_product,
    Finset.mem_range, Prod.mk.injEq]
  constructor
  · rintro ⟨q, ⟨h1, h2⟩, rfl, rfl⟩
    exact ⟨⟨q.1.2, q.2.2⟩, h1, not_lt.1 h2⟩
  · rintro ⟨⟨hi, hj⟩, hij, hsi⟩
    exact ⟨(⟨i, hi⟩, ⟨j, hj⟩), ⟨hij, not_lt.2 hsi⟩, rfl, rfl⟩

/-- Proposition 4.3 / Remark 4.4 (first alternative) in the paper's form: generators
`g_{1,1}, ..., g_{1,r_1}` indexed by `Fin r_1`, core the first `s`, prescribed values on a set `D`
of core pairs `j < k` (`j < s`; the `r_2` defining pairs in Remark 4.4, `D = ∅` in
Proposition 4.3), `|L_2| = p ^ s_2` and breadth `b_2` attained at `h ∈ C_core`: at most
`p ^ (((r_1 choose 2) - |D|) s_2 - ((r_1 - s) choose 2) b_2)` first-layer brackets. -/
theorem br_prop43_fin [Finite L2] {p r s s2 b : ℕ} (hp : p.Prime)
    (hL2 : Nat.card L2 = p ^ s2) (g : Fin r → L1)
    (hg : Subgroup.closure (Set.range g) = ⊤) (κ : L2 →* L1 →* L3) {h : L1}
    (hh : h ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}))
    (hb : p ^ b ≤ Nat.card (κ.flip h).range) (D : Finset (Fin r × Fin r))
    (hD : ∀ q ∈ D, q.1 < q.2 ∧ (q.1 : ℕ) < s) (v : Fin r × Fin r → L2) :
    {β1 : L1 →* L1 →* L2 | brAlt β1 ∧
        Subgroup.closure {w | ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}),
          ∃ u' ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β1 u u' = w} = ⊤ ∧
        (∃ β2 : L2 →* L1 →* L3,
          (∀ z, ∀ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β2 z u = κ z u) ∧
          brJacobi β1 β2) ∧
        ∀ q ∈ D, β1 (g q.1) (g q.2) = v q}.ncard ≤
      p ^ ((r.choose 2 - D.card) * s2 - (r - s).choose 2 * b) := by
  classical
  set T := (Finset.univ : Finset (Fin r × Fin r)).filter (fun q => q.1 < q.2) with hTdef
  set Pc := T.filter (fun q => (q.1 : ℕ) < s) with hPcdef
  set Po := T.filter (fun q => ¬ (q.1 : ℕ) < s) with hPodef
  have hcov : ∀ i, ∀ j ∈ {j : Fin r | (j : ℕ) < s}, i = j ∨ (i, j) ∈ Pc ∨ (j, i) ∈ Pc := by
    intro i j hj
    have hj' : (j : ℕ) < s := hj
    rcases lt_trichotomy i j with hij | hij | hij
    · refine Or.inr (Or.inl ?_)
      rw [hPcdef, hTdef, Finset.mem_filter, Finset.mem_filter]
      exact ⟨⟨Finset.mem_univ _, hij⟩, Nat.lt_trans (show (i : ℕ) < j from hij) hj'⟩
    · exact Or.inl hij
    · refine Or.inr (Or.inr ?_)
      rw [hPcdef, hTdef, Finset.mem_filter, Finset.mem_filter]
      exact ⟨⟨Finset.mem_univ _, hij⟩, hj'⟩
  have hcovo : ∀ i j, i ∉ {j : Fin r | (j : ℕ) < s} → j ∉ {j : Fin r | (j : ℕ) < s} →
      i = j ∨ (i, j) ∈ Po ∨ (j, i) ∈ Po := by
    intro i j hi hj
    have hi' : ¬ (i : ℕ) < s := hi
    have hj' : ¬ (j : ℕ) < s := hj
    rcases lt_trichotomy i j with hij | hij | hij
    · refine Or.inr (Or.inl ?_)
      rw [hPodef, hTdef, Finset.mem_filter, Finset.mem_filter]
      exact ⟨⟨Finset.mem_univ _, hij⟩, hi'⟩
    · exact Or.inl hij
    · refine Or.inr (Or.inr ?_)
      rw [hPodef, hTdef, Finset.mem_filter, Finset.mem_filter]
      exact ⟨⟨Finset.mem_univ _, hij⟩, hj'⟩
  have main := br_prop43 hp hL2 g hg {j : Fin r | (j : ℕ) < s} κ hh hb Pc Po D hcov hcovo v
  refine le_trans main (Nat.pow_le_pow_right hp.pos ?_)
  have hTc : T.card = r.choose 2 := by
    have h0 := br_card_pairs_fin r 0
    rw [Nat.sub_zero] at h0
    rw [← h0, hTdef]
    congr 1
    ext q
    simp
  have hT : Pc.card + Po.card = r.choose 2 := by
    rw [hPcdef, hPodef, Finset.card_filter_add_card_filter_not, hTc]
  have hPo : Po.card = (r - s).choose 2 := by
    rw [← br_card_pairs_fin r s, hPodef, hTdef]
    congr 1
    ext q
    simp
  have hDsub : D ⊆ Pc := by
    intro q hq
    rw [hPcdef, hTdef, Finset.mem_filter, Finset.mem_filter]
    exact ⟨⟨Finset.mem_univ _, (hD q hq).1⟩, (hD q hq).2⟩
  have hsd : (Pc \ D).card + D.card = Pc.card := Finset.card_sdiff_add_card_eq_card hDsub
  have hrange : Nat.card (κ.flip h).range ≤ Nat.card L2 :=
    Nat.card_le_card_of_surjective _ (κ.flip h).rangeRestrict_surjective
  have hbs : b ≤ s2 := br_pow_le_cancel hp.one_lt (hb.trans (hrange.trans hL2.le))
  have key : ∀ a o b c : ℕ, (b + c) * a + c * o ≤ (a + o) * (b + c) - o * b := by
    intro a o b c
    have e : (a + o) * (b + c) = o * b + ((b + c) * a + c * o) := by ring
    rw [e, Nat.add_sub_cancel_left]
  have e1 : r.choose 2 - D.card = (Pc \ D).card + Po.card := by omega
  rw [e1, ← hPo]
  obtain ⟨c, hc⟩ : ∃ c, s2 = b + c := ⟨s2 - b, by omega⟩
  rw [hc, Nat.add_sub_cancel_left]
  exact key _ _ _ _

/-- Eq. (53) at `c = 3`, with Remark 4.4 (first alternative): the graded brackets
`(β_1, β_2)` (`L_1 × L_1 → L_2` and `L_2 × L_1 → L_3`) with the Jacobi identity, generation of
`L_2` by the core, core slices of breadth `≤ b` attained at some `h ∈ C_core`, and prescribed
values on `D`, number at most `p ^ (s b (n + s_3 - b + 1)) · p ^ (((r_1 choose 2) - |D|) s_2 -
((r_1 - s) choose 2) b)`, where `L_2` is generated by `n` elements (`n = r_2`). The first factor is
the sharp Proposition 4.2 (`br_prop42`, through Lemma 2.7(iii)); `b ≤ s_3` is automatic here
since some slice has breadth `≥ b`. -/
theorem br_eq53 [Finite L1] [Finite L2] [Finite L3] {p r s s2 s3 n b : ℕ} (hp : p.Prime)
    (hsr : s ≤ r) (hL2 : Nat.card L2 = p ^ s2) (hL3 : Nat.card L3 = p ^ s3) (y : Fin n → L2)
    (hy : Subgroup.closure (Set.range y) = ⊤) (g : Fin r → L1)
    (hg : Subgroup.closure (Set.range g) = ⊤) (D : Finset (Fin r × Fin r))
    (hD : ∀ q ∈ D, q.1 < q.2 ∧ (q.1 : ℕ) < s) (v : Fin r × Fin r → L2) :
    {β : (L1 →* L1 →* L2) × (L2 →* L1 →* L3) | brAlt β.1 ∧
        Subgroup.closure {w | ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}),
          ∃ u' ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β.1 u u' = w} = ⊤ ∧
        brJacobi β.1 β.2 ∧
        (∀ j : Fin r, (j : ℕ) < s → Nat.card (β.2.flip (g j)).range ≤ p ^ b) ∧
        (∃ h ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), p ^ b ≤ Nat.card (β.2.flip h).range) ∧
        ∀ q ∈ D, β.1 (g q.1) (g q.2) = v q}.ncard ≤
      p ^ (s * (b * (n + s3 + 1 - b))) *
        p ^ ((r.choose 2 - D.card) * s2 - (r - s).choose 2 * b) := by
  classical
  haveI : Finite (L2 →* L3) :=
    Finite.of_injective (fun f : L2 →* L3 => (f : L2 → L3)) DFunLike.coe_injective
  haveI : Finite (L1 →* L2) :=
    Finite.of_injective (fun f : L1 →* L2 => (f : L1 → L2)) DFunLike.coe_injective
  haveI : Finite (L1 →* L1 →* L2) :=
    Finite.of_injective (fun f : L1 →* L1 →* L2 => (f : L1 → (L1 →* L2))) DFunLike.coe_injective
  set C := Subgroup.closure (g '' {j | (j : ℕ) < s}) with hCdef
  let c : Fin s → L1 := fun k => g (Fin.castLE hsr k)
  set BR := {β : (L1 →* L1 →* L2) × (L2 →* L1 →* L3) | brAlt β.1 ∧
        Subgroup.closure {w | ∃ u ∈ C, ∃ u' ∈ C, β.1 u u' = w} = ⊤ ∧
        brJacobi β.1 β.2 ∧
        (∀ j : Fin r, (j : ℕ) < s → Nat.card (β.2.flip (g j)).range ≤ p ^ b) ∧
        (∃ h ∈ C, p ^ b ≤ Nat.card (β.2.flip h).range) ∧
        ∀ q ∈ D, β.1 (g q.1) (g q.2) = v q} with hBR
  rcases BR.eq_empty_or_nonempty with hBe | ⟨β1, hβ1⟩
  · rw [hBe, Set.ncard_empty]
    exact Nat.zero_le _
  have hbs3 : b ≤ s3 := by
    obtain ⟨-, -, -, -, ⟨h1, -, hb1⟩, -⟩ := id hβ1
    have hr : Nat.card (β1.2.flip h1).range ≤ Nat.card L3 :=
      Subgroup.card_le_card_group (H := (β1.2.flip h1).range)
    exact br_pow_le_cancel hp.one_lt (hb1.trans (hr.trans hL3.le))
  let ρ : (L1 →* L1 →* L2) × (L2 →* L1 →* L3) → (Fin s → (L2 →* L3)) :=
    fun β k => β.2.flip (c k)
  have himg : (ρ '' BR).ncard ≤ p ^ (s * (b * (n + s3 + 1 - b))) := by
    refine le_trans (Set.ncard_le_ncard ?_ (Set.toFinite _))
      (br_prop42 hp hL3 hbs3 y hy s (b := b))
    rintro _ ⟨β, hβ, rfl⟩ k
    obtain ⟨-, -, -, hsl0, -⟩ := id hβ
    exact hsl0 (Fin.castLE hsr k) (by simp)
  have hfib : ∀ a, (BR ∩ ρ ⁻¹' {a}).ncard ≤
      p ^ ((r.choose 2 - D.card) * s2 - (r - s).choose 2 * b) := by
    intro a
    rcases (BR ∩ ρ ⁻¹' {a}).eq_empty_or_nonempty with he | ⟨β0, hβ0, hβ0a⟩
    · rw [he, Set.ncard_empty]
      exact Nat.zero_le _
    · obtain ⟨-, -, -, -, ⟨h0, hh0, hb0⟩, -⟩ := id hβ0
      have hβ0a' : ρ β0 = a := hβ0a
      have hsl : ∀ β ∈ BR ∩ ρ ⁻¹' {a}, ∀ z, ∀ u ∈ C, β.2 z u = β0.2 z u := by
        rintro β ⟨-, hβa⟩ z u hu
        have hβa' : ρ β = a := hβa
        have hgen : ∀ j : Fin r, (j : ℕ) < s → β.2.flip (g j) = β0.2.flip (g j) := by
          intro j hj
          have e := congrFun (hβa'.trans hβ0a'.symm) ⟨(j : ℕ), hj⟩
          change β.2.flip (c ⟨(j : ℕ), hj⟩) = β0.2.flip (c ⟨(j : ℕ), hj⟩) at e
          have e2 : c ⟨(j : ℕ), hj⟩ = g j := congrArg g (Fin.ext rfl)
          rw [e2] at e
          exact e
        have hle : C ≤ (β.2 z).eqLocus (β0.2 z) := by
          rw [hCdef, Subgroup.closure_le]
          rintro _ ⟨j, hj, rfl⟩
          show β.2 z (g j) = β0.2 z (g j)
          have := congrArg (fun φ : L2 →* L3 => φ z) (hgen j hj)
          simpa [MonoidHom.flip_apply] using this
        exact hle hu
      let S43 : Set (L1 →* L1 →* L2) := {β1 | brAlt β1 ∧
        Subgroup.closure {w | ∃ u ∈ C, ∃ u' ∈ C, β1 u u' = w} = ⊤ ∧
        (∃ β2 : L2 →* L1 →* L3, (∀ z, ∀ u ∈ C, β2 z u = β0.2 z u) ∧ brJacobi β1 β2) ∧
        ∀ q ∈ D, β1 (g q.1) (g q.2) = v q}
      have hmaps : ∀ β ∈ BR ∩ ρ ⁻¹' {a}, Prod.fst β ∈ S43 := by
        intro β hβ
        obtain ⟨⟨hA, hgen, hJ, -, -, hDv⟩, -⟩ := id hβ
        exact ⟨hA, hgen, ⟨β.2, hsl β hβ, hJ⟩, hDv⟩
      have hinj : Set.InjOn Prod.fst (BR ∩ ρ ⁻¹' {a}) := by
        intro β hβ β' hβ' h1
        obtain ⟨⟨hA, hgen, hJ, -⟩, -⟩ := id hβ
        obtain ⟨⟨hA', -, hJ', -⟩, -⟩ := id hβ'
        have h1' : β.1 = β'.1 := h1
        have h2 : β.2 = β'.2 := br_lemma41 C hA hA' hJ hJ' hgen (fun x u _ => by rw [h1'])
          (fun z u hu => (hsl β hβ z u hu).trans (hsl β' hβ' z u hu).symm)
        exact Prod.ext h1' h2
      calc (BR ∩ ρ ⁻¹' {a}).ncard ≤ S43.ncard :=
            Set.ncard_le_ncard_of_injOn Prod.fst hmaps hinj (Set.toFinite _)
        _ ≤ _ := br_prop43_fin hp hL2 g hg β0.2 hh0 hb0 D hD v
  calc BR.ncard ≤ (ρ '' BR).ncard * p ^ ((r.choose 2 - D.card) * s2 - (r - s).choose 2 * b) :=
        br_ncard_le_image_mul BR ρ _ hfib
    _ ≤ p ^ (s * (b * (n + s3 + 1 - b))) *
          p ^ ((r.choose 2 - D.card) * s2 - (r - s).choose 2 * b) :=
        Nat.mul_le_mul_right _ himg

/-- Remark 4.4, second alternative: counting alternating brackets through a reduction
`π : L_2 → W` (e.g. `L_2 → L_2 / p L_2`). If all brackets in `S` take prescribed values on the
pairs `D`, the number of brackets is at most the number of reduced value tuples on the pairs `P`
times `|ker π| ^ |P \ D|`. -/
theorem br_rem44_lift [Finite L2] {W : Type*} [Group W] {ι : Type*} [DecidableEq ι] (g : ι → L1)
    (hg : Subgroup.closure (Set.range g) = ⊤) (P D : Finset (ι × ι))
    (hcov : ∀ i j, i = j ∨ (i, j) ∈ P ∨ (j, i) ∈ P) (v : ι × ι → L2) (π : L2 →* W)
    (S : Set (L1 →* L1 →* L2))
    (hS : ∀ β ∈ S, brAlt β ∧ ∀ q ∈ D, β (g q.1) (g q.2) = v q) :
    S.ncard ≤ ((fun β : L1 →* L1 →* L2 => fun q : ↥P => π (β (g q.1.1) (g q.1.2))) '' S).ncard *
      Nat.card π.ker ^ (P \ D).card := by
  classical
  let R : (L1 →* L1 →* L2) → (↥P → W) := fun β q => π (β (g q.1.1) (g q.1.2))
  refine br_ncard_le_image_mul S R _ ?_
  intro a
  rcases (S ∩ R ⁻¹' {a}).eq_empty_or_nonempty with he | ⟨β0, hβ0S, hβ0a⟩
  · rw [he, Set.ncard_empty]
    exact Nat.zero_le _
  · have hβ0a' : R β0 = a := hβ0a
    have hker : ∀ β ∈ S ∩ R ⁻¹' {a}, ∀ q ∈ P,
        β (g q.1) (g q.2) / β0 (g q.1) (g q.2) ∈ π.ker := by
      rintro β ⟨-, hβa⟩ q hq
      have hβa' : R β = a := hβa
      have e := congrFun (hβa'.trans hβ0a'.symm) ⟨q, hq⟩
      rw [MonoidHom.mem_ker, map_div]
      exact div_eq_one.mpr e
    let F : (L1 →* L1 →* L2) → (↥(P \ D) → π.ker) := fun β q =>
      if hq : β (g q.1.1) (g q.1.2) / β0 (g q.1.1) (g q.1.2) ∈ π.ker then ⟨_, hq⟩ else 1
    have hv : ∀ β ∈ S ∩ R ⁻¹' {a}, ∀ q : ↥(P \ D), ((F β q : π.ker) : L2) =
        β (g q.1.1) (g q.1.2) / β0 (g q.1.1) (g q.1.2) := by
      intro β hβ q
      exact br_dite_val (hker β hβ q.1 (Finset.mem_sdiff.1 q.2).1)
    have hinj : Set.InjOn F (S ∩ R ⁻¹' {a}) := by
      intro β hβ β' hβ' hF
      obtain ⟨hβS, -⟩ := id hβ
      obtain ⟨hβS', -⟩ := id hβ'
      obtain ⟨hA, hD⟩ := hS β hβS
      obtain ⟨hA', hD'⟩ := hS β' hβS'
      have hP : ∀ q ∈ P, β (g q.1) (g q.2) = β' (g q.1) (g q.2) := by
        intro q hq
        by_cases hqD : q ∈ D
        · rw [hD q hqD, hD' q hqD]
        · have hq' : q ∈ P \ D := Finset.mem_sdiff.2 ⟨hq, hqD⟩
          have e := congrArg Subtype.val (congrFun hF ⟨q, hq'⟩)
          rw [hv β hβ ⟨q, hq'⟩, hv β' hβ' ⟨q, hq'⟩] at e
          exact div_left_inj.mp e
      have hgi : ∀ i, β (g i) = β' (g i) := by
        intro i
        apply MonoidHom.eq_of_eqOn_dense hg
        rintro _ ⟨j, rfl⟩
        rcases hcov i j with rfl | h | h
        · exact (hA _).trans (hA' _).symm
        · exact hP _ h
        · rw [br_antisymm hA (g j) (g i), br_antisymm hA' (g j) (g i), hP _ h]
      apply MonoidHom.eq_of_eqOn_dense hg
      rintro _ ⟨i, rfl⟩
      exact hgi i
    calc (S ∩ R ⁻¹' {a}).ncard ≤ Nat.card (↥(P \ D) → π.ker) :=
          br_ncard_le_card_of_injOn _ F hinj
      _ = Nat.card π.ker ^ (P \ D).card := by
          rw [Nat.card_fun, Nat.card_eq_fintype_card (α := ↥(P \ D)), Fintype.card_coe]

end BrBracket

section BrBreadth

/-! ### The breadth (48) and the breadth relations (49)-(51) -/

variable {L1 L2 L3 : Type*} [CommGroup L1] [CommGroup L2] [CommGroup L3]

/-- Eq. (48): the breadth `b = max_{u ∈ C} log_p |im ad(u)|` of a core bracket map
`κ : L_2 × C → L_3`, as the largest `k` with `p ^ k ≤ |im ad(u)|` for some `u ∈ C`. -/
noncomputable def brBreadth (p : ℕ) (κ : L2 →* L1 →* L3) (C : Subgroup L1) : ℕ :=
  sSup {k | ∃ u ∈ C, p ^ k ≤ Nat.card (κ.flip u).range}

lemma brBreadth_nonempty [Finite L3] (p : ℕ) (κ : L2 →* L1 →* L3) (C : Subgroup L1) :
    {k | ∃ u ∈ C, p ^ k ≤ Nat.card (κ.flip u).range}.Nonempty :=
  ⟨0, show ∃ u ∈ C, p ^ 0 ≤ Nat.card (κ.flip u).range from
    ⟨1, C.one_mem, by rw [pow_zero]; exact Nat.card_pos⟩⟩

lemma brBreadth_bdd [Finite L3] {p s3 : ℕ} (hp : p.Prime) (hL3 : Nat.card L3 = p ^ s3)
    (κ : L2 →* L1 →* L3) (C : Subgroup L1) :
    ∀ k ∈ {k | ∃ u ∈ C, p ^ k ≤ Nat.card (κ.flip u).range}, k ≤ s3 := by
  rintro k ⟨u, -, hk⟩
  exact br_pow_le_cancel hp.one_lt
    (hk.trans ((Subgroup.card_le_card_group (H := (κ.flip u).range)).trans hL3.le))

/-- The breadth is attained (`h*` in (48)). -/
theorem brBreadth_spec [Finite L3] {p s3 : ℕ} (hp : p.Prime) (hL3 : Nat.card L3 = p ^ s3)
    (κ : L2 →* L1 →* L3) (C : Subgroup L1) :
    ∃ h ∈ C, p ^ brBreadth p κ C ≤ Nat.card (κ.flip h).range :=
  Nat.sSup_mem (brBreadth_nonempty p κ C) ⟨s3, brBreadth_bdd hp hL3 κ C⟩

/-- `b ≤ s_3`. -/
theorem brBreadth_le_s3 [Finite L3] {p s3 : ℕ} (hp : p.Prime) (hL3 : Nat.card L3 = p ^ s3)
    (κ : L2 →* L1 →* L3) (C : Subgroup L1) : brBreadth p κ C ≤ s3 :=
  csSup_le (brBreadth_nonempty p κ C) (brBreadth_bdd hp hL3 κ C)

/-- Every slice of the core bracket map has breadth at most `b`. -/
theorem br_card_range_le_breadth [Finite L3] {p s3 : ℕ} (hp : p.Prime)
    (hL3 : Nat.card L3 = p ^ s3) (κ : L2 →* L1 →* L3) (C : Subgroup L1) {u : L1} (hu : u ∈ C) :
    Nat.card (κ.flip u).range ≤ p ^ brBreadth p κ C := by
  obtain ⟨k, -, hk⟩ := (Nat.dvd_prime_pow hp).1
    (show Nat.card (κ.flip u).range ∣ p ^ s3 by
      rw [← hL3]; exact Subgroup.card_subgroup_dvd_card _)
  rw [hk]
  exact Nat.pow_le_pow_right hp.pos
    (le_csSup ⟨s3, brBreadth_bdd hp hL3 κ C⟩
      (show ∃ v ∈ C, p ^ k ≤ Nat.card (κ.flip v).range from ⟨u, hu, hk.ge⟩))

/-- `b ≤ s_2`. -/
theorem brBreadth_le_s2 [Finite L2] [Finite L3] {p s2 s3 : ℕ} (hp : p.Prime)
    (hL2 : Nat.card L2 = p ^ s2) (hL3 : Nat.card L3 = p ^ s3) (κ : L2 →* L1 →* L3)
    (C : Subgroup L1) : brBreadth p κ C ≤ s2 := by
  obtain ⟨h, -, hh⟩ := brBreadth_spec hp hL3 κ C
  have hr : Nat.card (κ.flip h).range ≤ Nat.card L2 :=
    Nat.card_le_card_of_surjective _ (κ.flip h).rangeRestrict_surjective
  exact br_pow_le_cancel hp.one_lt (hh.trans (hr.trans hL2.le))

/-- `|⨆_{i ∈ I} H_i| ≤ M ^ |I|` when each `|H_i| ≤ M`, in a commutative group. -/
theorem br_card_finset_sup_le {L : Type*} [CommGroup L] [Finite L] {ι : Type*}
    (H : ι → Subgroup L) (M : ℕ) :
    ∀ I : Finset ι, (∀ i ∈ I, Nat.card (H i) ≤ M) → Nat.card ↥(I.sup H) ≤ M ^ I.card := by
  classical
  intro I
  refine Finset.induction_on I ?_ ?_
  · intro _
    rw [Finset.sup_empty, Subgroup.card_bot, Finset.card_empty, pow_zero]
  · intro a I ha ih hM
    rw [Finset.sup_insert, Finset.card_insert_eq_ite, if_neg ha, pow_succ, mul_comm]
    exact (br_card_sup_le _ _).trans (Nat.mul_le_mul (hM a (Finset.mem_insert_self a I))
      (ih fun i hi => hM i (Finset.mem_insert_of_mem hi)))

/-- Eq. (51): if `L_3 = [L_2, C_core]`, with `C_core` generated by the `s` core generators
`g_{1,1}, ..., g_{1,s}`, then `s_3 ≤ s b`. -/
theorem br_s3_le_breadth [Finite L3] {p r s s3 : ℕ} (hp : p.Prime) (hsr : s ≤ r)
    (hL3 : Nat.card L3 = p ^ s3) (κ : L2 →* L1 →* L3) (g : Fin r → L1)
    (hgen3 : Subgroup.closure
      {w | ∃ z, ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), κ z u = w} = ⊤) :
    s3 ≤ s * brBreadth p κ (Subgroup.closure (g '' {j | (j : ℕ) < s})) := by
  classical
  let c : Fin s → L1 := fun k => g (Fin.castLE hsr k)
  have hc : ∀ j : Fin r, ∀ hj : (j : ℕ) < s, c ⟨(j : ℕ), hj⟩ = g j := fun j hj =>
    congrArg g (Fin.ext rfl)
  have hsup : (⊤ : Subgroup L3) ≤ Finset.univ.sup (fun k => (κ.flip (c k)).range) := by
    rw [← hgen3, Subgroup.closure_le]
    rintro _ ⟨z, u, hu, rfl⟩
    have hle : Subgroup.closure (g '' {j | (j : ℕ) < s}) ≤
        (Finset.univ.sup (fun k => (κ.flip (c k)).range)).comap (κ z) := by
      rw [Subgroup.closure_le]
      rintro _ ⟨j, hj, rfl⟩
      rw [SetLike.mem_coe, Subgroup.mem_comap]
      have hj' : (j : ℕ) < s := hj
      have hmem : κ z (g j) ∈ (κ.flip (c ⟨(j : ℕ), hj'⟩)).range := by
        rw [hc j hj']
        exact ⟨z, MonoidHom.flip_apply _ _ _⟩
      exact Finset.le_sup (f := fun k => (κ.flip (c k)).range) (b := ⟨(j : ℕ), hj'⟩)
        (Finset.mem_univ _) hmem
    exact hle hu
  have hcard : Nat.card L3 ≤
      (p ^ brBreadth p κ (Subgroup.closure (g '' {j | (j : ℕ) < s}))) ^ s := by
    have h1 := br_card_finset_sup_le (fun k => (κ.flip (c k)).range)
      (p ^ brBreadth p κ (Subgroup.closure (g '' {j | (j : ℕ) < s}))) Finset.univ
      (fun k _ => br_card_range_le_breadth hp hL3 κ _
        (Subgroup.subset_closure ⟨Fin.castLE hsr k, by simp, rfl⟩))
    rw [Finset.card_univ, Fintype.card_fin] at h1
    rw [← Subgroup.card_top (G := L3)]
    exact (Subgroup.card_le_of_le hsup).trans h1
  rw [hL3, ← pow_mul] at hcard
  have h2 := br_pow_le_cancel hp.one_lt hcard
  rw [mul_comm] at h2
  exact h2

/-- The breadth relations (48)-(51) together: `s_3 ≤ s b_2` and `b_2 ≤ min(s_2, s_3)`, so that
`b_2 ∈ [⌈s_3 / s⌉, min(s_2, s_3)]`. -/
theorem br_breadth_range [Finite L2] [Finite L3] {p r s s2 s3 : ℕ} (hp : p.Prime) (hsr : s ≤ r)
    (hL2 : Nat.card L2 = p ^ s2) (hL3 : Nat.card L3 = p ^ s3) (κ : L2 →* L1 →* L3)
    (g : Fin r → L1)
    (hgen3 : Subgroup.closure
      {w | ∃ z, ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), κ z u = w} = ⊤) :
    s3 ≤ s * brBreadth p κ (Subgroup.closure (g '' {j | (j : ℕ) < s})) ∧
      brBreadth p κ (Subgroup.closure (g '' {j | (j : ℕ) < s})) ≤ min s2 s3 :=
  ⟨br_s3_le_breadth hp hsr hL3 κ g hgen3,
    le_min (brBreadth_le_s2 hp hL2 hL3 κ _) (brBreadth_le_s3 hp hL3 κ _)⟩

lemma br_finite_pairs [Finite L1] [Finite L2] [Finite L3] :
    Finite ((L1 →* L1 →* L2) × (L2 →* L1 →* L3)) := by
  haveI : Finite (L1 →* L2) :=
    Finite.of_injective (fun f : L1 →* L2 => (f : L1 → L2)) DFunLike.coe_injective
  haveI : Finite (L1 →* L3) :=
    Finite.of_injective (fun f : L1 →* L3 => (f : L1 → L3)) DFunLike.coe_injective
  haveI : Finite (L1 →* L1 →* L2) :=
    Finite.of_injective (fun f : L1 →* L1 →* L2 => (f : L1 → (L1 →* L2))) DFunLike.coe_injective
  haveI : Finite (L2 →* L1 →* L3) :=
    Finite.of_injective (fun f : L2 →* L1 →* L3 => (f : L2 → (L1 →* L3))) DFunLike.coe_injective
  infer_instance

/-- Eq. (53) at `c = 3` for a fixed breadth `b_2 = b` in the sense of (48): the paper's
fixed-breadth set of graded brackets. -/
theorem br_eq53_breadth [Finite L1] [Finite L2] [Finite L3] {p r s s2 s3 n b : ℕ}
    (hp : p.Prime) (hsr : s ≤ r) (hL2 : Nat.card L2 = p ^ s2) (hL3 : Nat.card L3 = p ^ s3)
    (y : Fin n → L2) (hy : Subgroup.closure (Set.range y) = ⊤) (g : Fin r → L1)
    (hg : Subgroup.closure (Set.range g) = ⊤) (D : Finset (Fin r × Fin r))
    (hD : ∀ q ∈ D, q.1 < q.2 ∧ (q.1 : ℕ) < s) (v : Fin r × Fin r → L2) :
    {β : (L1 →* L1 →* L2) × (L2 →* L1 →* L3) | brAlt β.1 ∧
        Subgroup.closure {w | ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}),
          ∃ u' ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β.1 u u' = w} = ⊤ ∧
        brJacobi β.1 β.2 ∧
        brBreadth p β.2 (Subgroup.closure (g '' {j | (j : ℕ) < s})) = b ∧
        ∀ q ∈ D, β.1 (g q.1) (g q.2) = v q}.ncard ≤
      p ^ (s * (b * (n + s3 + 1 - b))) *
        p ^ ((r.choose 2 - D.card) * s2 - (r - s).choose 2 * b) := by
  have := br_finite_pairs (L1 := L1) (L2 := L2) (L3 := L3)
  refine le_trans (Set.ncard_le_ncard ?_ (Set.toFinite _))
    (br_eq53 hp hsr hL2 hL3 y hy g hg D hD v)
  rintro β ⟨hA, hgen, hJ, hb, hDv⟩
  refine ⟨hA, hgen, hJ, ?_, ?_, hDv⟩
  · intro j hj
    rw [← hb]
    exact br_card_range_le_breadth hp hL3 β.2 _ (Subgroup.subset_closure ⟨j, hj, rfl⟩)
  · rw [← hb]
    exact brBreadth_spec hp hL3 β.2 _

lemma br_ncard_biUnion_le {ι α : Type*} [DecidableEq ι] (I : Finset ι) (T : ι → Set α) :
    (⋃ i ∈ I, T i).ncard ≤ ∑ i ∈ I, (T i).ncard := by
  refine Finset.induction_on I ?_ ?_
  · simp
  · intro a J ha ih
    rw [Finset.set_biUnion_insert, Finset.sum_insert ha]
    exact (Set.ncard_union_le _ _).trans (Nat.add_le_add_left ih _)

/-- Eq. (53) at `c = 3` summed over the breadth: if moreover `L_3 = [L_2, C_core]` (the
generation property used for (51)), the breadth `b_2` ranges over `s_3 ≤ s b_2 ≤ s min(s_2, s_3)`,
and the graded brackets number at most the sum over these `b_2` of the fixed-breadth bound. -/
theorem br_eq53_sum [Finite L1] [Finite L2] [Finite L3] {p r s s2 s3 n : ℕ}
    (hp : p.Prime) (hsr : s ≤ r) (hL2 : Nat.card L2 = p ^ s2) (hL3 : Nat.card L3 = p ^ s3)
    (y : Fin n → L2) (hy : Subgroup.closure (Set.range y) = ⊤) (g : Fin r → L1)
    (hg : Subgroup.closure (Set.range g) = ⊤) (D : Finset (Fin r × Fin r))
    (hD : ∀ q ∈ D, q.1 < q.2 ∧ (q.1 : ℕ) < s) (v : Fin r × Fin r → L2) :
    {β : (L1 →* L1 →* L2) × (L2 →* L1 →* L3) | brAlt β.1 ∧
        Subgroup.closure {w | ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}),
          ∃ u' ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β.1 u u' = w} = ⊤ ∧
        brJacobi β.1 β.2 ∧
        Subgroup.closure
          {w | ∃ z, ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β.2 z u = w} = ⊤ ∧
        ∀ q ∈ D, β.1 (g q.1) (g q.2) = v q}.ncard ≤
      ∑ b ∈ (Finset.range (min s2 s3 + 1)).filter (fun b => s3 ≤ s * b),
        p ^ (s * (b * (n + s3 + 1 - b))) *
          p ^ ((r.choose 2 - D.card) * s2 - (r - s).choose 2 * b) := by
  classical
  have := br_finite_pairs (L1 := L1) (L2 := L2) (L3 := L3)
  set I := (Finset.range (min s2 s3 + 1)).filter (fun b => s3 ≤ s * b) with hI
  obtain ⟨T, hT⟩ : ∃ T : ℕ → Set ((L1 →* L1 →* L2) × (L2 →* L1 →* L3)), T = fun b =>
    {β | brAlt β.1 ∧
        Subgroup.closure {w | ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}),
          ∃ u' ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β.1 u u' = w} = ⊤ ∧
        brJacobi β.1 β.2 ∧
        brBreadth p β.2 (Subgroup.closure (g '' {j | (j : ℕ) < s})) = b ∧
        ∀ q ∈ D, β.1 (g q.1) (g q.2) = v q} := ⟨_, rfl⟩
  have hsub : {β : (L1 →* L1 →* L2) × (L2 →* L1 →* L3) | brAlt β.1 ∧
        Subgroup.closure {w | ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}),
          ∃ u' ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β.1 u u' = w} = ⊤ ∧
        brJacobi β.1 β.2 ∧
        Subgroup.closure
          {w | ∃ z, ∃ u ∈ Subgroup.closure (g '' {j | (j : ℕ) < s}), β.2 z u = w} = ⊤ ∧
        ∀ q ∈ D, β.1 (g q.1) (g q.2) = v q} ⊆ ⋃ b ∈ I, T b := by
    rintro β ⟨hA, hgen, hJ, hgen3, hDv⟩
    obtain ⟨h51, hmin⟩ := br_breadth_range hp hsr hL2 hL3 β.2 g hgen3
    refine Set.mem_iUnion₂.2 ⟨brBreadth p β.2 (Subgroup.closure (g '' {j | (j : ℕ) < s})), ?_, ?_⟩
    · rw [hI, Finset.mem_filter, Finset.mem_range]
      exact ⟨Nat.lt_succ_of_le hmin, h51⟩
    · rw [hT]
      exact ⟨hA, hgen, hJ, rfl, hDv⟩
  calc _ ≤ (⋃ b ∈ I, T b).ncard := Set.ncard_le_ncard hsub (Set.toFinite _)
    _ ≤ ∑ b ∈ I, (T b).ncard := br_ncard_biUnion_le I T
    _ ≤ _ := Finset.sum_le_sum fun b _ => by
      rw [hT]
      exact br_eq53_breadth hp hsr hL2 hL3 y hy g hg D hD v

/-- The deeper commutator coefficients on the non-defining pairs: coefficient arrays
`ι × ι → Γ` (e.g. the `γ_3`-coefficients `c(1, j, k, 3, v)` of `[g_{1,j}, g_{1,k}]`), prescribed
outside `P \ D`, number at most `p ^ ((|P| - |D|) m_3)` when `|Γ| = p ^ m_3`. -/
theorem br_deeper_count {Γ : Type*} [Finite Γ] {ι : Type*} [DecidableEq ι] {p m3 : ℕ}
    (hΓ : Nat.card Γ = p ^ m3) (P D : Finset (ι × ι)) (hDP : D ⊆ P) (c0 : ι × ι → Γ) :
    {c : ι × ι → Γ | ∀ q, q ∉ P \ D → c q = c0 q}.ncard ≤ p ^ ((P.card - D.card) * m3) := by
  classical
  let F : (ι × ι → Γ) → (↥(P \ D) → Γ) := fun c q => c q.1
  have hinj : Set.InjOn F {c : ι × ι → Γ | ∀ q, q ∉ P \ D → c q = c0 q} := by
    intro c hc c' hc' he
    funext q
    by_cases hq : q ∈ P \ D
    · exact congrFun he ⟨q, hq⟩
    · rw [hc q hq, hc' q hq]
  have hk : (P \ D).card = P.card - D.card := by
    have := Finset.card_sdiff_add_card_eq_card hDP
    omega
  calc _ ≤ Nat.card (↥(P \ D) → Γ) := br_ncard_le_card_of_injOn _ F hinj
    _ = p ^ ((P.card - D.card) * m3) := by
      rw [Nat.card_fun, Nat.card_eq_fintype_card (α := ↥(P \ D)), Fintype.card_coe, hk, hΓ,
        ← pow_mul]
      ring

/-- The deeper count in the paper's form: generators `Fin r_1`, the pairs `j < k`, and a set `D`
of `r_2` defining pairs: at most `p ^ (((r_1 choose 2) - r_2) m_3)` arrays. -/
theorem br_deeper_count_fin {Γ : Type*} [Finite Γ] {p r m3 : ℕ} (hΓ : Nat.card Γ = p ^ m3)
    (D : Finset (Fin r × Fin r)) (hD : ∀ q ∈ D, q.1 < q.2) (c0 : Fin r × Fin r → Γ) :
    {c : Fin r × Fin r → Γ | ∀ q, q ∉ (Finset.univ.filter (fun q : Fin r × Fin r => q.1 < q.2)) \ D →
      c q = c0 q}.ncard ≤ p ^ ((r.choose 2 - D.card) * m3) := by
  classical
  have hTc : (Finset.univ.filter (fun q : Fin r × Fin r => q.1 < q.2)).card = r.choose 2 := by
    have h0 := br_card_pairs_fin r 0
    rw [Nat.sub_zero] at h0
    rw [← h0]
    congr 1
    ext q
    simp
  have hDP : D ⊆ Finset.univ.filter (fun q : Fin r × Fin r => q.1 < q.2) := by
    intro q hq
    rw [Finset.mem_filter]
    exact ⟨Finset.mem_univ _, hD q hq⟩
  have h := br_deeper_count hΓ _ D hDP c0
  rwa [hTc] at h

/-- The bracket sets counted above are finite once `L_1` is finitely generated and `L_2` is
finite. -/
theorem br_finite_hom_of_gen {A B : Type*} [Group A] [Group B] [Finite B] {ι : Type*} [Finite ι]
    (g : ι → A) (hg : Subgroup.closure (Set.range g) = ⊤) : Finite (A →* B) :=
  Finite.of_injective (fun f : A →* B => fun i => f (g i)) (fun f f' h =>
    MonoidHom.eq_of_eqOn_dense hg (by
      rintro _ ⟨i, rfl⟩
      exact congrFun h i))

theorem br_bracket_set_finite [Finite L2] {ι : Type*} [Finite ι] (g : ι → L1)
    (hg : Subgroup.closure (Set.range g) = ⊤) (S : Set (L1 →* L1 →* L2)) : S.Finite := by
  have := br_finite_hom_of_gen (B := L2) g hg
  have := br_finite_hom_of_gen (B := L1 →* L2) g hg
  exact Set.toFinite S

end BrBreadth

section BrLemma61

/-! ### Lemma 6.1 and the bound `s_2 ≤ r_2 (δ + 1)` -/

variable {L1 L2 : Type*} [CommGroup L1] [CommGroup L2]

/-- The subgroup generated by the brackets of elements of `S`. -/
def brBS {A B : Type*} [CommGroup A] [CommGroup B] (γ : A →* A →* B) (S : Subgroup A) :
    Subgroup B :=
  Subgroup.closure {w | ∃ a ∈ S, ∃ b ∈ S, γ a b = w}

/-- An alternating bracket on an abelian group of order `p ^ k` has values generating a subgroup
of order at most `p ^ (k choose 2)`. -/
theorem br_alt_closure_card {A B : Type*} [CommGroup A] [CommGroup B] [Finite A] [Finite B]
    {p k : ℕ} (hp : p.Prime) (γ : A →* A →* B) (hA : brAlt γ) (hk : Nat.card A = p ^ k) :
    Nat.card (Subgroup.closure {w | ∃ a b : A, γ a b = w}) ≤ p ^ k.choose 2 := by
  classical
  haveI := Fintype.ofFinite A
  have main : ∀ T : Finset A, ∀ j, Nat.card (Subgroup.closure (T : Set A)) = p ^ j →
      Nat.card (brBS γ (Subgroup.closure (T : Set A))) ≤ p ^ j.choose 2 := by
    intro T
    refine Finset.induction_on T ?_ ?_
    · intro j _
      have hbot : brBS γ (Subgroup.closure ((∅ : Finset A) : Set A)) = ⊥ := by
        rw [eq_bot_iff, brBS, Subgroup.closure_le]
        rintro _ ⟨a, ha, b, -, rfl⟩
        simp only [Finset.coe_empty, Subgroup.closure_empty, Subgroup.mem_bot] at ha
        rw [ha, map_one, MonoidHom.one_apply]
        exact Subgroup.one_mem _
      rw [hbot, Subgroup.card_bot]
      exact Nat.one_le_pow _ _ hp.pos
    · intro x T _ ih j hj
      set S' := Subgroup.closure (T : Set A) with hS'def
      set S := Subgroup.closure ((insert x T : Finset A) : Set A) with hSdef
      have hS : S = Subgroup.closure {x} ⊔ S' := by
        rw [hSdef, Finset.coe_insert, Set.insert_eq, Subgroup.closure_union]
      have hdS' : Nat.card S' ∣ p ^ k := by
        rw [← hk]
        exact Subgroup.card_subgroup_dvd_card S'
      obtain ⟨j', -, hj'⟩ := (Nat.dvd_prime_pow hp).1 hdS'
      have IH := ih j' hj'
      have hle : S' ≤ S := by rw [hS]; exact le_sup_right
      by_cases heq : S' = S
      · rw [← heq, hj'] at hj
        have hjj : j' = j := Nat.pow_right_injective hp.two_le hj
        rw [← heq, ← hjj]
        exact IH
      · have hne : Nat.card S' ≠ Nat.card S := fun h' =>
          heq (Subgroup.eq_of_le_of_card_ge hle h'.symm.le)
        have hdvd := Subgroup.card_dvd_of_le hle
        rw [hj', hj] at hdvd
        rw [hj', hj] at hne
        have h1 : j' ≤ j := (Nat.pow_dvd_pow_iff_le_right hp.one_lt).1 hdvd
        have h2 : j' ≠ j := fun h' => hne (by rw [h'])
        have hlt : j' + 1 ≤ j := by omega
        let R := S'.map (γ.flip x)
        set Qs := brBS γ S' ⊔ R with hQs
        have f1 : ∀ b ∈ S, γ x b ∈ Qs := by
          have hc : S ≤ Qs.comap (γ x) := by
            rw [hS]
            refine sup_le ?_ ?_
            · rw [Subgroup.closure_le, Set.singleton_subset_iff]
              show γ x x ∈ Qs
              rw [hA x]
              exact Subgroup.one_mem _
            · intro b' hb'
              show γ x b' ∈ Qs
              rw [br_antisymm hA b' x]
              exact Subgroup.mem_sup_right (Subgroup.inv_mem _
                (Subgroup.mem_map.2 ⟨b', hb', MonoidHom.flip_apply _ _ _⟩))
          exact fun b hb => hc hb
        have f2 : ∀ a' ∈ S', ∀ b ∈ S, γ a' b ∈ Qs := by
          intro a' ha'
          have hc : S ≤ Qs.comap (γ a') := by
            rw [hS]
            refine sup_le ?_ ?_
            · rw [Subgroup.closure_le, Set.singleton_subset_iff]
              show γ a' x ∈ Qs
              exact Subgroup.mem_sup_right
                (Subgroup.mem_map.2 ⟨a', ha', MonoidHom.flip_apply _ _ _⟩)
            · intro b' hb'
              show γ a' b' ∈ Qs
              exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨a', ha', b', hb', rfl⟩)
          exact fun b hb => hc hb
        have f3 : ∀ b ∈ S, S ≤ Qs.comap (γ.flip b) := by
          intro b hb
          rw [hS]
          refine sup_le ?_ ?_
          · rw [Subgroup.closure_le, Set.singleton_subset_iff]
            show γ.flip b x ∈ Qs
            rw [MonoidHom.flip_apply]
            exact f1 b hb
          · intro a' ha'
            show γ.flip b a' ∈ Qs
            rw [MonoidHom.flip_apply]
            exact f2 a' ha' b hb
        have hsub : brBS γ S ≤ Qs := by
          rw [brBS, Subgroup.closure_le]
          rintro _ ⟨a, ha, b, hb, rfl⟩
          have := f3 b hb ha
          rw [Subgroup.mem_comap, MonoidHom.flip_apply] at this
          exact this
        have hR : Nat.card R ≤ Nat.card S' :=
          Nat.card_le_card_of_surjective _ (MonoidHom.subgroupMap_surjective (γ.flip x) S')
        calc Nat.card (brBS γ S) ≤ Nat.card ↥Qs := Subgroup.card_le_of_le hsub
          _ ≤ Nat.card (brBS γ S') * Nat.card R := br_card_sup_le _ _
          _ ≤ p ^ j'.choose 2 * p ^ j' := Nat.mul_le_mul IH (hR.trans hj'.le)
          _ = p ^ (j' + 1).choose 2 := by
              rw [Nat.choose_succ_succ', Nat.choose_one_right, pow_add, mul_comm]
          _ ≤ p ^ j.choose 2 := Nat.pow_le_pow_right hp.pos (Nat.choose_le_choose 2 hlt)
  have key := main Finset.univ k (by rw [Finset.coe_univ, Subgroup.closure_univ,
    Subgroup.card_top, hk])
  have e : brBS γ (Subgroup.closure ((Finset.univ : Finset A) : Set A)) =
      Subgroup.closure {w | ∃ a b : A, γ a b = w} := by
    rw [Finset.coe_univ, Subgroup.closure_univ, brBS]
    congr 1
    ext w
    simp
  rw [← e]
  exact key

/-- Lemma 6.1 (abstract). For an alternating bracket `β : L_1 × L_1 → L_2` whose values generate
`L_2`, with `|p L_1| = p ^ δ`, one has `|p L_2| ≤ p ^ (δ choose 2)`, i.e.
`e = s_2 - r_2 ≤ (δ choose 2)`. -/
theorem br_lemma61 [Finite L1] [Finite L2] {p δ : ℕ} (hp : p.Prime) (β : L1 →* L1 →* L2)
    (hA : brAlt β) (hgen : Subgroup.closure (Set.range (fun q : L1 × L1 => β q.1 q.2)) = ⊤)
    (hd : Nat.card (powMonoidHom p : L1 →* L1).range = p ^ δ) :
    Nat.card (powMonoidHom p : L2 →* L2).range ≤ p ^ δ.choose 2 := by
  classical
  set P := (powMonoidHom p : L1 →* L1).range with hP
  have hroot : ∀ a : P, ∃ x : L1, x ^ p = (a : L1) := fun a => by
    obtain ⟨x, hx⟩ := MonoidHom.mem_range.1 a.2
    exact ⟨x, hx⟩
  let r : P → L1 := fun a => Classical.choose (hroot a)
  have hr : ∀ a, r a ^ p = (a : L1) := fun a => Classical.choose_spec (hroot a)
  have hvan : ∀ k : L1, k ^ p = 1 → ∀ b : P, β k (b : L1) = 1 := by
    intro k hk b
    obtain ⟨y, hy⟩ := hroot b
    rw [← hy, map_pow, ← br_map_pow_left, hk, map_one, MonoidHom.one_apply]
  let γ : P →* P →* L2 := MonoidHom.mk' (fun a => (β (r a)).comp P.subtype) (by
    intro a a'
    ext b
    simp only [MonoidHom.comp_apply, Subgroup.coe_subtype, MonoidHom.mul_apply]
    have hk : (r (a * a') * (r a * r a')⁻¹) ^ p = 1 := by
      rw [mul_pow, inv_pow, mul_pow, hr, hr, hr]
      simp
    have h0 := hvan _ hk b
    simp only [map_mul, map_inv, MonoidHom.mul_apply, MonoidHom.inv_apply] at h0
    exact mul_inv_eq_one.mp h0)
  have hγ : ∀ a b : P, γ a b = β (r a) (b : L1) := fun a b => rfl
  have hAγ : brAlt γ := by
    intro a
    rw [hγ]
    conv_lhs => rw [← hr a]
    rw [map_pow, hA (r a), one_pow]
  have hQ : (powMonoidHom p : L2 →* L2).range ≤ Subgroup.closure {w | ∃ a b : P, γ a b = w} := by
    have h1 : Subgroup.closure (Set.range (fun q : L1 × L1 => β q.1 q.2)) ≤
        (Subgroup.closure {w | ∃ a b : P, γ a b = w}).comap (powMonoidHom p) := by
      rw [Subgroup.closure_le]
      rintro _ ⟨⟨x, y⟩, rfl⟩
      show powMonoidHom p (β x y) ∈ Subgroup.closure {w | ∃ a b : P, γ a b = w}
      rw [powMonoidHom_apply]
      apply Subgroup.subset_closure
      let ax : P := ⟨x ^ p, x, rfl⟩
      let ay : P := ⟨y ^ p, y, rfl⟩
      refine ⟨ax, ay, ?_⟩
      have e1 : r ax ^ p = x ^ p := hr ax
      calc γ ax ay = β (r ax) (y ^ p) := rfl
        _ = (β (r ax) y) ^ p := map_pow _ _ _
        _ = β (r ax ^ p) y := (br_map_pow_left β _ y p).symm
        _ = β (x ^ p) y := by rw [e1]
        _ = (β x y) ^ p := br_map_pow_left β x y p
    rw [hgen] at h1
    rintro _ ⟨z, rfl⟩
    exact h1 (Subgroup.mem_top z)
  calc Nat.card (powMonoidHom p : L2 →* L2).range
      ≤ Nat.card (Subgroup.closure {w | ∃ a b : P, γ a b = w}) := Subgroup.card_le_of_le hQ
    _ ≤ p ^ δ.choose 2 := br_alt_closure_card hp γ hAγ hd

/-- A commutative group generated by a finite set `T`, of exponent dividing `n`, has order
at most `n ^ |T|`. -/
theorem br_card_le_of_exp {L : Type*} [CommGroup L] [Finite L] {n : ℕ} (hn : 0 < n)
    (hexp : ∀ z : L, z ^ n = 1) (T : Finset L) (hT : Subgroup.closure (T : Set L) = ⊤) :
    Nat.card L ≤ n ^ T.card := by
  classical
  have main : ∀ T : Finset L, Nat.card (Subgroup.closure (T : Set L)) ≤ n ^ T.card := by
    intro T
    refine Finset.induction_on T ?_ ?_
    · simp
    · intro x T hx ih
      rw [Finset.coe_insert, Set.insert_eq, Subgroup.closure_union, Finset.card_insert_eq_ite,
        if_neg hx, pow_succ, mul_comm]
      refine le_trans (br_card_sup_le _ _) (Nat.mul_le_mul ?_ ih)
      rw [← Subgroup.zpowers_eq_closure, Nat.card_zpowers]
      exact orderOf_le_of_pow_eq_one hn (hexp x)
  have h := main T
  rwa [hT, Subgroup.card_top] at h

/-- Eq. (126), abstract: if `|p L_1| = p ^ δ` and the bracket values generate `L_2`, then
`L_2` has exponent dividing `p ^ (δ + 1)`, so `|L_2| ≤ p ^ ((δ + 1) |T|)` for a generating set `T`
of `L_2`; with `|T| = r_2` this is `s_2 ≤ r_2 (δ + 1)`. -/
theorem br_s2_le [Finite L1] [Finite L2] {p δ : ℕ} (hp : p.Prime) (β : L1 →* L1 →* L2)
    (hgen : Subgroup.closure (Set.range (fun q : L1 × L1 => β q.1 q.2)) = ⊤)
    (hd : Nat.card (powMonoidHom p : L1 →* L1).range = p ^ δ) (T : Finset L2)
    (hT : Subgroup.closure (T : Set L2) = ⊤) :
    Nat.card L2 ≤ p ^ ((δ + 1) * T.card) := by
  have hx : ∀ x : L1, x ^ (p ^ (δ + 1)) = 1 := by
    intro x
    have h1 : (⟨x ^ p, x, rfl⟩ : (powMonoidHom p : L1 →* L1).range) ^
        Nat.card (powMonoidHom p : L1 →* L1).range = 1 := pow_card_eq_one'
    rw [hd] at h1
    have h2 := congrArg Subtype.val h1
    simp only [SubgroupClass.coe_pow, OneMemClass.coe_one] at h2
    rw [pow_succ', pow_mul]
    exact h2
  have hz : ∀ z : L2, z ^ (p ^ (δ + 1)) = 1 := by
    have hle : Subgroup.closure (Set.range (fun q : L1 × L1 => β q.1 q.2)) ≤
        (powMonoidHom (p ^ (δ + 1)) : L2 →* L2).ker := by
      rw [Subgroup.closure_le]
      rintro _ ⟨⟨x, y⟩, rfl⟩
      show (β x y) ^ (p ^ (δ + 1)) = 1
      rw [← br_map_pow_left, hx, map_one, MonoidHom.one_apply]
    rw [hgen] at hle
    intro z
    exact (MonoidHom.mem_ker).1 (hle (Subgroup.mem_top z))
  have h := br_card_le_of_exp (Nat.pos_of_ne_zero (pow_ne_zero _ hp.ne_zero)) hz T hT
  rwa [← pow_mul] at h

end BrLemma61

section BrGroup

/-! ### The class-3 graded brackets of a group -/

variable {G : Type u} [Group G]

lemma br_mk'_eq {H : Type*} [Group H] (N : Subgroup H) [N.Normal] {x y : H}
    (h : x * y⁻¹ ∈ N) : QuotientGroup.mk' N x = QuotientGroup.mk' N y := by
  have h1 : QuotientGroup.mk' N (x * y⁻¹) = 1 := by
    rw [← MonoidHom.mem_ker, QuotientGroup.ker_mk']
    exact h
  rw [map_mul, map_inv] at h1
  exact mul_inv_eq_one.mp h1

/-- A section `A / B` with `[A, A] ≤ B` is commutative. -/
theorem br_sect_comm {A B : Subgroup G} [(B.subgroupOf A).Normal]
    (h : ∀ x ∈ A, ∀ y ∈ A, ⁅x, y⁆ ∈ B) (a b : A ⧸ B.subgroupOf A) : a * b = b * a := by
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (B.subgroupOf A) a
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (B.subgroupOf A) b
  rw [← map_mul, ← map_mul]
  apply br_mk'_eq
  rw [Subgroup.mem_subgroupOf]
  show (x : G) * (y : G) * ((y : G) * (x : G))⁻¹ ∈ B
  have e : (x : G) * (y : G) * ((y : G) * (x : G))⁻¹ = ⁅(x : G), (y : G)⁆ := by
    simp only [commutatorElement_def]
    group
  rw [e]
  exact h _ x.2 _ y.2

variable (G) in
/-- `L_2 = γ_2 / γ_3`. -/
def brL2 : Type u := lcs G 1 ⧸ (lcs G 2).subgroupOf (lcs G 1)

variable (G) in
/-- `L_3 = γ_3 / γ_4`. -/
def brL3 : Type u := lcs G 2 ⧸ (lcs G 3).subgroupOf (lcs G 2)

noncomputable instance brL2.instCommGroup : CommGroup (brL2 G) :=
  { (inferInstance : Group (lcs G 1 ⧸ (lcs G 2).subgroupOf (lcs G 1))) with
    mul_comm := br_sect_comm (A := lcs G 1) (B := lcs G 2) (fun x hx y hy =>
      lcs_antitone (by norm_num) (commElem_mem_lcs_add hx hy)) }

noncomputable instance brL3.instCommGroup : CommGroup (brL3 G) :=
  { (inferInstance : Group (lcs G 2 ⧸ (lcs G 3).subgroupOf (lcs G 2))) with
    mul_comm := br_sect_comm (A := lcs G 2) (B := lcs G 3) (fun x hx y hy =>
      lcs_antitone (by norm_num) (commElem_mem_lcs_add hx hy)) }

instance brL2.instFinite [Finite G] : Finite (brL2 G) :=
  inferInstanceAs (Finite (lcs G 1 ⧸ (lcs G 2).subgroupOf (lcs G 1)))

instance brL3.instFinite [Finite G] : Finite (brL3 G) :=
  inferInstanceAs (Finite (lcs G 2 ⧸ (lcs G 3).subgroupOf (lcs G 2)))

variable (G) in
/-- The projection `γ_2 → L_2`. -/
noncomputable def brq2 : lcs G 1 →* brL2 G := QuotientGroup.mk' ((lcs G 2).subgroupOf (lcs G 1))

variable (G) in
/-- The projection `γ_3 → L_3`. -/
noncomputable def brq3 : lcs G 2 →* brL3 G := QuotientGroup.mk' ((lcs G 3).subgroupOf (lcs G 2))

theorem brq2_surjective : Function.Surjective (brq2 G) :=
  QuotientGroup.mk'_surjective ((lcs G 2).subgroupOf (lcs G 1))

theorem brq2_eq_one_iff (w : lcs G 1) : brq2 G w = 1 ↔ (w : G) ∈ lcs G 2 := by
  have hk : (brq2 G).ker = (lcs G 2).subgroupOf (lcs G 1) :=
    QuotientGroup.ker_mk' ((lcs G 2).subgroupOf (lcs G 1))
  rw [← MonoidHom.mem_ker, hk, Subgroup.mem_subgroupOf]

theorem brq3_eq_one_iff (w : lcs G 2) : brq3 G w = 1 ↔ (w : G) ∈ lcs G 3 := by
  have hk : (brq3 G).ker = (lcs G 3).subgroupOf (lcs G 2) :=
    QuotientGroup.ker_mk' ((lcs G 3).subgroupOf (lcs G 2))
  rw [← MonoidHom.mem_ker, hk, Subgroup.mem_subgroupOf]

theorem brq2_eq_of {a b : lcs G 1} (h : (a : G) * (b : G)⁻¹ ∈ lcs G 2) :
    brq2 G a = brq2 G b := by
  have h1 : brq2 G (a * b⁻¹) = 1 := (brq2_eq_one_iff _).2 h
  rw [map_mul, map_inv] at h1
  exact mul_inv_eq_one.mp h1

theorem brq3_eq_of {a b : lcs G 2} (h : (a : G) * (b : G)⁻¹ ∈ lcs G 3) :
    brq3 G a = brq3 G b := by
  have h1 : brq3 G (a * b⁻¹) = 1 := (brq3_eq_one_iff _).2 h
  rw [map_mul, map_inv] at h1
  exact mul_inv_eq_one.mp h1

/-- The element `⁅w, y⁆ ∈ γ_3` for `w ∈ γ_2`. -/
def cw2 (w : lcs G 1) (y : G) : lcs G 2 := ⟨⁅(w : G), y⁆, commElem_mem_lcs_succ w.2 y⟩

theorem brq2_cw_mul_right (x y z : G) :
    brq2 G (cw x (y * z)) = brq2 G (cw x y) * brq2 G (cw x z) := by
  rw [← map_mul]
  apply brq2_eq_of
  show ⁅x, y * z⁆ * (⁅x, y⁆ * ⁅x, z⁆)⁻¹ ∈ lcs G 2
  rw [commElem_mul_right]
  have hc : ⁅y, ⁅x, z⁆⁆ ∈ lcs G 2 :=
    commElem_mem_lcs_succ' y (commElem_mem_lcs_succ' (n := 0) x (Subgroup.mem_top z))
  have e : ⁅x, y⁆ * ⁅y, ⁅x, z⁆⁆ * ⁅x, z⁆ * (⁅x, y⁆ * ⁅x, z⁆)⁻¹ =
      ⁅x, y⁆ * ⁅y, ⁅x, z⁆⁆ * ⁅x, y⁆⁻¹ := by group
  rw [e]
  exact Subgroup.Normal.conj_mem inferInstance _ hc _

theorem brq2_cw_mul_left (x x' y : G) :
    brq2 G (cw (x * x') y) = brq2 G (cw x y) * brq2 G (cw x' y) := by
  rw [mul_comm (brq2 G (cw x y)), ← map_mul]
  apply brq2_eq_of
  show ⁅x * x', y⁆ * (⁅x', y⁆ * ⁅x, y⁆)⁻¹ ∈ lcs G 2
  rw [commElem_mul_left]
  have e : ⁅x, ⁅x', y⁆⁆ * ⁅x', y⁆ * ⁅x, y⁆ * (⁅x', y⁆ * ⁅x, y⁆)⁻¹ = ⁅x, ⁅x', y⁆⁆ := by group
  rw [e]
  exact commElem_mem_lcs_succ' x (commElem_mem_lcs_succ' (n := 0) x' (Subgroup.mem_top y))

theorem brq3_cw2_mul_right (w : lcs G 1) (y z : G) :
    brq3 G (cw2 w (y * z)) = brq3 G (cw2 w y) * brq3 G (cw2 w z) := by
  rw [← map_mul]
  apply brq3_eq_of
  show ⁅(w : G), y * z⁆ * (⁅(w : G), y⁆ * ⁅(w : G), z⁆)⁻¹ ∈ lcs G 3
  rw [commElem_mul_right]
  have hc : ⁅y, ⁅(w : G), z⁆⁆ ∈ lcs G 3 :=
    commElem_mem_lcs_succ' y (commElem_mem_lcs_succ w.2 z)
  have e : ⁅(w : G), y⁆ * ⁅y, ⁅(w : G), z⁆⁆ * ⁅(w : G), z⁆ * (⁅(w : G), y⁆ * ⁅(w : G), z⁆)⁻¹ =
      ⁅(w : G), y⁆ * ⁅y, ⁅(w : G), z⁆⁆ * ⁅(w : G), y⁆⁻¹ := by group
  rw [e]
  exact Subgroup.Normal.conj_mem inferInstance _ hc _

theorem brq3_cw2_mul_left (w w' : lcs G 1) (y : G) :
    brq3 G (cw2 (w * w') y) = brq3 G (cw2 w y) * brq3 G (cw2 w' y) := by
  rw [mul_comm (brq3 G (cw2 w y)), ← map_mul]
  apply brq3_eq_of
  show ⁅(w : G) * (w' : G), y⁆ * (⁅(w' : G), y⁆ * ⁅(w : G), y⁆)⁻¹ ∈ lcs G 3
  rw [commElem_mul_left]
  have e : ⁅(w : G), ⁅(w' : G), y⁆⁆ * ⁅(w' : G), y⁆ * ⁅(w : G), y⁆ *
      (⁅(w' : G), y⁆ * ⁅(w : G), y⁆)⁻¹ = ⁅(w : G), ⁅(w' : G), y⁆⁆ := by group
  rw [e]
  exact commElem_mem_lcs_succ' (w : G) (commElem_mem_lcs_succ w'.2 y)

/-- `y ↦ [x, y] γ_3`. -/
noncomputable def brHom1 (x : G) : G →* brL2 G :=
  MonoidHom.mk' (fun y => brq2 G (cw x y)) (fun y z => brq2_cw_mul_right x y z)

/-- `y ↦ [w, y] γ_4` for `w ∈ γ_2`. -/
noncomputable def brHom2 (w : lcs G 1) : G →* brL3 G :=
  MonoidHom.mk' (fun y => brq3 G (cw2 w y)) (fun y z => brq3_cw2_mul_right w y z)

theorem brHom1_mul (x x' : G) : brHom1 (x * x') = brHom1 x * brHom1 x' := by
  ext y
  rw [MonoidHom.mul_apply]
  exact brq2_cw_mul_left x x' y

theorem brHom2_mul (w w' : lcs G 1) : brHom2 (w * w') = brHom2 w * brHom2 w' := by
  ext y
  rw [MonoidHom.mul_apply]
  exact brq3_cw2_mul_left w w' y

theorem br_lift_mul {A : Type*} [CommGroup A] (f f' : G →* A) :
    Abelianization.lift (f * f') = Abelianization.lift f * Abelianization.lift f' := by
  apply Abelianization.hom_ext
  ext y
  simp only [MonoidHom.comp_apply, MonoidHom.mul_apply, Abelianization.lift_apply_of]

variable (G) in
/-- The bracket `L_1 × L_1 → L_2`, `L_1 = G^ab`. -/
noncomputable def brB1 : Abelianization G →* Abelianization G →* brL2 G :=
  Abelianization.lift (MonoidHom.mk' (fun x => Abelianization.lift (brHom1 x))
    (fun x x' => by
      show Abelianization.lift (brHom1 (x * x')) =
        Abelianization.lift (brHom1 x) * Abelianization.lift (brHom1 x')
      rw [brHom1_mul, br_lift_mul]))

variable (G) in
/-- The bracket `L_2 × L_1 → L_3`. -/
noncomputable def brB2 : brL2 G →* Abelianization G →* brL3 G :=
  QuotientGroup.lift ((lcs G 2).subgroupOf (lcs G 1))
    (MonoidHom.mk' (fun w => Abelianization.lift (brHom2 w))
      (fun w w' => by
        show Abelianization.lift (brHom2 (w * w')) =
          Abelianization.lift (brHom2 w) * Abelianization.lift (brHom2 w')
        rw [brHom2_mul, br_lift_mul]))
    (by
      intro w hw
      rw [MonoidHom.mem_ker]
      apply Abelianization.hom_ext
      ext y
      show brq3 G (cw2 w y) = 1
      rw [brq3_eq_one_iff]
      rw [Subgroup.mem_subgroupOf] at hw
      exact commElem_mem_lcs_succ hw y)

theorem brB1_of (x y : G) :
    brB1 G (Abelianization.of x) (Abelianization.of y) = brq2 G (cw x y) := rfl

theorem brB2_mk_of (w : lcs G 1) (z : G) :
    brB2 G (brq2 G w) (Abelianization.of z) = brq3 G (cw2 w z) := rfl

theorem br_of_surjective : Function.Surjective (Abelianization.of : G →* Abelianization G) :=
  fun a => QuotientGroup.induction_on a fun x => ⟨x, rfl⟩

instance br_abel_finite [Finite G] : Finite (Abelianization G) :=
  Finite.of_surjective _ br_of_surjective

/-- The bracket `L_1 × L_1 → L_2` is alternating. -/
theorem brB1_alt : brAlt (brB1 G) := by
  intro a
  obtain ⟨x, rfl⟩ := br_of_surjective a
  rw [brB1_of, brq2_eq_one_iff]
  show ⁅x, x⁆ ∈ lcs G 2
  rw [commutatorElement_self]
  exact Subgroup.one_mem _

/-- The values of `L_1 × L_1 → L_2` generate `L_2`. -/
theorem brB1_closure :
    Subgroup.closure (Set.range (fun q : Abelianization G × Abelianization G =>
      brB1 G q.1 q.2)) = ⊤ := by
  set K := Subgroup.closure (Set.range (fun q : Abelianization G × Abelianization G =>
      brB1 G q.1 q.2)) with hK
  have hcw : ∀ a b : G, cw a b ∈ K.comap (brq2 G) := by
    intro a b
    rw [Subgroup.mem_comap]
    exact Subgroup.subset_closure ⟨(Abelianization.of a, Abelianization.of b), rfl⟩
  have hle : commutator G ≤ (K.comap (brq2 G)).map (lcs G 1).subtype := by
    rw [commutator_eq_closure, Subgroup.closure_le]
    rintro _ ⟨a, b, rfl⟩
    exact Subgroup.mem_map.2 ⟨cw a b, hcw a b, rfl⟩
  rw [eq_top_iff]
  intro q _
  obtain ⟨w, rfl⟩ := brq2_surjective q
  have hw : (w : G) ∈ commutator G := by
    rw [commutator_eq_lcs_one]
    exact w.2
  obtain ⟨w', hw', hww⟩ := Subgroup.mem_map.1 (hle hw)
  have : w' = w := Subtype.ext hww
  rw [← this]
  exact hw'

/-- The Hall-Witt identity. -/
theorem br_hall_witt (a b c : G) :
    ⁅⁅a, b⁆, b * c * b⁻¹⁆ * ⁅⁅b, c⁆, c * a * c⁻¹⁆ * ⁅⁅c, a⁆, a * b * a⁻¹⁆ = 1 := by
  simp only [commutatorElement_def]
  group

lemma br_conj_comm_mem {w : G} (hw : w ∈ lcs G 1) (y z : G) :
    ⁅w, z⁆ * ⁅w, y * z * y⁻¹⁆⁻¹ ∈ lcs G 3 := by
  have e : y * z * y⁻¹ = ⁅y, z⁆ * z := by
    simp only [commutatorElement_def]
    group
  rw [e, commElem_mul_right]
  have h1 : ⁅w, ⁅y, z⁆⁆ ∈ lcs G 3 :=
    commElem_mem_lcs_add (a := 1) (b := 1) hw (commElem_mem_lcs_one y z)
  have h2 : ⁅⁅y, z⁆, ⁅w, z⁆⁆ ∈ lcs G 3 :=
    lcs_antitone (show 3 ≤ 1 + 2 + 1 by norm_num) (commElem_mem_lcs_add (a := 1) (b := 2)
      (commElem_mem_lcs_one y z) (commElem_mem_lcs_succ hw z))
  have e2 : ⁅w, z⁆ * (⁅w, ⁅y, z⁆⁆ * ⁅⁅y, z⁆, ⁅w, z⁆⁆ * ⁅w, z⁆)⁻¹ =
      ⁅⁅y, z⁆, ⁅w, z⁆⁆⁻¹ * ⁅w, ⁅y, z⁆⁆⁻¹ := by group
  rw [e2]
  exact mul_mem (inv_mem h2) (inv_mem h1)

/-- The Jacobi identity for the graded brackets, from the Hall-Witt identity. -/
theorem brB_jacobi : brJacobi (brB1 G) (brB2 G) := by
  intro a b c
  obtain ⟨x, rfl⟩ := br_of_surjective a
  obtain ⟨y, rfl⟩ := br_of_surjective b
  obtain ⟨z, rfl⟩ := br_of_surjective c
  rw [brB1_of, brB1_of, brB1_of, brB2_mk_of, brB2_mk_of, brB2_mk_of, ← map_mul, ← map_mul,
    brq3_eq_one_iff]
  show ⁅⁅x, y⁆, z⁆ * ⁅⁅y, z⁆, x⁆ * ⁅⁅z, x⁆, y⁆ ∈ lcs G 3
  have h1 := br_conj_comm_mem (commElem_mem_lcs_one x y) y z
  have h2 := br_conj_comm_mem (commElem_mem_lcs_one y z) z x
  have h3 := br_conj_comm_mem (commElem_mem_lcs_one z x) x y
  have key : QuotientGroup.mk' (lcs G 3) (⁅⁅x, y⁆, z⁆ * ⁅⁅y, z⁆, x⁆ * ⁅⁅z, x⁆, y⁆) = 1 := by
    rw [map_mul, map_mul, br_mk'_eq _ h1, br_mk'_eq _ h2, br_mk'_eq _ h3, ← map_mul, ← map_mul,
      br_hall_witt, map_one]
  rwa [← MonoidHom.mem_ker, QuotientGroup.ker_mk'] at key

/-! ### Group-level Lemma 6.1 and (126) -/

variable {p : ℕ} [hp : Fact p.Prime] [Finite G]

/-- `|γ_2| = |γ_3| |L_2|`. -/
theorem br_card_lcs_one : Nat.card (lcs G 1) = Nat.card (lcs G 2) * Nat.card (brL2 G) := by
  have h1 := Subgroup.card_mul_index ((lcs G 2).subgroupOf (lcs G 1))
  have h2 := Nat.card_congr (Subgroup.subgroupOfEquivOfLe
    (lcs_antitone (D := G) (show 1 ≤ 2 by norm_num))).toEquiv
  rw [h2] at h1
  exact h1.symm

/-- `|L_2| = |p L_2| p ^ r_2`. -/
theorem br_card_L2 (hG : IsPGroup p G) :
    Nat.card (powMonoidHom p : brL2 G →* brL2 G).range * p ^ r2 p G = Nat.card (brL2 G) := by
  have hQ : IsPGroup p (brL2 G) := (hG.to_subgroup (lcs G 1)).to_quotient _
  have h1 : (pPhi p (brL2 G)).index = p ^ Group.rank (brL2 G) := card_quot_pPhi hQ
  have h2 : Group.rank (brL2 G) = r2 p G := rank_lcs_quot_eq_r2 hG
  have h3 : pPhi p (brL2 G) = (powMonoidHom p : brL2 G →* brL2 G).range := by
    apply le_antisymm
    · refine sup_le ?_ ?_
      · rw [Subgroup.closure_le]
        rintro _ ⟨g, rfl⟩
        exact ⟨g, rfl⟩
      · rw [commutator_def, Subgroup.commutator_le]
        intro g1 _ g2 _
        rw [commutatorElement_eq_one_iff_mul_comm.mpr (mul_comm g1 g2)]
        exact Subgroup.one_mem _
    · rintro _ ⟨g, rfl⟩
      exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨g, rfl⟩)
  rw [h3, h2] at h1
  rw [← h1]
  exact Subgroup.card_mul_index _

/-- `|p G^ab| = p ^ λ`. -/
theorem br_card_pL1 (hG : IsPGroup p G) :
    Nat.card (powMonoidHom p : Abelianization G →* Abelianization G).range =
      p ^ lambdaPar p G := by
  have hK : elemK p G (pPhi p G) = (powMonoidHom p : Abelianization G →* Abelianization G).range := by
    apply le_antisymm _ le_sup_right
    refine sup_le ?_ le_rfl
    rw [Subgroup.map_sup]
    refine sup_le ?_ ?_
    · rw [MonoidHom.map_closure, Subgroup.closure_le]
      rintro _ ⟨_, ⟨g, rfl⟩, rfl⟩
      exact ⟨Abelianization.of g, (map_pow Abelianization.of g p).symm⟩
    · rw [Subgroup.map_le_iff_le_comap]
      intro x hx
      rw [Subgroup.mem_comap]
      have h1 : Abelianization.of x = 1 := by
        rw [← MonoidHom.mem_ker, Abelianization.ker_of]
        exact hx
      rw [h1]
      exact Subgroup.one_mem _
  have hV : (elemK p G (pPhi p G)).index = p ^ Group.rank G := card_V hG
  have hAb : Nat.card (Abelianization G) = p ^ (Group.rank G + lambdaPar p G) := by
    rw [← index_lcs_one_eq hG, ← commutator_eq_lcs_one]
    rfl
  have h1 := Subgroup.card_mul_index (elemK p G (pPhi p G))
  rw [hV, hAb, hK, pow_add, mul_comm (p ^ Group.rank G)] at h1
  exact Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero (pow_ne_zero _ hp.out.ne_zero)) h1

/-- Lemma 6.1 for a finite `p`-group: `|γ_2| ≤ |γ_3| p ^ (r_2 + (λ choose 2))`, i.e.
`e = m_2 - m_3 - r_2 ≤ (λ choose 2)`. -/
theorem br_lemma61_group (hG : IsPGroup p G) :
    Nat.card (lcs G 1) ≤ Nat.card (lcs G 2) * p ^ (r2 p G + (lambdaPar p G).choose 2) := by
  have h61 := br_lemma61 hp.out (brB1 G) brB1_alt brB1_closure (br_card_pL1 hG)
  rw [br_card_lcs_one, ← br_card_L2 hG, pow_add, mul_comm (p ^ r2 p G)]
  exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ h61)

/-- Eq. (126) for a finite `p`-group: `|γ_2| ≤ |γ_3| p ^ (r_2 (λ + 1))`, i.e.
`m_2 - m_3 ≤ r_2 (λ + 1)`. -/
theorem br_s2_le_group (hG : IsPGroup p G) :
    Nat.card (lcs G 1) ≤ Nat.card (lcs G 2) * p ^ (r2 p G * (lambdaPar p G + 1)) := by
  obtain ⟨T, hTc, hT⟩ := Group.rank_spec (brL2 G)
  have h := br_s2_le hp.out (brB1 G) brB1_closure (br_card_pL1 hG) T hT
  have hr : Group.rank (brL2 G) = r2 p G := rank_lcs_quot_eq_r2 hG
  rw [hTc, hr, mul_comm] at h
  rw [br_card_lcs_one]
  exact Nat.mul_le_mul_left _ h

end BrGroup

/-! ### Transport of the graded brackets to fixed layers

For CNT3 the brackets of a group are compared on fixed layers `L_1, L_2, L_3` (the ones carried
by the recorded Sims data): identifications `e_1 : G^ab ≃ L_1`, `e_2 : γ_2/γ_3 ≃ L_2`,
`e_3 : γ_3/γ_4 ≃ L_3` transport `brB1 G`, `brB2 G` to brackets on `L_1, L_2, L_3`, which are
alternating, satisfy the Jacobi identity, and generate `L_2`; their values on generators are the
transported leading commutators `[g_j, g_k] γ_3` and `[[g_j, g_k], g_l] γ_4`. -/

section BrTransport

variable {G : Type u} [Group G] {L1 L2 L3 : Type*} [CommGroup L1] [CommGroup L2] [CommGroup L3]

/-- The bracket `L_1 × L_1 → L_2` transported along `e_1`, `e_2`. -/
noncomputable def brT1 (e1 : Abelianization G ≃* L1) (e2 : brL2 G ≃* L2) : L1 →* L1 →* L2 :=
  MonoidHom.mk' (fun x => (e2.toMonoidHom.comp (brB1 G (e1.symm x))).comp e1.symm.toMonoidHom)
    (fun x x' => by
      ext z
      simp [MonoidHom.comp_apply, MonoidHom.mul_apply, map_mul])

/-- The bracket `L_2 × L_1 → L_3` transported along `e_1`, `e_2`, `e_3`. -/
noncomputable def brT2 (e1 : Abelianization G ≃* L1) (e2 : brL2 G ≃* L2) (e3 : brL3 G ≃* L3) :
    L2 →* L1 →* L3 :=
  MonoidHom.mk' (fun x => (e3.toMonoidHom.comp (brB2 G (e2.symm x))).comp e1.symm.toMonoidHom)
    (fun x x' => by
      ext z
      simp [MonoidHom.comp_apply, MonoidHom.mul_apply, map_mul])

variable (e1 : Abelianization G ≃* L1) (e2 : brL2 G ≃* L2) (e3 : brL3 G ≃* L3)

theorem brT1_apply (x y : L1) : brT1 e1 e2 x y = e2 (brB1 G (e1.symm x) (e1.symm y)) := rfl

theorem brT2_apply (z : L2) (x : L1) : brT2 e1 e2 e3 z x = e3 (brB2 G (e2.symm z) (e1.symm x)) :=
  rfl

/-- The leading coefficient of `[g_j, g_k]`: the value of the transported bracket on the images
of `a, b` is the transported class of `[a, b]` in `γ_2/γ_3`. -/
theorem brT1_of (a b : G) :
    brT1 e1 e2 (e1 (Abelianization.of a)) (e1 (Abelianization.of b)) = e2 (brq2 G (cw a b)) := by
  rw [brT1_apply, MulEquiv.symm_apply_apply, MulEquiv.symm_apply_apply, brB1_of]

/-- The leading coefficient of `[w, g_l]`, `w ∈ γ_2`: the transported class of `[w, c]` in
`γ_3/γ_4`. -/
theorem brT2_of (w : lcs G 1) (c : G) :
    brT2 e1 e2 e3 (e2 (brq2 G w)) (e1 (Abelianization.of c)) = e3 (brq3 G (cw2 w c)) := by
  rw [brT2_apply, MulEquiv.symm_apply_apply, MulEquiv.symm_apply_apply, brB2_mk_of]

theorem brT1_alt : brAlt (brT1 e1 e2) := by
  intro x
  rw [brT1_apply, brB1_alt, map_one]

theorem brT_jacobi : brJacobi (brT1 e1 e2) (brT2 e1 e2 e3) := by
  intro x y z
  rw [brT1_apply, brT1_apply, brT1_apply, brT2_apply, brT2_apply, brT2_apply,
    MulEquiv.symm_apply_apply, MulEquiv.symm_apply_apply, MulEquiv.symm_apply_apply,
    ← map_mul e3, ← map_mul e3, brB_jacobi (G := G) (e1.symm x) (e1.symm y) (e1.symm z), map_one]

theorem brT1_closure :
    Subgroup.closure (Set.range (fun q : L1 × L1 => brT1 e1 e2 q.1 q.2)) = ⊤ := by
  have hle : Subgroup.closure
      (Set.range (fun q : Abelianization G × Abelianization G => brB1 G q.1 q.2)) ≤
      (Subgroup.closure (Set.range (fun q : L1 × L1 => brT1 e1 e2 q.1 q.2))).comap
        e2.toMonoidHom := by
    rw [Subgroup.closure_le]
    rintro _ ⟨⟨a, b⟩, rfl⟩
    rw [SetLike.mem_coe, Subgroup.mem_comap]
    apply Subgroup.subset_closure
    refine ⟨(e1 a, e1 b), ?_⟩
    show brT1 e1 e2 (e1 a) (e1 b) = e2 (brB1 G a b)
    rw [brT1_apply, MulEquiv.symm_apply_apply, MulEquiv.symm_apply_apply]
  rw [brB1_closure] at hle
  rw [eq_top_iff]
  intro w _
  have h := hle (Subgroup.mem_top (e2.symm w))
  rw [Subgroup.mem_comap] at h
  simpa using h

/-- Equal transported brackets give equal leading coefficients: if two groups `G`, `G'` with
identifications have the same transported first bracket, and generators `a`, `a'` with the same
images in `L_1`, then the transported classes of `[a_j, a_k]` and `[a'_j, a'_k]` agree. -/
theorem brT1_coeff_eq {G' : Type u} [Group G'] (e1' : Abelianization G' ≃* L1)
    (e2' : brL2 G' ≃* L2) (hT : brT1 e1 e2 = brT1 e1' e2') {ι : Type*} (a : ι → G) (a' : ι → G')
    (ha : ∀ i, e1 (Abelianization.of (a i)) = e1' (Abelianization.of (a' i))) (j k : ι) :
    e2 (brq2 G (cw (a j) (a k))) = e2' (brq2 G' (cw (a' j) (a' k))) := by
  rw [← brT1_of e1 e2, ← brT1_of e1' e2', hT, ha j, ha k]

/-- The same for the second bracket. -/
theorem brT2_coeff_eq {G' : Type u} [Group G'] (e1' : Abelianization G' ≃* L1)
    (e2' : brL2 G' ≃* L2) (e3' : brL3 G' ≃* L3) (hT : brT2 e1 e2 e3 = brT2 e1' e2' e3')
    (w : lcs G 1) (w' : lcs G' 1) (hw : e2 (brq2 G w) = e2' (brq2 G' w')) (c : G) (c' : G')
    (hc : e1 (Abelianization.of c) = e1' (Abelianization.of c')) :
    e3 (brq3 G (cw2 w c)) = e3' (brq3 G' (cw2 w' c')) := by
  rw [← brT2_of e1 e2 e3, ← brT2_of e1' e2' e3', hT, hw, hc]

end BrTransport


