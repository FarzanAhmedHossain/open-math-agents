import H2Dev.Code
import H2Dev.Stmt

/-! Theorem R (rigidity): two groups realising the same code are isomorphic.

The proof works in the subgroup `D` of `G × G'` generated by the paired generators. The paired
generators satisfy the relations of the code, the Lie lemma (tail form) shows that every term of
the lower central series of `D` is generated by the later positions, so normal forms exist and
`Nat.card D ≤ p ^ m`. Both projections are onto, hence bijective. -/

namespace OMA.SimsLite

open scoped commutatorElement

universe u

section RigidityAux

/-- Strong induction over `Fin m`. -/
lemma fin_strong_ind {m : ℕ} {C : Fin m → Prop}
    (h : ∀ i : Fin m, (∀ j : Fin m, j.val < i.val → C j) → C i) : ∀ i, C i := by
  have key : ∀ n, ∀ i : Fin m, i.val = n → C i := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro i hi
      exact h i (fun j hj => ih j.val (by omega) j rfl)
  exact fun i => key _ i rfl

/-- Positions at or after `start w` have level at least `w`. -/
lemma le_lv_of_start_le {m : ℕ} {s : Shape m} (hs : s.Valid) {w : ℕ} {j : Fin m}
    (hj : s.start w ≤ j.val) : w ≤ s.lv j := by
  rcases Nat.lt_or_ge (s.lv j) w with hlt | hge
  · exfalso
    have hk : ∀ k : Fin (j.val + 1), k.val < m := fun k => by
      have h1 := k.isLt
      have h2 := j.isLt
      omega
    have hw : ∀ k : Fin (j.val + 1), s.lv ⟨k.val, hk k⟩ < w := fun k =>
      lt_of_le_of_lt (hs.mono ⟨k.val, hk k⟩ j (Fin.le_def.mpr (Nat.le_of_lt_succ k.isLt))) hlt
    have hc := Nat.card_le_card_of_injective
      (fun k : Fin (j.val + 1) => (⟨⟨k.val, hk k⟩, hw k⟩ : {i : Fin m // s.lv i < w}))
      (fun a b hab => Fin.ext (congrArg (fun x : {i : Fin m // s.lv i < w} => x.1.val) hab))
    rw [Nat.card_fin] at hc
    unfold Shape.start at hj
    omega
  · exact hge

variable {D : Type u} [Group D]

lemma mem_cl_drop_ofFn {m : ℕ} (Z : Fin m → D) {n : ℕ} (j : Fin m) (h : n ≤ j.val) :
    Z j ∈ cl ((List.ofFn Z).drop n) := by
  have hm := getElem_mem_drop (List.ofFn Z) h (lt_of_lt_of_eq j.isLt List.length_ofFn.symm)
  rw [List.getElem_ofFn] at hm
  exact mem_cl_of_mem hm

lemma cl_drop_ofFn_le {m : ℕ} (Z : Fin m → D) (n : ℕ) (H : Subgroup D)
    (h : ∀ j : Fin m, n ≤ j.val → Z j ∈ H) : cl ((List.ofFn Z).drop n) ≤ H := by
  rw [cl_def, Subgroup.closure_le]
  intro x hx
  obtain ⟨k, hk, rfl⟩ := List.getElem_of_mem hx
  rw [List.getElem_drop, List.getElem_ofFn]
  exact h _ (Nat.le_add_right n k)

open Classical in
/-- The core element of core index `k` (junk value `1` when there is none). -/
noncomputable def coreElt {m : ℕ} (s : Shape m) (Z : Fin m → D) (k : ℕ) : D :=
  if h : ∃ j : Fin m, ∃ κ : Fin m, s.cidx j = some κ ∧ κ.val = k then Z h.choose else 1

lemma coreElt_eq {m : ℕ} {s : Shape m} (hs : s.Valid) (Z : Fin m → D) {j κ : Fin m}
    (hj : s.cidx j = some κ) : coreElt s Z κ.val = Z j := by
  have h : ∃ j : Fin m, ∃ κ' : Fin m, s.cidx j = some κ' ∧ κ'.val = κ.val := ⟨j, κ, hj, rfl⟩
  unfold coreElt
  rw [dif_pos h]
  obtain ⟨κ', h1, h2⟩ := h.choose_spec
  have h1' : s.cidx h.choose = some κ := by rw [h1, Fin.ext h2]
  exact congrArg Z (hs.core_inj _ _ κ h1' hj)

lemma coreElt_cases {m : ℕ} {s : Shape m} (hs : s.Valid) (Z : Fin m → D) (k : ℕ) :
    coreElt s Z k = 1 ∨ ∃ j κ : Fin m, s.cidx j = some κ ∧ κ.val = k ∧ coreElt s Z k = Z j := by
  by_cases h : ∃ j : Fin m, ∃ κ : Fin m, s.cidx j = some κ ∧ κ.val = k
  · obtain ⟨j, κ, hj, rfl⟩ := h
    exact Or.inr ⟨j, κ, hj, rfl, coreElt_eq hs Z hj⟩
  · left
    unfold coreElt
    rw [dif_neg h]

/-- The positions of level `l` defined as commutators. -/
def levE {m : ℕ} (s : Shape m) (Z : Fin m → D) (l : ℕ) : Set D :=
  {x | ∃ i a b, s.df i = some (some (a, b)) ∧ s.lv i = l ∧ x = Z i}

lemma mem_levE {m : ℕ} {s : Shape m} {Z : Fin m → D} {l : ℕ} {x : D} :
    x ∈ levE s Z l ↔ ∃ i a b, s.df i = some (some (a, b)) ∧ s.lv i = l ∧ x = Z i := Iff.rfl

/-- The free positions. -/
def freeSet {m : ℕ} (s : Shape m) (Z : Fin m → D) : Set D :=
  {x | ∃ i, s.df i = none ∧ x = Z i}

lemma mem_freeSet {m : ℕ} {s : Shape m} {Z : Fin m → D} {x : D} :
    x ∈ freeSet s Z ↔ ∃ i, s.df i = none ∧ x = Z i := Iff.rfl

/-- The pairs of core indices of the level-1 commutator positions. -/
def coreP {m : ℕ} (s : Shape m) : Set (ℕ × ℕ) :=
  {ab | ∃ (i a b ka kb : Fin m), s.df i = some (some (a, b)) ∧ s.lv i = 1 ∧
    s.cidx a = some ka ∧ s.cidx b = some kb ∧ ab = (ka.val, kb.val)}

lemma mem_coreP {m : ℕ} {s : Shape m} {ab : ℕ × ℕ} :
    ab ∈ coreP s ↔ ∃ (i a b ka kb : Fin m), s.df i = some (some (a, b)) ∧ s.lv i = 1 ∧
      s.cidx a = some ka ∧ s.cidx b = some kb ∧ ab = (ka.val, kb.val) := Iff.rfl

/-- The counting core of Theorem R: a nilpotent group generated by a tuple satisfying the
relations of a valid shape has at most `p ^ m` elements. -/
theorem card_le_of_code {p m : ℕ} (hp : 0 < p) (s : Shape m) (hs : s.Valid) (Z : Fin m → D)
    (hgen : Subgroup.closure (Set.range Z) = ⊤)
    (hN : ∃ N, lcs D N = ⊥)
    (hpow : ∀ i, s.df i = some none → ∀ h : 0 < i.val,
      Z i = Z ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩ ^ p)
    (hcomm : ∀ i a b, s.df i = some (some (a, b)) → Z i = ⁅Z a, Z b⁆)
    (h2 : ∀ i : Fin m, Z i ^ p ∈ cl ((List.ofFn Z).drop (i.val + 1)))
    (h3 : ∀ i k, s.lv i = 0 → s.lv k = 0 → i < k →
      ⁅Z i, Z k⁆ ∈ cl ((List.ofFn Z).drop (s.start 1)))
    (h4 : ∀ i k (κ : Fin m), s.lv i = 1 → s.cidx k = some κ → κ.val ≤ s.st i →
      ⁅Z i, Z k⁆ ∈ cl ((List.ofFn Z).drop (s.start 2)))
    (h5 : ∀ i k, 2 ≤ s.lv i → (s.cidx k).isSome →
      ⁅Z i, Z k⁆ ∈ cl ((List.ofFn Z).drop (s.start (s.lv i + 1)))) :
    Nat.card D ≤ p ^ m := by
  obtain ⟨N, hN⟩ := hN
  -- every generator lies in the term of the lower central series given by its level
  have hlv : ∀ i, Z i ∈ lcs D (s.lv i) := by
    refine fin_strong_ind ?_
    intro i ih
    match hdf : s.df i with
    | none =>
      rw [hs.free i hdf, lcs_zero]
      exact Subgroup.mem_top _
    | some none =>
      obtain ⟨h0, hl, -⟩ := hs.pow i hdf
      have hprev : Z _ ∈ lcs D (s.lv _) :=
        ih ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩ (by show i.val - 1 < i.val; omega)
      rw [hl] at hprev
      rw [hpow i hdf h0]
      exact pow_mem hprev p
    | some (some (a, b)) =>
      obtain ⟨hai, -, -, hl, -⟩ := hs.comm i a b hdf
      rw [hcomm i a b hdf, hl]
      exact commElem_mem_lcs_succ (ih a (Fin.lt_def.mp hai)) _
  -- a generator of level `l ≥ 1` lies in the subgroup generated by the level-`l` commutators
  have hE : ∀ i, 1 ≤ s.lv i → Z i ∈ Subgroup.closure (levE s Z (s.lv i)) := by
    refine fin_strong_ind ?_
    intro i ih h1
    match hdf : s.df i with
    | none =>
      rw [hs.free i hdf] at h1
      omega
    | some none =>
      obtain ⟨h0, hl, -⟩ := hs.pow i hdf
      have hprev : Z _ ∈ Subgroup.closure (levE s Z (s.lv _)) :=
        ih ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩
          (by show i.val - 1 < i.val; omega) (by rw [hl]; exact h1)
      rw [hl] at hprev
      rw [hpow i hdf h0]
      exact pow_mem hprev p
    | some (some (a, b)) =>
      exact Subgroup.subset_closure (mem_levE.mpr ⟨i, a, b, hdf, rfl, rfl⟩)
  -- the tail from `start w` lies in the level-`w` generators modulo the next term
  have hdrop : ∀ w, 1 ≤ w → cl ((List.ofFn Z).drop (s.start w)) ≤
      Subgroup.closure (levE s Z w) ⊔ lcs D (w + 1) := by
    intro w hw
    apply cl_drop_ofFn_le
    intro j hj
    have hwj := le_lv_of_start_le hs hj
    rcases Nat.lt_or_ge w (s.lv j) with hlt | hge
    · exact Subgroup.mem_sup_right (lcs_antitone (D := D) (show w + 1 ≤ s.lv j by omega) (hlv j))
    · have heq : s.lv j = w := le_antisymm hge hwj
      have hj' := hE j (by omega)
      rw [heq] at hj'
      exact Subgroup.mem_sup_left hj'
  -- the hypotheses of the Lie lemma
  have hP : ∀ ab ∈ coreP s, ab.1 < ab.2 ∧ ab.2 < s.ncore := by
    intro ab hab
    obtain ⟨i, a, b, ka, kb, hdf, hl, hka, hkb, rfl⟩ := mem_coreP.mp hab
    obtain ⟨-, -, -, -, h1⟩ := hs.comm i a b hdf
    obtain ⟨ka', kb', hka', hkb', hlt, -⟩ := h1 hl
    have e1 : ka' = ka := Option.some_inj.mp (hka'.symm.trans hka)
    have e2 : kb' = kb := Option.some_inj.mp (hkb'.symm.trans hkb)
    rw [e1, e2] at hlt
    exact ⟨Fin.lt_def.mp hlt, (hs.core b kb hkb).2⟩
  have hE1 : levE s Z 1 =
      (fun ab : ℕ × ℕ => ⁅coreElt s Z ab.1, coreElt s Z ab.2⁆) '' coreP s := by
    ext x
    constructor
    · intro hx
      obtain ⟨i, a, b, hdf, hl, rfl⟩ := mem_levE.mp hx
      obtain ⟨-, -, -, -, h1⟩ := hs.comm i a b hdf
      obtain ⟨ka, kb, hka, hkb, -, -⟩ := h1 hl
      refine ⟨(ka.val, kb.val), mem_coreP.mpr ⟨i, a, b, ka, kb, hdf, hl, hka, hkb, rfl⟩, ?_⟩
      show ⁅coreElt s Z ka.val, coreElt s Z kb.val⁆ = Z i
      rw [coreElt_eq hs Z hka, coreElt_eq hs Z hkb, hcomm i a b hdf]
    · rintro ⟨ab, hab, rfl⟩
      obtain ⟨i, a, b, ka, kb, hdf, hl, hka, hkb, rfl⟩ := mem_coreP.mp hab
      refine mem_levE.mpr ⟨i, a, b, hdf, hl, ?_⟩
      show ⁅coreElt s Z ka.val, coreElt s Z kb.val⁆ = Z i
      rw [coreElt_eq hs Z hka, coreElt_eq hs Z hkb, hcomm i a b hdf]
  have hL2 : ∀ w, 1 ≤ w → ∀ x ∈ levE s Z (w + 1), ∃ y ∈ Subgroup.closure (levE s Z w),
      ∃ b < s.ncore, x = ⁅y, coreElt s Z b⁆ := by
    intro w hw x hx
    obtain ⟨i, a, b, hdf, hl, rfl⟩ := mem_levE.mp hx
    obtain ⟨-, -, hb, hla, -⟩ := hs.comm i a b hdf
    obtain ⟨kb, hkb⟩ := Option.isSome_iff_exists.mp hb
    have hya := hE a (by omega)
    rw [show s.lv a = w by omega] at hya
    refine ⟨Z a, hya, kb.val, (hs.core b kb hkb).2, ?_⟩
    rw [coreElt_eq hs Z hkb]
    exact hcomm i a b hdf
  have hfree : ∀ i, Z i ∈ Subgroup.closure (freeSet s Z) ⊔ lcs D 1 := by
    refine fin_strong_ind ?_
    intro i ih
    match hdf : s.df i with
    | none =>
      exact Subgroup.mem_sup_left (Subgroup.subset_closure (mem_freeSet.mpr ⟨i, hdf, rfl⟩))
    | some none =>
      obtain ⟨h0, -, -⟩ := hs.pow i hdf
      have hprev : Z _ ∈ Subgroup.closure (freeSet s Z) ⊔ lcs D 1 :=
        ih ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩ (by show i.val - 1 < i.val; omega)
      rw [hpow i hdf h0]
      exact pow_mem hprev p
    | some (some (a, b)) =>
      rw [hcomm i a b hdf]
      exact Subgroup.mem_sup_right (commElem_mem_lcs_succ (n := 0) (Subgroup.mem_top _) _)
  have hL0 : Subgroup.closure (freeSet s Z) ⊔ lcs D 1 = ⊤ := by
    have hle : Subgroup.closure (Set.range Z) ≤ Subgroup.closure (freeSet s Z) ⊔ lcs D 1 := by
      rw [Subgroup.closure_le]
      rintro x ⟨i, rfl⟩
      exact hfree i
    rw [hgen] at hle
    exact top_le_iff.mp hle
  have hH1 : ∀ x ∈ freeSet s Z, ∀ y ∈ freeSet s Z,
      ⁅x, y⁆ ∈ Subgroup.closure (levE s Z 1) ⊔ lcs D 2 := by
    intro x hx y hy
    obtain ⟨i, hi, rfl⟩ := mem_freeSet.mp hx
    obtain ⟨k, hk, rfl⟩ := mem_freeSet.mp hy
    have hli := hs.free i hi
    have hlk := hs.free k hk
    rcases lt_trichotomy i k with hik | rfl | hki
    · exact hdrop 1 le_rfl (h3 i k hli hlk hik)
    · rw [commutatorElement_self]
      exact one_mem _
    · rw [← commutatorElement_inv]
      exact inv_mem (hdrop 1 le_rfl (h3 k i hlk hli hki))
  have hH2 : ∀ ab ∈ coreP s, ∀ k ≤ ab.2,
      ⁅⁅coreElt s Z ab.1, coreElt s Z ab.2⁆, coreElt s Z k⁆ ∈
        Subgroup.closure (levE s Z 2) ⊔ lcs D 3 := by
    intro ab hab k hk
    obtain ⟨i, a, b, ka, kb, hdf, hl, hka, hkb, rfl⟩ := mem_coreP.mp hab
    obtain ⟨-, -, -, -, h1⟩ := hs.comm i a b hdf
    obtain ⟨-, kb', -, hkb', -, hst⟩ := h1 hl
    have e2 : kb' = kb := Option.some_inj.mp (hkb'.symm.trans hkb)
    rw [e2] at hst
    have hk' : k ≤ kb.val := hk
    show ⁅⁅coreElt s Z ka.val, coreElt s Z kb.val⁆, coreElt s Z k⁆ ∈ _
    rw [coreElt_eq hs Z hka, coreElt_eq hs Z hkb, ← hcomm i a b hdf]
    rcases coreElt_cases hs Z k with h0 | ⟨j, κ, hj, hκ, hjk⟩
    · rw [h0, commutatorElement_one_right]
      exact one_mem _
    · rw [hjk]
      exact hdrop 2 (by omega) (h4 i j κ hl hj (by omega))
  have hH3 : ∀ w, 2 ≤ w → ∀ x ∈ levE s Z w, ∀ k < s.ncore,
      ⁅x, coreElt s Z k⁆ ∈ Subgroup.closure (levE s Z (w + 1)) ⊔ lcs D (w + 2) := by
    intro w hw x hx k _
    obtain ⟨i, a, b, hdf, hl, rfl⟩ := mem_levE.mp hx
    rcases coreElt_cases hs Z k with h0 | ⟨j, κ, hj, hκ, hjk⟩
    · rw [h0, commutatorElement_one_right]
      exact one_mem _
    · rw [hjk]
      have h5' := h5 i j (by omega) (by simp [hj])
      rw [hl] at h5'
      have hres := hdrop (w + 1) (by omega) h5'
      rwa [show w + 1 + 1 = w + 2 by omega] at hres
  have htail := lie_lemma_tail s.ncore (coreElt s Z) (freeSet s Z) (coreP s) (levE s Z)
    hP hE1 hL2 hL0 hH1 hH2 hH3 N hN
  -- the term of level `lv j + 1` lies in the closure of the positions after `j`
  have htailcl : ∀ j : Fin m, lcs D (s.lv j + 1) ≤ cl ((List.ofFn Z).drop (j.val + 1)) := by
    intro j
    refine le_trans (htail (s.lv j + 1) (by omega)) ?_
    rw [Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_iUnion, Set.mem_Ici, exists_prop] at hx
    obtain ⟨v, hv, hxv⟩ := hx
    obtain ⟨k, a, b, -, hlk, rfl⟩ := mem_levE.mp hxv
    refine mem_cl_drop_ofFn Z k ?_
    rcases Nat.lt_or_ge j.val k.val with hjk | hjk
    · omega
    · have hmono := hs.mono k j (Fin.le_def.mpr hjk)
      omega
  -- normal forms
  have hsurj : ∀ x : D, ∃ e : ℕ → ℕ, (∀ k, e k < p) ∧ x = nf (List.ofFn Z) e := by
    intro x
    refine nf_surj p hp (List.ofFn Z) ?_ ?_ x ?_
    · intro i hi
      have him : i < m := lt_of_lt_of_eq hi List.length_ofFn
      simp only [List.getElem_ofFn]
      exact h2 ⟨i, him⟩
    · intro i j hij hj
      have hjm : j < m := lt_of_lt_of_eq hj List.length_ofFn
      have him : i < m := lt_trans hij hjm
      simp only [List.getElem_ofFn]
      have hc : Z ⟨i, him⟩ * Z ⟨j, hjm⟩ * (Z ⟨i, him⟩)⁻¹ =
          ⁅Z ⟨i, him⟩, Z ⟨j, hjm⟩⁆ * Z ⟨j, hjm⟩ := by
        simp only [commutatorElement_def]
        group
      rw [hc]
      refine mul_mem ?_ (mem_cl_drop_ofFn Z ⟨j, hjm⟩ (show i + 1 ≤ j by omega))
      exact cl_drop_mono (List.ofFn Z) (show i + 1 ≤ j + 1 by omega)
        (htailcl ⟨j, hjm⟩ (commElem_mem_lcs_succ' (Z ⟨i, him⟩) (hlv ⟨j, hjm⟩)))
    · have hle : Subgroup.closure (Set.range Z) ≤ cl (List.ofFn Z) := by
        rw [Subgroup.closure_le]
        rintro y ⟨i, rfl⟩
        have hi := mem_cl_drop_ofFn Z (n := 0) i (Nat.zero_le _)
        rwa [List.drop_zero] at hi
      rw [hgen] at hle
      exact hle (Subgroup.mem_top x)
  have hF : Function.Surjective (fun f : Fin m → Fin p =>
      nf (List.ofFn Z) (fun k => if h : k < m then ((f ⟨k, h⟩ : Fin p) : ℕ) else 0)) := by
    intro x
    obtain ⟨e, he, rfl⟩ := hsurj x
    refine ⟨fun k => ⟨e k.val, he k.val⟩, ?_⟩
    apply nf_congr
    intro k hk
    have hkm : k < m := lt_of_lt_of_eq hk List.length_ofFn
    simp [hkm]
  have hc := Nat.card_le_card_of_surjective _ hF
  simpa only [Nat.card_fun, Nat.card_fin] using hc

end RigidityAux

section Diag

variable {G G' : Type u} [Group G] [Group G'] {m : ℕ}

/-- The subgroup of `G × G'` generated by the paired generators. -/
abbrev diagSub (X : Fin m → G) (X' : Fin m → G') : Subgroup (G × G') :=
  Subgroup.closure (Set.range fun i => (X i, X' i))

/-- The paired generators, as elements of `diagSub`. -/
def diagGen (X : Fin m → G) (X' : Fin m → G') (i : Fin m) : diagSub X X' :=
  ⟨(X i, X' i), Subgroup.subset_closure ⟨i, rfl⟩⟩

/-- The first projection on `diagSub`. -/
def diagFst (X : Fin m → G) (X' : Fin m → G') : diagSub X X' →* G :=
  (MonoidHom.fst G G').comp (diagSub X X').subtype

/-- The second projection on `diagSub`. -/
def diagSnd (X : Fin m → G) (X' : Fin m → G') : diagSub X X' →* G' :=
  (MonoidHom.snd G G').comp (diagSub X X').subtype

lemma diagFst_gen (X : Fin m → G) (X' : Fin m → G') (i : Fin m) :
    diagFst X X' (diagGen X X' i) = X i := rfl

lemma diagSnd_gen (X : Fin m → G) (X' : Fin m → G') (i : Fin m) :
    diagSnd X X' (diagGen X X' i) = X' i := rfl

lemma diag_ext (X : Fin m → G) (X' : Fin m → G') {x y : diagSub X X'}
    (h1 : diagFst X X' x = diagFst X X' y) (h2 : diagSnd X X' x = diagSnd X X' y) : x = y :=
  Subtype.ext (Prod.ext h1 h2)

lemma diagGen_closure (X : Fin m → G) (X' : Fin m → G') :
    Subgroup.closure (Set.range (diagGen X X')) = ⊤ := by
  have hpre : Set.range (diagGen X X') =
      ((↑) : diagSub X X' → G × G') ⁻¹' (Set.range fun i => (X i, X' i)) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact Set.mem_preimage.mpr ⟨i, rfl⟩
    · rintro ⟨i, hi⟩
      exact ⟨i, Subtype.ext hi⟩
  rw [hpre]
  exact Subgroup.closure_closure_coe_preimage

lemma diagFst_surj (X : Fin m → G) (X' : Fin m → G')
    (hX : Subgroup.closure (Set.range X) = ⊤) : Function.Surjective (diagFst X X') := by
  intro y
  have hy : y ∈ (diagSub X X').map (MonoidHom.fst G G') := by
    rw [MonoidHom.map_closure, ← Set.range_comp]
    have hr : (⇑(MonoidHom.fst G G') ∘ fun i => (X i, X' i)) = X := rfl
    rw [hr, hX]
    exact Subgroup.mem_top y
  obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hy
  exact ⟨⟨z, hz⟩, rfl⟩

lemma diagSnd_surj (X : Fin m → G) (X' : Fin m → G')
    (hX : Subgroup.closure (Set.range X') = ⊤) : Function.Surjective (diagSnd X X') := by
  intro y
  have hy : y ∈ (diagSub X X').map (MonoidHom.snd G G') := by
    rw [MonoidHom.map_closure, ← Set.range_comp]
    have hr : (⇑(MonoidHom.snd G G') ∘ fun i => (X i, X' i)) = X' := rfl
    rw [hr, hX]
    exact Subgroup.mem_top y
  obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hy
  exact ⟨⟨z, hz⟩, rfl⟩

/-- The paired subgroup of two realisations of the same code has at most `p ^ m` elements. -/
theorem diag_card_le {p : ℕ} (hp : 0 < p) [Group.IsNilpotent G] [Group.IsNilpotent G']
    (X : Fin m → G) (X' : Fin m → G') (c : Code p m) (h : Realizes X c) (h' : Realizes X' c) :
    Nat.card (diagSub X X') ≤ p ^ m := by
  obtain ⟨-, -, hpow, hcomm, h2, h3, h4, h5⟩ := h
  obtain ⟨-, -, hpow', hcomm', h2', h3', h4', h5'⟩ := h'
  have hmap : (List.ofFn (diagGen X X')).map (diagFst X X') = List.ofFn X := by
    rw [List.map_ofFn]
    rfl
  have hmap' : (List.ofFn (diagGen X X')).map (diagSnd X X') = List.ofFn X' := by
    rw [List.map_ofFn]
    rfl
  have hcl : ∀ (x : diagSub X X') (n : ℕ) (e : ℕ → ℕ),
      diagFst X X' x = nf ((List.ofFn X).drop n) e →
      diagSnd X X' x = nf ((List.ofFn X').drop n) e →
      x ∈ cl ((List.ofFn (diagGen X X')).drop n) := by
    intro x n e e1 e2
    have hx : x = nf ((List.ofFn (diagGen X X')).drop n) e := by
      apply diag_ext X X'
      · rw [e1, nf_map, List.map_drop, hmap]
      · rw [e2, nf_map, List.map_drop, hmap']
    rw [hx]
    exact nf_mem _ _
  refine card_le_of_code hp c.1.1 c.1.2 (diagGen X X') (diagGen_closure X X') ?_ ?_ ?_ ?_ ?_ ?_ ?_
  · exact Subgroup.nilpotent_iff_lowerCentralSeries.mp inferInstance
  · intro i hd h0
    apply diag_ext X X'
    · simp only [map_pow, diagFst_gen]
      exact hpow i hd h0
    · simp only [map_pow, diagSnd_gen]
      exact hpow' i hd h0
  · intro i a b hd
    apply diag_ext X X'
    · simp only [map_commutatorElement, diagFst_gen]
      exact hcomm i a b hd
    · simp only [map_commutatorElement, diagSnd_gen]
      exact hcomm' i a b hd
  · intro i
    apply hcl
    · simp only [map_pow, diagFst_gen]
      exact h2 i
    · simp only [map_pow, diagSnd_gen]
      exact h2' i
  · intro i k hi hk hik
    apply hcl
    · simp only [map_commutatorElement, diagFst_gen]
      exact h3 i k hi hk hik
    · simp only [map_commutatorElement, diagSnd_gen]
      exact h3' i k hi hk hik
  · intro i k κ hi hk hκ
    apply hcl
    · simp only [map_commutatorElement, diagFst_gen]
      exact h4 i k κ hi hk hκ
    · simp only [map_commutatorElement, diagSnd_gen]
      exact h4' i k κ hi hk hκ
  · intro i k hi hk
    apply hcl
    · simp only [map_commutatorElement, diagFst_gen]
      exact h5 i k hi hk
    · simp only [map_commutatorElement, diagSnd_gen]
      exact h5' i k hi hk

end Diag

/-- Theorem R: two finite groups realising the same code are isomorphic. -/
theorem rigidity {p m : Nat} (hp : p.Prime) {G G' : Type u} [Group G] [Group G'] [Finite G]
    [Finite G'] (X : Fin m -> G) (X' : Fin m -> G') (c : Code p m) (h : Realizes X c)
    (h' : Realizes X' c) : Nonempty (G ≃* G') := by
  have hR := h
  have hR' := h'
  obtain ⟨hcard, hgen, -⟩ := hR
  obtain ⟨hcard', hgen', -⟩ := hR'
  haveI : Fact p.Prime := ⟨hp⟩
  haveI : Group.IsNilpotent G := (IsPGroup.of_card hcard).isNilpotent
  haveI : Group.IsNilpotent G' := (IsPGroup.of_card hcard').isNilpotent
  have hK := diag_card_le hp.pos X X' c h h'
  have hb1 : Function.Bijective (diagFst X X') :=
    (diagFst_surj X X' hgen).bijective_of_nat_card_le (by rw [hcard]; exact hK)
  have hb2 : Function.Bijective (diagSnd X X') :=
    (diagSnd_surj X X' hgen').bijective_of_nat_card_le (by rw [hcard']; exact hK)
  exact ⟨(MulEquiv.ofBijective (diagFst X X') hb1).symm.trans
    (MulEquiv.ofBijective (diagSnd X X') hb2)⟩

end OMA.SimsLite
