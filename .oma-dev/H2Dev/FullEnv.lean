import Mathlib

-- Step Erdos1160.erdos_1160.variants.sum.R3.H1.R1.H2.R1.H2 (H2 of reduction ...R3.H1.R1.H2.R1)
-- Credit: @FarzanAhmedHossain
-- Sims-lite: log_p g(p^m) <= (2/25) m^3 + O(m^2), hence g(3^a)^12 <= 3^(a^3 + 84 (a+1)^2).

-- ===== NF =====
/-! Normal forms for lists of group elements (from the accepted proof of R3.H1.R1.H2.R1.H1). -/

namespace OMA.SimsLite

universe u v

section NF

variable {G : Type u} [Group G] {H : Type v} [Group H]

/-- The subgroup generated by the entries of a list. -/
def cl (l : List G) : Subgroup G := Subgroup.closure {x | x ∈ l}

lemma cl_def (l : List G) : cl l = Subgroup.closure {x | x ∈ l} := rfl

lemma mem_cl_of_mem {l : List G} {x : G} (h : x ∈ l) : x ∈ cl l := Subgroup.subset_closure h

/-- A normal-form product `l[n-1]^(e (n-1)) * ... * l[0]^(e 0)`. -/
def nf : List G → (ℕ → ℕ) → G
  | [], _ => 1
  | b :: l, e => nf l (fun k => e (k + 1)) * b ^ (e 0)

@[simp] lemma nf_nil (e : ℕ → ℕ) : nf ([] : List G) e = 1 := rfl

@[simp] lemma nf_cons (b : G) (l : List G) (e : ℕ → ℕ) :
    nf (b :: l) e = nf l (fun k => e (k + 1)) * b ^ (e 0) := rfl

lemma nf_map (f : G →* H) : ∀ (l : List G) (e : ℕ → ℕ), f (nf l e) = nf (l.map f) e
  | [], e => by simp
  | b :: l, e => by simp [nf_map f l]

lemma nf_mem : ∀ (l : List G) (e : ℕ → ℕ), nf l e ∈ cl l
  | [], e => by simp [cl]
  | b :: l, e => by
    rw [nf_cons]
    refine mul_mem ?_ (pow_mem (mem_cl_of_mem (by simp)) _)
    exact Subgroup.closure_mono (fun x hx => by simp_all) (nf_mem l _)

lemma nf_congr : ∀ (l : List G) (e e' : ℕ → ℕ), (∀ k < l.length, e k = e' k) →
    nf l e = nf l e'
  | [], e, e', _ => rfl
  | b :: l, e, e', h => by
    rw [nf_cons, nf_cons, nf_congr l _ (fun k => e' (k + 1))
      (fun k hk => h (k + 1) (by simp; omega)), h 0 (by simp)]

lemma cl_drop_mono (l : List G) {a b : ℕ} (h : a ≤ b) : cl (l.drop b) ≤ cl (l.drop a) :=
  Subgroup.closure_mono fun _ hx => (List.drop_sublist_drop_left l h).subset hx

lemma getElem_mem_drop (l : List G) {i j : ℕ} (hij : i ≤ j) (hj : j < l.length) :
    l[j] ∈ l.drop i := by
  rw [List.mem_iff_getElem]
  refine ⟨j - i, by simp; omega, ?_⟩
  simp only [List.getElem_drop]
  congr 1
  omega

/-- Normal forms exist: under the power and normality hypotheses every element of the closure is
a normal-form product with exponents below `p`. -/
theorem nf_surj (p : ℕ) (hp : 0 < p) : ∀ (X : List G),
    (∀ i (hi : i < X.length), X[i] ^ p ∈ cl (X.drop (i + 1))) →
    (∀ i j (hij : i < j) (hj : j < X.length), X[i] * X[j] * X[i]⁻¹ ∈ cl (X.drop (i + 1))) →
    ∀ x ∈ cl X, ∃ e : ℕ → ℕ, (∀ k, e k < p) ∧ x = nf X e
  | [], _, _, x, hx => by
    refine ⟨fun _ => 0, fun _ => hp, ?_⟩
    have : x = 1 := by simpa [cl] using hx
    simp [this]
  | b :: Y, hpow, hnorm, x, hx => by
    have hpowY : ∀ i (hi : i < Y.length), Y[i] ^ p ∈ cl (Y.drop (i + 1)) := fun i hi =>
      hpow (i + 1) (by simp; omega)
    have hnormY : ∀ i j (hij : i < j) (hj : j < Y.length),
        Y[i] * Y[j] * Y[i]⁻¹ ∈ cl (Y.drop (i + 1)) := fun i j hij hj =>
      hnorm (i + 1) (j + 1) (by omega) (by simp; omega)
    have hbp : b ^ p ∈ cl Y := hpow 0 (by simp)
    have hconj : ∀ y ∈ cl Y, b * y * b⁻¹ ∈ cl Y := by
      intro y hy
      have hle : cl Y ≤ (cl Y).comap (MulAut.conj b).toMonoidHom := by
        rw [cl_def Y, Subgroup.closure_le]
        intro z hz
        obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem hz
        exact hnorm 0 (j + 1) (by omega) (by simp; omega)
      simpa using hle hy
    have hconjm : ∀ m : ℕ, ∀ y ∈ cl Y, b ^ m * y * (b ^ m)⁻¹ ∈ cl Y := by
      intro m
      induction m with
      | zero => intro y hy; simpa using hy
      | succ m ih =>
        intro y hy
        have := hconj _ (ih y hy)
        convert this using 1
        group
    have key : ∀ z ∈ cl (b :: Y), ∃ y ∈ cl Y, ∃ k : ℕ, z = y * b ^ k := by
      intro z hz
      rw [cl_def] at hz
      induction hz using Subgroup.closure_induction_left with
      | one => exact ⟨1, one_mem _, 0, by simp⟩
      | mul_left g hg z hz ih =>
        obtain ⟨y, hy, k, rfl⟩ := ih
        simp only [Set.mem_ofPred_eq, List.mem_cons] at hg
        rcases hg with rfl | hg
        · exact ⟨g * y * g⁻¹, hconj y hy, k + 1, by group⟩
        · exact ⟨g * y, mul_mem (mem_cl_of_mem hg) hy, k, by group⟩
      | inv_mul_cancel g hg z hz ih =>
        obtain ⟨y, hy, k, rfl⟩ := ih
        simp only [Set.mem_ofPred_eq, List.mem_cons] at hg
        rcases hg with rfl | hg
        · obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 := ⟨p - 1, by omega⟩
          refine ⟨g ^ q * ((g ^ (q + 1))⁻¹ * y) * (g ^ q)⁻¹,
            hconjm q _ (mul_mem (inv_mem hbp) hy), q + k, ?_⟩
          group
        · exact ⟨g⁻¹ * y, mul_mem (inv_mem (mem_cl_of_mem hg)) hy, k, by group⟩
    obtain ⟨y, hy, k, rfl⟩ := key x hx
    have hy' : y * (b ^ p) ^ (k / p) ∈ cl Y := mul_mem hy (pow_mem hbp _)
    obtain ⟨e', he'p, he'⟩ := nf_surj p hp Y hpowY hnormY _ hy'
    refine ⟨fun i => Nat.casesOn i (k % p) e', ?_, ?_⟩
    · intro i
      cases i with
      | zero => exact Nat.mod_lt _ hp
      | succ i => exact he'p i
    · show y * b ^ k = nf Y e' * b ^ (k % p)
      rw [← he', mul_assoc, ← pow_mul, ← pow_add, Nat.div_add_mod]

end NF

section Suffix

variable {G : Type u} [Group G]

lemma suffix_hyps (p : ℕ) (l : List G)
    (h2 : ∀ i (hi : i < l.length), l[i] ^ p ∈ cl (l.drop (i + 1)))
    (h3 : ∀ (g : G) j (hj : j < l.length), g * l[j] * g⁻¹ * l[j]⁻¹ ∈ cl (l.drop (j + 1)))
    (m : ℕ) :
    (∀ i (hi : i < (l.drop m).length), (l.drop m)[i] ^ p ∈ cl ((l.drop m).drop (i + 1))) ∧
    (∀ i j (hij : i < j) (hj : j < (l.drop m).length),
      (l.drop m)[i] * (l.drop m)[j] * ((l.drop m)[i])⁻¹ ∈ cl ((l.drop m).drop (i + 1))) := by
  have hdd : ∀ i, (l.drop m).drop (i + 1) = l.drop (m + i + 1) := by
    intro i
    rw [List.drop_drop]
    congr 1
  constructor
  · intro i hi
    have hi' : m + i < l.length := by simp at hi; omega
    rw [hdd, List.getElem_drop]
    exact h2 (m + i) hi'
  · intro i j hij hj
    have hj' : m + j < l.length := by simp at hj; omega
    rw [hdd, List.getElem_drop, List.getElem_drop]
    have h := h3 (l[m + i]'(by omega)) (m + j) hj'
    have e : l[m + i] * l[m + j] * (l[m + i])⁻¹ =
        (l[m + i] * l[m + j] * (l[m + i])⁻¹ * (l[m + j])⁻¹) * l[m + j] := by group
    rw [e]
    exact mul_mem (cl_drop_mono l (by omega) h)
      (mem_cl_of_mem (getElem_mem_drop l (by omega) hj'))

lemma cl_append_comap {Q : Type v} [Group Q] (f : G →* Q) (z : G) (hker : f.ker = Subgroup.zpowers z)
    (A : List G) : cl (A ++ [z]) = (cl (A.map f)).comap f := by
  have e1 : {x | x ∈ A ++ [z]} = {x | x ∈ A} ∪ {z} := by
    ext x
    simp [or_comm]
  have e2 : {x | x ∈ A.map f} = f '' {x | x ∈ A} := by
    ext x
    simp
  rw [cl_def, cl_def, e1, e2, Subgroup.closure_union, ← Subgroup.zpowers_eq_closure, ← MonoidHom.map_closure,
    Subgroup.comap_map_eq, hker]

end Suffix

end OMA.SimsLite


-- ===== Comm =====
/-! Commutator calculus for the Sims-lite bound (C1 to C5 of the blueprint).
Convention: Mathlib's `⁅x, y⁆ = x * y * x⁻¹ * y⁻¹`; `lcs D n` is the lower central series with
`lcs D 0 = ⊤`, so `lcs D n` is `γ_{n+1}`. -/

namespace OMA.SimsLite

open scoped commutatorElement

universe u

section Comm

variable {D : Type u} [Group D]

/-- The lower central series, 0-indexed. -/
abbrev lcs (D : Type u) [Group D] (n : ℕ) : Subgroup D := (⊤ : Subgroup D).lowerCentralSeries n

lemma lcs_zero : lcs D 0 = ⊤ := rfl

lemma lcs_succ (n : ℕ) : lcs D (n + 1) = ⁅lcs D n, ⊤⁆ := rfl

lemma lcs_succ' (n : ℕ) : lcs D (n + 1) = ⁅(⊤ : Subgroup D), lcs D n⁆ := by
  rw [lcs_succ, Subgroup.commutator_comm]

lemma lcs_antitone {a b : ℕ} (h : a ≤ b) : lcs D b ≤ lcs D a :=
  Subgroup.lowerCentralSeries_antitone (⊤ : Subgroup D) h

lemma commElem_mem_lcs_succ {n : ℕ} {x : D} (hx : x ∈ lcs D n) (g : D) :
    ⁅x, g⁆ ∈ lcs D (n + 1) := by
  rw [lcs_succ]
  exact Subgroup.commutator_mem_commutator hx (Subgroup.mem_top g)

lemma commElem_mem_lcs_succ' {n : ℕ} (g : D) {x : D} (hx : x ∈ lcs D n) :
    ⁅g, x⁆ ∈ lcs D (n + 1) := by
  rw [lcs_succ']
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top g) hx

/-- C1: for normal `N`, the elements `g` with `⁅x, g⁆ ∈ N` form a subgroup. -/
def zn (N : Subgroup D) [N.Normal] (x : D) : Subgroup D where
  carrier := {g | ⁅x, g⁆ ∈ N}
  one_mem' := by
    show ⁅x, (1 : D)⁆ ∈ N
    rw [commutatorElement_one_right]
    exact N.one_mem
  mul_mem' := by
    intro g h hg hh
    show ⁅x, g * h⁆ ∈ N
    have e : ⁅x, g * h⁆ = ⁅x, g⁆ * (g * ⁅x, h⁆ * g⁻¹) := by
      simp only [commutatorElement_def]
      group
    rw [e]
    exact N.mul_mem hg (‹N.Normal›.conj_mem _ hh g)
  inv_mem' := by
    intro g hg
    show ⁅x, g⁻¹⁆ ∈ N
    have e : ⁅x, g⁻¹⁆ = g⁻¹ * ⁅x, g⁆⁻¹ * g⁻¹⁻¹ := by
      simp only [commutatorElement_def]
      group
    rw [e]
    exact ‹N.Normal›.conj_mem _ (N.inv_mem hg) g⁻¹

lemma mem_zn {N : Subgroup D} [N.Normal] {x g : D} : g ∈ zn N x ↔ ⁅x, g⁆ ∈ N := Iff.rfl

lemma commElem_mem_symm {N : Subgroup D} {x g : D} (h : ⁅x, g⁆ ∈ N) : ⁅g, x⁆ ∈ N := by
  rw [← commutatorElement_inv]
  exact N.inv_mem h

/-- C1': commutators of generators control the commutator of the generated subgroups. -/
lemma commutator_closure_le {N : Subgroup D} [N.Normal] {A B : Set D}
    (h : ∀ a ∈ A, ∀ b ∈ B, ⁅a, b⁆ ∈ N) :
    ⁅Subgroup.closure A, Subgroup.closure B⁆ ≤ N := by
  have hB : ∀ a ∈ A, Subgroup.closure B ≤ zn N a := fun a ha =>
    (Subgroup.closure_le (zn N a)).mpr fun b hb => h a ha b hb
  rw [Subgroup.commutator_le]
  intro x hx y hy
  have hA : Subgroup.closure A ≤ zn N y :=
    (Subgroup.closure_le (zn N y)).mpr fun a ha => commElem_mem_symm (hB a ha hy)
  exact commElem_mem_symm (hA hx)

/-- Elementwise form of C1'. -/
lemma commElem_mem_of_closure {N : Subgroup D} [N.Normal] {A B : Set D}
    (h : ∀ a ∈ A, ∀ b ∈ B, ⁅a, b⁆ ∈ N) {x y : D}
    (hx : x ∈ Subgroup.closure A) (hy : y ∈ Subgroup.closure B) : ⁅x, y⁆ ∈ N :=
  commutator_closure_le h (Subgroup.commutator_mem_commutator hx hy)

/-- C2: a subgroup sandwiched between consecutive terms of the lower central series is normal. -/
lemma normal_of_sandwich {K : Subgroup D} {n : ℕ} (h1 : lcs D (n + 1) ≤ K) (h2 : K ≤ lcs D n) :
    K.Normal := by
  constructor
  intro k hk g
  have e : g * k * g⁻¹ = ⁅g, k⁆ * k := by
    simp only [commutatorElement_def]
    group
  rw [e]
  exact K.mul_mem (h1 (commElem_mem_lcs_succ' g (h2 hk))) hk

/-- C2: a subgroup containing the commutator subgroup is normal. -/
lemma normal_of_lcs_one_le {K : Subgroup D} (h1 : lcs D 1 ≤ K) : K.Normal :=
  normal_of_sandwich (n := 0) h1 le_top

/-- C3: the three subgroup lemma modulo a normal subgroup. -/
lemma three_subgroup_mod (N : Subgroup D) [N.Normal] {A B C : Subgroup D}
    (h1 : ⁅⁅B, C⁆, A⁆ ≤ N) (h2 : ⁅⁅C, A⁆, B⁆ ≤ N) : ⁅⁅A, B⁆, C⁆ ≤ N := by
  have key : ∀ X Y Z : Subgroup D, ⁅⁅X, Y⁆, Z⁆ ≤ N ↔
      ⁅⁅X.map (QuotientGroup.mk' N), Y.map (QuotientGroup.mk' N)⁆,
        Z.map (QuotientGroup.mk' N)⁆ = ⊥ := by
    intro X Y Z
    rw [← Subgroup.map_commutator, ← Subgroup.map_commutator, Subgroup.map_eq_bot_iff,
      QuotientGroup.ker_mk']
  rw [key] at h1 h2 ⊢
  exact Subgroup.commutator_commutator_eq_bot_of_rotate h1 h2

/-- C4: `⁅γ_{a+1}, γ_{b+1}⁆ ≤ γ_{a+b+2}`. -/
lemma lcs_comm_le : ∀ (b a : ℕ), ⁅lcs D a, lcs D b⁆ ≤ lcs D (a + b + 1)
  | 0, a => by rw [lcs_zero, ← lcs_succ]
  | b + 1, a => by
    rw [lcs_succ b, Subgroup.commutator_comm]
    have h1 : ⁅⁅(⊤ : Subgroup D), lcs D a⁆, lcs D b⁆ ≤ lcs D (a + (b + 1) + 1) := by
      rw [← lcs_succ']
      have := lcs_comm_le b (a + 1)
      rwa [show a + 1 + b + 1 = a + (b + 1) + 1 by omega] at this
    have h2 : ⁅⁅lcs D a, lcs D b⁆, (⊤ : Subgroup D)⁆ ≤ lcs D (a + (b + 1) + 1) := by
      rw [show a + (b + 1) + 1 = a + b + 1 + 1 by omega, lcs_succ]
      exact Subgroup.commutator_mono (lcs_comm_le b a) le_rfl
    exact three_subgroup_mod _ h1 h2

lemma commElem_mem_lcs_add {a b : ℕ} {x y : D} (hx : x ∈ lcs D a) (hy : y ∈ lcs D b) :
    ⁅x, y⁆ ∈ lcs D (a + b + 1) :=
  lcs_comm_le b a (Subgroup.commutator_mem_commutator hx hy)

/-- C5 (I1). -/
lemma commElem_mul_right (x y z : D) : ⁅x, y * z⁆ = ⁅x, y⁆ * ⁅y, ⁅x, z⁆⁆ * ⁅x, z⁆ := by
  simp only [commutatorElement_def]
  group

/-- C5 (I2). -/
lemma commElem_mul_left (x y z : D) : ⁅y * z, x⁆ = ⁅y, ⁅z, x⁆⁆ * ⁅z, x⁆ * ⁅y, x⁆ := by
  simp only [commutatorElement_def]
  group

/-- C5 consequence: modulo a subgroup `W ≥ γ_3`, `⁅x, y z⁆ ∈ W ↔ ⁅x, z⁆ ∈ W` when `⁅x, y⁆ ∈ W`. -/
lemma comm_mul_right_mem_iff {W : Subgroup D} (hW : lcs D 2 ≤ W) {x y z : D} (hxy : ⁅x, y⁆ ∈ W) :
    ⁅x, y * z⁆ ∈ W ↔ ⁅x, z⁆ ∈ W := by
  have h3 : ⁅y, ⁅x, z⁆⁆ ∈ W :=
    hW (commElem_mem_lcs_succ' y (commElem_mem_lcs_succ' (n := 0) x (Subgroup.mem_top z)))
  rw [commElem_mul_right, mul_assoc, Subgroup.mul_mem_cancel_left W hxy,
    Subgroup.mul_mem_cancel_left W h3]

/-- C5 consequence: modulo `W ≥ γ_3`, `⁅x, y z⁆ ∈ W ↔ ⁅x, y⁆ ∈ W` when `⁅x, z⁆ ∈ W`. -/
lemma comm_mul_right_mem_iff' {W : Subgroup D} (hW : lcs D 2 ≤ W) {x y z : D} (hxz : ⁅x, z⁆ ∈ W) :
    ⁅x, y * z⁆ ∈ W ↔ ⁅x, y⁆ ∈ W := by
  have h3 : ⁅y, ⁅x, z⁆⁆ ∈ W :=
    hW (commElem_mem_lcs_succ' y (commElem_mem_lcs_succ' (n := 0) x (Subgroup.mem_top z)))
  rw [commElem_mul_right, Subgroup.mul_mem_cancel_right W hxz,
    Subgroup.mul_mem_cancel_right W h3]

/-- C5 consequence: modulo `W ≥ γ_3`, `⁅y z, x⁆ ∈ W ↔ ⁅z, x⁆ ∈ W` when `⁅y, x⁆ ∈ W`. -/
lemma comm_mul_left_mem_iff {W : Subgroup D} (hW : lcs D 2 ≤ W) {x y z : D} (hyx : ⁅y, x⁆ ∈ W) :
    ⁅y * z, x⁆ ∈ W ↔ ⁅z, x⁆ ∈ W := by
  have h3 : ⁅y, ⁅z, x⁆⁆ ∈ W :=
    hW (commElem_mem_lcs_succ' y (commElem_mem_lcs_succ' (n := 0) z (Subgroup.mem_top x)))
  rw [commElem_mul_left, Subgroup.mul_mem_cancel_right W hyx,
    Subgroup.mul_mem_cancel_left W h3]

end Comm

end OMA.SimsLite


-- ===== Code =====
/-! The interface of the Sims-lite count: shapes, validity, index sets, codes, and what it means
for a generating tuple `X : Fin m → G` to realise a code.

Levels are 0-based: a position of level `ℓ` lies in `lcs G ℓ` (`γ_{ℓ+1}`).
* `df i = none`: `X i` is free (level 0);
* `df i = some none`: `X i = X (i-1) ^ p` (same level as `i-1`);
* `df i = some (some (a, b))`: `X i = ⁅X a, X b⁆` with `b` a core position and level `lv a + 1`.
Core positions carry a core index `cidx`; level-1 positions carry a step `st`.
Recorded relations: all `p`-th powers; commutators of level-0 pairs; commutators of a level-1
position `i` with core positions of core index `≤ st i`; commutators of a position of level `≥ 2`
with every core position. -/

namespace OMA.SimsLite

open scoped commutatorElement

universe u

section Code

/-- A shape on `m` positions: level, definition, core index, step. -/
abbrev Shape (m : ℕ) : Type :=
  (Fin m → Fin (m + 1)) × (Fin m → Option (Option (Fin m × Fin m))) ×
    (Fin m → Option (Fin m)) × (Fin m → Fin m)

variable {m : ℕ}

/-- Level (0-based weight). -/
def Shape.lv (s : Shape m) (i : Fin m) : ℕ := s.1 i

/-- Definition of a position. -/
def Shape.df (s : Shape m) (i : Fin m) : Option (Option (Fin m × Fin m)) := s.2.1 i

/-- Core index (`none` off the core). -/
def Shape.cidx (s : Shape m) (i : Fin m) : Option (Fin m) := s.2.2.1 i

/-- Step of a level-1 position. -/
def Shape.st (s : Shape m) (i : Fin m) : ℕ := s.2.2.2 i

/-- Number of core positions. -/
noncomputable def Shape.ncore (s : Shape m) : ℕ := Nat.card {i : Fin m // (s.cidx i).isSome}

/-- Number of positions of level `< w`; by monotonicity the positions of level `≥ w` are the
suffix starting here. -/
noncomputable def Shape.start (s : Shape m) (w : ℕ) : ℕ := Nat.card {i : Fin m // s.lv i < w}

/-- Validity conditions V1 to V6. -/
structure Shape.Valid (s : Shape m) : Prop where
  mono : ∀ i j : Fin m, i ≤ j → s.lv i ≤ s.lv j
  free : ∀ i, s.df i = none → s.lv i = 0
  pow : ∀ i, s.df i = some none → ∃ h : 0 < i.val,
    s.lv ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩ = s.lv i ∧ (s.lv i = 1 → s.st i = s.st ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩)
  comm : ∀ i a b, s.df i = some (some (a, b)) →
    a < i ∧ b < i ∧ (s.cidx b).isSome ∧ s.lv i = s.lv a + 1 ∧
      (s.lv i = 1 → ∃ ka kb : Fin m, s.cidx a = some ka ∧ s.cidx b = some kb ∧ ka < kb ∧
        kb.val = s.st i)
  core : ∀ i (k : Fin m), s.cidx i = some k → s.df i = none ∧ k.val < s.ncore
  core_inj : ∀ i j (k : Fin m), s.cidx i = some k → s.cidx j = some k → i = j
  steps : ∀ β, 1 ≤ β → β < s.ncore → ∃ i, s.lv i = 1 ∧ s.st i = β
  st_range : ∀ i, s.lv i = 1 → 1 ≤ s.st i ∧ s.st i < s.ncore

/-- Index predicate. Kind `0`: power relations; `1`: level-0 pairs; `2`: level 1 against core;
`3`: level `≥ 2` against core. The last coordinate is the column (position of the exponent). -/
def Shape.IdxP (s : Shape m) : Fin 4 × Fin m × Fin m × Fin m → Prop
  | (κ, i, k, j) =>
    (κ.val = 0 ∧ k = i ∧ i < j) ∨
    (κ.val = 1 ∧ s.lv i = 0 ∧ s.lv k = 0 ∧ i < k ∧ 1 ≤ s.lv j) ∨
    (κ.val = 2 ∧ s.lv i = 1 ∧ (∃ c : Fin m, s.cidx k = some c ∧ c.val ≤ s.st i) ∧ 2 ≤ s.lv j) ∨
    (κ.val = 3 ∧ 2 ≤ s.lv i ∧ (s.cidx k).isSome ∧ s.lv i + 1 ≤ s.lv j)

/-- The index set of a shape. -/
def Shape.Idx (s : Shape m) : Type := {q : Fin 4 × Fin m × Fin m × Fin m // s.IdxP q}

instance (s : Shape m) : Finite s.Idx := Subtype.finite

/-- Codes: a valid shape and an exponent below `p` for every index. -/
def Code (p m : ℕ) : Type := Σ s : {s : Shape m // s.Valid}, (s.1.Idx → Fin p)

instance (p m : ℕ) : Finite (Code p m) := by
  unfold Code
  infer_instance

open Classical in
/-- Exponent of column `j` in the relation of kind `κ` for the pair `(i, k)`; `0` off the index set. -/
noncomputable def Code.ex {p m : ℕ} (c : Code p m) (κ : Fin 4) (i k : Fin m) (j : ℕ) : ℕ :=
  if h : ∃ hj : j < m, c.1.1.IdxP (κ, i, k, ⟨j, hj⟩) then
    (c.2 ⟨(κ, i, k, ⟨j, h.1⟩), h.2⟩ : ℕ)
  else 0

/-- `(G, X)` realises the code `c`. -/
def Realizes {p m : ℕ} {G : Type u} [Group G] (X : Fin m → G) (c : Code p m) : Prop :=
  Nat.card G = p ^ m ∧
  Subgroup.closure (Set.range X) = ⊤ ∧
  (∀ i, c.1.1.df i = some none → ∀ h : 0 < i.val, X i = X ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩ ^ p) ∧
  (∀ i a b, c.1.1.df i = some (some (a, b)) → X i = ⁅X a, X b⁆) ∧
  (∀ i, X i ^ p = nf ((List.ofFn X).drop (i.val + 1)) (fun j => c.ex 0 i i (i.val + 1 + j))) ∧
  (∀ i k, c.1.1.lv i = 0 → c.1.1.lv k = 0 → i < k →
    ⁅X i, X k⁆ = nf ((List.ofFn X).drop (c.1.1.start 1)) (fun j => c.ex 1 i k (c.1.1.start 1 + j))) ∧
  (∀ i k (κ : Fin m), c.1.1.lv i = 1 → c.1.1.cidx k = some κ → κ.val ≤ c.1.1.st i →
    ⁅X i, X k⁆ = nf ((List.ofFn X).drop (c.1.1.start 2)) (fun j => c.ex 2 i k (c.1.1.start 2 + j))) ∧
  (∀ i k, 2 ≤ c.1.1.lv i → (c.1.1.cidx k).isSome →
    ⁅X i, X k⁆ = nf ((List.ofFn X).drop (c.1.1.start (c.1.1.lv i + 1)))
      (fun j => c.ex 3 i k (c.1.1.start (c.1.1.lv i + 1) + j)))

end Code

end OMA.SimsLite


-- ===== Lie =====
/-! Theorem L and Corollary L' of the Sims-lite blueprint (sections 1 and 2), with 0-based
levels: `lieM E l = closure (E l) ⊔ lcs D (l + 1)` is the blueprint's `M_{l+1}`. -/

namespace OMA.SimsLite

open scoped commutatorElement

universe u

section Lie

variable {D : Type u} [Group D]

/-- The level-`l` target subgroup `closure (E l) ⊔ lcs D (l + 1)`. -/
abbrev lieM (E : ℕ → Set D) (l : ℕ) : Subgroup D := Subgroup.closure (E l) ⊔ lcs D (l + 1)

lemma lieM_sup_right {E : ℕ → Set D} {l : ℕ} {x : D} (h : x ∈ lcs D (l + 1)) :
    x ∈ lieM E l :=
  Subgroup.mem_sup_right h

lemma lieM_le {E : ℕ → Set D} (hcl : ∀ w, 1 ≤ w → Subgroup.closure (E w) ≤ lcs D w)
    {l : ℕ} (hl : 1 ≤ l) : lieM E l ≤ lcs D l :=
  sup_le (hcl l hl) (lcs_antitone (Nat.le_succ l))

lemma lieM_normal {E : ℕ → Set D} (hcl : ∀ w, 1 ≤ w → Subgroup.closure (E w) ≤ lcs D w)
    {l : ℕ} (hl : 1 ≤ l) : (lieM E l).Normal :=
  normal_of_sandwich (n := l) le_sup_right (lieM_le hcl hl)

/-- Reduction of `⁅x, g⁆ ∈ N` (for `x` in a join) to generators. -/
lemma lie_sup_comm {N : Subgroup D} [N.Normal] {S : Set D} {L : Subgroup D} {g : D}
    (hS : ∀ x ∈ S, ⁅x, g⁆ ∈ N) (hL : ∀ x ∈ L, ⁅x, g⁆ ∈ N) :
    ∀ x ∈ Subgroup.closure S ⊔ L, ⁅x, g⁆ ∈ N := by
  have hle : Subgroup.closure S ⊔ L ≤ zn N g :=
    sup_le ((Subgroup.closure_le (zn N g)).mpr fun y hy => mem_zn.mpr (commElem_mem_symm (hS y hy)))
      fun y hy => mem_zn.mpr (commElem_mem_symm (hL y hy))
  intro x hx
  exact commElem_mem_symm (mem_zn.mp (hle hx))

/-- Reduction of `⁅x, g⁆ ∈ N` (for `g` in a join) to generators. -/
lemma lie_sup_comm_right {N : Subgroup D} [N.Normal] {S : Set D} {L : Subgroup D} {x : D}
    (hS : ∀ g ∈ S, ⁅x, g⁆ ∈ N) (hL : ∀ g ∈ L, ⁅x, g⁆ ∈ N) :
    ∀ g ∈ Subgroup.closure S ⊔ L, ⁅x, g⁆ ∈ N := fun g hg =>
  commElem_mem_symm (lie_sup_comm (N := N) (S := S) (L := L) (g := x)
    (fun y hy => commElem_mem_symm (hS y hy)) (fun y hy => commElem_mem_symm (hL y hy)) g hg)

/-- Commutators of a subgroup with a generated subgroup. -/
lemma lie_comm_le_closure {N : Subgroup D} [N.Normal] {K : Subgroup D} {S : Set D}
    (h : ∀ x ∈ K, ∀ s ∈ S, ⁅x, s⁆ ∈ N) : ⁅K, Subgroup.closure S⁆ ≤ N := by
  have h' := commutator_closure_le (N := N) (A := (K : Set D)) (B := S)
    (fun x hx s hs => h x (SetLike.mem_coe.mp hx) s hs)
  rwa [Subgroup.closure_eq] at h'

/-- The three subgroup lemma for cyclic subgroups, elementwise. -/
lemma lie_three (N K K' : Subgroup D) [N.Normal] [K.Normal] [K'.Normal] {a b c : D}
    (hbc : ⁅b, c⁆ ∈ K) (hKa : ∀ z ∈ K, ⁅z, a⁆ ∈ N) (hca : ⁅c, a⁆ ∈ K')
    (hK'b : ∀ z ∈ K', ⁅z, b⁆ ∈ N) : ⁅⁅a, b⁆, c⁆ ∈ N := by
  have hBC : ⁅Subgroup.closure ({b} : Set D), Subgroup.closure ({c} : Set D)⁆ ≤ K :=
    commutator_closure_le fun x hx y hy => by
      rw [Set.mem_singleton_iff] at hx hy
      rw [hx, hy]
      exact hbc
  have hCA : ⁅Subgroup.closure ({c} : Set D), Subgroup.closure ({a} : Set D)⁆ ≤ K' :=
    commutator_closure_le fun x hx y hy => by
      rw [Set.mem_singleton_iff] at hx hy
      rw [hx, hy]
      exact hca
  have h1 : ⁅⁅Subgroup.closure ({b} : Set D), Subgroup.closure ({c} : Set D)⁆,
      Subgroup.closure ({a} : Set D)⁆ ≤ N :=
    (Subgroup.commutator_mono hBC le_rfl).trans (lie_comm_le_closure fun z hz s hs => by
      rw [Set.mem_singleton_iff] at hs
      rw [hs]
      exact hKa z hz)
  have h2 : ⁅⁅Subgroup.closure ({c} : Set D), Subgroup.closure ({a} : Set D)⁆,
      Subgroup.closure ({b} : Set D)⁆ ≤ N :=
    (Subgroup.commutator_mono hCA le_rfl).trans (lie_comm_le_closure fun z hz s hs => by
      rw [Set.mem_singleton_iff] at hs
      rw [hs]
      exact hK'b z hz)
  have h3 := three_subgroup_mod N h1 h2
  exact h3 (Subgroup.commutator_mem_commutator
    (Subgroup.commutator_mem_commutator (Subgroup.subset_closure (Set.mem_singleton a))
      (Subgroup.subset_closure (Set.mem_singleton b)))
    (Subgroup.subset_closure (Set.mem_singleton c)))

/-- The level-`w` generators lie in `lcs D w`. -/
theorem closure_E_le (t : ℕ) (u : ℕ → D) (P : Set (ℕ × ℕ)) (E : ℕ → Set D)
    (hE1 : E 1 = (fun ab : ℕ × ℕ => ⁅u ab.1, u ab.2⁆) '' P)
    (hL2 : ∀ w, 1 ≤ w → ∀ x ∈ E (w + 1), ∃ y ∈ Subgroup.closure (E w), ∃ b < t, x = ⁅y, u b⁆) :
    ∀ w, 1 ≤ w → Subgroup.closure (E w) ≤ lcs D w := by
  intro w hw
  induction w, hw using Nat.le_induction with
  | base =>
    refine (Subgroup.closure_le (lcs D 1)).mpr ?_
    intro x hx
    rw [hE1] at hx
    obtain ⟨ab, -, rfl⟩ := hx
    exact commElem_mem_lcs_succ (n := 0) (Subgroup.mem_top (u ab.1)) (u ab.2)
  | succ w hw ih =>
    refine (Subgroup.closure_le (lcs D (w + 1))).mpr ?_
    intro x hx
    obtain ⟨y, hy, b, -, rfl⟩ := hL2 w hw x hx
    exact commElem_mem_lcs_succ (ih hy) (u b)

/-- Theorem L (0-based levels). `E w` is the set of level-`w` generators (`E 1` the core
commutators indexed by `P`); then every `lcs D w` (w ≥ 1) is generated by `E w` modulo the
next term. -/
theorem lie_lemma (t : ℕ) (u : ℕ → D) (H1 : Set D) (P : Set (ℕ × ℕ)) (E : ℕ → Set D)
    (hP : ∀ ab ∈ P, ab.1 < ab.2 ∧ ab.2 < t)
    (hE1 : E 1 = (fun ab : ℕ × ℕ => ⁅u ab.1, u ab.2⁆) '' P)
    (hL2 : ∀ w, 1 ≤ w → ∀ x ∈ E (w + 1), ∃ y ∈ Subgroup.closure (E w), ∃ b < t, x = ⁅y, u b⁆)
    (hL0 : Subgroup.closure H1 ⊔ lcs D 1 = ⊤)
    (hH1 : ∀ x ∈ H1, ∀ y ∈ H1, ⁅x, y⁆ ∈ Subgroup.closure (E 1) ⊔ lcs D 2)
    (hH2 : ∀ ab ∈ P, ∀ k ≤ ab.2, ⁅⁅u ab.1, u ab.2⁆, u k⁆ ∈ Subgroup.closure (E 2) ⊔ lcs D 3)
    (hH3 : ∀ w, 2 ≤ w → ∀ x ∈ E w, ∀ k < t,
      ⁅x, u k⁆ ∈ Subgroup.closure (E (w + 1)) ⊔ lcs D (w + 2)) :
    ∀ w, 1 ≤ w → lcs D w ≤ Subgroup.closure (E w) ⊔ lcs D (w + 1) := by
  have hcl := closure_E_le t u P E hE1 hL2
  have hMn : ∀ l, 1 ≤ l → (lieM E l).Normal := fun l hl => lieM_normal hcl hl
  have hc1 : ∀ a b : D, ⁅a, b⁆ ∈ lcs D 1 := fun a b =>
    commElem_mem_lcs_succ (n := 0) (Subgroup.mem_top a) b
  have hg : ∀ g : D, g ∈ Subgroup.closure H1 ⊔ lcs D 1 := fun g => by
    rw [hL0]
    exact Subgroup.mem_top g
  -- A(0): the commutator subgroup lies in `lieM E 1`
  have hA0 : lcs D 1 ≤ lieM E 1 := by
    have := hMn 1 le_rfl
    rw [show lcs D 1 = ⁅(⊤ : Subgroup D), ⊤⁆ from lcs_succ 0, Subgroup.commutator_le]
    intro x _ g _
    refine lie_sup_comm ?_ ?_ x (hg x)
    · intro y hy
      refine lie_sup_comm_right ?_ ?_ g (hg g)
      · intro h hh
        exact hH1 y hy h hh
      · intro h hh
        exact lieM_sup_right (commElem_mem_lcs_succ' y hh)
    · intro y hy
      exact lieM_sup_right (commElem_mem_lcs_succ hy g)
  -- B(1), by strong induction on the core index
  have hB1 : ∀ k, k < t → ∀ x ∈ lieM E 1, ⁅x, u k⁆ ∈ lieM E 2 := by
    have := hMn 1 le_rfl
    have := hMn 2 (by omega)
    intro k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
      intro hk
      refine lie_sup_comm ?_ ?_
      · intro z hz
        rw [hE1] at hz
        obtain ⟨ab, hab, rfl⟩ := hz
        obtain ⟨hab1, hab2⟩ := hP ab hab
        show ⁅⁅u ab.1, u ab.2⁆, u k⁆ ∈ lieM E 2
        by_cases hkb : k ≤ ab.2
        · exact hH2 ab hab k hkb
        · exact lie_three (lieM E 2) (lieM E 1) (lieM E 1) (a := u ab.1) (b := u ab.2) (c := u k)
            (hA0 (hc1 _ _)) (ih ab.1 (by omega) (by omega)) (hA0 (hc1 _ _))
            (ih ab.2 (by omega) (by omega))
      · intro z hz
        exact lieM_sup_right (commElem_mem_lcs_succ hz (u k))
  -- B(l) for all l ≥ 1
  have hB : ∀ l, 1 ≤ l → ∀ k, k < t → ∀ x ∈ lieM E l, ⁅x, u k⁆ ∈ lieM E (l + 1) := by
    intro l hl k hk
    rcases Nat.lt_or_ge l 2 with h | h
    · have hl1 : l = 1 := by omega
      subst hl1
      exact hB1 k hk
    · have := hMn (l + 1) (by omega)
      refine lie_sup_comm ?_ ?_
      · intro z hz
        exact hH3 l h z hz k hk
      · intro z hz
        exact lieM_sup_right (commElem_mem_lcs_succ hz (u k))
  -- reduction of A(l) to generators
  have hred : ∀ l, 1 ≤ l → (∀ x ∈ E l, ∀ h ∈ H1, ⁅x, h⁆ ∈ lieM E (l + 1)) →
      ∀ x ∈ lieM E l, ∀ g : D, ⁅x, g⁆ ∈ lieM E (l + 1) := by
    intro l hl hgen x hx g
    have := hMn (l + 1) (by omega)
    refine lie_sup_comm ?_ ?_ x hx
    · intro y hy
      refine lie_sup_comm_right ?_ ?_ g (hg g)
      · intro h hh
        exact hgen y hy h hh
      · intro h hh
        exact lieM_sup_right (commElem_mem_lcs_add (hcl l hl (Subgroup.subset_closure hy)) hh)
    · intro y hy
      exact lieM_sup_right (commElem_mem_lcs_succ hy g)
  -- A(l) for all l ≥ 1
  have hA : ∀ l, 1 ≤ l → ∀ x ∈ lieM E l, ∀ g : D, ⁅x, g⁆ ∈ lieM E (l + 1) := by
    intro l hl
    induction l, hl using Nat.le_induction with
    | base =>
      refine hred 1 le_rfl ?_
      have := hMn 1 le_rfl
      have := hMn 2 (by omega)
      intro x hx h _
      rw [hE1] at hx
      obtain ⟨ab, hab, rfl⟩ := hx
      obtain ⟨hab1, hab2⟩ := hP ab hab
      exact lie_three (lieM E 2) (lieM E 1) (lieM E 1) (a := u ab.1) (b := u ab.2) (c := h)
        (hA0 (hc1 _ _)) (hB 1 le_rfl ab.1 (by omega)) (hA0 (hc1 _ _)) (hB 1 le_rfl ab.2 hab2)
    | succ j hj ih =>
      refine hred (j + 1) (by omega) ?_
      have := hMn 1 le_rfl
      have := hMn (j + 1) (by omega)
      have := hMn (j + 1 + 1) (by omega)
      intro x hx h _
      obtain ⟨y, hy, bi, hbi, rfl⟩ := hL2 j hj x hx
      have hyM : y ∈ lieM E j := Subgroup.mem_sup_left hy
      have hyl : y ∈ lcs D j := hcl j hj hy
      have h5b : ∀ z ∈ lieM E 1, ⁅z, y⁆ ∈ lieM E (j + 1 + 1) := by
        refine lie_sup_comm ?_ ?_
        · intro z hz
          rw [hE1] at hz
          obtain ⟨cd, hcd, rfl⟩ := hz
          obtain ⟨hcd1, hcd2⟩ := hP cd hcd
          exact lie_three (lieM E (j + 1 + 1)) (lieM E (j + 1)) (lieM E (j + 1))
            (a := u cd.1) (b := u cd.2) (c := y)
            (commElem_mem_symm (hB j hj cd.2 hcd2 y hyM)) (hB (j + 1) (by omega) cd.1 (by omega))
            (hB j hj cd.1 (by omega) y hyM) (hB (j + 1) (by omega) cd.2 hcd2)
        · intro z hz
          exact lieM_sup_right (lcs_antitone (by omega) (commElem_mem_lcs_add hz hyl))
      exact lie_three (lieM E (j + 1 + 1)) (lieM E 1) (lieM E (j + 1)) (a := y) (b := u bi) (c := h)
        (hA0 (hc1 _ _)) h5b (commElem_mem_symm (ih y hyM h)) (hB (j + 1) (by omega) bi hbi)
  -- conclusion
  have hfin : ∀ l, 1 ≤ l → lcs D l ≤ lieM E l := by
    intro l hl
    induction l, hl using Nat.le_induction with
    | base => exact hA0
    | succ j hj ih =>
      rw [lcs_succ, Subgroup.commutator_le]
      intro x hx g _
      exact hA j hj x (ih hx) g
  exact hfin

/-- Corollary L' (tail form): in a nilpotent group the level-`≥ w` generators generate `lcs D w`. -/
theorem lie_lemma_tail (t : ℕ) (u : ℕ → D) (H1 : Set D) (P : Set (ℕ × ℕ)) (E : ℕ → Set D)
    (hP : ∀ ab ∈ P, ab.1 < ab.2 ∧ ab.2 < t)
    (hE1 : E 1 = (fun ab : ℕ × ℕ => ⁅u ab.1, u ab.2⁆) '' P)
    (hL2 : ∀ w, 1 ≤ w → ∀ x ∈ E (w + 1), ∃ y ∈ Subgroup.closure (E w), ∃ b < t, x = ⁅y, u b⁆)
    (hL0 : Subgroup.closure H1 ⊔ lcs D 1 = ⊤)
    (hH1 : ∀ x ∈ H1, ∀ y ∈ H1, ⁅x, y⁆ ∈ Subgroup.closure (E 1) ⊔ lcs D 2)
    (hH2 : ∀ ab ∈ P, ∀ k ≤ ab.2, ⁅⁅u ab.1, u ab.2⁆, u k⁆ ∈ Subgroup.closure (E 2) ⊔ lcs D 3)
    (hH3 : ∀ w, 2 ≤ w → ∀ x ∈ E w, ∀ k < t,
      ⁅x, u k⁆ ∈ Subgroup.closure (E (w + 1)) ⊔ lcs D (w + 2))
    (N : ℕ) (hN : lcs D N = ⊥) :
    ∀ w, 1 ≤ w → lcs D w ≤ Subgroup.closure (⋃ v ∈ Set.Ici w, E v) := by
  have hL := lie_lemma t u H1 P E hP hE1 hL2 hL0 hH1 hH2 hH3
  have key : ∀ d w, 1 ≤ w → N ≤ w + d →
      lcs D w ≤ Subgroup.closure (⋃ v ∈ Set.Ici w, E v) := by
    intro d
    induction d with
    | zero =>
      intro w _ hw
      calc lcs D w ≤ lcs D N := lcs_antitone (by omega)
        _ = ⊥ := hN
        _ ≤ _ := bot_le
    | succ d ih =>
      intro w hw hwd
      have h1 := ih (w + 1) (by omega) (by omega)
      refine (hL w hw).trans (sup_le ?_ (h1.trans ?_))
      · exact Subgroup.closure_mono (Set.subset_biUnion_of_mem (u := E) (Set.mem_Ici.mpr le_rfl))
      · refine Subgroup.closure_mono (Set.biUnion_subset_biUnion_left ?_)
        intro v hv
        rw [Set.mem_Ici] at hv ⊢
        omega
  intro w hw
  exact key N w hw (by omega)

end Lie

end OMA.SimsLite


-- ===== Strict =====
/-! Theorem S of the blueprint (section 3): strict chains.
S1 (`exists_strict_chain`) by maximality, S2 (`strict_chain_indep`) via `zn`. -/

namespace OMA.SimsLite

open scoped commutatorElement

universe u

section StrictStmt

variable {G : Type u} [Group G]

/-- `W_k(u) = ⟨⁅u a, u b⁆ : a < b < k⟩ γ_3`. -/
def Wk (u : ℕ → G) (k : ℕ) : Subgroup G :=
  Subgroup.closure {x | ∃ a b, a < b ∧ b < k ∧ x = ⁅u a, u b⁆} ⊔ lcs G 2

/-- `u` is strict of length `t`: each new core element enlarges `W`. -/
def StrictChain (u : ℕ → G) (t : ℕ) : Prop := ∀ k, 2 ≤ k → k ≤ t → Wk u (k - 1) ≠ Wk u k

/-! Basic facts about `Wk`. -/

lemma lcs_two_le_Wk (u : ℕ → G) (k : ℕ) : lcs G 2 ≤ Wk u k := by
  unfold Wk
  exact le_sup_right

lemma comm_mem_Wk (u : ℕ → G) {a b k : ℕ} (hab : a < b) (hbk : b < k) :
    ⁅u a, u b⁆ ∈ Wk u k := by
  unfold Wk
  exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨a, b, hab, hbk, rfl⟩)

lemma Wk_le {u : ℕ → G} {k : ℕ} {H : Subgroup G} (h3 : lcs G 2 ≤ H)
    (h : ∀ a b, a < b → b < k → ⁅u a, u b⁆ ∈ H) : Wk u k ≤ H := by
  unfold Wk
  refine sup_le ?_ h3
  rw [Subgroup.closure_le]
  rintro _ ⟨a, b, hab, hbk, rfl⟩
  exact h a b hab hbk

lemma Wk_mono (u : ℕ → G) {k l : ℕ} (hkl : k ≤ l) : Wk u k ≤ Wk u l :=
  Wk_le (lcs_two_le_Wk u l) fun a b hab hbk => comm_mem_Wk u hab (by omega)

lemma Wk_le_lcs_one (u : ℕ → G) (k : ℕ) : Wk u k ≤ lcs G 1 :=
  Wk_le (lcs_antitone (by norm_num)) fun a b _ _ =>
    commElem_mem_lcs_succ (n := 0) (Subgroup.mem_top (u a)) (u b)

lemma Wk_normal (u : ℕ → G) (k : ℕ) : (Wk u k).Normal :=
  normal_of_sandwich (n := 1) (lcs_two_le_Wk u k) (Wk_le_lcs_one u k)

lemma Wk_congr_le {u v : ℕ → G} {k : ℕ} (h : ∀ i < k, u i = v i) : Wk u k ≤ Wk v k :=
  Wk_le (lcs_two_le_Wk v k) fun a b hab hbk => by
    rw [h a (by omega), h b hbk]
    exact comm_mem_Wk v hab hbk

lemma Wk_congr {u v : ℕ → G} {k : ℕ} (h : ∀ i < k, u i = v i) : Wk u k = Wk v k :=
  le_antisymm (Wk_congr_le h) (Wk_congr_le fun i hi => (h i hi).symm)

lemma Wk_succ_le {u : ℕ → G} {k : ℕ} (h : ∀ a < k, ⁅u a, u k⁆ ∈ Wk u k) :
    Wk u (k + 1) ≤ Wk u k := by
  refine Wk_le (lcs_two_le_Wk u k) ?_
  intro a b hab hbk
  by_cases hb : b < k
  · exact comm_mem_Wk u hab hb
  · rw [show b = k by omega]
    exact h a (by omega)

lemma Wk_exists_not_mem_of_ne {u : ℕ → G} {k : ℕ} (h : Wk u k ≠ Wk u (k + 1)) :
    ∃ a < k, ⁅u a, u k⁆ ∉ Wk u k := by
  by_contra hc
  apply h
  refine le_antisymm (Wk_mono u (show k ≤ k + 1 by omega)) (Wk_succ_le ?_)
  intro a ha
  by_contra hn
  exact hc ⟨a, ha, hn⟩

lemma Wk_ne_of_mem {A B : Subgroup G} {z : G} (hB : z ∈ B) (hA : z ∉ A) : A ≠ B := by
  rintro rfl
  exact hA hB

lemma Wk_exists_comm {W : Subgroup G} (h : ¬ lcs G 1 ≤ W) : ∃ x y : G, ⁅x, y⁆ ∉ W := by
  by_contra hc
  apply h
  have e : lcs G 1 = ⁅(⊤ : Subgroup G), ⊤⁆ := rfl
  rw [e, Subgroup.commutator_le]
  intro x _ y _
  by_contra hxy
  exact hc ⟨x, y, hxy⟩

/-! Basic facts about strict chains. -/

lemma strictChain_of {u : ℕ → G} {t : ℕ}
    (h : ∀ k, 1 ≤ k → k + 1 ≤ t → Wk u k ≠ Wk u (k + 1)) : StrictChain u t := by
  intro k hk hkt
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  rw [Nat.add_sub_cancel]
  exact h j (by omega) hkt

lemma StrictChain.ne_succ {u : ℕ → G} {t : ℕ} (h : StrictChain u t) {k : ℕ} (hk : 1 ≤ k)
    (hkt : k + 1 ≤ t) : Wk u k ≠ Wk u (k + 1) := by
  have := h (k + 1) (by omega) hkt
  rw [Nat.add_sub_cancel] at this
  exact this

lemma strictChain_zero (u : ℕ → G) : StrictChain u 0 := by
  intro k hk hkt
  omega

/-- A strict chain has length at most `Nat.card G`: the orders of the `Wk u k` increase. -/
lemma StrictChain.le_card [Finite G] {u : ℕ → G} {t : ℕ} (h : StrictChain u t) :
    t ≤ Nat.card G := by
  have key : ∀ k, 1 ≤ k → k ≤ t → k ≤ Nat.card (Wk u k) := by
    intro k
    induction k with
    | zero => intro hk _; omega
    | succ j ih =>
      intro hk hkt
      rcases Nat.eq_zero_or_pos j with hj | hj
      · subst hj
        show 1 ≤ Nat.card (Wk u 1)
        have hpos : 0 < Nat.card (Wk u 1) := Nat.card_pos
        omega
      · have h1 := ih (by omega) (by omega)
        have hne := h.ne_succ (k := j) (by omega) hkt
        have hle := Wk_mono u (show j ≤ j + 1 by omega)
        have hlt : Nat.card (Wk u j) < Nat.card (Wk u (j + 1)) := by
          by_contra hc
          exact hne (Subgroup.eq_of_le_of_card_ge hle (by omega))
        omega
  rcases Nat.eq_zero_or_pos t with ht | ht
  · omega
  · exact (key t (by omega) le_rfl).trans (Subgroup.card_le_card_group _)

/-- The chain `(x, y)` is strict of length 2 when `⁅x, y⁆ ∉ γ_3`. -/
lemma strict_two {u : ℕ → G} {x y : G} (e0 : u 0 = x) (e1 : u 1 = y)
    (hxy : ⁅x, y⁆ ∉ lcs G 2) : StrictChain u 2 := by
  apply strictChain_of
  intro k hk hkt
  rw [show k = 1 by omega]
  have hm : ⁅u 0, u 1⁆ ∈ Wk u (1 + 1) := comm_mem_Wk u (by norm_num) (by norm_num)
  have h1 : Wk u 1 ≤ lcs G 2 := Wk_le le_rfl fun a b hab hb => by
    exfalso
    omega
  rw [e0, e1] at hm
  exact Wk_ne_of_mem hm fun h => hxy (h1 h)

/-- Case 1 of S1: appending `v` with `⁅u a, v⁆ ∉ W_t`. -/
lemma strict_append {u u' : ℕ → G} {t a : ℕ} {v : G} (hu : StrictChain u t) (ha : a < t)
    (e1 : ∀ i < t, u' i = u i) (e2 : u' t = v) (hv : ⁅u a, v⁆ ∉ Wk u t) :
    StrictChain u' (t + 1) := by
  have hW : ∀ k ≤ t, Wk u' k = Wk u k := fun k hk => Wk_congr fun i hi => e1 i (by omega)
  apply strictChain_of
  intro k hk hkt
  rcases Nat.lt_or_ge k t with hkt' | hkt'
  · rw [hW k (by omega), hW (k + 1) (by omega)]
    exact hu.ne_succ hk (by omega)
  · rw [show k = t by omega, hW t le_rfl]
    have hm : ⁅u' a, u' t⁆ ∈ Wk u' (t + 1) := comm_mem_Wk u' ha (by omega)
    rw [e1 a ha, e2] at hm
    exact Wk_ne_of_mem hm hv

/-- Case 2 of S1: the exchange `u' = (u_0, ..., u_{s-1}, w, y)`. -/
lemma strict_exchange {u u' : ℕ → G} {s : ℕ} {w y : G} (hu : StrictChain u (s + 1))
    (hc : ∀ a < s + 1, ∀ v, ⁅u a, v⁆ ∈ Wk u (s + 1))
    (e1 : ∀ i < s, u' i = u i) (e2 : u' s = w) (e3 : u' (s + 1) = y)
    (hw1 : ∃ a < s, ⁅u a, w⁆ ∉ Wk u s) (hw2 : ⁅w, y⁆ ∉ Wk u (s + 1)) :
    StrictChain u' (s + 1 + 1) := by
  have hW : ∀ k ≤ s, Wk u' k = Wk u k := fun k hk => Wk_congr fun i hi => e1 i (by omega)
  have hle : Wk u' (s + 1) ≤ Wk u (s + 1) := by
    refine Wk_le (lcs_two_le_Wk u (s + 1)) ?_
    intro a b hab hb
    by_cases hbs : b < s
    · rw [e1 a (by omega), e1 b hbs]
      exact comm_mem_Wk u hab (by omega)
    · rw [show b = s by omega, e1 a (by omega), e2]
      exact hc a (by omega) w
  apply strictChain_of
  intro k hk hkt
  by_cases hks : k < s
  · rw [hW k (by omega), hW (k + 1) (by omega)]
    exact hu.ne_succ hk (by omega)
  · by_cases hk' : k = s
    · rw [hk']
      obtain ⟨a, ha, hna⟩ := hw1
      have hm : ⁅u' a, u' s⁆ ∈ Wk u' (s + 1) := comm_mem_Wk u' ha (by omega)
      rw [e1 a ha, e2] at hm
      rw [hW s le_rfl]
      exact Wk_ne_of_mem hm hna
    · rw [show k = s + 1 by omega]
      have hm : ⁅u' s, u' (s + 1)⁆ ∈ Wk u' (s + 1 + 1) :=
        comm_mem_Wk u' (by omega) (by omega)
      rw [e2, e3] at hm
      exact Wk_ne_of_mem hm fun h => hw2 (hle h)

/-- The extension step of S1: a strict chain of length `t ≥ 2` with `γ_2 ≰ W_t` extends. -/
lemma strict_extend {u : ℕ → G} {t : ℕ} (ht : 2 ≤ t) (hu : StrictChain u t) {x y : G}
    (hxy : ⁅x, y⁆ ∉ Wk u t) : ∃ u' : ℕ → G, StrictChain u' (t + 1) := by
  by_cases hc : ∃ a < t, ∃ v, ⁅u a, v⁆ ∉ Wk u t
  · obtain ⟨a, ha, v, hv⟩ := hc
    refine ⟨fun i => if i < t then u i else v, ?_⟩
    refine strict_append (u' := fun i => if i < t then u i else v) hu ha ?_ ?_ hv
    · intro i hi
      exact if_pos hi
    · show (if t < t then u t else v) = v
      exact if_neg (lt_irrefl t)
  · have hc' : ∀ a < t, ∀ v, ⁅u a, v⁆ ∈ Wk u t := fun a ha v => by
      by_contra hn
      exact hc ⟨a, ha, v, hn⟩
    obtain ⟨s, rfl⟩ : ∃ s, t = s + 1 := ⟨t - 1, by omega⟩
    obtain ⟨a0, ha0, hna0⟩ := Wk_exists_not_mem_of_ne (hu.ne_succ (k := s) (by omega) le_rfl)
    have hw : ∃ w : G, (∃ a < s, ⁅u a, w⁆ ∉ Wk u s) ∧ ⁅w, y⁆ ∉ Wk u (s + 1) := by
      by_cases hx : ∃ a < s, ⁅u a, x⁆ ∉ Wk u s
      · exact ⟨x, hx, hxy⟩
      · refine ⟨u s * x, ⟨a0, ha0, ?_⟩, ?_⟩
        · have hax : ⁅u a0, x⁆ ∈ Wk u s := by
            by_contra hn
            exact hx ⟨a0, ha0, hn⟩
          rw [comm_mul_right_mem_iff' (lcs_two_le_Wk u s) hax]
          exact hna0
        · rw [comm_mul_left_mem_iff (lcs_two_le_Wk u (s + 1)) (hc' s (by omega) y)]
          exact hxy
    obtain ⟨w, hw1, hw2⟩ := hw
    refine ⟨fun i => if i < s then u i else if i = s then w else y, ?_⟩
    refine strict_exchange (u' := fun i => if i < s then u i else if i = s then w else y)
      hu hc' ?_ ?_ ?_ hw1 hw2
    · intro i hi
      exact if_pos hi
    · show (if s < s then u s else if s = s then w else y) = w
      rw [if_neg (lt_irrefl s), if_pos rfl]
    · show (if s + 1 < s then u (s + 1) else if s + 1 = s then w else y) = y
      rw [if_neg (show ¬ (s + 1 < s) by omega), if_neg (show ¬ (s + 1 = s) by omega)]

/-- S1: a strict chain whose commutators generate `γ_2` modulo `γ_3`. -/
theorem exists_strict_chain [Finite G] :
    ∃ (t : ℕ) (u : ℕ → G), t ≠ 1 ∧ StrictChain u t ∧ lcs G 1 ≤ Wk u t := by
  by_contra H
  have H' : ∀ (t : ℕ) (u : ℕ → G), t ≠ 1 → StrictChain u t → ¬ lcs G 1 ≤ Wk u t :=
    fun t u h1 h2 h3 => H ⟨t, u, h1, h2, h3⟩
  have key : ∀ n : ℕ, ∃ u : ℕ → G, StrictChain u (n + 2) := by
    intro n
    induction n with
    | zero =>
      obtain ⟨x, y, hxy⟩ :=
        Wk_exists_comm (H' 0 (fun _ => 1) (by norm_num) (strictChain_zero _))
      refine ⟨fun i => if i = 0 then x else y, ?_⟩
      refine strict_two (u := fun i => if i = 0 then x else y) (x := x) (y := y) ?_ ?_ ?_
      · show (if (0 : ℕ) = 0 then x else y) = x
        exact if_pos rfl
      · show (if (1 : ℕ) = 0 then x else y) = y
        exact if_neg (by norm_num)
      · exact fun h => hxy (lcs_two_le_Wk (fun _ : ℕ => (1 : G)) 0 h)
    | succ n ih =>
      obtain ⟨u, hu⟩ := ih
      obtain ⟨x, y, hxy⟩ := Wk_exists_comm (H' (n + 2) u (by omega) hu)
      obtain ⟨u', hu'⟩ := strict_extend (by omega) hu hxy
      refine ⟨u', ?_⟩
      show StrictChain u' (n + 1 + 2)
      rw [show n + 1 + 2 = n + 2 + 1 by omega]
      exact hu'
  obtain ⟨u, hu⟩ := key (Nat.card G)
  have := hu.le_card
  omega

/-- S2: the elements of a strict chain are independent modulo `γ_2`. -/
theorem strict_chain_indep (u : ℕ → G) (t : ℕ) (h : StrictChain u t) (ht : 2 ≤ t) :
    ∀ k < t, u k ∉ Subgroup.closure (u '' Set.Iio k) ⊔ lcs G 1 := by
  intro k hk hmem
  rcases Nat.eq_zero_or_pos k with hk0 | hk0
  · subst hk0
    have hle : Subgroup.closure (u '' Set.Iio 0) ⊔ lcs G 1 ≤ lcs G 1 := by
      refine sup_le ?_ le_rfl
      rw [Subgroup.closure_le]
      rintro _ ⟨i, hi, rfl⟩
      exact absurd (Set.mem_Iio.mp hi) (Nat.not_lt_zero i)
    have h0 : u 0 ∈ lcs G 1 := hle hmem
    refine h.ne_succ (k := 1) le_rfl (by omega)
      (le_antisymm (Wk_mono u (show 1 ≤ 1 + 1 by omega)) (Wk_succ_le ?_))
    intro a ha
    obtain rfl : a = 0 := by omega
    exact lcs_two_le_Wk u 1 (commElem_mem_lcs_succ (n := 1) h0 (u 1))
  · have := Wk_normal u k
    refine h.ne_succ (k := k) (by omega) (by omega)
      (le_antisymm (Wk_mono u (show k ≤ k + 1 by omega)) (Wk_succ_le ?_))
    intro a ha
    have hle : Subgroup.closure (u '' Set.Iio k) ⊔ lcs G 1 ≤ zn (Wk u k) (u a) := by
      refine sup_le ?_ ?_
      · rw [Subgroup.closure_le]
        rintro _ ⟨b, hb, rfl⟩
        rw [SetLike.mem_coe, mem_zn]
        rcases lt_trichotomy a b with hab | hab | hab
        · exact comm_mem_Wk u hab (Set.mem_Iio.mp hb)
        · rw [hab, commutatorElement_self]
          exact (Wk u k).one_mem
        · exact commElem_mem_symm (comm_mem_Wk u hab ha)
      · intro z hz
        exact mem_zn.mpr (lcs_two_le_Wk u k (commElem_mem_lcs_succ' (n := 1) (u a) hz))
    exact mem_zn.mp (hle hmem)

end StrictStmt

end OMA.SimsLite


-- ===== Count =====
/-! Theorem C (the count of codes).

For a valid shape on `m` positions, let `a`, `b`, `c` be the numbers of positions of level `0`,
`1` and `≥ 2`, and `t` the number of core positions. The index set splits by kind:
* kind `0`: at most `m * m` indices;
* kind `1`: increasing pairs of level-0 positions times the positions of level `≥ 1`;
* kind `2`: for each level-1 position `i`, the core positions of core index `≤ st i`
  (at most `st i + 1` of them), times the positions of level `≥ 2`;
* kind `3`: increasing pairs of positions of level `≥ 2` times the core.
The steps of (V6) give the saving `Σ (st i + 1) ≤ t b - (t - 1) (t - 2) / 2`, and a cubic
inequality with explicit polynomial certificates gives `25 |Idx| ≤ 2 m^3 + 50 m^2`. -/

namespace OMA.SimsLite

open scoped commutatorElement

section Count

/-! Finsets attached to a shape -/

/-- Positions of level `0`. -/
def Shape.cntA {m : ℕ} (s : Shape m) : Finset (Fin m) :=
  Finset.univ.filter (fun i => s.lv i = 0)

/-- Positions of level `≥ 1`. -/
def Shape.cntN {m : ℕ} (s : Shape m) : Finset (Fin m) :=
  Finset.univ.filter (fun i => ¬ s.lv i = 0)

/-- Positions of level `1`. -/
def Shape.cntB {m : ℕ} (s : Shape m) : Finset (Fin m) :=
  Finset.univ.filter (fun i => s.lv i = 1)

/-- Positions of level `≥ 2`. -/
def Shape.cntC {m : ℕ} (s : Shape m) : Finset (Fin m) :=
  Finset.univ.filter (fun i => 2 ≤ s.lv i)

/-- Core positions. -/
def Shape.cntK {m : ℕ} (s : Shape m) : Finset (Fin m) :=
  Finset.univ.filter (fun i => (s.cidx i).isSome)

/-- Core positions whose core index is at most `st i`. -/
def Shape.cntKs {m : ℕ} (s : Shape m) (i : Fin m) : Finset (Fin m) :=
  Finset.univ.filter (fun k => ∃ c : Fin m, s.cidx k = some c ∧ c.val ≤ s.st i)

/-- Increasing pairs of elements of a finset. -/
def cntPairs {m : ℕ} (S : Finset (Fin m)) : Finset (Fin m × Fin m) :=
  (S ×ˢ S).filter (fun q => q.1 < q.2)

lemma Shape.mem_cntA {m : ℕ} (s : Shape m) (i : Fin m) : i ∈ s.cntA ↔ s.lv i = 0 := by
  simp [Shape.cntA]

lemma Shape.mem_cntN {m : ℕ} (s : Shape m) (i : Fin m) : i ∈ s.cntN ↔ ¬ s.lv i = 0 := by
  simp [Shape.cntN]

lemma Shape.mem_cntB {m : ℕ} (s : Shape m) (i : Fin m) : i ∈ s.cntB ↔ s.lv i = 1 := by
  simp [Shape.cntB]

lemma Shape.mem_cntC {m : ℕ} (s : Shape m) (i : Fin m) : i ∈ s.cntC ↔ 2 ≤ s.lv i := by
  simp [Shape.cntC]

lemma Shape.mem_cntK {m : ℕ} (s : Shape m) (i : Fin m) :
    i ∈ s.cntK ↔ (s.cidx i).isSome = true := by
  simp [Shape.cntK]

lemma Shape.mem_cntKs {m : ℕ} (s : Shape m) (i k : Fin m) :
    k ∈ s.cntKs i ↔ ∃ c : Fin m, s.cidx k = some c ∧ c.val ≤ s.st i := by
  simp [Shape.cntKs]

lemma mem_cntPairs {m : ℕ} (S : Finset (Fin m)) (q : Fin m × Fin m) :
    q ∈ cntPairs S ↔ q.1 ∈ S ∧ q.2 ∈ S ∧ q.1 < q.2 := by
  unfold cntPairs
  rw [Finset.mem_filter, Finset.mem_product, and_assoc]

/-! Elementary counts -/

lemma cnt_two_mul_pairs_le {m : ℕ} (S : Finset (Fin m)) :
    2 * (cntPairs S).card ≤ S.card * S.card := by
  have hXY : (cntPairs S).card ≤
      ((S ×ˢ S).filter (fun q : Fin m × Fin m => ¬ q.1 < q.2)).card := by
    rw [← Finset.card_image_of_injective (cntPairs S) Prod.swap_injective]
    apply Finset.card_le_card
    intro q hq
    rw [Finset.mem_image] at hq
    obtain ⟨r, hr, rfl⟩ := hq
    rw [mem_cntPairs] at hr
    rw [Finset.mem_filter, Finset.mem_product]
    exact ⟨⟨hr.2.1, hr.1⟩, not_lt.2 hr.2.2.le⟩
  have h : (cntPairs S).card + ((S ×ˢ S).filter (fun q : Fin m × Fin m => ¬ q.1 < q.2)).card =
      S.card * S.card := by
    rw [← Finset.card_product]
    exact Finset.card_filter_add_card_filter_not (fun q : Fin m × Fin m => q.1 < q.2)
  omega

lemma Shape.cnt_card_A_N {m : ℕ} (s : Shape m) : s.cntA.card + s.cntN.card = m := by
  have h : s.cntA.card + s.cntN.card = (Finset.univ : Finset (Fin m)).card :=
    Finset.card_filter_add_card_filter_not (fun i => s.lv i = 0)
  rw [h, Finset.card_univ, Fintype.card_fin]

lemma Shape.cnt_card_N {m : ℕ} (s : Shape m) : s.cntN.card = s.cntB.card + s.cntC.card := by
  have e1 : s.cntN.filter (fun i => s.lv i = 1) = s.cntB := by
    ext i
    rw [Finset.mem_filter, s.mem_cntN, s.mem_cntB]
    omega
  have e2 : s.cntN.filter (fun i => ¬ s.lv i = 1) = s.cntC := by
    ext i
    rw [Finset.mem_filter, s.mem_cntN, s.mem_cntC]
    omega
  rw [← e1, ← e2]
  exact (Finset.card_filter_add_card_filter_not (fun i => s.lv i = 1)).symm

lemma Shape.cnt_ncore_eq {m : ℕ} (s : Shape m) : s.ncore = s.cntK.card := by
  unfold Shape.ncore
  exact Nat.subtype_card _ (fun x => s.mem_cntK x)

/-- `t ≤ l1`: core positions are free, hence of level `0`. -/
lemma Shape.cnt_ncore_le {m : ℕ} (s : Shape m) (hs : s.Valid) : s.ncore ≤ s.cntA.card := by
  rw [s.cnt_ncore_eq]
  apply Finset.card_le_card
  intro i hi
  rw [s.mem_cntK] at hi
  rw [s.mem_cntA]
  obtain ⟨k, hk⟩ := Option.isSome_iff_exists.1 hi
  exact hs.free i (hs.core i k hk).1

/-- At most `st i + 1` core positions have core index `≤ st i` (`core_inj`). -/
lemma Shape.cnt_card_Ks_le {m : ℕ} (s : Shape m) (hs : s.Valid) (i : Fin m) :
    (s.cntKs i).card ≤ s.st i + 1 := by
  calc (s.cntKs i).card ≤ (Finset.range (s.st i + 1)).card := by
        apply Finset.card_le_card_of_injOn (fun k => ((s.cidx k).map Fin.val).getD 0)
        · intro k hk
          rw [Finset.mem_coe, s.mem_cntKs] at hk
          obtain ⟨c, hc, hle⟩ := hk
          simp only [Finset.coe_range, Set.mem_Iio, hc, Option.map_some, Option.getD_some]
          omega
        · intro k1 hk1 k2 hk2 hfeq
          rw [Finset.mem_coe, s.mem_cntKs] at hk1 hk2
          obtain ⟨c1, hc1, -⟩ := hk1
          obtain ⟨c2, hc2, -⟩ := hk2
          simp only [hc1, hc2, Option.map_some, Option.getD_some] at hfeq
          have h12 : c1 = c2 := Fin.ext hfeq
          rw [← h12] at hc2
          exact hs.core_inj k1 k2 c1 hc1 hc2
    _ = s.st i + 1 := Finset.card_range _

lemma cnt_gauss (n : ℕ) : (∑ i ∈ Finset.range n, i) * 2 + n = n * n := by
  induction n with
  | zero => simp
  | succ k ih =>
    rw [Finset.sum_range_succ]
    nlinarith [ih]

/-- The rho bound: the steps of (V6) give distinct witnesses, so
`2 Σ_{lv i = 1} (st i + 1) + (t - 1)^2 ≤ 2 t l2 + (t - 1)`, and `t - 1 ≤ l2`. -/
lemma Shape.cnt_rho {m : ℕ} (s : Shape m) (hs : s.Valid) :
    s.ncore - 1 ≤ s.cntB.card ∧
      2 * (∑ i ∈ s.cntB, (s.st i + 1)) + (s.ncore - 1) * (s.ncore - 1) ≤
        2 * (s.cntB.card * s.ncore) + (s.ncore - 1) := by
  have hsum : ∑ i ∈ s.cntB, (s.st i + 1) + ∑ i ∈ s.cntB, (s.ncore - 1 - s.st i) =
      s.cntB.card * s.ncore := by
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_const_nat
    intro i hi
    have h1 := hs.st_range i ((s.mem_cntB i).1 hi)
    omega
  have hsub : Finset.range (s.ncore - 1) ⊆ s.cntB.image (fun i => s.ncore - 1 - s.st i) := by
    intro g hg
    rw [Finset.mem_range] at hg
    obtain ⟨i, hi1, hi2⟩ := hs.steps (s.ncore - 1 - g) (by omega) (by omega)
    rw [Finset.mem_image]
    exact ⟨i, (s.mem_cntB i).2 hi1, show s.ncore - 1 - s.st i = g by omega⟩
  have hdef : ∑ i ∈ Finset.range (s.ncore - 1), i ≤ ∑ i ∈ s.cntB, (s.ncore - 1 - s.st i) := by
    calc ∑ i ∈ Finset.range (s.ncore - 1), i
        ≤ ∑ i ∈ s.cntB.image (fun i => s.ncore - 1 - s.st i), i :=
          Finset.sum_le_sum_of_subset hsub
      _ ≤ ∑ i ∈ s.cntB, (s.ncore - 1 - s.st i) :=
          Finset.sum_image_le_of_nonneg (fun _ _ => Nat.zero_le _)
  have hg := cnt_gauss (s.ncore - 1)
  have hcard : s.ncore - 1 ≤ s.cntB.card := by
    have h1 := Finset.card_le_card hsub
    have h2 : (s.cntB.image (fun i => s.ncore - 1 - s.st i)).card ≤ s.cntB.card :=
      Finset.card_image_le
    rw [Finset.card_range] at h1
    omega
  exact ⟨hcard, by omega⟩

/-! Splitting the index set by kind -/

/-- Kind-0 indices. -/
def cntS0 (n : ℕ) : Finset (Fin 4 × Fin n × Fin n × Fin n) :=
  (Finset.univ : Finset (Fin n × Fin n)).image
    (fun q => ((⟨0, by omega⟩ : Fin 4), q.1, q.1, q.2))

/-- Kind-1 indices. -/
def Shape.cntS1 {m : ℕ} (s : Shape m) : Finset (Fin 4 × Fin m × Fin m × Fin m) :=
  ((cntPairs s.cntA) ×ˢ s.cntN).image (fun q => ((⟨1, by omega⟩ : Fin 4), q.1.1, q.1.2, q.2))

/-- Kind-2 indices. -/
def Shape.cntS2 {m : ℕ} (s : Shape m) : Finset (Fin 4 × Fin m × Fin m × Fin m) :=
  s.cntB.biUnion
    (fun i => (s.cntKs i ×ˢ s.cntC).image (fun q => ((⟨2, by omega⟩ : Fin 4), i, q.1, q.2)))

/-- Kind-3 indices. -/
def Shape.cntS3 {m : ℕ} (s : Shape m) : Finset (Fin 4 × Fin m × Fin m × Fin m) :=
  ((cntPairs s.cntC) ×ˢ s.cntK).image (fun q => ((⟨3, by omega⟩ : Fin 4), q.1.1, q.2, q.1.2))

lemma Shape.cnt_idx_parts {m : ℕ} (s : Shape m) (hs : s.Valid) :
    Nat.card s.Idx ≤ m * m + (cntPairs s.cntA).card * s.cntN.card +
      (∑ i ∈ s.cntB, (s.cntKs i).card) * s.cntC.card + (cntPairs s.cntC).card * s.ncore := by
  classical
  have e : Nat.card s.Idx = (Finset.univ.filter s.IdxP).card :=
    Nat.subtype_card _ (fun x => Finset.mem_filter.trans (and_iff_right (Finset.mem_univ _)))
  have hsub : Finset.univ.filter s.IdxP ⊆ cntS0 m ∪ s.cntS1 ∪ s.cntS2 ∪ s.cntS3 := by
    rintro ⟨κ, i, k, j⟩ hq
    have hq2 : (κ.val = 0 ∧ k = i ∧ i < j) ∨
        (κ.val = 1 ∧ s.lv i = 0 ∧ s.lv k = 0 ∧ i < k ∧ 1 ≤ s.lv j) ∨
        (κ.val = 2 ∧ s.lv i = 1 ∧ (∃ c : Fin m, s.cidx k = some c ∧ c.val ≤ s.st i) ∧
          2 ≤ s.lv j) ∨
        (κ.val = 3 ∧ 2 ≤ s.lv i ∧ (s.cidx k).isSome ∧ s.lv i + 1 ≤ s.lv j) :=
      (Finset.mem_filter.1 hq).2
    simp only [Finset.mem_union]
    rcases hq2 with ⟨h0, rfl, -⟩ | ⟨h1, hi, hk, hik, hj⟩ | ⟨h2, hi, hk, hj⟩ |
      ⟨h3, hi, hk, hj⟩
    · obtain rfl : κ = ⟨0, by decide⟩ := Fin.ext h0
      exact Or.inl (Or.inl (Or.inl (Finset.mem_image.2 ⟨(_, j), Finset.mem_univ _, rfl⟩)))
    · obtain rfl : κ = ⟨1, by decide⟩ := Fin.ext h1
      refine Or.inl (Or.inl (Or.inr (Finset.mem_image.2 ⟨((i, k), j), ?_, rfl⟩)))
      exact Finset.mem_product.2
        ⟨(mem_cntPairs _ _).2 ⟨(s.mem_cntA i).2 hi, (s.mem_cntA k).2 hk, hik⟩,
          (s.mem_cntN j).2 (by omega)⟩
    · obtain rfl : κ = ⟨2, by decide⟩ := Fin.ext h2
      refine Or.inl (Or.inr (Finset.mem_biUnion.2 ⟨i, (s.mem_cntB i).2 hi,
        Finset.mem_image.2 ⟨(k, j), ?_, rfl⟩⟩))
      exact Finset.mem_product.2 ⟨(s.mem_cntKs i k).2 hk, (s.mem_cntC j).2 hj⟩
    · obtain rfl : κ = ⟨3, by decide⟩ := Fin.ext h3
      have hij : i < j := not_le.1 (fun h => by have := hs.mono j i h; omega)
      refine Or.inr (Finset.mem_image.2 ⟨((i, j), k), ?_, rfl⟩)
      exact Finset.mem_product.2
        ⟨(mem_cntPairs _ _).2 ⟨(s.mem_cntC i).2 hi, (s.mem_cntC j).2 (by omega), hij⟩,
          (s.mem_cntK k).2 hk⟩
  have hu := Finset.card_le_card hsub
  have hu1 := Finset.card_union_le (cntS0 m ∪ s.cntS1 ∪ s.cntS2) s.cntS3
  have hu2 := Finset.card_union_le (cntS0 m ∪ s.cntS1) s.cntS2
  have hu3 := Finset.card_union_le (cntS0 m) s.cntS1
  have h0 : (cntS0 m).card ≤ m * m := by
    refine Finset.card_image_le.trans (le_of_eq ?_)
    rw [Finset.card_univ, Fintype.card_prod, Fintype.card_fin]
  have h1 : s.cntS1.card ≤ (cntPairs s.cntA).card * s.cntN.card :=
    Finset.card_image_le.trans (Finset.card_product _ _).le
  have h2 : s.cntS2.card ≤ (∑ i ∈ s.cntB, (s.cntKs i).card) * s.cntC.card := by
    refine Finset.card_biUnion_le.trans ?_
    rw [Finset.sum_mul]
    exact Finset.sum_le_sum (fun i _ => Finset.card_image_le.trans (Finset.card_product _ _).le)
  have h3 : s.cntS3.card ≤ (cntPairs s.cntC).card * s.ncore := by
    refine Finset.card_image_le.trans (le_of_eq ?_)
    rw [Finset.card_product, s.cnt_ncore_eq]
  omega

/-! The cubic inequality and the final arithmetic -/

/-- The cubic inequality of section 8, with explicit polynomial certificates. -/
lemma cnt_cubic (a b c u : ℤ) (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c)
    (hua : u ≤ a) (hub : u ≤ b) :
    25 * (a ^ 2 * (b + c) + c * u * (2 * b - u + c)) ≤ 4 * (a + (b + c)) ^ 3 := by
  have hn : 0 ≤ b + c := add_nonneg hb hc
  rcases le_total b a with hba | hab
  · have P3 : 0 ≤ c * (b - u) * (b - u + c) :=
      mul_nonneg (mul_nonneg hc (by linarith)) (by linarith)
    rcases le_total (b + c) (4 * a) with h4 | h4
    · have P1 : 0 ≤ (2 * a - 3 * (b + c)) ^ 2 * (4 * a - (b + c)) :=
        mul_nonneg (sq_nonneg _) (by linarith)
      have P2 : 0 ≤ (b + c) * (b - c) ^ 2 := mul_nonneg hn (sq_nonneg _)
      linarith
    · have Q1 : 0 ≤ (a + (b + c)) * ((b + c) - 4 * a) * (4 * (b + c) - a) :=
        mul_nonneg (mul_nonneg (by linarith) (by linarith)) (by linarith)
      have Q2 : 0 ≤ (b + c) * a * b := mul_nonneg (mul_nonneg hn ha) hb
      have Q3 : 0 ≤ (b + c) * c * (a - b) := mul_nonneg (mul_nonneg hn hc) (by linarith)
      linarith
  · have R1 : 0 ≤ a ^ 3 := pow_nonneg ha 3
    have R2 : 0 ≤ (b + c) * (24 * a - 13 * (b + c)) ^ 2 := mul_nonneg hn (sq_nonneg _)
    have R3 : 0 ≤ (b + c) ^ 3 := pow_nonneg hn 3
    have R4 : 0 ≤ a * b * (b - a) := mul_nonneg (mul_nonneg ha hb) (by linarith)
    have R5 : 0 ≤ c * (a - u) * (2 * b - a - u + c) :=
      mul_nonneg (mul_nonneg hc (by linarith)) (by linarith)
    linarith

/-- The final arithmetic: `a, b, c` are the level counts, `t` the core size, `u = t - 1`. -/
lemma cnt_final (m a b c u t X1 X3 R I : ℕ) (hm : a + b + c = m) (hua : u ≤ a) (hub : u ≤ b)
    (htu : t ≤ u + 1) (hX1 : 2 * X1 ≤ a * a) (hX3 : 2 * X3 ≤ c * c)
    (hR : 2 * R + u * u ≤ 2 * (b * t) + u)
    (hI : I ≤ m * m + X1 * (b + c) + R * c + X3 * t) :
    I ≤ (2 * m ^ 3 + 50 * m ^ 2) / 25 := by
  refine (Nat.le_div_iff_mul_le (show (0 : ℕ) < 25 by norm_num)).2 ?_
  subst hm
  have hcub := cnt_cubic (a : ℤ) b c u (by positivity) (by positivity) (by positivity)
    (by exact_mod_cast hua) (by exact_mod_cast hub)
  have hua' : (u : ℤ) ≤ a := by exact_mod_cast hua
  have htu' : (t : ℤ) ≤ u + 1 := by exact_mod_cast htu
  have hX1' : 2 * (X1 : ℤ) ≤ a * a := by exact_mod_cast hX1
  have hX3' : 2 * (X3 : ℤ) ≤ c * c := by exact_mod_cast hX3
  have hR' : 2 * (R : ℤ) + u * u ≤ 2 * (b * t) + u := by exact_mod_cast hR
  have hI' : (I : ℤ) ≤ (a + b + c) * (a + b + c) + X1 * (b + c) + R * c + X3 * t := by
    exact_mod_cast hI
  have hc0 : (0 : ℤ) ≤ c := by positivity
  have ht0 : (0 : ℤ) ≤ t := by positivity
  have e1 : 2 * (X1 : ℤ) * (b + c) ≤ a * a * (b + c) :=
    mul_le_mul_of_nonneg_right hX1' (by positivity)
  have e2 : (2 * (R : ℤ) + u * u) * c ≤ (2 * (b * t) + u) * c :=
    mul_le_mul_of_nonneg_right hR' hc0
  have e3 : 2 * (X3 : ℤ) * t ≤ c * c * t := mul_le_mul_of_nonneg_right hX3' ht0
  have e4 : 0 ≤ ((u : ℤ) + 1 - t) * (b * c) := mul_nonneg (by linarith) (by positivity)
  have e5 : 0 ≤ ((u : ℤ) + 1 - t) * (c * c) := mul_nonneg (by linarith) (by positivity)
  have e6 : 0 ≤ ((a : ℤ) - u) * c := mul_nonneg (by linarith) hc0
  have e7 : (0 : ℤ) ≤ a * a := by positivity
  have e8 : (0 : ℤ) ≤ b * b := by positivity
  have e9 : (0 : ℤ) ≤ a * b := by positivity
  have e10 : (0 : ℤ) ≤ a * c := by positivity
  have e11 : (0 : ℤ) ≤ c * c := by positivity
  have e12 : (0 : ℤ) ≤ b * c := by positivity
  have goal : (I : ℤ) * 25 ≤ 2 * ((a : ℤ) + b + c) ^ 3 + 50 * ((a : ℤ) + b + c) ^ 2 := by
    linarith
  exact_mod_cast goal

/-- Every valid shape has at most `(2 m^3 + 50 m^2) / 25` indices. -/
lemma Shape.cnt_card_idx_le {m : ℕ} (s : Shape m) (hs : s.Valid) :
    Nat.card s.Idx ≤ (2 * m ^ 3 + 50 * m ^ 2) / 25 := by
  have hparts := s.cnt_idx_parts hs
  rw [s.cnt_card_N] at hparts
  have hAN := s.cnt_card_A_N
  have hN := s.cnt_card_N
  have hKA := s.cnt_ncore_le hs
  have hrho := s.cnt_rho hs
  have hks : ∑ i ∈ s.cntB, (s.cntKs i).card ≤ ∑ i ∈ s.cntB, (s.st i + 1) :=
    Finset.sum_le_sum (fun i _ => s.cnt_card_Ks_le hs i)
  have hPA := cnt_two_mul_pairs_le s.cntA
  have hPC := cnt_two_mul_pairs_le s.cntC
  exact cnt_final m s.cntA.card s.cntB.card s.cntC.card (s.ncore - 1) s.ncore
    (cntPairs s.cntA).card (cntPairs s.cntC).card (∑ i ∈ s.cntB, (s.cntKs i).card)
    (Nat.card s.Idx) (by omega) (by omega) (by omega) (by omega) hPA hPC (by omega) hparts

/-! The number of shapes and Theorem C -/

lemma cnt_card_shape_le (m : ℕ) : Nat.card (Shape m) ≤ (m + 2) ^ (5 * m) := by
  rw [Nat.card_eq_fintype_card]
  simp only [Fintype.card_prod, Fintype.card_fun, Fintype.card_option, Fintype.card_fin]
  have h1 : (m + 1) ^ m ≤ (m + 2) ^ m := Nat.pow_le_pow_left (by omega) m
  have h2 : (m * m + 1 + 1) ^ m ≤ (m + 2) ^ (2 * m) := by
    rw [pow_mul]
    exact Nat.pow_le_pow_left (by nlinarith) m
  have h3 : m ^ m ≤ (m + 2) ^ m := Nat.pow_le_pow_left (by omega) m
  have h5 : (m + 2) ^ (5 * m) =
      (m + 2) ^ m * ((m + 2) ^ (2 * m) * ((m + 2) ^ m * (m + 2) ^ m)) := by
    ring
  rw [h5]
  exact Nat.mul_le_mul h1 (Nat.mul_le_mul h2 (Nat.mul_le_mul h1 h3))

/-- Theorem C: the number of codes. -/
theorem card_code_le (p m : ℕ) (hp : 0 < p) :
    Nat.card (Code p m) ≤ (m + 2) ^ (5 * m) * p ^ ((2 * m ^ 3 + 50 * m ^ 2) / 25) := by
  classical
  unfold Code
  rw [Nat.card_sigma]
  have key : ∀ s : {s : Shape m // s.Valid},
      Nat.card (s.1.Idx → Fin p) ≤ p ^ ((2 * m ^ 3 + 50 * m ^ 2) / 25) := by
    intro s
    rw [Nat.card_fun, Nat.card_eq_fintype_card (α := Fin p), Fintype.card_fin]
    exact Nat.pow_le_pow_right hp (s.1.cnt_card_idx_le s.2)
  have hS : Fintype.card {s : Shape m // s.Valid} ≤ (m + 2) ^ (5 * m) := by
    have h1 := Fintype.card_subtype_le (fun s : Shape m => s.Valid)
    have h2 := cnt_card_shape_le m
    rw [Nat.card_eq_fintype_card] at h2
    exact h1.trans h2
  refine (Finset.sum_le_sum (fun s _ => key s)).trans ?_
  rw [Finset.sum_const, Finset.card_univ, smul_eq_mul]
  exact Nat.mul_le_mul_right _ hS

end Count

end OMA.SimsLite


-- ===== Rigidity =====
/-! Theorem R (rigidity): two groups realising the same code are isomorphic.

The proof works in the subgroup `D` of `G × G'` generated by the paired generators. The paired
generators satisfy the relations of the code, the Lie lemma (tail form) shows that every term of
the lower central series of `D` is generated by the later positions, so normal forms exist and
`Nat.card D ≤ p ^ m`. Both projections are onto, hence bijective. -/

namespace OMA.SimsLite

open scoped commutatorElement

universe u

section RigidityAux

/-- Strong induction over `Fin m`. -/
lemma fin_strong_ind {m : ℕ} {C : Fin m → Prop}
    (h : ∀ i : Fin m, (∀ j : Fin m, j.val < i.val → C j) → C i) : ∀ i, C i := by
  have key : ∀ n, ∀ i : Fin m, i.val = n → C i := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro i hi
      exact h i (fun j hj => ih j.val (by omega) j rfl)
  exact fun i => key _ i rfl

/-- Positions at or after `start w` have level at least `w`. -/
lemma le_lv_of_start_le {m : ℕ} {s : Shape m} (hs : s.Valid) {w : ℕ} {j : Fin m}
    (hj : s.start w ≤ j.val) : w ≤ s.lv j := by
  rcases Nat.lt_or_ge (s.lv j) w with hlt | hge
  · exfalso
    have hk : ∀ k : Fin (j.val + 1), k.val < m := fun k => by
      have h1 := k.isLt
      have h2 := j.isLt
      omega
    have hw : ∀ k : Fin (j.val + 1), s.lv ⟨k.val, hk k⟩ < w := fun k =>
      lt_of_le_of_lt (hs.mono ⟨k.val, hk k⟩ j (Fin.le_def.mpr (Nat.le_of_lt_succ k.isLt))) hlt
    have hc := Nat.card_le_card_of_injective
      (fun k : Fin (j.val + 1) => (⟨⟨k.val, hk k⟩, hw k⟩ : {i : Fin m // s.lv i < w}))
      (fun a b hab => Fin.ext (congrArg (fun x : {i : Fin m // s.lv i < w} => x.1.val) hab))
    rw [Nat.card_fin] at hc
    unfold Shape.start at hj
    omega
  · exact hge

/-- The positions of level `l` defined as commutators. -/
def levE {D : Type u} {m : ℕ} (s : Shape m) (Z : Fin m → D) (l : ℕ) : Set D :=
  {x | ∃ i a b, s.df i = some (some (a, b)) ∧ s.lv i = l ∧ x = Z i}

lemma mem_levE {D : Type u} {m : ℕ} {s : Shape m} {Z : Fin m → D} {l : ℕ} {x : D} :
    x ∈ levE s Z l ↔ ∃ i a b, s.df i = some (some (a, b)) ∧ s.lv i = l ∧ x = Z i := Iff.rfl

/-- The free positions. -/
def freeSet {D : Type u} {m : ℕ} (s : Shape m) (Z : Fin m → D) : Set D :=
  {x | ∃ i, s.df i = none ∧ x = Z i}

lemma mem_freeSet {D : Type u} {m : ℕ} {s : Shape m} {Z : Fin m → D} {x : D} :
    x ∈ freeSet s Z ↔ ∃ i, s.df i = none ∧ x = Z i := Iff.rfl

variable {D : Type u} [Group D]

lemma mem_cl_drop_ofFn {m : ℕ} (Z : Fin m → D) {n : ℕ} (j : Fin m) (h : n ≤ j.val) :
    Z j ∈ cl ((List.ofFn Z).drop n) := by
  have hm := getElem_mem_drop (List.ofFn Z) h (lt_of_lt_of_eq j.isLt List.length_ofFn.symm)
  rw [List.getElem_ofFn] at hm
  exact mem_cl_of_mem hm

lemma cl_drop_ofFn_le {m : ℕ} (Z : Fin m → D) (n : ℕ) (H : Subgroup D)
    (h : ∀ j : Fin m, n ≤ j.val → Z j ∈ H) : cl ((List.ofFn Z).drop n) ≤ H := by
  rw [cl_def, Subgroup.closure_le]
  intro x hx
  obtain ⟨k, hk, rfl⟩ := List.getElem_of_mem hx
  rw [List.getElem_drop, List.getElem_ofFn]
  exact h _ (Nat.le_add_right n k)

open Classical in
/-- The core element of core index `k` (junk value `1` when there is none). -/
noncomputable def coreElt {m : ℕ} (s : Shape m) (Z : Fin m → D) (k : ℕ) : D :=
  if h : ∃ j : Fin m, ∃ κ : Fin m, s.cidx j = some κ ∧ κ.val = k then Z h.choose else 1

lemma coreElt_eq {m : ℕ} {s : Shape m} (hs : s.Valid) (Z : Fin m → D) {j κ : Fin m}
    (hj : s.cidx j = some κ) : coreElt s Z κ.val = Z j := by
  have h : ∃ j : Fin m, ∃ κ' : Fin m, s.cidx j = some κ' ∧ κ'.val = κ.val := ⟨j, κ, hj, rfl⟩
  unfold coreElt
  rw [dif_pos h]
  obtain ⟨κ', h1, h2⟩ := h.choose_spec
  have h1' : s.cidx h.choose = some κ := by rw [h1, Fin.ext h2]
  exact congrArg Z (hs.core_inj _ _ κ h1' hj)

lemma coreElt_cases {m : ℕ} {s : Shape m} (hs : s.Valid) (Z : Fin m → D) (k : ℕ) :
    coreElt s Z k = 1 ∨ ∃ j κ : Fin m, s.cidx j = some κ ∧ κ.val = k ∧ coreElt s Z k = Z j := by
  by_cases h : ∃ j : Fin m, ∃ κ : Fin m, s.cidx j = some κ ∧ κ.val = k
  · obtain ⟨j, κ, hj, rfl⟩ := h
    exact Or.inr ⟨j, κ, hj, rfl, coreElt_eq hs Z hj⟩
  · left
    unfold coreElt
    rw [dif_neg h]

/-- The pairs of core indices of the level-1 commutator positions. -/
def coreP {m : ℕ} (s : Shape m) : Set (ℕ × ℕ) :=
  {ab | ∃ (i a b ka kb : Fin m), s.df i = some (some (a, b)) ∧ s.lv i = 1 ∧
    s.cidx a = some ka ∧ s.cidx b = some kb ∧ ab = (ka.val, kb.val)}

lemma mem_coreP {m : ℕ} {s : Shape m} {ab : ℕ × ℕ} :
    ab ∈ coreP s ↔ ∃ (i a b ka kb : Fin m), s.df i = some (some (a, b)) ∧ s.lv i = 1 ∧
      s.cidx a = some ka ∧ s.cidx b = some kb ∧ ab = (ka.val, kb.val) := Iff.rfl

/-- The counting core of Theorem R: a nilpotent group generated by a tuple satisfying the
relations of a valid shape has at most `p ^ m` elements. -/
theorem card_le_of_code {p m : ℕ} (hp : 0 < p) (s : Shape m) (hs : s.Valid) (Z : Fin m → D)
    (hgen : Subgroup.closure (Set.range Z) = ⊤)
    (hN : ∃ N, lcs D N = ⊥)
    (hpow : ∀ i, s.df i = some none → ∀ _ : 0 < i.val,
      Z i = Z ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩ ^ p)
    (hcomm : ∀ i a b, s.df i = some (some (a, b)) → Z i = ⁅Z a, Z b⁆)
    (h2 : ∀ i : Fin m, Z i ^ p ∈ cl ((List.ofFn Z).drop (i.val + 1)))
    (h3 : ∀ i k, s.lv i = 0 → s.lv k = 0 → i < k →
      ⁅Z i, Z k⁆ ∈ cl ((List.ofFn Z).drop (s.start 1)))
    (h4 : ∀ i k (κ : Fin m), s.lv i = 1 → s.cidx k = some κ → κ.val ≤ s.st i →
      ⁅Z i, Z k⁆ ∈ cl ((List.ofFn Z).drop (s.start 2)))
    (h5 : ∀ i k, 2 ≤ s.lv i → (s.cidx k).isSome →
      ⁅Z i, Z k⁆ ∈ cl ((List.ofFn Z).drop (s.start (s.lv i + 1)))) :
    Nat.card D ≤ p ^ m := by
  obtain ⟨N, hN⟩ := hN
  -- every generator lies in the term of the lower central series given by its level
  have hlv : ∀ i, Z i ∈ lcs D (s.lv i) := by
    refine fin_strong_ind ?_
    intro i ih
    match hdf : s.df i with
    | none =>
      rw [hs.free i hdf, lcs_zero]
      exact Subgroup.mem_top _
    | some none =>
      obtain ⟨h0, hl, -⟩ := hs.pow i hdf
      have hprev : Z _ ∈ lcs D (s.lv _) :=
        ih ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩ (by show i.val - 1 < i.val; omega)
      rw [hl] at hprev
      rw [hpow i hdf h0]
      exact pow_mem hprev p
    | some (some (a, b)) =>
      obtain ⟨hai, -, -, hl, -⟩ := hs.comm i a b hdf
      rw [hcomm i a b hdf, hl]
      exact commElem_mem_lcs_succ (ih a (Fin.lt_def.mp hai)) _
  -- a generator of level `l ≥ 1` lies in the subgroup generated by the level-`l` commutators
  have hE : ∀ i, 1 ≤ s.lv i → Z i ∈ Subgroup.closure (levE s Z (s.lv i)) := by
    refine fin_strong_ind ?_
    intro i ih h1
    match hdf : s.df i with
    | none =>
      rw [hs.free i hdf] at h1
      omega
    | some none =>
      obtain ⟨h0, hl, -⟩ := hs.pow i hdf
      have hprev : Z _ ∈ Subgroup.closure (levE s Z (s.lv _)) :=
        ih ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩
          (by show i.val - 1 < i.val; omega) (by rw [hl]; exact h1)
      rw [hl] at hprev
      rw [hpow i hdf h0]
      exact pow_mem hprev p
    | some (some (a, b)) =>
      exact Subgroup.subset_closure (mem_levE.mpr ⟨i, a, b, hdf, rfl, rfl⟩)
  -- the tail from `start w` lies in the level-`w` generators modulo the next term
  have hdrop : ∀ w, 1 ≤ w → cl ((List.ofFn Z).drop (s.start w)) ≤
      Subgroup.closure (levE s Z w) ⊔ lcs D (w + 1) := by
    intro w hw
    apply cl_drop_ofFn_le
    intro j hj
    have hwj := le_lv_of_start_le hs hj
    rcases Nat.lt_or_ge w (s.lv j) with hlt | hge
    · exact Subgroup.mem_sup_right (lcs_antitone (D := D) (show w + 1 ≤ s.lv j by omega) (hlv j))
    · have heq : s.lv j = w := le_antisymm hge hwj
      have hj' := hE j (by omega)
      rw [heq] at hj'
      exact Subgroup.mem_sup_left hj'
  -- the hypotheses of the Lie lemma
  have hP : ∀ ab ∈ coreP s, ab.1 < ab.2 ∧ ab.2 < s.ncore := by
    intro ab hab
    obtain ⟨i, a, b, ka, kb, hdf, hl, hka, hkb, rfl⟩ := mem_coreP.mp hab
    obtain ⟨-, -, -, -, h1⟩ := hs.comm i a b hdf
    obtain ⟨ka', kb', hka', hkb', hlt, -⟩ := h1 hl
    have e1 : ka' = ka := Option.some_inj.mp (hka'.symm.trans hka)
    have e2 : kb' = kb := Option.some_inj.mp (hkb'.symm.trans hkb)
    rw [e1, e2] at hlt
    exact ⟨Fin.lt_def.mp hlt, (hs.core b kb hkb).2⟩
  have hE1 : levE s Z 1 =
      (fun ab : ℕ × ℕ => ⁅coreElt s Z ab.1, coreElt s Z ab.2⁆) '' coreP s := by
    ext x
    constructor
    · intro hx
      obtain ⟨i, a, b, hdf, hl, rfl⟩ := mem_levE.mp hx
      obtain ⟨-, -, -, -, h1⟩ := hs.comm i a b hdf
      obtain ⟨ka, kb, hka, hkb, -, -⟩ := h1 hl
      refine ⟨(ka.val, kb.val), mem_coreP.mpr ⟨i, a, b, ka, kb, hdf, hl, hka, hkb, rfl⟩, ?_⟩
      show ⁅coreElt s Z ka.val, coreElt s Z kb.val⁆ = Z i
      rw [coreElt_eq hs Z hka, coreElt_eq hs Z hkb, hcomm i a b hdf]
    · rintro ⟨ab, hab, rfl⟩
      obtain ⟨i, a, b, ka, kb, hdf, hl, hka, hkb, rfl⟩ := mem_coreP.mp hab
      refine mem_levE.mpr ⟨i, a, b, hdf, hl, ?_⟩
      show ⁅coreElt s Z ka.val, coreElt s Z kb.val⁆ = Z i
      rw [coreElt_eq hs Z hka, coreElt_eq hs Z hkb, hcomm i a b hdf]
  have hL2 : ∀ w, 1 ≤ w → ∀ x ∈ levE s Z (w + 1), ∃ y ∈ Subgroup.closure (levE s Z w),
      ∃ b < s.ncore, x = ⁅y, coreElt s Z b⁆ := by
    intro w hw x hx
    obtain ⟨i, a, b, hdf, hl, rfl⟩ := mem_levE.mp hx
    obtain ⟨-, -, hb, hla, -⟩ := hs.comm i a b hdf
    obtain ⟨kb, hkb⟩ := Option.isSome_iff_exists.mp hb
    have hya := hE a (by omega)
    rw [show s.lv a = w by omega] at hya
    refine ⟨Z a, hya, kb.val, (hs.core b kb hkb).2, ?_⟩
    rw [coreElt_eq hs Z hkb]
    exact hcomm i a b hdf
  have hfree : ∀ i, Z i ∈ Subgroup.closure (freeSet s Z) ⊔ lcs D 1 := by
    refine fin_strong_ind ?_
    intro i ih
    match hdf : s.df i with
    | none =>
      exact Subgroup.mem_sup_left (Subgroup.subset_closure (mem_freeSet.mpr ⟨i, hdf, rfl⟩))
    | some none =>
      obtain ⟨h0, -, -⟩ := hs.pow i hdf
      have hprev : Z _ ∈ Subgroup.closure (freeSet s Z) ⊔ lcs D 1 :=
        ih ⟨i.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) i.isLt⟩ (by show i.val - 1 < i.val; omega)
      rw [hpow i hdf h0]
      exact pow_mem hprev p
    | some (some (a, b)) =>
      rw [hcomm i a b hdf]
      exact Subgroup.mem_sup_right (commElem_mem_lcs_succ (n := 0) (Subgroup.mem_top _) _)
  have hL0 : Subgroup.closure (freeSet s Z) ⊔ lcs D 1 = ⊤ := by
    have hle : Subgroup.closure (Set.range Z) ≤ Subgroup.closure (freeSet s Z) ⊔ lcs D 1 := by
      rw [Subgroup.closure_le]
      rintro x ⟨i, rfl⟩
      exact hfree i
    rw [hgen] at hle
    exact top_le_iff.mp hle
  have hH1 : ∀ x ∈ freeSet s Z, ∀ y ∈ freeSet s Z,
      ⁅x, y⁆ ∈ Subgroup.closure (levE s Z 1) ⊔ lcs D 2 := by
    intro x hx y hy
    obtain ⟨i, hi, rfl⟩ := mem_freeSet.mp hx
    obtain ⟨k, hk, rfl⟩ := mem_freeSet.mp hy
    have hli := hs.free i hi
    have hlk := hs.free k hk
    rcases lt_trichotomy i k with hik | rfl | hki
    · exact hdrop 1 le_rfl (h3 i k hli hlk hik)
    · rw [commutatorElement_self]
      exact one_mem _
    · rw [← commutatorElement_inv]
      exact inv_mem (hdrop 1 le_rfl (h3 k i hlk hli hki))
  have hH2 : ∀ ab ∈ coreP s, ∀ k ≤ ab.2,
      ⁅⁅coreElt s Z ab.1, coreElt s Z ab.2⁆, coreElt s Z k⁆ ∈
        Subgroup.closure (levE s Z 2) ⊔ lcs D 3 := by
    intro ab hab k hk
    obtain ⟨i, a, b, ka, kb, hdf, hl, hka, hkb, rfl⟩ := mem_coreP.mp hab
    obtain ⟨-, -, -, -, h1⟩ := hs.comm i a b hdf
    obtain ⟨-, kb', -, hkb', -, hst⟩ := h1 hl
    have e2 : kb' = kb := Option.some_inj.mp (hkb'.symm.trans hkb)
    rw [e2] at hst
    have hk' : k ≤ kb.val := hk
    show ⁅⁅coreElt s Z ka.val, coreElt s Z kb.val⁆, coreElt s Z k⁆ ∈ _
    rw [coreElt_eq hs Z hka, coreElt_eq hs Z hkb, ← hcomm i a b hdf]
    rcases coreElt_cases hs Z k with h0 | ⟨j, κ, hj, hκ, hjk⟩
    · rw [h0, commutatorElement_one_right]
      exact one_mem _
    · rw [hjk]
      exact hdrop 2 (by omega) (h4 i j κ hl hj (by omega))
  have hH3 : ∀ w, 2 ≤ w → ∀ x ∈ levE s Z w, ∀ k < s.ncore,
      ⁅x, coreElt s Z k⁆ ∈ Subgroup.closure (levE s Z (w + 1)) ⊔ lcs D (w + 2) := by
    intro w hw x hx k _
    obtain ⟨i, a, b, hdf, hl, rfl⟩ := mem_levE.mp hx
    rcases coreElt_cases hs Z k with h0 | ⟨j, κ, hj, hκ, hjk⟩
    · rw [h0, commutatorElement_one_right]
      exact one_mem _
    · rw [hjk]
      have h5' := h5 i j (by omega) (by simp [hj])
      rw [hl] at h5'
      have hres := hdrop (w + 1) (by omega) h5'
      rwa [show w + 1 + 1 = w + 2 by omega] at hres
  have htail := lie_lemma_tail s.ncore (coreElt s Z) (freeSet s Z) (coreP s) (levE s Z)
    hP hE1 hL2 hL0 hH1 hH2 hH3 N hN
  -- the term of level `lv j + 1` lies in the closure of the positions after `j`
  have htailcl : ∀ j : Fin m, lcs D (s.lv j + 1) ≤ cl ((List.ofFn Z).drop (j.val + 1)) := by
    intro j
    refine le_trans (htail (s.lv j + 1) (by omega)) ?_
    rw [Subgroup.closure_le]
    intro x hx
    simp only [Set.mem_iUnion, Set.mem_Ici, exists_prop] at hx
    obtain ⟨v, hv, hxv⟩ := hx
    obtain ⟨k, a, b, -, hlk, rfl⟩ := mem_levE.mp hxv
    refine mem_cl_drop_ofFn Z k ?_
    rcases Nat.lt_or_ge j.val k.val with hjk | hjk
    · omega
    · have hmono := hs.mono k j (Fin.le_def.mpr hjk)
      omega
  -- normal forms
  have hsurj : ∀ x : D, ∃ e : ℕ → ℕ, (∀ k, e k < p) ∧ x = nf (List.ofFn Z) e := by
    intro x
    refine nf_surj p hp (List.ofFn Z) ?_ ?_ x ?_
    · intro i hi
      have him : i < m := lt_of_lt_of_eq hi List.length_ofFn
      simp only [List.getElem_ofFn]
      exact h2 ⟨i, him⟩
    · intro i j hij hj
      have hjm : j < m := lt_of_lt_of_eq hj List.length_ofFn
      have him : i < m := lt_trans hij hjm
      simp only [List.getElem_ofFn]
      have hc : Z ⟨i, him⟩ * Z ⟨j, hjm⟩ * (Z ⟨i, him⟩)⁻¹ =
          ⁅Z ⟨i, him⟩, Z ⟨j, hjm⟩⁆ * Z ⟨j, hjm⟩ := by
        simp only [commutatorElement_def]
        group
      rw [hc]
      refine mul_mem ?_ (mem_cl_drop_ofFn Z ⟨j, hjm⟩ (show i + 1 ≤ j by omega))
      exact cl_drop_mono (List.ofFn Z) (show i + 1 ≤ j + 1 by omega)
        (htailcl ⟨j, hjm⟩ (commElem_mem_lcs_succ' (Z ⟨i, him⟩) (hlv ⟨j, hjm⟩)))
    · have hle : Subgroup.closure (Set.range Z) ≤ cl (List.ofFn Z) := by
        rw [Subgroup.closure_le]
        rintro y ⟨i, rfl⟩
        have hi := mem_cl_drop_ofFn Z (n := 0) i (Nat.zero_le _)
        rwa [List.drop_zero] at hi
      rw [hgen] at hle
      exact hle (Subgroup.mem_top x)
  have hF : Function.Surjective (fun f : Fin m → Fin p =>
      nf (List.ofFn Z) (fun k => if h : k < m then ((f ⟨k, h⟩ : Fin p) : ℕ) else 0)) := by
    intro x
    obtain ⟨e, he, rfl⟩ := hsurj x
    refine ⟨fun k => ⟨e k.val, he k.val⟩, ?_⟩
    apply nf_congr
    intro k hk
    have hkm : k < m := lt_of_lt_of_eq hk List.length_ofFn
    simp [hkm]
  have hc := Nat.card_le_card_of_surjective _ hF
  simpa only [Nat.card_fun, Nat.card_fin] using hc

end RigidityAux

section Diag

variable {G G' : Type u} [Group G] [Group G'] {m : ℕ}

/-- The subgroup of `G × G'` generated by the paired generators. -/
abbrev diagSub (X : Fin m → G) (X' : Fin m → G') : Subgroup (G × G') :=
  Subgroup.closure (Set.range fun i => (X i, X' i))

/-- The paired generators, as elements of `diagSub`. -/
def diagGen (X : Fin m → G) (X' : Fin m → G') (i : Fin m) : diagSub X X' :=
  ⟨(X i, X' i), Subgroup.subset_closure ⟨i, rfl⟩⟩

/-- The first projection on `diagSub`. -/
def diagFst (X : Fin m → G) (X' : Fin m → G') : diagSub X X' →* G :=
  (MonoidHom.fst G G').comp (diagSub X X').subtype

/-- The second projection on `diagSub`. -/
def diagSnd (X : Fin m → G) (X' : Fin m → G') : diagSub X X' →* G' :=
  (MonoidHom.snd G G').comp (diagSub X X').subtype

lemma diagFst_gen (X : Fin m → G) (X' : Fin m → G') (i : Fin m) :
    diagFst X X' (diagGen X X' i) = X i := rfl

lemma diagSnd_gen (X : Fin m → G) (X' : Fin m → G') (i : Fin m) :
    diagSnd X X' (diagGen X X' i) = X' i := rfl

lemma diag_ext (X : Fin m → G) (X' : Fin m → G') {x y : diagSub X X'}
    (h1 : diagFst X X' x = diagFst X X' y) (h2 : diagSnd X X' x = diagSnd X X' y) : x = y :=
  Subtype.ext (Prod.ext h1 h2)

lemma diagGen_closure (X : Fin m → G) (X' : Fin m → G') :
    Subgroup.closure (Set.range (diagGen X X')) = ⊤ := by
  have hpre : Set.range (diagGen X X') =
      ((↑) : diagSub X X' → G × G') ⁻¹' (Set.range fun i => (X i, X' i)) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact Set.mem_preimage.mpr ⟨i, rfl⟩
    · rintro ⟨i, hi⟩
      exact ⟨i, Subtype.ext hi⟩
  rw [hpre]
  exact Subgroup.closure_closure_coe_preimage

lemma diagFst_surj (X : Fin m → G) (X' : Fin m → G')
    (hX : Subgroup.closure (Set.range X) = ⊤) : Function.Surjective (diagFst X X') := by
  intro y
  have hy : y ∈ (diagSub X X').map (MonoidHom.fst G G') := by
    rw [MonoidHom.map_closure, ← Set.range_comp]
    have hr : (⇑(MonoidHom.fst G G') ∘ fun i => (X i, X' i)) = X := rfl
    rw [hr, hX]
    exact Subgroup.mem_top y
  obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hy
  exact ⟨⟨z, hz⟩, rfl⟩

lemma diagSnd_surj (X : Fin m → G) (X' : Fin m → G')
    (hX : Subgroup.closure (Set.range X') = ⊤) : Function.Surjective (diagSnd X X') := by
  intro y
  have hy : y ∈ (diagSub X X').map (MonoidHom.snd G G') := by
    rw [MonoidHom.map_closure, ← Set.range_comp]
    have hr : (⇑(MonoidHom.snd G G') ∘ fun i => (X i, X' i)) = X' := rfl
    rw [hr, hX]
    exact Subgroup.mem_top y
  obtain ⟨z, hz, rfl⟩ := Subgroup.mem_map.mp hy
  exact ⟨⟨z, hz⟩, rfl⟩

/-- The paired subgroup of two realisations of the same code has at most `p ^ m` elements. -/
theorem diag_card_le {p : ℕ} (hp : 0 < p) [Group.IsNilpotent G] [Group.IsNilpotent G']
    (X : Fin m → G) (X' : Fin m → G') (c : Code p m) (h : Realizes X c) (h' : Realizes X' c) :
    Nat.card (diagSub X X') ≤ p ^ m := by
  obtain ⟨-, -, hpow, hcomm, h2, h3, h4, h5⟩ := h
  obtain ⟨-, -, hpow', hcomm', h2', h3', h4', h5'⟩ := h'
  have hmap : (List.ofFn (diagGen X X')).map (diagFst X X') = List.ofFn X := by
    rw [List.map_ofFn]
    rfl
  have hmap' : (List.ofFn (diagGen X X')).map (diagSnd X X') = List.ofFn X' := by
    rw [List.map_ofFn]
    rfl
  have hcl : ∀ (x : diagSub X X') (n : ℕ) (e : ℕ → ℕ),
      diagFst X X' x = nf ((List.ofFn X).drop n) e →
      diagSnd X X' x = nf ((List.ofFn X').drop n) e →
      x ∈ cl ((List.ofFn (diagGen X X')).drop n) := by
    intro x n e e1 e2
    have hx : x = nf ((List.ofFn (diagGen X X')).drop n) e := by
      apply diag_ext X X'
      · rw [e1, nf_map, List.map_drop, hmap]
      · rw [e2, nf_map, List.map_drop, hmap']
    rw [hx]
    exact nf_mem _ _
  refine card_le_of_code hp c.1.1 c.1.2 (diagGen X X') (diagGen_closure X X') ?_ ?_ ?_ ?_ ?_ ?_ ?_
  · exact Subgroup.nilpotent_iff_lowerCentralSeries.mp inferInstance
  · intro i hd h0
    apply diag_ext X X'
    · simp only [map_pow, diagFst_gen]
      exact hpow i hd h0
    · simp only [map_pow, diagSnd_gen]
      exact hpow' i hd h0
  · intro i a b hd
    apply diag_ext X X'
    · simp only [map_commutatorElement, diagFst_gen]
      exact hcomm i a b hd
    · simp only [map_commutatorElement, diagSnd_gen]
      exact hcomm' i a b hd
  · intro i
    apply hcl
    · simp only [map_pow, diagFst_gen]
      exact h2 i
    · simp only [map_pow, diagSnd_gen]
      exact h2' i
  · intro i k hi hk hik
    apply hcl
    · simp only [map_commutatorElement, diagFst_gen]
      exact h3 i k hi hk hik
    · simp only [map_commutatorElement, diagSnd_gen]
      exact h3' i k hi hk hik
  · intro i k κ hi hk hκ
    apply hcl
    · simp only [map_commutatorElement, diagFst_gen]
      exact h4 i k κ hi hk hκ
    · simp only [map_commutatorElement, diagSnd_gen]
      exact h4' i k κ hi hk hκ
  · intro i k hi hk
    apply hcl
    · simp only [map_commutatorElement, diagFst_gen]
      exact h5 i k hi hk
    · simp only [map_commutatorElement, diagSnd_gen]
      exact h5' i k hi hk

end Diag

/-- Theorem R: two finite groups realising the same code are isomorphic. -/
theorem rigidity {p m : Nat} (hp : p.Prime) {G G' : Type u} [Group G] [Group G'] [Finite G]
    [Finite G'] (X : Fin m -> G) (X' : Fin m -> G') (c : Code p m) (h : Realizes X c)
    (h' : Realizes X' c) : Nonempty (G ≃* G') := by
  have hR := h
  have hR' := h'
  obtain ⟨hcard, hgen, -⟩ := hR
  obtain ⟨hcard', hgen', -⟩ := hR'
  have : Fact p.Prime := ⟨hp⟩
  have : Group.IsNilpotent G := (IsPGroup.of_card hcard).isNilpotent
  have : Group.IsNilpotent G' := (IsPGroup.of_card hcard').isNilpotent
  have hK := diag_card_le hp.pos X X' c h h'
  have hb1 : Function.Bijective (diagFst X X') :=
    (diagFst_surj X X' hgen).bijective_of_nat_card_le (by rw [hcard]; exact hK)
  have hb2 : Function.Bijective (diagSnd X X') :=
    (diagSnd_surj X X' hgen').bijective_of_nat_card_le (by rw [hcard']; exact hK)
  exact ⟨(MulEquiv.ofBijective (diagFst X X') hb1).symm.trans
    (MulEquiv.ofBijective (diagSnd X X') hb2)⟩

end OMA.SimsLite


